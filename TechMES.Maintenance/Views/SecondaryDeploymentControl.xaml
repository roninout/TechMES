<views:MaintenancePageControl x:Class="TechMES.Maintenance.Views.SecondaryDeploymentControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:views="clr-namespace:TechMES.Maintenance.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Deployment на Secondary" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock Text="Maintenance работает только на Primary. Выбранные службы Secondary будут обновлены и запущены." TextWrapping="Wrap" Margin="0,0,0,12" />

            <TextBlock Text="Готовый ZIP" />
            <DockPanel Margin="0,4,0,10">
                <ui:Button Content="Выбрать ZIP" Click="OnChooseSecondaryArchiveClick" DockPanel.Dock="Right" Margin="8,0,0,0" />
                <ui:TextBox Text="{Binding SecondaryDeployment.ArchivePath, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <TextBlock Text="Secondary: имя или IPv4" />
            <ui:TextBox Text="{Binding SecondaryDeployment.ComputerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />

            <TextBlock Text="Приложения на Secondary — локальный путь" />
            <ui:TextBox Text="{Binding SecondaryDeployment.InstallRoot, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />

            <TextBlock Text="Отдельная папка пакетов — локальный путь на Secondary" />
            <ui:TextBox Text="{Binding SecondaryDeployment.StageRoot, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />

            <TextBlock Text="Сетевой путь к той же папке пакетов" />
            <ui:TextBox Text="{Binding SecondaryDeployment.ShareRoot, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />

            <TextBlock Text="Проверка Runtime — localhost на Secondary" />
            <ui:TextBox Text="{Binding SecondaryDeployment.RuntimeStatusUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />

            <TextBlock Text="Зашифрованный файл учётной записи (пусто — текущая Windows)" />
            <ui:TextBox Text="{Binding SecondaryDeployment.CredentialPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />

            <WrapPanel Margin="0,6,0,12">
                <CheckBox Content="Runtime" IsChecked="{Binding SecondaryDeployment.UpdateRuntime}" Margin="0,0,18,0" />
                <CheckBox Content="Calc" IsChecked="{Binding SecondaryDeployment.UpdateCalc}" Margin="0,0,18,0" />
                <CheckBox Content="Web" IsChecked="{Binding SecondaryDeployment.UpdateWeb}" />
            </WrapPanel>

            <TextBlock Text="{Binding SecondaryDeployment.LoadError}" TextWrapping="Wrap" Margin="0,0,0,8" />

            <WrapPanel Margin="0,0,0,12">
                <ui:Button Content="Сохранить профиль" Click="OnSaveSecondaryDeploymentClick" Margin="0,0,12,0" />
                <ui:Button Content="Deploy Secondary" Click="OnDeploySecondaryClick" />
            </WrapPanel>

            <ui:TextBox Text="{Binding SecondaryDeploymentLog, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Height="300" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" TextChanged="OnAutoScrollLogTextChanged" />
        </StackPanel>
    </ScrollViewer>
</views:MaintenancePageControl>