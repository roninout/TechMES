<UserControl x:Class="TechMES.Maintenance.Views.PostgreSqlSwitchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock x:Name="ConnectionText" Margin="0,0,0,10" />
            <ui:Button x:Name="RefreshButton" Content="Обновить состояние" Click="OnRefreshClick" Margin="0,0,0,10" />

            <StackPanel x:Name="SwitchingPanel">
                <TextBlock Text="Плановое переключение: Fence → Promote → Rejoin. Направление определяется фактическими ролями БД."
                           Margin="0,0,0,8" />

                <WrapPanel Margin="0,0,0,4">
                    <ui:Button x:Name="SwitchButton" Content="Переключить Primary → Standby" Click="OnSwitchClick"
                               IsEnabled="False" Margin="0,0,8,8" />

                    <ui:Button x:Name="ResumeButton" Content="Продолжить текущую операцию" Click="OnResumeClick"
                               IsEnabled="False" Margin="0,0,8,8" />
                </WrapPanel>

                <DataGrid x:Name="NodesGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                          MinHeight="95" Margin="0,0,0,12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Узел" Binding="{Binding Address}" Width="130" />
                        <DataGridTextColumn Header="Фактическая роль" Binding="{Binding Role}" Width="120" />
                        <DataGridTextColumn Header="Хост" Binding="{Binding Host}" Width="100" />
                        <DataGridTextColumn Header="Служба PG" Binding="{Binding Service}" Width="100" />
                        <DataGridTextColumn Header="Контроллер" Binding="{Binding Controller}" Width="110" />
                        <DataGridTextColumn Header="Проверено" Binding="{Binding Checked}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Ход текущего запуска" FontWeight="SemiBold" Margin="0,0,0,6" />

                <ui:TextBox x:Name="ProgressBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                            MinHeight="130" MaxHeight="280" VerticalScrollBarVisibility="Auto" />
            </StackPanel>

            <StackPanel x:Name="HistoryPanel" Visibility="Collapsed">
                <TextBlock Text="История и этапы операций" FontWeight="SemiBold" Margin="0,0,0,6" />

                <DataGrid x:Name="HistoryGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                          MaxHeight="240" MinHeight="100" SelectionChanged="OnHistorySelected" Margin="0,0,0,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Создана" Binding="{Binding Created}" Width="125" />
                        <DataGridTextColumn Header="Направление" Binding="{Binding Direction}" Width="190" />
                        <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="125" />
                        <DataGridTextColumn Header="Fence" Binding="{Binding Fence}" Width="100" />
                        <DataGridTextColumn Header="Promote" Binding="{Binding Promote}" Width="100" />
                        <DataGridTextColumn Header="Восстановление" Binding="{Binding Recovery}" Width="145" />
                    </DataGrid.Columns>
                </DataGrid>

                <ui:TextBox x:Name="DetailsBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                            MinHeight="100" MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
