<views:MaintenancePageControl x:Class="TechMES.Maintenance.Views.DeploymentPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:views="clr-namespace:TechMES.Maintenance.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <TextBlock Text="Deployment" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
            <TextBlock Text="Один архив, два профиля. Подготовьте комплект, отправьте его кнопкой Send или скопируйте вручную. Скрипт запускается локально на выбранном сервере." TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock Text="Общий ZIP TechMES" />
            <DockPanel Margin="0,4,0,12">
                <ui:Button Content="Выбрать ZIP" Click="OnChooseDeploymentArchiveClick" DockPanel.Dock="Right" Margin="8,0,0,0" />
                <ui:TextBox Text="{Binding PackageDeployment.ArchivePath, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <TextBlock Text="Локальная папка подготовки комплектов" />
            <DockPanel Margin="0,4,0,12">
                <ui:Button Content="Выбрать папку" Click="OnChooseDeploymentOutputClick" DockPanel.Dock="Right" Margin="8,0,0,0" />
                <ui:TextBox Text="{Binding PackageDeployment.OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <TabControl ItemsSource="{Binding PackageDeployment.Profiles}" Margin="0,0,0,12">
                <TabControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Margin="12">
                            <TextBlock Text="Компьютер: имя или IPv4 (скрипт проверит, что запущен на нужном сервере)" TextWrapping="Wrap" />
                            <ui:TextBox Text="{Binding ComputerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
                            <TextBlock Text="Локальная папка установки на этом сервере" />
                            <ui:TextBox Text="{Binding InstallRoot, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
                            <TextBlock Text="Сетевая папка доставки" />
                            <DockPanel Margin="0,4,0,10">
                                <ui:Button Content="Send" Tag="{Binding}" Click="OnSendDeploymentPackageClick" DockPanel.Dock="Right" Margin="8,0,0,0" />
                                <ui:TextBox Text="{Binding ShareRoot, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <TextBlock Text="Проверка Runtime — localhost этого сервера" />
                            <ui:TextBox Text="{Binding RuntimeStatusUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
                            <WrapPanel Margin="0,6,0,8">
                                <CheckBox Content="Runtime" IsChecked="{Binding UpdateRuntime}" Margin="0,0,20,0" />
                                <CheckBox Content="Calc" IsChecked="{Binding UpdateCalc}" Margin="0,0,20,0" />
                                <CheckBox Content="Web" IsChecked="{Binding UpdateWeb}" Margin="0,0,20,0" />
                                <CheckBox Content="Maintenance" IsChecked="{Binding UpdateMaintenance}" />
                            </WrapPanel>
                            <TextBlock Text="Существующие appsettings*.json сохраняются. Для обновления Maintenance закройте её на целевом сервере перед запуском скрипта." TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
            <TextBlock Text="{Binding PackageDeployment.LoadError}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <WrapPanel Margin="0,0,0,10">
                <ui:Button Content="Сохранить профили" Click="OnSavePackageDeploymentClick" Margin="0,0,10,0" />
                <ui:Button Content="Подготовить комплект" Click="OnPrepareDeploymentPackageClick" Margin="0,0,10,0" />
                <ui:Button Content="Открыть папку комплекта" Click="OnOpenDeploymentOutputClick" />
            </WrapPanel>
            <TextBlock Text="{Binding PreparedDeploymentFolder}" TextWrapping="Wrap" Margin="0,0,0,10" />
            <ui:TextBox Text="{Binding PackageDeploymentLog, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Height="230" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" TextChanged="OnAutoScrollLogTextChanged" />
        </StackPanel>
    </ScrollViewer>
</views:MaintenancePageControl>
