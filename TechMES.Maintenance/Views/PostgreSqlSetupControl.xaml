<UserControl x:Class="TechMES.Maintenance.Views.PostgreSqlSetupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SetupField" TargetType="{x:Type ui:TextBox}" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>

        <Style x:Key="TabIcon" TargetType="{x:Type ui:SymbolIcon}">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="AgentCard" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox x:Name="ServerCards" ItemsSource="{Binding Cards}" SelectedIndex="0" SelectionChanged="OnProfileSelected"
                 Margin="0,0,0,10" Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Margin" Value="2" />
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Frame" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="2" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Profile.Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Address}" Margin="0,2,0,5" />
                        <TextBlock Text="{Binding Summary}" />
                        <TextBlock Text="{Binding Source}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TabControl x:Name="ActionsPanel" Grid.Row="1" SelectionChanged="OnActionTabSelected"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Info24" Style="{StaticResource TabIcon}" />
                        <TextBlock Text="Info" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <WrapPanel Margin="0,0,0,8">
                            <ui:Button Content="Обновить состояние" Click="OnRefreshCardsClick" Margin="0,0,8,8" />
                            <ui:Button Content="Загрузить отчёт контроллера…" Click="OnImportHostClick" Margin="0,0,8,8" />
                        </WrapPanel>

                        <TextBlock x:Name="HostDetails" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="WizardTab" Header="Мастер HA">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="1. Проверить контроллеры" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="Используются два профиля из карточек сверху. Для узла с установленным Runtime выберите Runtime или Auto в профиле." Margin="0,0,0,6" />
                        <TextBlock x:Name="WizardTarget" Margin="0,0,0,8" />
                        <WrapPanel>
                            <ui:Button Content="Профили узлов" Click="OnWizardProfilesClick" Margin="0,0,8,8" />
                            <ui:Button Content="Проверить выбранный узел…" Click="OnCheckHostClick" Margin="0,0,8,8" />
                            <ui:Button Content="Подготовка выбранного узла…" Click="OnWizardPreparationClick" Margin="0,0,8,8" />
                            <ui:Button Content="Загрузить отчёт…" Click="OnImportHostClick" Margin="0,0,8,8" />
                        </WrapPanel>

                        <Expander x:Name="WizardNetwork" Header="Сетевая связь и сертификаты" Expanded="OnNetworkWizardExpanded" Margin="0,4,0,8">
                            <StackPanel Margin="8,8,8,0">
                                <TextBlock Text="Для новой пары сначала подтвердите работу обоих контроллеров в пункте 1. Если проверка пары уже проходит, этот блок можно пропустить." Margin="0,0,0,8" />
                                <WrapPanel>
                                    <StackPanel Width="215" Margin="0,0,8,0">
                                        <TextBlock Text="IPv4 из профиля Primary DB" />
                                        <ui:TextBox x:Name="NetworkFirstAddress" Style="{StaticResource SetupField}" />
                                        <TextBlock Text="IPv4 из профиля Secondary DB" />
                                        <ui:TextBox x:Name="NetworkSecondAddress" Style="{StaticResource SetupField}" />
                                    </StackPanel>
                                    <StackPanel Width="215" Margin="0,0,8,0">
                                        <TextBlock Text="Идентификатор кластера" />
                                        <ui:TextBox x:Name="NetworkSystemIdentifier" Style="{StaticResource SetupField}" />
                                        <TextBlock Text="Порт mTLS" />
                                        <ui:TextBox x:Name="NetworkPort" Text="5115" Style="{StaticResource SetupField}" />
                                    </StackPanel>
                                    <StackPanel Width="215" Margin="0,0,8,0">
                                        <TextBlock Text="IPv4 компьютера Maintenance" />
                                        <ui:TextBox x:Name="NetworkMaintenanceAddress" Style="{StaticResource SetupField}" />
                                    </StackPanel>
                                </WrapPanel>
                                <ui:Button Content="A. Экспортировать подготовку узлов…" Click="OnPrepareNetworkNodesClick" Margin="0,0,0,8" />
                                <TextBlock Text="После запуска комплектов на обоих узлах выберите их файлы public.cer. Введите SHA-256, который показал PowerShell на соответствующем узле." Margin="0,0,0,8" />
                                <DockPanel Margin="0,0,0,8">
                                    <ui:Button DockPanel.Dock="Right" Content="CER Primary DB…" Tag="First" Click="OnSelectNetworkCertificateClick" Margin="8,0,0,0" />
                                    <ui:TextBox DockPanel.Dock="Right" x:Name="NetworkFirstPin" PlaceholderText="SHA-256 Primary DB" Width="275" Margin="8,0,0,0" />
                                    <ui:TextBox x:Name="NetworkFirstCertificate" PlaceholderText="Файл Primary DB" IsReadOnly="True" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <ui:Button DockPanel.Dock="Right" Content="CER Secondary DB…" Tag="Second" Click="OnSelectNetworkCertificateClick" Margin="8,0,0,0" />
                                    <ui:TextBox DockPanel.Dock="Right" x:Name="NetworkSecondPin" PlaceholderText="SHA-256 Secondary DB" Width="275" Margin="8,0,0,0" />
                                    <ui:TextBox x:Name="NetworkSecondCertificate" PlaceholderText="Файл Secondary DB" IsReadOnly="True" />
                                </DockPanel>
                                <WrapPanel>
                                    <ui:Button Content="B. Экспортировать подключение узлов…" Click="OnConnectNetworkNodesClick" Margin="0,0,8,8" />
                                    <ui:Button Content="C. Подготовить сертификат Maintenance…" Click="OnPrepareNetworkMaintenanceClick" Margin="0,0,8,8" />
                                </WrapPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <ui:Button DockPanel.Dock="Right" Content="CER Maintenance…" Tag="Maintenance" Click="OnSelectNetworkCertificateClick" Margin="8,0,0,0" />
                                    <ui:TextBox DockPanel.Dock="Right" x:Name="NetworkMaintenancePin" PlaceholderText="SHA-256 Maintenance" Width="275" Margin="8,0,0,0" />
                                    <ui:TextBox x:Name="NetworkMaintenanceCertificate" PlaceholderText="Файл Maintenance" IsReadOnly="True" />
                                </DockPanel>
                                <WrapPanel>
                                    <ui:Button Content="D. Экспортировать доверие к Maintenance…" Click="OnTrustNetworkMaintenanceClick" Margin="0,0,8,8" />
                                    <ui:Button x:Name="NetworkOpenFolder" Content="Открыть папку комплекта" Click="OnOpenNetworkFolderClick" IsEnabled="False" Margin="0,0,8,8" />
                                </WrapPanel>
                                <ui:TextBox x:Name="NetworkResult" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto" MaxHeight="160" />
                            </StackPanel>
                        </Expander>

                        <TextBlock Text="2. Проверить репликацию и Main DB" Style="{StaticResource SectionTitleText}" Margin="0,8,0,6" />
                        <TextBlock Text="Базовый URL Runtime, который проверяет эту пару PostgreSQL" />
                        <ui:TextBox x:Name="WizardRuntimeUrl" Text="http://127.0.0.1:5101" Style="{StaticResource SetupField}" TextChanged="OnWizardRuntimeUrlChanged" />
                        <ui:Button Content="Проверить пару" Click="OnCheckWizardClick" Margin="0,0,0,8" />
                        <ui:TextBox x:Name="WizardResult" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" MinHeight="100" MaxHeight="240" />
                        <ui:Button x:Name="WizardActivePlan" Content="Открыть план переключения" Click="OnWizardActivePlanClick" Visibility="Collapsed" Margin="0,8,0,0" />

                        <TextBlock Text="3. Автоматический возврат" Style="{StaticResource SectionTitleText}" Margin="0,12,0,6" />
                        <TextBlock Text="Этот шаг нужен для изменения политики автовозврата. Для проверки уже настроенной пары достаточно пункта 2." Margin="0,0,0,8" />
                        <TextBlock Text="Предпочтительный Primary" />
                        <ComboBox x:Name="WizardPreferredPrimary" ItemsSource="{Binding Cards}" DisplayMemberPath="Address"
                                  SelectionChanged="OnWizardPolicyChanged" Margin="0,4,0,8" />
                        <CheckBox x:Name="WizardEnableFailback" Content="Включить автовозврат" Checked="OnWizardPolicyChanged"
                                  Unchecked="OnWizardPolicyChanged" Margin="0,0,0,8" />
                        <TextBlock x:Name="WizardPolicyHint" Margin="0,0,0,8" />
                        <ui:Button x:Name="WizardApply" Content="Настроить автовозврат…" Click="OnWizardApplyClick" IsEnabled="False" />

                        <StackPanel x:Name="WizardTransferPanel" Visibility="Collapsed" Margin="0,10,0,0">
                            <ui:TextBox x:Name="WizardTransferText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8" />
                            <ui:Button Content="Открыть папку комплекта" Click="OnOpenHostFolderClick" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="ProfileTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Person24" Style="{StaticResource TabIcon}" />
                        <TextBlock Text="Profile" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ProfileEditor" DataContext="{Binding SelectedItem.Profile, ElementName=ServerCards}" Margin="12">
                        <TextBlock Text="Компьютер БД (имя или IPv4)" />
                        <ui:TextBox Text="{Binding ComputerName, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"
                                    Style="{StaticResource SetupField}" SourceUpdated="OnProfileEdited" />

                        <TextBlock Text="Имя Windows-службы PostgreSQL" />
                        <ui:TextBox Text="{Binding ServiceName, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"
                                    Style="{StaticResource SetupField}" SourceUpdated="OnProfileEdited" />

                        <TextBlock Text="Каталог bin" />
                        <ui:TextBox Text="{Binding BinDirectory, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"
                                    Style="{StaticResource SetupField}" SourceUpdated="OnProfileEdited" />

                        <TextBlock Text="Каталог data" />
                        <ui:TextBox Text="{Binding DataDirectory, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"
                                    Style="{StaticResource SetupField}" SourceUpdated="OnProfileEdited" />

                        <TextBlock Text="Порт PostgreSQL" />
                        <ui:TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnSourceUpdated=True}"
                                    Style="{StaticResource SetupField}" SourceUpdated="OnProfileEdited" />

                        <TextBlock Text="Тип контроллера (Auto выбирает на сервере)" />
                        <ComboBox x:Name="HostModeField"
                                  SelectedValue="{Binding HostMode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, NotifyOnSourceUpdated=True}"
                                  SelectedValuePath="Content" SourceUpdated="OnProfileEdited" Margin="0,4,0,10">
                            <ComboBoxItem Content="Auto" />
                            <ComboBoxItem Content="Runtime" />
                            <ComboBoxItem Content="Standalone" />
                        </ComboBox>

                        <TextBlock Text="Интервал проверки Agent, секунд" />
                        <ui:TextBox Text="{Binding HostHealthPeriodSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnSourceUpdated=True}"
                                    Style="{StaticResource SetupField}" SourceUpdated="OnProfileEdited" />

                        <ui:Button Content="Сохранить профили" Click="OnSaveClick" Margin="0,0,0,10" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Server24" Style="{StaticResource TabIcon}" />
                        <TextBlock Text="Service" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="AdoptService может перезапустить PostgreSQL и прервать подключения." Margin="0,0,0,8" />

                        <WrapPanel>
                            <ui:Button x:Name="CheckDatabaseButton" Content="Проверить локальную службу" Click="OnCheckClick" Margin="0,0,8,8" />
                            <ui:Button x:Name="AdoptDatabaseButton" Content="AdoptService локально" Click="OnPrepareClick" Margin="0,0,8,8" />
                            <ui:Button Content="Экспорт скрипта службы…" Click="OnExportClick" Margin="0,0,8,8" />
                            <ui:Button Content="Загрузить отчёт службы…" Click="OnImportClick" Margin="0,0,8,8" />
                        </WrapPanel>

                        <ui:TextBox x:Name="StatusBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                    MaxHeight="230" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="PreparationTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="WindowWrench24" Style="{StaticResource TabIcon}" />
                        <TextBlock Text="Preparing the controller" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock x:Name="TargetText" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock x:Name="PreparationHint" Margin="0,0,0,8" />

                        <WrapPanel Margin="0,0,0,4">
                            <ui:Button x:Name="CheckHostButton" Click="OnCheckHostClick" Margin="0,0,8,8" />
                            <ui:Button x:Name="PrepareHostButton" Click="OnPrepareHostClick" Margin="0,0,8,8" />
                        </WrapPanel>

                        <Border x:Name="AgentSection" Style="{StaticResource AgentCard}">
                            <StackPanel x:Name="AgentFields" DataContext="{Binding SelectedItem.Profile, ElementName=ServerCards}">
                                <TextBlock Text="Установка или обновление Agent" Style="{StaticResource SectionTitleText}" />

                                <TextBlock Text="Каталог установки на сервере (при первом запуске)" />
                                <ui:TextBox Text="{Binding AgentDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SetupField}" />

                                <TextBlock Text="Готовый пакет Agent на компьютере Maintenance" />
                                <ui:TextBox x:Name="AgentPackagePath" Text="{Binding AgentPackageDirectory}" IsReadOnly="True" Style="{StaticResource SetupField}" />

                                <TextBlock x:Name="AgentModeHint" Text="При подготовке установки профиль будет сохранён в режиме Standalone." Margin="0,0,0,8" />

                                <WrapPanel>
                                    <ui:Button x:Name="BuildAgentButton" Content="Собрать Agent…" Click="OnBuildAgentClick" Margin="0,0,8,8" />
                                    <ui:Button Content="Выбрать готовый пакет…" Click="OnChooseAgentPackageClick" Margin="0,0,8,8" />
                                    <ui:Button x:Name="InstallAgentButton" Click="OnInstallAgentClick" Margin="0,0,8,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="TransferPanel" Visibility="Collapsed">
                            <ui:TextBox x:Name="TransferInstructions" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8" />

                            <WrapPanel>
                                <ui:Button Content="Открыть папку" Click="OnOpenHostFolderClick" Margin="0,0,8,8" />
                                <ui:Button Content="Загрузить результат…" Click="OnImportHostClick" Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="SwitchingTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowSwap24" Style="{StaticResource TabIcon}" />
                        <TextBlock Text="Switching" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl x:Name="SwitchContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </TabItem>

            <TabItem x:Name="HistoryTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="History24" Style="{StaticResource TabIcon}" />
                        <TextBlock Text="History" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl x:Name="HistoryContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </TabItem>
        </TabControl>

        <TextBlock x:Name="ActionStatus" Grid.Row="2" Margin="2,8,2,0" Style="{StaticResource MutedText}" />
    </Grid>
</UserControl>
