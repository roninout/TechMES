<views:MaintenancePageControl x:Class="TechMES.Maintenance.Views.HostSetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:TechMES.Maintenance.Views">

    <views:MaintenancePageControl.Resources>
        <Style x:Key="CoordinatorSettings" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCoordinator}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StandbySettings" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCoordinator}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HostHint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="HostField" TargetType="{x:Type ui:TextBox}" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
    </views:MaintenancePageControl.Resources>

    <Grid DataContext="{Binding HostSetup}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="16,16,16,0" IsEnabled="{Binding CanOperate}">
            <TextBlock Text="{Binding NodeTitle}" Style="{StaticResource SectionTitleText}" />
            <TextBlock Text="{Binding AddressSummary}" Style="{StaticResource HostHint}" Margin="0,0,0,12" />

            <WrapPanel Margin="0,0,0,8">
                <ui:Button Content="Загрузить профиль" Click="OnLoadHostSetupClick" Margin="0,0,8,8" />
                <ui:Button Content="Сохранить и перезапустить Host" Click="OnSaveHostSetupClick" Margin="0,0,8,8" />
                <ui:Button Content="Состояние IP" Click="OnHostOwnerStatusClick" Margin="0,0,8,8" />
                <ui:Button Content="Проверить второй Host" Click="OnCheckPeerHostClick" Margin="0,0,8,8" />
            </WrapPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,0,16,0" IsEnabled="{Binding CanOperate}">
                <views:MaintenanceSection Header="Автоматическое переключение при отказе Host" Margin="0,0,0,14">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding ServiceFailover.Enabled}" Margin="0,0,0,4">
                            <TextBlock Text="Включить переключение и возврат при отказе Host" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Text="Включите на обоих узлах. После переключения из-за отказа Host адрес возвращается на координатор, когда его Host и WEB готовы."
                                   Style="{StaticResource HostHint}" />

                        <StackPanel Style="{StaticResource StandbySettings}" Margin="0,12,0,0">
                            <TextBlock Text="Полное DNS-имя координатора" TextWrapping="Wrap" />
                            <ui:TextBox Text="{Binding ServiceFailover.PreferredComputerName, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="srv1.plant.local" Style="{StaticResource HostField}" />
                            <TextBlock Text="Укажите полное доменное имя координатора. Оно используется для восстановления через WinRM."
                                       Style="{StaticResource HostHint}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource CoordinatorSettings}" Margin="0,12,0,0">
                            <TextBlock Text="Доменная учётная запись резервного компьютера" TextWrapping="Wrap" />
                            <ui:TextBox Text="{Binding PeerComputerAccount, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="DOMAIN\COMPUTER$" Style="{StaticResource HostField}" />
                            <TextBlock Text="На резерве служба Host должна работать под LocalSystem. Сохраните профиль на координаторе, затем зарегистрируйте восстановление."
                                       Style="{StaticResource HostHint}" Margin="0,0,0,8" />
                            <ui:Button Content="Зарегистрировать восстановление Host" Click="OnRegisterHostFailoverClick"
                                       HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </views:MaintenanceSection>

                <StackPanel Style="{StaticResource CoordinatorSettings}" Margin="0,0,0,14">
                    <views:MaintenanceSection Header="Автоматическая передача при отказе WEB">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding WebFailover.Enabled}" Margin="0,0,0,4">
                                <TextBlock Text="Включить автоматическую передачу IP при отказе WEB владельца" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Text="Для передачи нужны оба Host. После восстановления WEB адрес остаётся на текущем владельце до следующей передачи."
                                       Style="{StaticResource HostHint}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Наблюдений отказа WEB владельца" TextWrapping="Wrap" />
                                    <ui:TextBox Text="{Binding FailureThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource HostField}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Наблюдений готовности WEB резерва" TextWrapping="Wrap" />
                                    <ui:TextBox Text="{Binding RecoveryThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource HostField}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </views:MaintenanceSection>
                </StackPanel>

                <Expander Header="Сеть и сертификаты" Margin="0,0,0,14" HorizontalContentAlignment="Stretch">
                    <StackPanel Margin="12">
                        <TextBlock Text="Локальный сетевой интерфейс" TextWrapping="Wrap" />
                        <ComboBox ItemsSource="{Binding Adapters}" DisplayMemberPath="Display" SelectedValuePath="Id"
                                  SelectedValue="{Binding Shared.InterfaceId, Mode=TwoWay}" Margin="0,4,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="IPv4 этого компьютера" TextWrapping="Wrap" />
                                <ui:TextBox Text="{Binding NodeAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HostField}" />
                                <TextBlock Text="Общий IPv4 (VIP)" TextWrapping="Wrap" />
                                <ui:TextBox Text="{Binding VirtualAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HostField}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="IPv4 второго компьютера" TextWrapping="Wrap" />
                                <ui:TextBox Text="{Binding PeerAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HostField}" />
                                <TextBlock Text="Префикс подсети" TextWrapping="Wrap" />
                                <ui:TextBox Text="{Binding PrefixLengthText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HostField}" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Включить защищённое соединение между Host" IsChecked="{Binding Control.Enabled}" Margin="0,4,0,10" />
                        <TextBlock Text="Порт HTTPS Host, одинаковый на обоих узлах" TextWrapping="Wrap" />
                        <ui:TextBox Text="{Binding ControlPortText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HostField}" />
                        <TextBlock Text="SHA256 сертификата этого узла" TextWrapping="Wrap" />
                        <ui:TextBox Text="{Binding Control.CertificateSha256, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HostField}" />
                        <TextBlock Text="SHA256 сертификата второго узла" TextWrapping="Wrap" />
                        <ui:TextBox Text="{Binding Control.PeerCertificateSha256, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HostField}" />

                        <WrapPanel>
                            <ui:Button Content="Проверить сеть" Click="OnCheckHostSetupClick" Margin="0,0,8,8" />
                            <ui:Button Content="Создать сертификат узла" Click="OnCreateHostCertificateClick" Margin="0,0,8,8" />
                            <ui:Button Content="Открыть firewall Host" Click="OnOpenHostFirewallClick" Margin="0,0,8,8" />
                        </WrapPanel>
                    </StackPanel>
                </Expander>

                <views:MaintenanceSection Header="Ручное управление общим IP" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Используется сохранённый профиль. Во время передачи IP открытые WEB-сессии могут прерваться."
                                   Style="{StaticResource HostHint}" Margin="0,0,0,8" />
                        <WrapPanel>
                            <ui:Button Content="Первое назначение этому ПК" Click="OnHostOwnerInitializeClick" Margin="0,0,8,8" />
                            <ui:Button Content="Передать IP другому ПК" Click="OnHostOwnerTransferClick" Margin="0,0,8,8" />
                            <ui:Button Content="Продолжить операцию" Click="OnHostOwnerResumeClick" Margin="0,0,8,8" />
                        </WrapPanel>
                    </StackPanel>
                </views:MaintenanceSection>

            </StackPanel>
        </ScrollViewer>

        <views:MaintenanceSection Grid.Row="2" Header="Отчёт Host" Margin="16,8,16,16">
            <ui:TextBox Text="{Binding Report, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                        AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                        FontFamily="Consolas" Height="105" />
        </views:MaintenanceSection>
    </Grid>
</views:MaintenancePageControl>
