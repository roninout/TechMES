<views:MaintenancePageControl x:Class="TechMES.Maintenance.Views.ImportEditPage"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                              xmlns:control="http://filterdatagrid.control.com/2021"
                              xmlns:views="clr-namespace:TechMES.Maintenance.Views"
                              xmlns:converters="clr-namespace:TechMES.Maintenance.Converters"
                              mc:Ignorable="d">
    <views:MaintenancePageControl.Resources>
        <!-- Номер строки без использования AlternationCount. -->
        <converters:RowNumberConverter x:Key="RowNumberConverter" />

        <!--<Style x:Key="ImportGrid" TargetType="{x:Type control:FilterDataGrid}">-->
        <Style x:Key="ImportGrid"
               TargetType="{x:Type control:FilterDataGrid}"
               BasedOn="{StaticResource TechMesFilterDataGridStyle}">

            <Setter Property="AutoGenerateColumns"
                    Value="False" />

            <Setter Property="CanUserAddRows"
                    Value="True" />

            <Setter Property="CanUserDeleteRows"
                    Value="True" />

            <Setter Property="SelectionMode"
                    Value="Extended" />

            <Setter Property="SelectionUnit"
                    Value="CellOrRowHeader" />

            <Setter Property="ClipboardCopyMode"
                    Value="ExcludeHeader" />

            <Setter Property="HeadersVisibility"
                    Value="Column" />

            <Setter Property="GridLinesVisibility"
                    Value="Horizontal" />

            <Setter Property="Background"
                    Value="{DynamicResource TechMesPanelBrush}" />

            <!--
            Явно возвращаем темозависимый заголовок.
            FilterDataGrid подмешивает собственные локальные ресурсы,
            поэтому для Import/Edit лучше назначить стиль непосредственно.
            -->
            <Setter Property="ColumnHeaderStyle"
                    Value="{StaticResource TechMesFilterDataGridColumnHeaderStyle}" />

            <Setter Property="RowBackground"
                    Value="{DynamicResource TechMesPanelBrush}" />

            <Setter Property="AlternatingRowBackground"
                    Value="{DynamicResource TechMesPanelBrush}" />

            <EventSetter Event="PreviewKeyDown"
                         Handler="OnImportGridPreviewKeyDown" />

        </Style>


        <!-- =========================================================
             SUPPLIER ROW CONTROLS

             Строка SUPPLIER использует WPF UI-контролы:
             ui:TextBlock для просмотра, ui:TextBox для редактирования,
             ui:Button для выбора файла и ui:Card для превью логотипа.
             ========================================================= -->

        <Style x:Key="SupplierCellTextStyle"
               TargetType="{x:Type ui:TextBlock}">

            <Setter Property="Appearance"
                    Value="Primary" />

            <Setter Property="FontTypography"
                    Value="BodyStrong" />

            <Setter Property="Margin"
                    Value="8,0" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis" />

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPendingDelete}"
                             Value="True">

                    <Setter Property="TextDecorations"
                            Value="Strikethrough" />

                </DataTrigger>
            </Style.Triggers>

        </Style>

        <!-- =========================================================
             READ-ONLY TABLE CELLS

             Read-only cells use gray text and regular font weight.
             This makes them visually different from editable cells.
             ========================================================= -->

        <Style x:Key="ImportReadOnlyCellTextStyle"
               TargetType="{x:Type ui:TextBlock}">

            <Setter Property="Appearance"
                    Value="Secondary" />

            <Setter Property="FontTypography"
                    Value="Body" />

            <Setter Property="FontWeight"
                    Value="Regular" />

            <Setter Property="Margin"
                    Value="8,0" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis" />

        </Style>

        <Style x:Key="ImportReadOnlySupplierCellTextStyle"
               TargetType="{x:Type ui:TextBlock}"
               BasedOn="{StaticResource SupplierCellTextStyle}">

            <Setter Property="Appearance"
                    Value="Secondary" />

            <Setter Property="FontTypography"
                    Value="Body" />

            <Setter Property="FontWeight"
                    Value="Regular" />

        </Style>

        <Style x:Key="ImportReadOnlyRowNumberTextStyle"
               TargetType="{x:Type TextBlock}">

            <Setter Property="Foreground"
                    Value="{DynamicResource TextFillColorSecondaryBrush}" />

            <Setter Property="FontWeight"
                    Value="Regular" />

            <Setter Property="HorizontalAlignment"
                    Value="Center" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

            <Setter Property="TextAlignment"
                    Value="Center" />

        </Style>


        <Style x:Key="SupplierEditorTextBoxStyle"
               TargetType="{x:Type ui:TextBox}"
               BasedOn="{StaticResource DefaultUiTextBoxStyle}">

            <Setter Property="Height"
                    Value="34" />

            <Setter Property="Margin"
                    Value="6,0" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />

            <Setter Property="ClearButtonEnabled"
                    Value="False" />

        </Style>
    </views:MaintenancePageControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Содержимое выбранной вкладки. -->
            <RowDefinition Height="*" />

            <!-- Общая нижняя панель Import/Edit. -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="ImportTabControl"
                    Grid.Row="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    SelectionChanged="OnImportTabSelectionChanged">
            <TabItem x:Name="ImportTab" Tag="IMPORT">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowImport24" Width="20" Height="20" Margin="0,0,8,0" />
                        <TextBlock Text="IMPORT" />
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <!--
                        Верхняя область запускает единый импорт всех поддерживаемых листов книги.
                        Сам Excel-файл только описывает связи; PDF и изображения читаются из папок ниже.
                        -->
                        <views:MaintenanceCard Background="{DynamicResource TechMesPanelBrush}"
                                               BorderBrush="{DynamicResource TechMesBorderBrush}"
                                               BorderThickness="1"
                                               Padding="12"
                                               Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="Excel import"
                                               Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="Imports SUPPLIER, ORDERS, INSTRUCTION and SCHEME with their database links."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Excel file"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource MutedText}" />
                                    <ui:TextBox Grid.Column="1"
                                                Text="{Binding ExcelImportFilePath, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="0,0,8,0" />
                                    <ui:Button Grid.Column="2"
                                               Content="Browse..."
                                               MinWidth="96"
                                               Margin="0,0,8,0"
                                               Click="OnBrowseExcelImportFileClick" />
                                    <ui:Button Grid.Column="3"
                                               Content="Import"
                                               MinWidth="110"
                                               Appearance="Primary"
                                               Click="OnImportExcelClick" />
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,10,0,0">
                                    <ProgressBar Height="4"
                                                 IsIndeterminate="True">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExcelImportRunning}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                </Grid>
                            </Grid>
                        </views:MaintenanceCard>

                        <!--
                        Все внешние источники файлов собраны в одной панели. Эти значения сохраняются
                        в maintenance.settings.json и используются как Excel-импортом, так и ручным Save.
                        -->
                        <views:MaintenanceCard Background="{DynamicResource TechMesPanelBrush}"
                                               BorderBrush="{DynamicResource TechMesBorderBrush}"
                                               BorderThickness="1"
                                               Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="File source folders"
                                               Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="PDF and image folders used to store binary file data in PostgreSQL."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ORDERS PDF"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource MutedText}" />
                                    <ui:TextBox Grid.Column="1"
                                                Text="{Binding OrdersPdfSourceRoot, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="0,0,8,0" />
                                    <ui:Button Grid.Column="2"
                                               Content="Browse..."
                                               MinWidth="96"
                                               Tag="OrdersPdfSourceRoot"
                                               Click="OnBrowseImportSourceClick" />
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="INSTRUCTION PDF"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource MutedText}" />
                                    <ui:TextBox Grid.Column="1"
                                                Text="{Binding InstructionPdfSourceRoot, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="0,0,8,0" />
                                    <ui:Button Grid.Column="2"
                                               Content="Browse..."
                                               MinWidth="96"
                                               Tag="InstructionPdfSourceRoot"
                                               Click="OnBrowseImportSourceClick" />
                                </Grid>

                                <Grid Grid.Row="3" Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SCHEME PDF"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource MutedText}" />
                                    <ui:TextBox Grid.Column="1"
                                                Text="{Binding SchemePdfSourceRoot, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="0,0,8,0" />
                                    <ui:Button Grid.Column="2"
                                               Content="Browse..."
                                               MinWidth="96"
                                               Tag="SchemePdfSourceRoot"
                                               Click="OnBrowseImportSourceClick" />
                                </Grid>

                                <Grid Grid.Row="4" Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SUPPLIER logos"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource MutedText}" />
                                    <ui:TextBox Grid.Column="1"
                                                Text="{Binding SupplierLogoSourceRoot, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="0,0,8,0" />
                                    <ui:Button Grid.Column="2"
                                               Content="Browse..."
                                               MinWidth="96"
                                               Tag="SupplierLogoSourceRoot"
                                               Click="OnBrowseImportSourceClick" />
                                </Grid>

                                <Grid Grid.Row="5" Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="INSTRUCTION images"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource MutedText}" />
                                    <ui:TextBox Grid.Column="1"
                                                Text="{Binding InstructionImageSourceRoot, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="0,0,8,0" />
                                    <ui:Button Grid.Column="2"
                                               Content="Browse..."
                                               MinWidth="96"
                                               Tag="InstructionImageSourceRoot"
                                               Click="OnBrowseImportSourceClick" />
                                </Grid>

                                <Grid Grid.Row="6" Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SCHEME images"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource MutedText}" />
                                    <ui:TextBox Grid.Column="1"
                                                Text="{Binding SchemeImageSourceRoot, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="0,0,8,0" />
                                    <ui:Button Grid.Column="2"
                                               Content="Browse..."
                                               MinWidth="96"
                                               Tag="SchemeImageSourceRoot"
                                               Click="OnBrowseImportSourceClick" />
                                </Grid>

                                <TextBlock Grid.Row="7"
                                           Text="{Binding ImportExcelStatusText}"
                                           Margin="0,10,0,0"
                                           HorizontalAlignment="Center"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" />

                                <ui:Button Grid.Row="8"
                                           Content="Save"
                                           MinWidth="120"
                                           Margin="0,12,0,0"
                                           HorizontalAlignment="Right"
                                           Appearance="Primary"
                                           Click="OnSaveImportSourcePathsClick" />
                            </Grid>
                        </views:MaintenanceCard>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="SupplierTab" Tag="SUPPLIER">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="PersonAccounts20" Width="20" Height="20" Margin="0,0,8,0" />
                        <TextBlock Text="SUPPLIER" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <views:MaintenanceCard Grid.Row="0"
                        Background="{DynamicResource TechMesPanelBrush}"
                        BorderBrush="{DynamicResource TechMesBorderBrush}"
                        BorderThickness="1"
                        Padding="12"
                        Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Suppliers"
                                   Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="Редактирует public.equip_supplier: имя поставщика и логотип. Новый логотип выбирается файлом и попадает в БД после Save."
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" />
                        </StackPanel>
                    </views:MaintenanceCard>

                    <views:MaintenanceSection Grid.Row="1" Margin="0,12,0,0">
                        <control:FilterDataGrid
                        Grid.Row="1"
                        Style="{StaticResource ImportGrid}"
                        ColumnHeaderStyle="{StaticResource TechMesFilterDataGridColumnHeaderStyle}"
                        RowHeight="72"
                        ColumnHeaderHeight="36"
                        CanUserSortColumns="True"
                        ShowStatusBar="False"
                        ShowElapsedTime="False"
                        DateFormatString="dd.MM.yyyy"
                        FilterLanguage="Russian"
                        ItemsSource="{Binding ImportSuppliers}"
                        PreviewMouseLeftButtonDown="OnSupplierGridPreviewMouseLeftButtonDown">
                            <!--Важно наследовать штатный темозависимый стиль строки. Раньше локальный RowStyle создавался с нуля и тем самым убирал WPF UI-оформление только у таблицы SUPPLIER.-->
                            <control:FilterDataGrid.RowStyle>
                                <Style TargetType="{x:Type DataGridRow}"
                               BasedOn="{StaticResource {x:Type DataGridRow}}">

                                    <Setter Property="Background"
                                    Value="{DynamicResource TechMesPanelBrush}" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPendingDelete}"
                                             Value="True">

                                            <Setter Property="Opacity"
                                            Value="0.55" />

                                        </DataTrigger>
                                    </Style.Triggers>

                                </Style>
                            </control:FilterDataGrid.RowStyle>

                            <!--
                    Сохраняем штатный темозависимый стиль ячеек.
                    -->
                            <control:FilterDataGrid.CellStyle>
                                <Style TargetType="{x:Type DataGridCell}"
                               BasedOn="{StaticResource {x:Type DataGridCell}}">

                                    <Setter Property="Background"
                                    Value="Transparent" />

                                    <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch" />

                                    <Setter Property="VerticalContentAlignment"
                                        Value="Center" />

                                </Style>
                            </control:FilterDataGrid.CellStyle>
                            <control:FilterDataGrid.Columns>


                                <!-- Номер строки в текущем представлении DataGrid. -->
                                <control:DataGridTemplateColumn
                                    Header="№"
                                    Width="50"
                                    IsReadOnly="True"
                                    IsColumnFiltered="False"
                                    CanUserSort="False"
                                    CanUserReorder="False"
                                    CanUserResize="True">

                                    <control:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>

                                            <TextBlock
                                                Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}},
                                                               Converter={StaticResource RowNumberConverter}}"
                                                Style="{StaticResource ImportReadOnlyRowNumberTextStyle}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                TextAlignment="Center" />

                                        </DataTemplate>
                                    </control:DataGridTemplateColumn.CellTemplate>

                                </control:DataGridTemplateColumn>

                                <!-- Логотип отображается в WPF UI Card; двойной клик открывает выбор файла. -->
                                <control:DataGridTemplateColumn
                                Header="Logo"
                                FieldName="LogoFileName"
                                ClipboardContentBinding="{Binding LogoFileName}"
                                IsColumnFiltered="True"
                                Width="130"
                                SortMemberPath="LogoFileName"
                                IsReadOnly="True">

                                    <control:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>

                                            <ui:Card
                                            Width="104"
                                            Height="58"
                                            Padding="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            Cursor="Hand">

                                                <ui:Card.ToolTip>
                                                    <StackPanel>
                                                        <TextBlock
                                                        Text="{Binding LogoFileName}"
                                                        FontWeight="Regular" />

                                                        <TextBlock
                                                        Margin="0,3,0,0"
                                                        Text="Double-click to choose logo file"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </ui:Card.ToolTip>

                                                <Grid>

                                                    <!-- Для превью нужен обычный Image: ImageIcon использует UniformToFill и обрезает логотипы. -->
                                                    <Image
                                                    Source="{Binding LogoPreview}"
                                                    Stretch="Uniform"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch" />

                                                    <!-- Пустой логотип обозначаем штатной WPF UI-иконкой. -->
                                                    <ui:SymbolIcon
                                                    Symbol="Image24"
                                                    FontSize="24"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">

                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="{x:Type ui:SymbolIcon}">

                                                                <Setter Property="Visibility"
                                                                    Value="Collapsed" />

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding LogoPreview}"
                                                                             Value="{x:Null}">

                                                                        <Setter Property="Visibility"
                                                                            Value="Visible" />

                                                                    </DataTrigger>
                                                                </Style.Triggers>

                                                            </Style>
                                                        </ui:SymbolIcon.Style>

                                                    </ui:SymbolIcon>

                                                </Grid>

                                            </ui:Card>

                                        </DataTemplate>
                                    </control:DataGridTemplateColumn.CellTemplate>

                                </control:DataGridTemplateColumn>

                                <!-- Просмотр и редактирование имени поставщика выполняют WPF UI-контролы. -->
                                <control:DataGridTextColumn
                                Header="Supplier"
                                Binding="{Binding Supplier, UpdateSourceTrigger=PropertyChanged}"
                                ClipboardContentBinding="{Binding Supplier}"
                                SortMemberPath="Supplier"
                                IsColumnFiltered="True"
                                Width="*"
                                MinWidth="240" />

                                <!-- Статус отображается WPF UI TextBlock и выравнивается по центру строки. -->
                                <control:DataGridTemplateColumn
                                Header="Status"
                                FieldName="LogoStatus"
                                ClipboardContentBinding="{Binding LogoStatus}"
                                SortMemberPath="LogoStatus"
                                IsColumnFiltered="True"
                                IsReadOnly="True"
                                Width="150">

                                    <control:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>

                                            <ui:TextBlock
                                            Text="{Binding LogoStatus}"
                                            Style="{StaticResource ImportReadOnlySupplierCellTextStyle}" />

                                        </DataTemplate>
                                    </control:DataGridTemplateColumn.CellTemplate>

                                </control:DataGridTemplateColumn>

                            </control:FilterDataGrid.Columns>
                        </control:FilterDataGrid>
                    </views:MaintenanceSection>

                </Grid>
            </TabItem>

            <TabItem x:Name="OrdersTab" Tag="ORDERS">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="DocumentText24" Width="20" Height="20" Margin="0,0,8,0" />
                        <TextBlock Text="ORDERS" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <views:MaintenanceCard Grid.Row="0"
                        Background="{DynamicResource TechMesPanelBrush}"
                        BorderBrush="{DynamicResource TechMesBorderBrush}"
                        BorderThickness="1"
                        Padding="12"
                        Margin="0,0,0,10">
                        <Grid>

                            <StackPanel>
                                <TextBlock Text="Orders"
                                       Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Редактирует public.equip_order. PDF source folder нужен как рабочий источник для будущего добавления новых PDF-файлов."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </views:MaintenanceCard>

                    <control:FilterDataGrid Grid.Row="1"
                                        Style="{StaticResource ImportGrid}"
                                        CanUserResizeColumns="True"
                                        CanUserReorderColumns="True"
                                        ShowStatusBar="False"
                                        ShowElapsedTime="False"
                                        DateFormatString="dd.MM.yyyy"
                                        FilterLanguage="Russian"
                                        ItemsSource="{Binding ImportOrders}">
                        <control:FilterDataGrid.Columns>


                            <!-- Номер строки в текущем представлении DataGrid. -->
                            <control:DataGridTemplateColumn
                                Header="№"
                                Width="50"
                                IsReadOnly="True"
                                IsColumnFiltered="False"
                                CanUserSort="False"
                                CanUserReorder="False"
                                CanUserResize="True">

                                <control:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>

                                        <TextBlock
                                            Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}},
                                                           Converter={StaticResource RowNumberConverter}}"
                                                Style="{StaticResource ImportReadOnlyRowNumberTextStyle}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            TextAlignment="Center" />

                                    </DataTemplate>
                                </control:DataGridTemplateColumn.CellTemplate>

                            </control:DataGridTemplateColumn>

                            <control:DataGridTemplateColumn
                                Header="Type"
                                FieldName="Type"
                                ClipboardContentBinding="{Binding Type}"
                                SortMemberPath="Type"
                                IsColumnFiltered="True"
                                CanUserResize="True"
                                Width="150">

                                <!-- Первый клик: только выделение ячейки. -->
                                <control:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>

                                        <ui:TextBlock
                                            Text="{Binding Type}"
                                            Margin="8,0"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />

                                    </DataTemplate>
                                </control:DataGridTemplateColumn.CellTemplate>

                                <!-- Второй клик: режим редактирования с ComboBox. -->
                                <control:DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>

                                        <ComboBox
                                                            ItemsSource="{Binding DataContext.ImportOrderTypeOptions, RelativeSource={RelativeSource AncestorType={x:Type control:FilterDataGrid}}}"
                                                            SelectedItem="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
