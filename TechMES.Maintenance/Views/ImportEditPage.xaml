                Margin="0,10,0,0"
                Padding="12,8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, ElementName=ImportTab}"
                                     Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- SUPPLIER: Refresh -->
                <ui:Button Grid.Column="0"
                           Content="Refresh"
                           Width="130"
                           Height="34"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Appearance="Secondary"
                           Click="OnRefreshImportSuppliersClick">

                    <ui:Button.Style>
                        <Style TargetType="{x:Type ui:Button}"
                               BasedOn="{StaticResource TechMesDefaultButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, ElementName=SupplierTab}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>

                </ui:Button>

                <!-- ORDERS: Refresh -->
                <ui:Button Grid.Column="0"
                           Content="Refresh"
                           Width="130"
                           Height="34"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Appearance="Secondary"
                           Click="OnRefreshImportOrdersClick">

                    <ui:Button.Style>
                        <Style TargetType="{x:Type ui:Button}"
                               BasedOn="{StaticResource TechMesDefaultButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, ElementName=OrdersTab}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>

                </ui:Button>

                <!-- INSTRUCTION: Refresh -->
                <ui:Button Grid.Column="0"
                           Content="Refresh"
                           Width="130"
                           Height="34"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Appearance="Secondary"
                           Click="OnRefreshImportInstructionsClick">

                    <ui:Button.Style>
                        <Style TargetType="{x:Type ui:Button}"
                               BasedOn="{StaticResource TechMesDefaultButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, ElementName=InstructionTab}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>

                </ui:Button>

                <!-- SCHEME: Refresh -->
                <ui:Button Grid.Column="0"
                           Content="Refresh"
                           Width="130"
                           Height="34"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Appearance="Secondary"
                           Click="OnRefreshImportSchemesClick">

                    <ui:Button.Style>
                        <Style TargetType="{x:Type ui:Button}"
                               BasedOn="{StaticResource TechMesDefaultButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, ElementName=SchemeTab}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>

                </ui:Button>

                <!-- Центральный статус и ProgressBar выбранной вкладки. -->
                <Grid Grid.Column="1"
                      Margin="16,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding ImportSupplierStatusText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource MutedText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, ElementName=SupplierTab}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Row="0"
                               Text="{Binding ImportOrderStatusText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource MutedText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, ElementName=OrdersTab}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Row="0"
                               Text="{Binding ImportInstructionStatusText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource MutedText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, ElementName=InstructionTab}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Row="0"
                               Text="{Binding ImportSchemeStatusText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource MutedText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, ElementName=SchemeTab}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>



                    <!--
                    Неопределённый WPF UI ProgressBar.
                    Показывается во время получения Equipment Catalog из Runtime Service.
                    -->
                    <ProgressBar Grid.Row="1"
                                 Height="4"
                                 Margin="0,4,0,0"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Bottom"
                                 IsIndeterminate="True">

                        <ProgressBar.Style>
                            <Style TargetType="{x:Type ProgressBar}"
                                   BasedOn="{StaticResource {x:Type ProgressBar}}">

                                <Setter Property="Visibility"
                                        Value="Collapsed" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsImportRuntimeCatalogLoading}"
                                                 Value="True">

                                        <Setter Property="Visibility"
                                                Value="Visible" />

                                    </DataTrigger>
                                </Style.Triggers>

                            </Style>
                        </ProgressBar.Style>

                    </ProgressBar>
                </Grid>

                <!-- SUPPLIER: Save -->
                <ui:Button Grid.Column="2"
                           Content="Save"
                           Width="130"
                           Height="34"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Appearance="Primary"
                           Click="OnSaveImportSuppliersClick">

                    <ui:Button.Style>
                        <Style TargetType="{x:Type ui:Button}"
                               BasedOn="{StaticResource TechMesDefaultButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, ElementName=SupplierTab}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>

                </ui:Button>

                <!-- ORDERS: Save -->
                <ui:Button Grid.Column="2"
                           Content="Save"
                           Width="130"
                           Height="34"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Appearance="Primary"
                           Click="OnSaveImportOrdersClick">

                    <ui:Button.Style>
                        <Style TargetType="{x:Type ui:Button}"
                               BasedOn="{StaticResource TechMesDefaultButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, ElementName=OrdersTab}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>

                </ui:Button>

                <!-- INSTRUCTION: Save -->
                <ui:Button Grid.Column="2"
                           Content="Save"
                           Width="130"
                           Height="34"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Appearance="Primary"
                           Click="OnSaveImportInstructionsClick">

                    <ui:Button.Style>
                        <Style TargetType="{x:Type ui:Button}"
                               BasedOn="{StaticResource TechMesDefaultButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, ElementName=InstructionTab}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>

                </ui:Button>

                <!-- SCHEME: Save -->
                <ui:Button Grid.Column="2"
                           Content="Save"
                           Width="130"
                           Height="34"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Appearance="Primary"
                           Click="OnSaveImportSchemesClick">

                    <ui:Button.Style>
                        <Style TargetType="{x:Type ui:Button}"
                               BasedOn="{StaticResource TechMesDefaultButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, ElementName=SchemeTab}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>

                </ui:Button>

            </Grid>
        </Border>

    </Grid>
</views:MaintenancePageControl>
