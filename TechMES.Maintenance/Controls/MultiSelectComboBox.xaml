<UserControl x:Class="TechMES.Maintenance.Controls.MultiSelectComboBox"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="30"
             Focusable="False">

    <UserControl.Resources>

        <!--
        Opaque popup colors.
        Не используем Transparent, чтобы под выпадающим списком не просвечивала DataGrid.
        -->
        <SolidColorBrush x:Key="MultiSelectPopupBackgroundBrush"
                         Color="#FF252525" />

        <SolidColorBrush x:Key="MultiSelectPopupInnerBackgroundBrush"
                         Color="#FF2D2D2D" />

        <SolidColorBrush x:Key="MultiSelectPopupHoverBrush"
                         Color="#FF3A3A3A" />

        <SolidColorBrush x:Key="MultiSelectPopupBorderBrush"
                         Color="#FF484848" />

        <Style x:Key="MultiSelectPopupTextBoxStyle"
               TargetType="{x:Type TextBox}">
            <Setter Property="Height"
                    Value="28" />
            <Setter Property="Margin"
                    Value="0,0,0,6" />
            <Setter Property="Padding"
                    Value="6,2" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background"
                    Value="{StaticResource MultiSelectPopupInnerBackgroundBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource MultiSelectPopupBorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
        </Style>

        <Style x:Key="MultiSelectListBoxStyle"
               TargetType="{x:Type ListBox}">
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Background"
                    Value="{StaticResource MultiSelectPopupBackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Focusable"
                    Value="False" />
            <Setter Property="KeyboardNavigation.TabNavigation"
                    Value="Continue" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                    Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Disabled" />
        </Style>

        <Style x:Key="MultiSelectListBoxItemStyle"
               TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background"
                    Value="{StaticResource MultiSelectPopupBackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Padding"
                    Value="4,2" />
            <Setter Property="MinHeight"
                    Value="28" />

            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{StaticResource MultiSelectPopupHoverBrush}" />
                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="{StaticResource MultiSelectPopupHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <ToggleButton x:Name="PART_ToggleButton"
                      Height="30"
                      Padding="8,0"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Center"
                      IsChecked="{Binding IsDropDownOpen, ElementName=Root, Mode=TwoWay}">

            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           Text="▾"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <TextBlock Text="{Binding DisplayText, ElementName=Root}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </DockPanel>

        </ToggleButton>

        <!--
        StaysOpen=True:
        иначе Popup закрывается при переходе фокуса на Search TextBox или Clear Button.
        Закрытие при клике вне контрола выполняется в code-behind.
        -->
        <Popup x:Name="PART_Popup"
               PlacementTarget="{Binding ElementName=PART_ToggleButton}"
               Placement="Bottom"
               AllowsTransparency="True"
               StaysOpen="True"
               IsOpen="{Binding IsDropDownOpen, ElementName=Root, Mode=TwoWay}"
               Closed="OnPopupClosed">

            <Border Width="{Binding ActualWidth, ElementName=PART_ToggleButton}"
                    MinWidth="240"
                    Padding="8"
                    Opacity="1"
                    SnapsToDevicePixels="True"
                    Background="{StaticResource MultiSelectPopupBackgroundBrush}"
                    BorderBrush="{StaticResource MultiSelectPopupBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">

                <Grid Background="{StaticResource MultiSelectPopupBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="PART_FilterTextBox"
                             Grid.Row="0"
                             Style="{StaticResource MultiSelectPopupTextBoxStyle}"
                             TextChanged="OnFilterTextChanged"
                             ToolTip="Filter values" />

                    <ListBox Grid.Row="1"
                             MaxHeight="260"
                             Style="{StaticResource MultiSelectListBoxStyle}"
                             ItemContainerStyle="{StaticResource MultiSelectListBoxItemStyle}"
                             ItemsSource="{Binding ItemsView, ElementName=Root}">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Text}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Checked="OnItemCheckedChanged"
                                          Unchecked="OnItemCheckedChanged"
                                          Focusable="False"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Background="Transparent"
                                          Margin="0,2" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                    <!-- Нижняя панель: кнопка справа и всегда полностью видна. -->
                    <Grid Grid.Row="2"
                          MinHeight="34"
                          Margin="0,8,0,0"
                          Background="{StaticResource MultiSelectPopupBackgroundBrush}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1"
                                Content="Clear"
                                Width="76"
                                Height="28"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Focusable="False"
                                PreviewMouseDown="OnClearPreviewMouseDown" />
                    </Grid>
                    
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>