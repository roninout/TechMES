<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Update="maintenance.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Maintenance сам выполняет короткую PostgreSQL-проверку авторизации и версии сервера. -->
    <PackageReference Include="FilterDataGrid" Version="1.2.9" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TechMES.Contracts\TechMES.Contracts.csproj" />
  </ItemGroup>

	<!-- Инструменты включаются в переносимую Maintenance и доступны без исходников. -->
	<ItemGroup>
		<Content Include="..\scripts\deploy\Update-TechMESServer.ps1" Link="Tools\Update-TechMESServer.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="..\scripts\deploy\Build-TechMESUpdate.ps1" Link="Tools\Build-TechMESUpdate.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="..\scripts\deploy\Set-PostgreSQL18ServiceControl.ps1" Link="Tools\Set-PostgreSQL18ServiceControl.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
	
</Project>
