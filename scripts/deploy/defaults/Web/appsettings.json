{
  "RuntimeService": {
    "BaseUrl": "http://127.0.0.1:5101/",
    "SecondaryBaseUrl": "",
    "TimeoutSeconds": 30,
    "MessagesHubPath": "hubs/messages"
  },
  "App": {
    "Title": "TechMES"
  },
  "HttpsRedirection": {
    "Enabled": false
  },
  "WindowsAuthentication": {
    "Enabled": true
  },
  "FileLogging": {
    "Enabled": true,
    "Directory": "logs",
    "FileNamePrefix": "techmes-web"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5163"
      }
    }
  }
}
