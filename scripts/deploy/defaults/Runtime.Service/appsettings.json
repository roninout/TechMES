{
  "Urls": "http://127.0.0.1:5101",
  "Runtime": {
    "StartInStandby": true,
    "Redundancy": {
      "Enabled": false
    }
  },
  "EquipmentCatalog": {
    "Provider": "CtApi"
  },
  "CtApi": {
    "Provider": "CtApi",
    "Server": "",
    "User": "",
    "Password": "",
    "AllowWrites": false
  },
  "ParamWrites": {
    "Enabled": false
  },
  "MessageStorage": {
    "Provider": "PostgreSql"
  },
  "Database": {
    "Provider": "PostgreSql",
    "ConnectionString": "",
    "ConnectionStringSecondary": ""
  },
  "EventDatabase": {
    "Provider": "PostgreSql"
  },
  "Recipes": {
    "Provider": "PostgreSql"
  },
  "FileLogging": {
    "Enabled": true,
    "Directory": "logs",
    "FileNamePrefix": "techmes-runtime"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
