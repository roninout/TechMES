@page "/alarms/history"
@implements IAsyncDisposable
@inject AlarmSummaryApiClient SummaryApi
@inject NavigationManager Navigation

<PageTitle>Alarm history</PageTitle>

<div class="active-alarms-page">

    <div class="active-alarms-toolbar">
        <div class="active-alarms-toolbar-left">

            <RadzenSelectBar TValue="string" Value="@("history")" ValueChanged="@OnAlarmViewChanged" AriaLabel="Alarm view">
                <Items>
                    <RadzenSelectBarItem Text=" Active alarms" Value="@("active")" Icon="notifications_active" />
                    <RadzenSelectBarItem Text=" Alarm history" Value="@("history")" Icon="history" />
                </Items>
            </RadzenSelectBar>

            <RadzenDateRangePicker Value="@_selectedRange" ValueChanged="@OnRangeChanged"
                                   NavigationMode="DatePickerNavigationMode.DrillDown"
                                   DisplayMonths="2" AllowClear="false" DateFormat="dd.MM.yyyy"
                                   Style="width: 290px;" />
        </div>

        <h2 class="active-alarms-toolbar-title">Alarm history</h2>

        <div class="active-alarms-toolbar-right">
            @if (_isRefreshing)
            {
                <span class="active-alarms-spinner" title="Reading alarm history from SCADA" aria-label="Reading alarm history from SCADA">
                    <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" Style="width: 24px; height: 24px;" />
                </span>
            }

            <RadzenBadge Text="@($"Count: {_allItems.Count}")" BadgeStyle="BadgeStyle.Light" />

            @if (_loadedAt is not null)
            {
                <span class="active-alarms-status">Updated: @_loadedAt.Value.ToLocalTime().ToString("HH:mm:ss")</span>
            }

            @if (_readDurationMs is not null)
            {
                <span class="active-alarms-status">Read: @_readDurationMs ms</span>
            }

            <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light" Disabled="@_httpLoading" Click="@RefreshAsync" />
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="active-alarms-error">@_error</div>
    }

    @if (_stationCounts.Count > 0)
    {
        <div class="active-alarms-chart-shell">
            <div class="active-alarms-charts">
                <div class="active-alarms-column-chart">
                    <h4>Alarm history by station: @(_selectedStation ?? "All")</h4>

                    <RadzenChart Style="height: 320px; width: 100%;" SeriesClick="@OnStationClickAsync">
                        <RadzenColumnSeries Data="@_stationCounts" CategoryProperty="Station" ValueProperty="Height"
                                            Title="Alarms" Fills="@StationColumnFills">
                            <ChildContent>
                                @foreach (var station in _stationCounts)
                                {
                                    <RadzenSeriesAnnotation Data="@station" Text="@station.Count.ToString()" Fill="var(--rz-text-color)" OffsetY="-12" />
                                }
                            </ChildContent>

                            <TooltipTemplate Context="station">
                                <div>@station.Station — Alarms: @station.Count</div>
                            </TooltipTemplate>
                        </RadzenColumnSeries>

                        <RadzenCategoryAxis />
                        <RadzenValueAxis Min="0" FormatString="{0:0}" />
                        <RadzenLegend Visible="false" />
                    </RadzenChart>
                </div>

                <div class="active-alarms-donut-chart">
                    <h4>Priority: @(_selectedStation ?? "All")</h4>

                    @if (_priorityCounts.Count > 0)
                    {
                        <RadzenChart Style="height: 320px; width: 100%;">
                            <RadzenDonutSeries Data="@_priorityCounts" CategoryProperty="Name" ValueProperty="Count"
                                               Fills="@PriorityColors" FillMode="FillMode.Gradient"
                                               SegmentGap="0.5" CornerRadius="2" Radius="108">
                                <ChildContent>
                                    <RadzenSeriesDataLabels Visible="false" />
                                </ChildContent>

                                <TitleTemplate>
                                    <div class="rz-donut-content active-alarms-donut-content">
                                        <span>Total alarms</span>
                                        <strong>@_items.Count.ToString("N0")</strong>
                                    </div>
                                </TitleTemplate>
                            </RadzenDonutSeries>

                            <RadzenLegend Position="LegendPosition.Bottom" />
                        </RadzenChart>
                    }
                </div>

            </div>
        </div>
    }

    <div class="alarm-history-content">
        <div class="alarm-history-table">
            <RadzenDataGrid @ref="_grid" Data="@_items" TItem="AlarmSummaryDto" AllowFiltering="true"
                            AllowSorting="true" AllowPaging="true" PageSize="30" Density="Density.Compact"
                            class="active-alarms-grid">
                <Columns>
                    <RadzenDataGridColumn TItem="AlarmSummaryDto" Width="48px" Title=""
                                          Filterable="false" Sortable="false" TextAlign="TextAlign.Center">
                        <Template Context="alarm">
                            <span class="@GetPriorityCssClass(alarm)" title="@GetPriorityTitle(alarm.Priority)" aria-label="@GetPriorityTitle(alarm.Priority)">
                                <RadzenIcon Icon="@GetPriorityIcon(alarm.Priority)" />
                            </span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="AlarmSummaryDto" Property="ActiveAt" Title="Date" Width="180px"
                                          SortOrder="SortOrder.Descending">
                        <Template Context="alarm">
                            @(alarm.ActiveAt?.ToString("dd.MM.yyyy HH:mm:ss") ?? "")
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn @ref="_tagColumn" TItem="AlarmSummaryDto" Property="Tag" Title="Tag" Width="340px">
                        <Template Context="alarm">
                            <span class="active-alarms-tag" title="@alarm.Tag">@alarm.Tag</span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="AlarmSummaryDto" Property="Description" Title="Description" />
                    <RadzenDataGridColumn TItem="AlarmSummaryDto" Property="StateDesc" Title="State" Width="190px" />
                </Columns>
            </RadzenDataGrid>
        </div>

        <aside class="alarm-history-list">
            <h4>Equipment</h4>

            <RadzenListBox TValue="string" Data="@_tagPrefixes" TextProperty="Name" ValueProperty="Name"
                           Value="@_selectedTagPrefix" Change="@OnTagPrefixChangedAsync"
                           Style="width: 100%; height: 100%;"
                           InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = "Equipment filter" })">
                <Template Context="item">
                    @{
                        var equipment = (TagPrefixCount)item;
                    }

                    <div class="alarm-history-list-item">
                        <span class="alarm-history-list-name" title="@equipment.Name">@equipment.Name</span>
                        <RadzenBadge Text="@equipment.Count.ToString("N0")" BadgeStyle="BadgeStyle.Light" />
                    </div>
                </Template>
            </RadzenListBox>
        </aside>

    </div>

</div>

@code {

    private static readonly string[] Palette =
    [
        "var(--rz-danger)", "var(--rz-warning)", "var(--rz-info)",
        "#8b5cf6", "var(--rz-text-secondary-color)"
    ];

    private readonly CancellationTokenSource _stop = new();
    private readonly List<AlarmSummaryDto> _allItems = [];

    private List<AlarmSummaryDto> _items = [];
    private List<StationCount> _stationCounts = [];
    private List<PriorityCount> _priorityCounts = [];
    private RadzenDataGrid<AlarmSummaryDto>? _grid;
    private RadzenDataGridColumn<AlarmSummaryDto>? _tagColumn;
    private List<TagPrefixCount> _tagPrefixes = [new("All", 0)];
    private string _selectedTagPrefix = "All";
    private Task? _pollTask;
    private DateRange _selectedRange = new(DateTime.Today.AddDays(-1), DateTime.Today);
    private DateOnly _from = DateOnly.FromDateTime(DateTime.Today.AddDays(-1));
    private DateOnly _to = DateOnly.FromDateTime(DateTime.Today);
    private DateTimeOffset? _loadedAt;
    private string? _selectedStation;
    private string _error = "";
    private long _version;
    private long? _readDurationMs;
    private bool _httpLoading;
    private bool _isRefreshing;

    private IEnumerable<string> StationColumnFills => _stationCounts.Select(station => station.IsAll ? "var(--rz-base-500)" : "var(--rz-success-darker)");
    private IEnumerable<string> PriorityColors => _priorityCounts.Select((_, index) => Palette[index % Palette.Length]);

    /// <summary>
    /// По умолчанию выбирает вчера и сегодня, запрашивает снимок и начинает
    /// наблюдать за окончанием фонового чтения Runtime.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(false);
        _pollTask = PollAsync();
    }

    /// <summary>
    /// Сохраняет промежуточный выбор после первого клика, чтобы повторная
    /// отрисовка страницы не возвращала старый диапазон. Историю загружает
    /// только после выбора второй даты.
    /// </summary>
    private async Task OnRangeChanged(DateRange value)
    {
        if (value is null)
            return;

        // Radzen вызывает ValueChanged дважды: сначала Start без End,
        // затем завершённый диапазон. Оба состояния должны попасть в Value.
        _selectedRange = value;

        if (value.Start is null || value.End is null)
            return;

        var from = DateOnly.FromDateTime(value.Start.Value.Date);
        var to = DateOnly.FromDateTime(value.End.Value.Date);

        if (to < from || to == DateOnly.MaxValue || (from == _from && to == _to))
            return;

        _from = from;
        _to = to;
        _version = 0;
        _loadedAt = null;
        _readDurationMs = null;
        _selectedStation = null;
        _error = "";
        _isRefreshing = true;

        _allItems.Clear();
        _items.Clear();
        _stationCounts.Clear();
        _priorityCounts.Clear();

        // Новый период начинает новый список оборудования и показывает все теги.
        _selectedTagPrefix = "All";
        _tagPrefixes = [new TagPrefixCount("All", 0)];
        await ApplyTagPrefixFilterAsync();

        // Если HTTP-запрос прежнего диапазона ещё выполняется, очередной
        // опрос страницы запросит новый диапазон после его завершения.
        await LoadAsync(false);

        if (_grid is not null)
            await _grid.FirstPage(true);
    }

    /// <summary>
    /// Переключает SelectBar на страницу активных аварий.
    /// Текущая страница сама задаёт выбранное положение переключателя.
    /// </summary>
    private void OnAlarmViewChanged(string value)
    {
        if (value == "active")
            Navigation.NavigateTo("/alarms");
    }

    /// <summary>
    /// Повторно читает весь выбранный диапазон по явному запросу оператора.
    /// </summary>
    private Task RefreshAsync()
    {
        return LoadAsync(true);
    }

    /// <summary>
    /// Получает снимок выбранного диапазона. Ответ прежнего диапазона игнорируется,
    /// если оператор изменил даты во время HTTP-запроса.
    /// Сохраняет фильтры и сортировку таблицы при обновлении данных.
    /// </summary>
    private async Task LoadAsync(bool forceRefresh)
    {
        if (_httpLoading || _stop.IsCancellationRequested)
            return;

        _httpLoading = true;
        var from = _from;
        var to = _to;

        try
        {
            var result = await SummaryApi.GetAsync(from, to, forceRefresh, _version, _stop.Token);

            if (from != _from || to != _to)
                return;

            if (!result.NotModified && result.LoadedAtUtc is not null)
            {
                _allItems.Clear();
                _allItems.AddRange(result.Items);
                _stationCounts = BuildStationCounts(_allItems);

                if (_selectedStation is not null && !_stationCounts.Any(station => station.Station == _selectedStation))
                    _selectedStation = null;

                // Список оборудования строится из тех же строк станции,
                // которые передаются в таблицу.
                var previousTagPrefix = _selectedTagPrefix;
                ApplyStationSelection();
                BuildTagPrefixes();

                _version = result.Version;
                _loadedAt = result.LoadedAtUtc;
                _readDurationMs = result.ReadDurationMs;

                if (_grid is not null)
                {
                    await _grid.Reload();

                    // Если оборудование исчезло из нового снимка, снимаем
                    // установленный через ListBox фильтр колонки Tag.
                    if (previousTagPrefix != _selectedTagPrefix)
                        await ApplyTagPrefixFilterAsync();
                }
            }

            _isRefreshing = result.IsRefreshing;
            _error = result.RefreshError ?? "";
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            if (from != _from || to != _to)
                return;

            _isRefreshing = false;
            _error = _loadedAt is null
                ? "Cannot load alarm history from Runtime Service."
                : "Cannot refresh alarm history. Showing the last available data.";
        }
        finally
        {
            _httpLoading = false;
        }
    }

    /// <summary>
    /// Фильтрует строки по выбранной станции и считает приоритеты для donut.
    /// Коды 0 и 3 относятся к группе Info.
    /// </summary>
    private void ApplyStationSelection()
    {
        _items.Clear();
        _items.AddRange(_selectedStation is null
            ? _allItems
            : _allItems.Where(alarm => string.Equals(GetStation(alarm.Tag), _selectedStation, StringComparison.Ordinal)));

        var counts = new int[5];
        var unknownCount = 0;

        foreach (var alarm in _items)
        {
            if (alarm.Priority is >= 0 and <= 4)
                counts[alarm.Priority.Value]++;
            else
                unknownCount++;
        }

        _priorityCounts =
        [
            new($"Alarm ({counts[1]:N0})", counts[1]),
            new($"Warning ({counts[2]:N0})", counts[2]),
            new($"Info ({counts[0] + counts[3]:N0})", counts[0] + counts[3]),
            new($"System ({counts[4]:N0})", counts[4])
        ];

        if (unknownCount > 0)
            _priorityCounts.Add(new PriorityCount($"Unknown ({unknownCount:N0})", unknownCount));
    }

    /// <summary>
    /// Назначает цвет по приоритету и мигание для состояния Unacknowledged.
    /// </summary>
    private static string GetPriorityCssClass(AlarmSummaryDto alarm)
    {
        var level = alarm.Priority switch
        {
            0 or 3 => "is-info",
            1 => "is-alarm",
            2 => "is-warning",
            4 => "is-system",
            _ => "is-unknown"
        };

        return alarm.StateDesc.Contains("Unacknowledged", StringComparison.OrdinalIgnoreCase)
            ? $"active-alarms-priority {level} is-unacknowledged"
            : $"active-alarms-priority {level}";
    }

    /// <summary>
    /// Использует те же иконки, что страница активных аварий.
    /// </summary>
    private static string GetPriorityIcon(int? priority) => priority switch
    {
        0 or 3 => "info",
        1 => "error",
        2 => "warning",
        4 => "dns",
        _ => "help_outline"
    };

    /// <summary>
    /// Показывает расшифровку кода в подсказке иконки.
    /// </summary>
    private static string GetPriorityTitle(int? priority) => priority switch
    {
        0 or 3 => "Info",
        1 => "Alarm",
        2 => "Warning",
        4 => "System",
        _ => $"Unknown priority: {priority?.ToString() ?? "NULL"}"
    };

    /// <summary>
    /// Высота All равна максимальной станции; подпись содержит полное число.
    /// </summary>
    private static List<StationCount> BuildStationCounts(IReadOnlyCollection<AlarmSummaryDto> alarms)
    {
        var stations = alarms
            .Select(alarm => GetStation(alarm.Tag))
            .Where(station => station is not null)
            .GroupBy(station => station!, StringComparer.Ordinal)
            .Select(group => new StationCount(group.Key, group.Count(), group.Count()))
            .OrderBy(station => station.Station, StringComparer.Ordinal)
            .ToList();

        if (stations.Count == 0)
            return [];

        stations.Insert(0, new StationCount("All", alarms.Count, stations.Max(station => station.Count), IsAll: true));
        return stations;
    }

    /// <summary>
    /// Из Source вида S01.H02.M01 извлекает станцию S01.
    /// </summary>
    private static string? GetStation(string? source)
    {
        if (string.IsNullOrWhiteSpace(source))
            return null;

        var dot = source.IndexOf('.');
        return dot > 0 ? source[..dot].Trim().ToUpperInvariant() : null;
    }

    /// <summary>
    /// Для группировки оборудования берёт первые две части тега.
    /// Например, S01.H06_2.SIC01.AlarmHealth превращается в S01.H06_2.
    /// </summary>
    private static string? GetTagPrefix(string? tag)
    {
        if (string.IsNullOrWhiteSpace(tag))
            return null;

        var firstDot = tag.IndexOf('.');
        if (firstDot <= 0)
            return null;

        var secondDot = tag.IndexOf('.', firstDot + 1);
        if (secondDot <= firstDot + 1)
            return null;

        return tag[..secondDot].Trim();
    }

    /// <summary>
    /// Строит список оборудования из строк выбранной станции.
    /// Count показывает число записей истории за текущий период и станцию.
    /// </summary>
    private void BuildTagPrefixes()
    {
        var prefixes = _items
            .Select(alarm => GetTagPrefix(alarm.Tag))
            .Where(prefix => !string.IsNullOrWhiteSpace(prefix))
            .GroupBy(prefix => prefix!, StringComparer.OrdinalIgnoreCase)
            .Select(group => new TagPrefixCount(group.Key, group.Count()))
            .OrderBy(prefix => prefix.Name, StringComparer.OrdinalIgnoreCase);

        _tagPrefixes = [new TagPrefixCount("All", _items.Count), .. prefixes];

        // При выборе другой станции ранее выбранного оборудования
        // может не оказаться в новом списке.
        if (!_tagPrefixes.Any(prefix => string.Equals(prefix.Name, _selectedTagPrefix, StringComparison.OrdinalIgnoreCase)))
            _selectedTagPrefix = "All";
    }

    /// <summary>
    /// Применяет выбор ListBox как фильтр Contains непосредственно к колонке Tag.
    /// Фильтры остальных колонок и сортировку таблицы не сбрасывает.
    /// </summary>
    private async Task ApplyTagPrefixFilterAsync()
    {
        if (_grid is null || _tagColumn is null)
            return;

        _tagColumn.SetFilterOperator(FilterOperator.Contains);
        _tagColumn.SetFilterValue(_selectedTagPrefix == "All" ? null! : _selectedTagPrefix, true);
        await _grid.ApplyFilter(_tagColumn, true);
        await _grid.FirstPage(true);
    }

    /// <summary>
    /// Выбор оборудования меняет только фильтр колонки Tag.
    /// Элемент All снимает этот фильтр.
    /// </summary>
    private async Task OnTagPrefixChangedAsync(object? value)
    {
        _selectedTagPrefix = value as string ?? "All";
        await ApplyTagPrefixFilterAsync();
    }

    /// <summary>
    /// Выбирает станцию, обновляет её оборудование и строки таблицы.
    /// Если выбранного оборудования в станции нет, снимает фильтр Tag.
    /// </summary>
    private async Task OnStationClickAsync(SeriesClickEventArgs args)
    {
        if (args.Data is not StationCount station)
            return;

        _selectedStation = station.IsAll ? null : station.Station;

        var previousTagPrefix = _selectedTagPrefix;
        ApplyStationSelection();
        BuildTagPrefixes();

        if (_grid is null)
            return;

        if (previousTagPrefix != _selectedTagPrefix)
            await ApplyTagPrefixFilterAsync();
        else
            await _grid.FirstPage(true);
    }

    /// <summary>
    /// Пока страница открыта, проверяет завершение ODBC-чтения каждые три секунды.
    /// </summary>
    private async Task PollAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));

            while (await timer.WaitForNextTickAsync(_stop.Token))
            {
                await InvokeAsync(async () =>
                {
                    await LoadAsync(false);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested)
        {
        }
    }

    /// <summary>
    /// После ухода со страницы прекращает опрос Runtime.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        _stop.Cancel();

        if (_pollTask is not null)
            await _pollTask;

        _stop.Dispose();
    }

    private sealed record StationCount(string Station, int Count, int Height, bool IsAll = false);
    private sealed record TagPrefixCount(string Name, int Count);
    private sealed record PriorityCount(string Name, int Count);
}