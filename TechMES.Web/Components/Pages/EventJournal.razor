@page "/events"
@using TechMES.Contracts.Events
@using TechMES.Web.Components.Pages
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject EventJournalApiClient JournalApi
@inject IJSRuntime JSRuntime

<PageTitle>Events</PageTitle>

<div class="event-journal-page">

    <div class="event-journal-toolbar">
        <div class="event-journal-toolbar-date">
            <RadzenDateRangePicker Value="@_selectedRange" ValueChanged="@OnRangeChanged"
                                   NavigationMode="DatePickerNavigationMode.DrillDown"
                                   DisplayMonths="2" AllowClear="false" DateFormat="dd.MM.yyyy"
                                   Style="width: 100%; max-width: 290px;" />
        </div>

        <h2 class="event-journal-title">Event Journal</h2>

        <div class="event-journal-toolbar-right">
            @if (_isRefreshing)
            {
                <span class="event-journal-spinner" title="Reading events from SCADA" aria-label="Reading events from SCADA">
                    <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" Style="width: 24px; height: 24px;" />
                </span>
            }

            <RadzenBadge Text="@($"Count: {VisibleCount}")" BadgeStyle="BadgeStyle.Light" />

            @if (_loadedAt is not null)
            {
                <span class="event-journal-status">Updated: @_loadedAt.Value.ToLocalTime().ToString("HH:mm:ss")</span>
            }

            @if (_readDurationMs is not null)
            {
                <span class="event-journal-status">Read: @_readDurationMs ms</span>
            }

            <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                          Disabled="@(_httpLoading || _isRefreshing)" Click="@RefreshAsync" />
        </div>
    </div>

    <div class="event-journal-auto-refresh-row">
        <div class="event-journal-refresh-option">
            <RadzenLabel Text="Auto refresh" Component="eventJournalAutoRefresh" />
            <RadzenSwitch Name="eventJournalAutoRefresh" Value="@_autoRefresh" Change="@OnAutoRefreshChanged" />
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="event-journal-error">@_error</div>
    }

    @if (_selectedCategory == InterfaceEventCategory && _loadedAt is not null && _timelineItems.Count > 0)
    {
        <div class="event-journal-timeline-layout @(_equipmentPrefixes.Count > 1 ? "" : "event-journal-timeline-layout-full")">
            <div class="event-journal-timeline-scroll" aria-label="Latest operation actions">
                <RadzenTimeline Orientation="Orientation.Horizontal" LinePosition="LinePosition.Center"
                                AlignItems="AlignItems.Center" class="event-journal-timeline">
                    <Items>
                        @for (var index = 0; index < _timelineItems.Count; index++)
                        {
                            var action = _timelineItems[index];

                            <RadzenTimelineItem @key="action" PointStyle="@(index == 0 ? PointStyle.Primary : PointStyle.Base)"
                                                PointSize="PointSize.Small">
                                <LabelContent>
                                    <span class="event-journal-timeline-user"
                                          title="@(action.Date?.ToString("dd.MM.yyyy HH:mm:ss"))">@action.User</span>
                                </LabelContent>
                                <ChildContent>
                                    <span class="event-journal-timeline-equipment" title="@action.Equipment">@action.Equipment</span>
                                </ChildContent>
                            </RadzenTimelineItem>
                        }
                    </Items>
                </RadzenTimeline>
            </div>
        </div>
    }

    <div class="event-journal-station-toolbar">
        @if (_selectedCategory == InterfaceEventCategory)
        {
            <div class="event-journal-station-scroll" role="group" aria-label="Operation actions by station">

                <RadzenCardGroup Responsive="false" class="event-journal-station-group">
                    @foreach (var station in _stationCards)
                    {
                        <RadzenCard @key="station.Name" Variant="Variant.Filled" class="@GetStationCardCssClass(station)">
                            <button type="button" class="event-journal-station-button"
                                    aria-pressed="@IsStationSelected(station)"
                                    title="@($"{station.Name}: {station.Count} actions")"
                                    @onclick="() => OnStationClickAsync(station)">
                                <span class="event-journal-station-header">
                                    <RadzenIcon Icon="@(station.IsAll ? "apps" : "factory")" class="event-journal-station-icon" />
                                    <span class="event-journal-station-name">@station.Name</span>
                                </span>

                                <span class="event-journal-station-badge">
                                    <RadzenBadge Text="@station.Count.ToString()" BadgeStyle="BadgeStyle.Light" />
                                </span>
                            </button>
                        </RadzenCard>
                    }
                </RadzenCardGroup>

            </div>
        }
        else
        {
            <div class="event-journal-station-spacer"></div>
        }

        <div class="event-journal-category-select">
            <RadzenDropDown TValue="string" Data="@EventCategories" TextProperty="Text" ValueProperty="Value"
                            Value="@_selectedCategory" ValueChanged="@OnCategoryChanged" AllowClear="false"
                            Style="width: 100%;" AriaLabel="Event category">
                <Template Context="item">
                    @{
                        var category = (EventCategoryOption)item;
                    }
                    <span style="display: inline-flex; align-items: center; gap: 8px;">
                        <RadzenIcon Icon="@category.Icon" />
                        <span>@category.Text</span>
                    </span>
                </Template>
                <ValueTemplate Context="item">
                    @{
                        var category = (EventCategoryOption)item;
                    }
                    <span style="display: inline-flex; align-items: center; gap: 8px;">
                        <RadzenIcon Icon="@category.Icon" />
                        <span>@category.Text</span>
                    </span>
                </ValueTemplate>
            </RadzenDropDown>
        </div>
    </div>

    <div class="event-journal-content @(_selectedCategory == InterfaceEventCategory && _equipmentPrefixes.Count > 1 ? "" : "event-journal-content-full")">
        
        <div class="event-journal-table" @ref="_tableHost">
            @if (_selectedCategory == InterfaceEventCategory)
            {
                <RadzenDataGrid @key="_gridRevision" @ref="_operationGrid" Data="@_operationItems" TItem="OperationActionRow"
                                AllowFiltering="true" AllowSorting="true" AllowPaging="true" PageSize="40"
                                Density="Density.Compact" class="event-journal-grid">

                    <Columns>
                        <RadzenDataGridColumn TItem="OperationActionRow" Property="Date" Title="Date" Width="180px"
                                              SortOrder="SortOrder.Descending">
                            <Template Context="entry">
                                @(entry.Date?.ToString("dd.MM.yyyy HH:mm:ss") ?? "")
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="OperationActionRow" Property="User" Title="User" Width="120px" />

                        <RadzenDataGridColumn @ref="_equipmentColumn" TItem="OperationActionRow"
                                              Property="Equipment" Title="Equipment" Width="180px">
                            <Template Context="entry">
                                <span class="event-journal-description" title="@entry.Equipment">@entry.Equipment</span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="OperationActionRow" Property="Action" Title="Action" Width="180px" />

                        <RadzenDataGridColumn TItem="OperationActionRow" Property="Description" Title="Description" Width="620px">
                            <Template Context="entry">
                                <span class="event-journal-description" title="@entry.Description">@entry.Description</span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="OperationActionRow" Property="Old" Title="Old" Width="120px" />
                        <RadzenDataGridColumn TItem="OperationActionRow" Property="New" Title="New" Width="120px" />
                        <RadzenDataGridColumn TItem="OperationActionRow" Property="Client" Title="Client" Width="190px" Visible="@_showClientColumns" />
                        <RadzenDataGridColumn TItem="OperationActionRow" Property="Address" Title="Address" Width="180px" Visible="@_showClientColumns" />
                    </Columns>

                </RadzenDataGrid>
            }
            else
            {
                <RadzenDataGrid @key="_gridRevision" Data="@_eventItems" TItem="EventJournalDto"
                                AllowFiltering="true" AllowSorting="true" AllowPaging="true" PageSize="40"
                                Density="Density.Compact" class="event-journal-grid">
                    <Columns>
                        <RadzenDataGridColumn TItem="EventJournalDto" Property="Date" Title="Date" Width="180px"
                                              SortOrder="SortOrder.Descending">
                            <Template Context="entry">
                                @(entry.Date?.ToString("dd.MM.yyyy HH:mm:ss") ?? "")
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="EventJournalDto" Property="Description" Title="Description" Width="640px">
                            <Template Context="entry">
                                <span class="event-journal-description" title="@entry.Description">@entry.Description</span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="EventJournalDto" Property="Source" Title="Source" Width="320px" />
                        <RadzenDataGridColumn TItem="EventJournalDto" Property="ClientAddressDesc" Title="Client address" Width="180px" />
                        <RadzenDataGridColumn TItem="EventJournalDto" Property="User" Title="User" Width="160px" />
                    </Columns>
                </RadzenDataGrid>
            }
        </div>

        @if (_selectedCategory == InterfaceEventCategory && _equipmentPrefixes.Count > 1)
        {
            <aside class="event-journal-equipment-list">
                <div class="event-journal-equipment-list-box">
                    <RadzenListBox TValue="string" Data="@_equipmentPrefixes" TextProperty="Name" ValueProperty="Name"
                                   Value="@_selectedEquipmentPrefix" Change="@OnEquipmentPrefixChangedAsync"
                                   Style="width: 100%; height: 100%;"
                                   InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = "Equipment filter" })">
                        <Template Context="item">
                            @{
                                var equipment = (EquipmentPrefixCount)item;
                            }

                            <div class="event-journal-list-item">
                                <span class="event-journal-list-identity">
                                    <RadzenIcon Icon="@(equipment.Name == "All" ? "apps" : "precision_manufacturing")" />
                                    <span class="event-journal-list-name" title="@equipment.Name">@equipment.Name</span>
                                </span>

                                <RadzenBadge Text="@equipment.Count.ToString()" BadgeStyle="BadgeStyle.Light" />
                            </div>
                        </Template>
                    </RadzenListBox>
                </div>

                <div class="event-journal-switches">
                    <div class="event-journal-option-switch">
                        <span>client</span>
                        <RadzenSwitch @bind-Value="_showClientColumns"
                                      InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = "Show Client and Address columns" })" />
                    </div>

                    <div class="event-journal-option-switch">
                        <span>logged</span>
                        <RadzenSwitch Value="@_showRootEquipment" Change="@OnShowRootChanged"
                                      InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = "Show $Root events" })" />
                    </div>
                </div>
            </aside>
        }

    </div>

</div>


@code {
    private const string InterfaceEventCategory = "Interface Event";
    private const string SystemCategory = "System";
    private const string ArchivingCategory = "Archiving";

    // Подписи и иконки категорий используются в списке и в выбранном значении комбобокса.
    private static readonly EventCategoryOption[] EventCategories =
    [
        new(InterfaceEventCategory, "Operation actions", "touch_app"),
        new(SystemCategory, "System", "settings"),
        new(ArchivingCategory, "Archiving", "archive")
    ];

    // Минимальная ширина на одну точку с подписью и защитный предел для широких экранов.
    private const int TimelineItemWidth = 140;
    private const int TimelineMaxItems = 64;

    private List<OperationActionRow> _timelineCandidates = [];
    private ElementReference _tableHost;
    private IJSObjectReference? _timelineModule;
    private DotNetObjectReference<EventJournal>? _timelineSelfReference;
    private int _timelineCapacity;

    private readonly CancellationTokenSource _stop = new();
    private readonly List<OperationActionRow> _allOperationItems = [];
    private readonly List<OperationActionRow> _operationItems = [];

    private List<EventJournalDto> _allItems = [];
    private IReadOnlyList<EventJournalDto> _eventItems = [];
    private List<StationCount> _stationCards = [new("All", 0, true)];
    private List<OperationActionRow> _timelineItems = [];
    private List<EquipmentPrefixCount> _equipmentPrefixes = [new("All", 0)];
    private string _selectedCategory = InterfaceEventCategory;
    private string? _selectedStation;
    private string _selectedEquipmentPrefix = "All";
    private DateRange _selectedRange = new(DateTime.Today.AddDays(-1), DateTime.Today);
    private DateOnly _from = DateOnly.FromDateTime(DateTime.Today.AddDays(-1));
    private DateOnly _to = DateOnly.FromDateTime(DateTime.Today);
    private RadzenDataGrid<OperationActionRow>? _operationGrid;
    private RadzenDataGridColumn<OperationActionRow>? _equipmentColumn;
    private Task? _pollTask;
    private DateTimeOffset? _loadedAt;
    private long? _readDurationMs;
    private long _version;
    private int _gridRevision;
    private string _error = "";
    private bool _httpLoading;
    private bool _isRefreshing;

    // Switch выключен при открытии страницы. Интервал приходит из Runtime.
    private bool _autoRefresh;
    private int _refreshPeriodSeconds = 30;
    private DateTimeOffset? _nextAutoRefreshAtUtc;

    // По умолчанию служебные события Equipment = $Root скрыты.
    private bool _showRootEquipment;

    // Client и Address при открытии страницы скрыты.
    private bool _showClientColumns;

    private int VisibleCount => _selectedCategory == InterfaceEventCategory ? _operationItems.Count : _eventItems.Count;

    /// <summary>
    /// Проверяет, соответствует ли карточка выбранной станции.
    /// При отсутствии выбранной станции активной считается All.
    /// </summary>
    private bool IsStationSelected(StationCount station)
    {
        return station.IsAll
            ? _selectedStation is null
            : string.Equals(station.Name, _selectedStation, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// Передаёт RadzenCard одно готовое значение class.
    /// All сохраняет свой нейтральный цвет, выбранная карточка получает увеличенный размер.
    /// </summary>
    private string GetStationCardCssClass(StationCount station)
    {
        var cssClass = "event-journal-station-card";

        if (station.IsAll)
            cssClass += " is-all";

        if (IsStationSelected(station))
            cssClass += " is-selected";

        return cssClass;
    }

    /// <summary>
    /// После появления таблицы подписывается на изменение ширины её контейнера.
    /// Наблюдатель создаётся один раз и не зависит от Refresh или категории событий.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _stop.IsCancellationRequested)
            return;

        try
        {
            _timelineModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./techmesEventJournalTimeline.js");
            _timelineSelfReference = DotNetObjectReference.Create(this);

            await _timelineModule.InvokeVoidAsync("observe", _tableHost, _timelineSelfReference, TimelineItemWidth, TimelineMaxItems);
        }
        catch (JSDisconnectedException)
        {
            // Страница закрылась во время подключения наблюдателя.
        }
    }

    /// <summary>
    /// Изменяет количество видимых точек при изменении ширины таблицы.
    /// Использует уже подготовленные записи, не обращаясь повторно к Runtime.
    /// </summary>
    [JSInvokable]
    public Task OnTimelineCapacityChanged(int capacity)
    {
        return InvokeAsync(() =>
        {
            if (_stop.IsCancellationRequested)
                return;

            var newCapacity = Math.Clamp(capacity, 1, TimelineMaxItems);

            if (newCapacity == _timelineCapacity)
                return;

            _timelineCapacity = newCapacity;
            UpdateTimelineItems();
            StateHasChanged();
        });
    }

    /// <summary>
    /// Запрашивает вчерашние и сегодняшние события и наблюдает за окончанием фонового ODBC-чтения.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(false);
        _pollTask = PollAsync();
    }

    /// <summary>
    /// Запускает новый запрос после выбора обеих дат. Для нового периода возвращает
    /// категорию Operation actions и сбрасывает выбор станции и оборудования.
    /// </summary>
    private async Task OnRangeChanged(DateRange value)
    {
        if (value is null)
            return;

        _selectedRange = value;

        if (value.Start is null || value.End is null)
            return;

        var from = DateOnly.FromDateTime(value.Start.Value.Date);
        var to = DateOnly.FromDateTime(value.End.Value.Date);

        if (to < from || to == DateOnly.MaxValue || (from == _from && to == _to))
            return;

        _from = from;
        _to = to;
        _version = 0;
        _loadedAt = null;
        _readDurationMs = null;
        _error = "";
        _isRefreshing = true;
        _selectedCategory = InterfaceEventCategory;
        _selectedStation = null;
        _selectedEquipmentPrefix = "All";
        _allItems = [];
        _eventItems = [];
        _allOperationItems.Clear();
        _operationItems.Clear();
        _stationCards = [new StationCount("All", 0, true)];
        _equipmentPrefixes = [new EquipmentPrefixCount("All", 0)];
        _operationGrid = null;
        _equipmentColumn = null;
        _gridRevision++;

        // Если HTTP-запрос прежнего периода ещё идёт, PollAsync запросит новый период после его окончания.
        await LoadAsync(false);
    }

    /// <summary>
    /// Переключает категорию на уже полученном снимке без нового обращения к ODBC.
    /// При переходе между таблицами начинает с All.
    /// </summary>
    private void OnCategoryChanged(string value)
    {
        if (value != InterfaceEventCategory && value != SystemCategory && value != ArchivingCategory)
            return;

        if (string.Equals(value, _selectedCategory, StringComparison.Ordinal))
            return;

        _selectedCategory = value;
        _selectedStation = null;
        _selectedEquipmentPrefix = "All";
        _operationGrid = null;
        _equipmentColumn = null;
        _gridRevision++;
        ApplyCategoryFilter();
    }

    /// <summary>
    /// Показывает или скрывает события Equipment = $Root без повторного чтения ODBC.
    /// После изменения обновляет карточки станций, список оборудования и таблицу.
    /// </summary>
    private async Task OnShowRootChanged(bool showRootEquipment)
    {
        if (_showRootEquipment == showRootEquipment)
            return;

        _showRootEquipment = showRootEquipment;
        var previousEquipmentPrefix = _selectedEquipmentPrefix;

        ApplyCategoryFilter();

        if (_operationGrid is null)
            return;

        await _operationGrid.Reload();

        if (previousEquipmentPrefix != _selectedEquipmentPrefix)
            await ApplyEquipmentPrefixFilterAsync();
        else
            await _operationGrid.FirstPage(true);
    }

    /// <summary>
    /// Разбирает действия оператора только для Interface Event.
    /// Для System и Archiving очищает отображаемые User и Description.
    /// Timeline получает последние события независимо от фильтров станции и оборудования.
    /// </summary>
    private void ApplyCategoryFilter()
    {
        var selectedEvents = _allItems
            .Where(entry => string.Equals(entry.Category?.Trim(), _selectedCategory, StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (_selectedCategory != InterfaceEventCategory)
        {
            _eventItems = selectedEvents.Select(entry => new EventJournalDto
            {
                Date = entry.Date,
                Description = EventJournalDisplayText.Clean(entry.Description),
                CustomStringField = entry.CustomStringField,
                Source = entry.Source,
                Category = entry.Category,
                ClientAddressDesc = entry.ClientAddressDesc,
                User = EventJournalDisplayText.Clean(entry.User),
                Id = entry.Id,
                AlarmStateDesc = entry.AlarmStateDesc
            }).ToList();

            _timelineItems.Clear();
            _timelineCandidates.Clear();
            _allOperationItems.Clear();
            _operationItems.Clear();
            _stationCards = [new StationCount("All", 0, true)];
            _equipmentPrefixes = [new EquipmentPrefixCount("All", 0)];
            return;
        }

        _eventItems = [];
        var actions = selectedEvents.Select(OperationActionRow.FromEvent).ToList();

        BuildTimeline(actions);

        _allOperationItems.Clear();
        _allOperationItems.AddRange(actions.Where(action => _showRootEquipment || !IsRootEquipment(action)));

        BuildStationCards();

        // После Refresh или переключения $Root выбранная станция может исчезнуть из выборки.
        if (_selectedStation is not null && !_stationCards.Any(station => string.Equals(station.Name, _selectedStation, StringComparison.OrdinalIgnoreCase)))
            _selectedStation = null;

        ApplyStationSelection();
        BuildEquipmentPrefixes();
    }

    /// <summary>
    /// Сохраняет последние действия выбранного периода без $Root.
    /// Источник не зависит от фильтра станции, списка оборудования и switch logged.
    /// </summary>
    private void BuildTimeline(IReadOnlyList<OperationActionRow> actions)
    {
        _timelineCandidates = actions
            .Where(action => !IsRootEquipment(action))
            .OrderByDescending(action => action.Date ?? DateTime.MinValue)
            .Take(TimelineMaxItems)
            .ToList();

        UpdateTimelineItems();
    }

    /// <summary>
    /// Показывает столько подготовленных действий, сколько помещается по ширине таблицы.
    /// </summary>
    private void UpdateTimelineItems()
    {
        _timelineItems = _timelineCandidates.Take(_timelineCapacity).ToList();
    }

    /// <summary>
    /// Определяет служебное событие входа или выхода по полю Equipment.
    /// </summary>
    private static bool IsRootEquipment(OperationActionRow action)
    {
        return string.Equals(action.Equipment.Trim(), "$Root", StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// Строит карточки станций из Equipment вида S01.H09.TT02.
    /// All включает также события без распознанной станции.
    /// </summary>
    private void BuildStationCards()
    {
        var stations = _allOperationItems
            .Select(action => GetStation(action.Equipment))
            .Where(station => station is not null)
            .GroupBy(station => station!, StringComparer.OrdinalIgnoreCase)
            .Select(group => new StationCount(group.Key, group.Count()))
            .OrderBy(station => station.Name, StringComparer.OrdinalIgnoreCase);

        _stationCards = [new StationCount("All", _allOperationItems.Count, true), .. stations];
    }

    /// <summary>
    /// Передаёт таблице все действия или только действия выбранной станции.
    /// Список обновляется без повторного разбора сообщений.
    /// </summary>
    private void ApplyStationSelection()
    {
        _operationItems.Clear();
        _operationItems.AddRange(_selectedStation is null
            ? _allOperationItems
            : _allOperationItems.Where(action => string.Equals(GetStation(action.Equipment), _selectedStation, StringComparison.OrdinalIgnoreCase)));
    }

    /// <summary>
    /// Создаёт правый список оборудования для текущей станции.
    /// Например, S01.H09.TT02 и S01.H09.TT03 попадут в S01.H09.
    /// </summary>
    private void BuildEquipmentPrefixes()
    {
        var equipment = _operationItems
            .Select(action => GetEquipmentPrefix(action.Equipment))
            .Where(prefix => prefix is not null)
            .GroupBy(prefix => prefix!, StringComparer.OrdinalIgnoreCase)
            .Select(group => new EquipmentPrefixCount(group.Key, group.Count()))
            .OrderBy(prefix => prefix.Name, StringComparer.OrdinalIgnoreCase);

        _equipmentPrefixes = [new EquipmentPrefixCount("All", _operationItems.Count), .. equipment];

        if (!_equipmentPrefixes.Any(item => string.Equals(item.Name, _selectedEquipmentPrefix, StringComparison.OrdinalIgnoreCase)))
            _selectedEquipmentPrefix = "All";
    }

    /// <summary>
    /// Возвращает часть Equipment до первой точки: S01.H09.TT02 превращается в S01.
    /// </summary>
    private static string? GetStation(string? equipment)
    {
        if (string.IsNullOrWhiteSpace(equipment))
            return null;

        var dot = equipment.IndexOf('.');
        return dot > 0 ? equipment[..dot].Trim().ToUpperInvariant() : null;
    }

    /// <summary>
    /// Возвращает первые две части Equipment для правого списка.
    /// </summary>
    private static string? GetEquipmentPrefix(string? equipment)
    {
        if (string.IsNullOrWhiteSpace(equipment))
            return null;

        var firstDot = equipment.IndexOf('.');
        if (firstDot <= 0)
            return null;

        var secondDot = equipment.IndexOf('.', firstDot + 1);
        if (secondDot <= firstDot + 1)
            return null;

        return equipment[..secondDot].Trim();
    }

    /// <summary>
    /// Выбор карточки меняет строки таблицы и содержимое правого списка.
    /// Остальные фильтры и сортировка DataGrid сохраняются.
    /// </summary>
    private async Task OnStationClickAsync(StationCount station)
    {
        var selectedStation = station.IsAll ? null : station.Name;

        if (string.Equals(selectedStation, _selectedStation, StringComparison.OrdinalIgnoreCase))
            return;

        _selectedStation = selectedStation;
        var previousEquipmentPrefix = _selectedEquipmentPrefix;

        ApplyStationSelection();
        BuildEquipmentPrefixes();

        if (_operationGrid is null)
            return;

        if (previousEquipmentPrefix != _selectedEquipmentPrefix)
            await ApplyEquipmentPrefixFilterAsync();
        else
            await _operationGrid.FirstPage(true);
    }

    /// <summary>
    /// Применяет выбор ListBox через Contains к колонке Equipment.
    /// Фильтры других колонок остаются на месте.
    /// </summary>
    private async Task ApplyEquipmentPrefixFilterAsync()
    {
        if (_operationGrid is null || _equipmentColumn is null)
            return;

        _equipmentColumn.SetFilterOperator(FilterOperator.Contains);
        _equipmentColumn.SetFilterValue(_selectedEquipmentPrefix == "All" ? null! : _selectedEquipmentPrefix, true);
        await _operationGrid.ApplyFilter(_equipmentColumn, true);
        await _operationGrid.FirstPage(true);
    }

    /// <summary>
    /// Выбор оборудования в правом списке изменяет только фильтр Equipment.
    /// </summary>
    private async Task OnEquipmentPrefixChangedAsync(object? value)
    {
        _selectedEquipmentPrefix = value as string ?? "All";
        await ApplyEquipmentPrefixFilterAsync();
    }

    /// <summary>
    /// Повторно читает выбранный период по нажатию Refresh.
    /// </summary>
    private Task RefreshAsync()
    {
        return LoadAsync(true);
    }

    /// <summary>
    /// Включает или останавливает автоматическое чтение выбранного диапазона.
    /// Первое повторное чтение планируется через период, полученный из Runtime.
    /// </summary>
    private void OnAutoRefreshChanged(bool value)
    {
        _autoRefresh = value;
        _nextAutoRefreshAtUtc = value
            ? DateTimeOffset.UtcNow.AddSeconds(_refreshPeriodSeconds)
            : null;
    }

    /// <summary>
    /// Получает снимок и обновляет таблицу, карточки и правый список.
    /// При Refresh сохраняет выбранные станцию, оборудование, фильтры и сортировку.
    /// Следующий автоматический запрос отсчитывается после окончания чтения.
    /// </summary>
    private async Task LoadAsync(bool forceRefresh)
    {
        if (_httpLoading || _stop.IsCancellationRequested)
            return;

        _httpLoading = true;
        var from = _from;
        var to = _to;

        try
        {
            var response = await JournalApi.GetAsync(from, to, forceRefresh, _version, _stop.Token);

            if (from != _from || to != _to)
                return;

            _refreshPeriodSeconds = response.RefreshPeriodSeconds > 0 ? response.RefreshPeriodSeconds : 30;
            var wasRefreshing = _isRefreshing;
            var snapshotUpdated = !response.NotModified && response.LoadedAtUtc is not null;

            if (snapshotUpdated)
            {
                var previousEquipmentPrefix = _selectedEquipmentPrefix;

                _allItems = response.Items.ToList();
                ApplyCategoryFilter();

                if (_selectedCategory == InterfaceEventCategory && _operationGrid is not null)
                {
                    await _operationGrid.Reload();

                    if (previousEquipmentPrefix != _selectedEquipmentPrefix)
                        await ApplyEquipmentPrefixFilterAsync();
                }
            }

            _version = response.Version;
            _loadedAt = response.LoadedAtUtc;
            _readDurationMs = response.ReadDurationMs;
            _isRefreshing = response.IsRefreshing;
            _error = response.RefreshError ?? "";

            // Пока ODBC-запрос идёт, новый цикл не начинаем.
            if (_autoRefresh && !_isRefreshing && (wasRefreshing || snapshotUpdated))
                _nextAutoRefreshAtUtc = DateTimeOffset.UtcNow.AddSeconds(_refreshPeriodSeconds);
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested)
        {
            // Закрытие страницы прекращает WEB-опрос Runtime.
        }
        catch (Exception ex)
        {
            if (from == _from && to == _to)
            {
                _isRefreshing = false;
                _error = $"Cannot load Event Journal: {ex.Message}";
            }
        }
        finally
        {
            _httpLoading = false;

            if (!_stop.IsCancellationRequested)
                await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Во время чтения проверяет его завершение каждые две секунды.
    /// При включённом Switch запускает следующий запрос по интервалу Runtime.
    /// С выключенным Switch и готовым снимком не обращается к Runtime.
    /// </summary>
    private async Task PollAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));

            while (await timer.WaitForNextTickAsync(_stop.Token))
            {
                if (_httpLoading)
                    continue;

                var autoRefreshDue = _autoRefresh && _nextAutoRefreshAtUtc is { } nextRefreshAt
                    && DateTimeOffset.UtcNow >= nextRefreshAt;

                if (!_isRefreshing && !autoRefreshDue)
                    continue;

                await InvokeAsync(async () =>
                {
                    if (_stop.IsCancellationRequested || _httpLoading)
                        return;

                    if (_isRefreshing)
                    {
                        await LoadAsync(false);
                        return;
                    }

                    if (_autoRefresh && _nextAutoRefreshAtUtc is { } nextRefreshAtUtc
                        && DateTimeOffset.UtcNow >= nextRefreshAtUtc)
                    {
                        // Резервируем следующий срок до HTTP-вызова, чтобы ошибка не вызвала частые повторы.
                        _nextAutoRefreshAtUtc = DateTimeOffset.UtcNow.AddSeconds(_refreshPeriodSeconds);
                        await LoadAsync(true);
                    }
                });
            }
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested)
        {
            // Компонент удалён из страницы.
        }
    }

    /// <summary>
    /// Останавливает WEB-опрос Runtime и наблюдение за шириной таблицы.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        _stop.Cancel();

        if (_timelineModule is not null)
        {
            try
            {
                await _timelineModule.InvokeVoidAsync("disconnect", _tableHost);
                await _timelineModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Браузерное соединение уже закрыто.
            }
            catch (OperationCanceledException)
            {
                // JS-вызов отменён при закрытии страницы.
            }
        }

        _timelineSelfReference?.Dispose();

        if (_pollTask is not null)
            await _pollTask;

        _stop.Dispose();
    }

    private sealed record StationCount(string Name, int Count, bool IsAll = false);
    private sealed record EquipmentPrefixCount(string Name, int Count);
    private sealed record EventCategoryOption(string Value, string Text, string Icon);
}