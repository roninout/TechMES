@page "/alarms"
@implements IAsyncDisposable
@inject ActiveAlarmApiClient AlarmApi

<PageTitle>Active alarms</PageTitle>

<div class="active-alarms-page">
    <div class="active-alarms-toolbar">
        <h3>Active alarms</h3>

        <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                      Disabled="@(_httpLoading || _isRefreshing)" Click="@RefreshAsync" />

        <span class="active-alarms-spacer"></span>
        <RadzenBadge Text="@($"Count: {_items.Count}")" BadgeStyle="BadgeStyle.Light" />

        @if (_isRefreshing && _loadedAt is not null)
        {
            <span>Refreshing...</span>
        }

        @if (_loadedAt is not null)
        {
            <span>Loaded: @_loadedAt.Value.ToLocalTime().ToString("HH:mm:ss")</span>
        }
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <RadzenAlert AlertStyle="@(_loadedAt is null ? AlertStyle.Danger : AlertStyle.Warning)" ShowIcon="true">
            @_error
        </RadzenAlert>
    }

    @if (_truncated)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true">
            The alarm list reached the 1000 row limit. Only part of the SCADA alarm summary is shown.
        </RadzenAlert>
    }

    @if (_isRefreshing && _loadedAt is null)
    {
        <TechMesLoadingBar />
    }

    <RadzenDataGrid Data="@_items" TItem="ActiveAlarmDto" AllowFiltering="true"
                    AllowSorting="true" AllowPaging="true" PageSize="30"
                    Density="Density.Compact" class="active-alarms-grid">
        <Columns>
            <RadzenDataGridColumn TItem="ActiveAlarmDto" Property="Tag" Title="Tag" Width="220px" />
            <RadzenDataGridColumn TItem="ActiveAlarmDto" Property="Description" Title="Description" />
            <RadzenDataGridColumn TItem="ActiveAlarmDto" Property="Area" Title="Area" Width="100px" />
            <RadzenDataGridColumn TItem="ActiveAlarmDto" Property="Category" Title="Category" Width="120px" />
            <RadzenDataGridColumn TItem="ActiveAlarmDto" Property="State" Title="State" Width="110px" />
            <RadzenDataGridColumn TItem="ActiveAlarmDto" Property="OnDate" Title="On" Width="170px" />
            <RadzenDataGridColumn TItem="ActiveAlarmDto" Property="AckDate" Title="Acknowledged" Width="170px" />
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    private readonly CancellationTokenSource _stop = new();
    private List<ActiveAlarmDto> _items = [];
    private DateTimeOffset? _loadedAt;
    private bool _httpLoading;
    private bool _isRefreshing;
    private bool _truncated;
    private string _error = "";
    private long _version;

    /// <summary>
    /// Получает состояние кэша при открытии и запускает лёгкий опрос Runtime.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(forceRefresh: false);
        _ = PollAsync();
    }

    /// <summary>
    /// Кнопка просит Runtime начать новый опрос CtApi. Текущий список остаётся видимым.
    /// </summary>
    private Task RefreshAsync()
    {
        return LoadAsync(forceRefresh: true);
    }

    /// <summary>
    /// Применяет только новый успешный снимок. Ошибка HTTP или CtApi
    /// не стирает ранее показанные аварии.
    /// </summary>
    private async Task LoadAsync(bool forceRefresh)
    {
        if (_httpLoading || _stop.IsCancellationRequested)
            return;

        _httpLoading = true;

        try
        {
            var result = await AlarmApi.GetActiveAsync(forceRefresh, _version, _stop.Token);

            if (!result.NotModified && result.LoadedAtUtc is not null)
            {
                _items = result.Items.ToList();
                _loadedAt = result.LoadedAtUtc;
                _truncated = result.Truncated;
                _version = result.Version;
            }

            _isRefreshing = result.IsRefreshing;
            _error = result.RefreshError ?? "";
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            _isRefreshing = false;

            _error = _loadedAt is null
                ? "Cannot load active alarms from Runtime Service."
                : "Cannot refresh active alarms. Showing the last successful snapshot.";
        }
        finally
        {
            _httpLoading = false;
        }
    }

    /// <summary>
    /// WEB спрашивает состояние кэша каждые 10 секунд. Неизменившийся
    /// список аварий заново по сети не передаётся.
    /// </summary>
    private async Task PollAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));

            while (await timer.WaitForNextTickAsync(_stop.Token))
            {
                await InvokeAsync(async () =>
                {
                    await LoadAsync(forceRefresh: false);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested)
        {
        }
    }

    /// <summary>
    /// Останавливает опрос при уходе со страницы.
    /// </summary>
    public ValueTask DisposeAsync()
    {
        _stop.Cancel();
        _stop.Dispose();
        return ValueTask.CompletedTask;
    }
}