@page "/alarms"
@implements IAsyncDisposable
@inject ActiveAlarmApiClient AlarmApi

<PageTitle>Active alarms</PageTitle>

<div class="active-alarms-page">
    <div class="active-alarms-toolbar">
        <h3>Active alarms</h3>
        <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light" Disabled="@_httpLoading" Click="@RefreshAsync" />

        <span class="active-alarms-spacer"></span>
        <RadzenBadge Text="@($"Count: {_items.Count}")" BadgeStyle="BadgeStyle.Light" />

        @if (_isRefreshing)
        {
            <span class="active-alarms-status">Reading Plant SCADA: @_scannedCount records...</span>
        }
        else if (_loadedAt is not null && _isComplete)
        {
            <span class="active-alarms-status">Updated: @_loadedAt.Value.ToLocalTime().ToString("HH:mm:ss")</span>
        }

        @if (_truncated)
        {
            <span class="active-alarms-status">Limit reached: first @_items.Count records</span>
        }
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="active-alarms-error">@_error</div>
    }

    @if (_isRefreshing)
    {
        <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" class="active-alarms-progress" />
    }

    <RadzenDataGrid Data="@_items" TItem="ActiveAlarmDto" AllowFiltering="true" AllowSorting="true"
                    AllowPaging="true" PageSize="30" Density="Density.Compact" class="active-alarms-grid">
        <Columns>
            <RadzenDataGridColumn TItem="ActiveAlarmDto" Property="OccurredAt" Title="Occurred" Width="180px" SortOrder="SortOrder.Descending">
                <Template Context="alarm">
                    <span title="@alarm.OccurredAtText">@(alarm.OccurredAt?.ToString("dd.MM.yyyy HH:mm:ss") ?? alarm.OccurredAtText)</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ActiveAlarmDto" Property="Tag" Title="Tag" Width="340px">
                <Template Context="alarm">
                    <span class="active-alarms-tag" title="@alarm.Tag">@alarm.Tag</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ActiveAlarmDto" Property="Description" Title="Description" />
            <RadzenDataGridColumn TItem="ActiveAlarmDto" Property="Area" Title="Area" Width="100px" />
            <RadzenDataGridColumn TItem="ActiveAlarmDto" Property="Category" Title="Category" Width="120px" />
            <RadzenDataGridColumn TItem="ActiveAlarmDto" Property="State" Title="State" Width="190px" />
            <RadzenDataGridColumn TItem="ActiveAlarmDto" Property="AckDate" Title="Acknowledged" Width="170px" />
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    private readonly CancellationTokenSource _stop = new();
    private List<ActiveAlarmDto> _items = [];
    private Task? _pollTask;
    private DateTimeOffset? _loadedAt;
    private bool _httpLoading;
    private bool _isRefreshing;
    private bool _isComplete;
    private bool _truncated;
    private int _scannedCount;
    private string _error = "";
    private long _version;

    /// <summary>
    /// Показывает кэш Runtime сразу и затем наблюдает за фоновым обходом CtApi.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(forceRefresh: false);
        _pollTask = PollAsync();
    }

    /// <summary>
    /// Ручной Refresh запускает обход, если другой ещё не выполняется.
    /// Подпись кнопки не зависит от длительности нативного чтения.
    /// </summary>
    private Task RefreshAsync()
    {
        return LoadAsync(forceRefresh: true);
    }

    /// <summary>
    /// Список обновляется только при новом номере версии. Ошибка сети
    /// сохраняет последний успешно полученный список.
    /// </summary>
    private async Task LoadAsync(bool forceRefresh)
    {
        if (_httpLoading || _stop.IsCancellationRequested)
            return;

        _httpLoading = true;

        try
        {
            var result = await AlarmApi.GetActiveAsync(forceRefresh, _version, _stop.Token);

            if (!result.NotModified && result.LoadedAtUtc is not null)
            {
                _items = result.Items.ToList();
                _loadedAt = result.LoadedAtUtc;
                _version = result.Version;
            }

            _isRefreshing = result.IsRefreshing;
            _isComplete = result.IsComplete;
            _truncated = result.Truncated;
            _scannedCount = result.ScannedCount;
            _error = result.RefreshError ?? "";
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            _isRefreshing = false;
            _error = _loadedAt is null ? "Cannot load active alarms from Runtime Service." : "Cannot refresh active alarms. Showing the last available data.";
        }
        finally
        {
            _httpLoading = false;
        }
    }

    /// <summary>
    /// Во время загрузки быстро обновляет прогресс. Runtime отправляет строки
    /// повторно только при изменении версии снимка.
    /// </summary>
    private async Task PollAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));

            while (await timer.WaitForNextTickAsync(_stop.Token))
            {
                await InvokeAsync(async () =>
                {
                    await LoadAsync(forceRefresh: false);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested)
        {
        }
    }

    /// <summary>
    /// Останавливает опрос до освобождения его CancellationTokenSource.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        _stop.Cancel();

        if (_pollTask is not null)
            await _pollTask;

        _stop.Dispose();
    }
}