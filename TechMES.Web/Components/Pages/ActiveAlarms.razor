@page "/alarms"
@implements IAsyncDisposable
@inject ActiveAlarmApiClient AlarmApi
@inject NavigationManager Navigation

<PageTitle>Active alarms</PageTitle>

<div class="active-alarms-page">

    <div class="active-alarms-toolbar">

        <div class="active-alarms-toolbar-left">
            <RadzenSelectBar TValue="string" Value="@("active")" ValueChanged="@OnAlarmViewChanged" AriaLabel="Alarm view">
                <Items>
                    <RadzenSelectBarItem Text=" Active alarms" Value="@("active")" Icon="notifications_active" />
                    <RadzenSelectBarItem Text=" Alarm history" Value="@("history")" Icon="history" />
                </Items>
            </RadzenSelectBar>
        </div>

        <h2 class="active-alarms-toolbar-title">Active alarms</h2>

        <div class="active-alarms-toolbar-right">
            @if (_isRefreshing)
            {
                <span class="active-alarms-spinner" title="Reading active alarms from SCADA" aria-label="Reading active alarms from SCADA">
                    <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" Style="width: 24px; height: 24px;" />
                </span>
            }

            <RadzenBadge Text="@($"Count: {_items.Count}")" BadgeStyle="BadgeStyle.Light" />

            @if (_loadedAt is not null)
            {
                <span class="active-alarms-status">Updated: @_loadedAt.Value.ToLocalTime().ToString("HH:mm:ss")</span>
            }

            @if (_readDurationMs is not null)
            {
                <span class="active-alarms-status">Read: @_readDurationMs ms</span>
            }

            <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light" Disabled="@_httpLoading" Click="@RefreshAsync" />
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="active-alarms-error">@_error</div>
    }

    @if (_stationCounts.Count > 0)
    {
        <div class="active-alarms-chart-shell">
            <div class="active-alarms-charts">

                <div class="active-alarms-column-chart">
                    <h4>Active alarms by station: @(_selectedStation ?? "All")</h4>

                    <RadzenChart Style="height: 320px; width: 100%;" SeriesClick="@OnStationClickAsync">
                        <RadzenColumnSeries Data="@_stationCounts" CategoryProperty="Station" ValueProperty="Height" Title="Alarms" Fills="@StationColumnFills">
                            <ChildContent>
                                @foreach (var station in _stationCounts)
                                {
                                    <RadzenSeriesAnnotation Data="@station" Text="@station.Count.ToString()" Fill="var(--rz-text-color)" OffsetY="-12" />
                                }
                            </ChildContent>

                            <TooltipTemplate Context="station">
                                <div>@station.Station — Alarms: @station.Count</div>
                                @if (station.IsAll)
                                {
                                    <small>Column height matches the busiest station</small>
                                }
                            </TooltipTemplate>
                        </RadzenColumnSeries>

                        <RadzenCategoryAxis />
                        <RadzenValueAxis Min="0" FormatString="{0:0}" />
                        <RadzenLegend Visible="false" />
                    </RadzenChart>
                </div>

                <div class="active-alarms-donut-chart">
                    <h4>Type: @(_selectedStation ?? "All")</h4>

                    @if (_priorityCounts.Any(item => item.Count > 0))
                    {
                        <RadzenChart Style="height: 320px; width: 100%;">
                            <RadzenDonutSeries Data="@_priorityCounts" CategoryProperty="Name" ValueProperty="Count" Fills="@PriorityColors"
                                               FillMode="FillMode.Gradient" SegmentGap="0.5" CornerRadius="2" Radius="108">
                                <ChildContent>
                                    <RadzenSeriesDataLabels Visible="false" />
                                </ChildContent>

                                <TitleTemplate>
                                    <div class="rz-donut-content active-alarms-donut-content">
                                        <span>Total alarms</span>
                                        <strong>@_items.Count.ToString("N0")</strong>
                                    </div>
                                </TitleTemplate>
                            </RadzenDonutSeries>

                            <RadzenLegend Position="LegendPosition.Bottom" />
                        </RadzenChart>
                    }
                    else
                    {
                        <div class="active-alarms-donut-empty">No priority data</div>
                    }
                </div>
            </div>
        </div>
    }

    <RadzenDataGrid @ref="_grid" Data="@_items" TItem="ActiveAlarmDto" AllowFiltering="true" AllowSorting="true"
                    AllowPaging="true" PageSize="30" Density="Density.Compact" class="active-alarms-grid">
        <Columns>
            <RadzenDataGridColumn TItem="ActiveAlarmDto" Width="48px" Title="" Filterable="false" Sortable="false" TextAlign="TextAlign.Center">
                <Template Context="alarm">
                    <span class="@GetPriorityCssClass(alarm)" title="@GetPriorityTitle(alarm.Priority)" aria-label="@GetPriorityTitle(alarm.Priority)">
                        <RadzenIcon Icon="@GetPriorityIcon(alarm.Priority)" />
                    </span>
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ActiveAlarmDto" Property="OccurredAt" Title="Date" Width="180px" SortOrder="SortOrder.Descending">
                <Template Context="alarm">
                    <span title="@alarm.OccurredAtText">@(alarm.OccurredAt?.ToString("dd.MM.yyyy HH:mm:ss") ?? alarm.OccurredAtText)</span>
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ActiveAlarmDto" Property="Tag" Title="Tag" Width="340px">
                <Template Context="alarm">
                    <span class="active-alarms-tag" title="@alarm.Tag">@alarm.Tag</span>
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ActiveAlarmDto" Property="Description" Title="Description" />
            <RadzenDataGridColumn TItem="ActiveAlarmDto" Property="State" Title="State" Width="190px" />
        </Columns>
    </RadzenDataGrid>

</div>

@code {
    private readonly CancellationTokenSource _stop = new();
    private readonly List<ActiveAlarmDto> _allItems = [];

    // Порядок цветов соответствует порядку секторов: Alarm, Warning, Info, System, Unknown.
    private static readonly string[] PriorityColors = ["var(--rz-danger)", "var(--rz-warning)", "var(--rz-info)", "#8b5cf6", "var(--rz-text-secondary-color)"];

    private List<ActiveAlarmDto> _items = [];
    private List<StationAlarmCount> _stationCounts = [];
    // Цвета следуют порядку _stationCounts: All — первая колонка, далее станции.
    private IEnumerable<string> StationColumnFills => _stationCounts.Select(station => station.IsAll ? "var(--rz-base-500)" : "var(--rz-success-darker)");
    private List<PriorityAlarmCount> _priorityCounts = [];
    private string? _selectedStation;

    private RadzenDataGrid<ActiveAlarmDto>? _grid;
    private Task? _pollTask;
    private DateTimeOffset? _loadedAt;
    private bool _httpLoading;
    private bool _isRefreshing;
    private string _error = "";
    private long _version;
    private long? _readDurationMs;
    private long? _refreshDurationMs;

    /// <summary>
    /// Показывает кэш Runtime и начинает наблюдать за фоновым чтением ODBC.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(forceRefresh: false);
        _pollTask = PollAsync();
    }

    /// <summary>
    /// Переключает SelectBar на страницу истории.
    /// Текущая страница сама задаёт выбранное положение переключателя.
    /// </summary>
    private void OnAlarmViewChanged(string value)
    {
        if (value == "history")
            Navigation.NavigateTo("/alarms/history");
    }

    /// <summary>
    /// Ручной Refresh просит Runtime начать обход, если он ещё не выполняется.
    /// </summary>
    private Task RefreshAsync()
    {
        return LoadAsync(forceRefresh: true);
    }

    /// <summary>
    /// Обновляет полный снимок, диаграмму и строки выбранной станции.
    /// Ссылка на Data таблицы остаётся прежней, сохраняя её настройки.
    /// Ошибка сети не удаляет последний полученный список.
    /// </summary>
    private async Task LoadAsync(bool forceRefresh)
    {
        if (_httpLoading || _stop.IsCancellationRequested)
            return;

        _httpLoading = true;

        try
        {
            var result = await AlarmApi.GetActiveAsync(forceRefresh, _version, _stop.Token);

            if (!result.NotModified && result.LoadedAtUtc is not null)
            {
                // Не заменяем Data новым List: Radzen сохраняет фильтры и сортировку.
                _allItems.Clear();
                _allItems.AddRange(result.Items);
                _stationCounts = BuildStationCounts(_allItems);

                // Если на выбранной станции больше нет аварий, возвращаем All.
                if (_selectedStation is not null && !_stationCounts.Any(station => station.Station == _selectedStation))
                    _selectedStation = null;

                ApplyStationSelection();

                _loadedAt = result.LoadedAtUtc;
                _version = result.Version;
                _readDurationMs = result.ReadDurationMs;
                _refreshDurationMs = result.RefreshDurationMs;

                if (_grid is not null)
                    await _grid.Reload();
            }

            _isRefreshing = result.IsRefreshing;
            _error = result.RefreshError ?? "";
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            _isRefreshing = false;
            _error = _loadedAt is null
                ? "Cannot load active alarms from Runtime Service."
                : "Cannot refresh active alarms. Showing the last available data.";
        }
        finally
        {
            _httpLoading = false;
        }
    }

    /// <summary>
    /// При выборе колонки показывает аварии её станции. All снимает выбор станции.
    /// Первую страницу открываем, чтобы после смены станции не остаться на пустой странице.
    /// </summary>
    private async Task OnStationClickAsync(SeriesClickEventArgs args)
    {
        if (args.Data is not StationAlarmCount station)
            return;

        _selectedStation = station.IsAll ? null : station.Station;
        ApplyStationSelection();

        if (_grid is not null)
            await _grid.FirstPage(true);
    }

    /// <summary>
    /// Меняет содержимое таблицы, сохраняя ссылку на список для фильтров Radzen.
    /// Одновременно пересчитывает распределение Priority выбранной станции.
    /// </summary>
    private void ApplyStationSelection()
    {
        _items.Clear();
        _items.AddRange(_selectedStation is null
            ? _allItems
            : _allItems.Where(alarm => string.Equals(GetStation(alarm.Tag), _selectedStation, StringComparison.Ordinal)));

        // Donut использует выбор станции, но не зависит от фильтров колонок таблицы.
        _priorityCounts = BuildPriorityCounts(_items);
    }

    /// <summary>
    /// Считает пять кодов Priority. Коды 0 и 3 относятся к одной группе Info.
    /// Неожиданные значения показываются отдельно, чтобы сумма секторов
    /// всегда совпадала с количеством строк выбранной станции.
    /// </summary>
    private static List<PriorityAlarmCount> BuildPriorityCounts(IEnumerable<ActiveAlarmDto> alarms)
    {
        var counts = new int[5];
        var unknownCount = 0;

        foreach (var alarm in alarms)
        {
            if (alarm.Priority is >= 0 and <= 4)
                counts[alarm.Priority.Value]++;
            else
                unknownCount++;
        }

        var alarmCount = counts[1];
        var warningCount = counts[2];
        var infoCount = counts[0] + counts[3];
        var systemCount = counts[4];

        var result = new List<PriorityAlarmCount>
    {
        new($"Alarm ({alarmCount:N0})", alarmCount),
        new($"Warning ({warningCount:N0})", warningCount),
        new($"Info ({infoCount:N0})", infoCount),
        new($"System ({systemCount:N0})", systemCount)
    };

        if (unknownCount > 0)
            result.Add(new PriorityAlarmCount($"Unknown ({unknownCount:N0})", unknownCount));

        return result;
    }

    /// <summary>
    /// Выбирает цвет по Priority и добавляет мигание для Unacknowledged.
    /// Это правило действует также для System.
    /// </summary>
    private static string GetPriorityCssClass(ActiveAlarmDto alarm)
    {
        var level = alarm.Priority switch
        {
            0 or 3 => "is-info",
            1 => "is-alarm",
            2 => "is-warning",
            4 => "is-system",
            _ => "is-unknown"
        };

        return IsUnacknowledged(alarm)
            ? $"active-alarms-priority {level} is-unacknowledged"
            : $"active-alarms-priority {level}";
    }

    /// <summary>Возвращает иконку для каждого кода Priority.</summary>
    private static string GetPriorityIcon(int? priority) =>
        priority switch
        {
            0 or 3 => "info",
            1 => "error",
            2 => "warning",
            4 => "dns",
            _ => "help_outline"
        };

    /// <summary>Показывает тип аварии в подсказке к иконке.</summary>
    private static string GetPriorityTitle(int? priority) =>
        priority switch
        {
            0 or 3 => "Info",
            1 => "Alarm",
            2 => "Warning",
            4 => "System",
            _ => $"Unknown priority: {priority?.ToString() ?? "NULL"}"
        };

    /// <summary>Читает расшифрованное состояние AlarmDesc, полученное через ODBC.</summary>
    private static bool IsUnacknowledged(ActiveAlarmDto alarm) =>
        alarm.State.Contains("Unacknowledged", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Считает аварии по станциям и добавляет первой колонку All.
    /// Count — фактическое число аварий, Height — высота колонки на диаграмме.
    /// </summary>
    private static List<StationAlarmCount> BuildStationCounts(IReadOnlyCollection<ActiveAlarmDto> alarms)
    {
        var stations = alarms
            .Select(alarm => GetStation(alarm.Tag))
            .Where(station => station is not null)
            .GroupBy(station => station!, StringComparer.Ordinal)
            .Select(group => new StationAlarmCount(group.Key, group.Count(), group.Count()))
            .OrderBy(item => item.Station, StringComparer.Ordinal)
            .ToList();

        if (stations.Count == 0)
            return [];

        var highestStationCount = stations.Max(station => station.Count);
        stations.Insert(0, new StationAlarmCount("All", alarms.Count, highestStationCount, IsAll: true));
        return stations;
    }

    /// <summary>
    /// Из S01.H02.M01.Interlock0 извлекает S01; теги без станции пропускает.
    /// </summary>
    private static string? GetStation(string? tag)
    {
        if (string.IsNullOrWhiteSpace(tag))
            return null;

        var dot = tag.IndexOf('.');
        var station = dot > 0 ? tag[..dot].Trim().ToUpperInvariant() : "";
        return station.Length > 0 ? station : null;
    }

    public sealed record StationAlarmCount(string Station, int Count, int Height, bool IsAll = false);
    public sealed record PriorityAlarmCount(string Name, int Count);

    /// <summary>
    /// Пока страница открыта, опрашивает Runtime каждые три секунды.
    /// Строки повторно передаются только при изменении версии снимка.
    /// </summary>
    private async Task PollAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));

            while (await timer.WaitForNextTickAsync(_stop.Token))
            {
                await InvokeAsync(async () =>
                {
                    await LoadAsync(forceRefresh: false);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested)
        {
        }
    }

    /// <summary>
    /// При уходе со страницы прекращает опрос Runtime.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        _stop.Cancel();

        if (_pollTask is not null)
            await _pollTask;

        _stop.Dispose();
    }
}