    /// <summary>
    /// Ручное обновление runtime-состояний.
    ///
    /// Во время ручного запроса кнопка Refresh временно блокируется,
    /// а после завершения обязательно перерисовывается обратно.
    /// </summary>
    private Task RefreshStatesAsync()
    {
        return RefreshStatesCoreAsync(showError: true,showBusyIndicator: true,CancellationToken.None);
    }

    /// <summary>
    /// Периодически обновляет только calc_job_state.
    ///
    /// Автоматическое обновление не перечитывает конфигурацию jobs,
    /// не затирает несохранённые изменения и не блокирует кнопку Refresh.
    /// </summary>
    private async Task RefreshStatesLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));

        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await RefreshStatesCoreAsync(showError: false,showBusyIndicator: false,ct);
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // Нормальное закрытие страницы.
        }
    }

    /// <summary>
    /// Обновляет сохранённые job-state и heartbeat Calc.Service.
    ///
    /// Конфигурация редактора при этом не перечитывается.
    /// </summary>
    private async Task RefreshStatesCoreAsync(bool showError, bool showBusyIndicator, CancellationToken ct)
    {
        if (_isStateRefreshBusy)
            return;

        _isStateRefreshBusy = true;

        if (showBusyIndicator)
            await InvokeAsync(StateHasChanged);

        try
        {
            var statesTask = CalcApi.GetStatesAsync(ct);
            var serviceStatusTask = CalcApi.GetServiceStatusAsync(ct);

            await Task.WhenAll(statesTask, serviceStatusTask);

            var states = await statesTask;
            var serviceStatus = await serviceStatusTask;

            await InvokeAsync(() =>
            {
                ApplyStates(states);
                _serviceStatus = serviceStatus;
                _isStateRefreshBusy = false;
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // Нормальное закрытие страницы.
        }
        catch (Exception ex)
        {
            if (showError)
                await InvokeAsync(() => ShowError("Cannot refresh calculation diagnostics: " + ex.Message));
        }
        finally
        {
            if (_isStateRefreshBusy)
            {
                _isStateRefreshBusy = false;

                if (showBusyIndicator && !_disposeCts.IsCancellationRequested)
                    await InvokeAsync(StateHasChanged);
            }
        }
    }

    /// <summary>
    /// Заменяет локальный snapshot состояний.
    /// </summary>
    private void ApplyStates(IReadOnlyList<CalcJobStateDto> states)
    {
        _statesByJobId = states.ToDictionary(state => state.JobId);
    }

    private CalcJobStateDto? GetState(long jobId)
    {
        return _statesByJobId.GetValueOrDefault(jobId);
    }

    private string GetStateText(long jobId)
    {
        return GetState(jobId)?.Status.ToString() ?? "Unknown";
    }

    private BadgeStyle GetStateBadgeStyle(long jobId)
    {
        return GetStateBadgeStyle(GetState(jobId)?.Status);
    }

    private static BadgeStyle GetStateBadgeStyle(CalcJobStateStatusDto? status)
    {
        return status switch
        {
            CalcJobStateStatusDto.Success => BadgeStyle.Success,
            CalcJobStateStatusDto.Skipped => BadgeStyle.Warning,
            CalcJobStateStatusDto.Error => BadgeStyle.Danger,
            CalcJobStateStatusDto.Running => BadgeStyle.Info,
            CalcJobStateStatusDto.NeverRun => BadgeStyle.Light,
            _ => BadgeStyle.Light
        };
    }

    /// <summary>
    /// Преобразует сохранённый JSON object в строки диагностической таблицы.
    ///
    /// Определение алгоритма ищется по сохранённому job.
    /// Несохранённая смена Calculation в редакторе не должна менять
    /// единицы измерения уже выполненного Runtime-результата.
    /// </summary>
    private IReadOnlyList<CalcStateValueRow> GetStateValues(long jobId, JsonElement? source, bool outputValues)
    {
        if (!source.HasValue || source.Value.ValueKind != JsonValueKind.Object)
            return Array.Empty<CalcStateValueRow>();

        var storedJob = _jobs.FirstOrDefault(job => job.Id == jobId);
        var definition = FindDefinition(storedJob?.DefinitionCode);
        var result = new List<CalcStateValueRow>();

        foreach (var property in source.Value.EnumerateObject())
        {
            var unit = outputValues
                ? definition?.Outputs.FirstOrDefault(item =>
                    string.Equals(
                        item.Key,
                        property.Name,
                        StringComparison.OrdinalIgnoreCase))?.Unit
                : definition?.Parameters.FirstOrDefault(item =>
                    string.Equals(
                        item.Key,
                        property.Name,
                        StringComparison.OrdinalIgnoreCase))?.Unit;

            result.Add(new CalcStateValueRow
            {
                Key = property.Name,
                Value = FormatJsonValue(property.Value),
                Unit = unit ?? ""
            });
        }

        return result;
    }

    /// <summary>
    /// Форматирует простое JSON-значение без лишних кавычек.
    /// </summary>
    private static string FormatJsonValue(JsonElement value)
    {
        return value.ValueKind switch
        {
            JsonValueKind.String => value.GetString() ?? "",
            JsonValueKind.Number => value.GetRawText(),
            JsonValueKind.True => "true",
            JsonValueKind.False => "false",
            JsonValueKind.Null => "null",
            _ => value.GetRawText()
        };
    }

    private static string FormatDuration(long? durationMs)
    {
        return durationMs.HasValue ? $"{durationMs.Value} ms" : "—";
    }

    private static string FormatDateTime(DateTimeOffset? value)
    {
        return value.HasValue
            ? value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
            : "—";
    }

    private static string FormatDateTime(DateTimeOffset value)
    {
        return value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
    }

    /// <summary>
    /// Останавливает фоновое обновление состояния при уходе со страницы.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        _disposeCts.Cancel();

        if (_stateRefreshTask is not null)
        {
            try
            {
                await _stateRefreshTask;
            }
            catch (OperationCanceledException)
            {
                // Ожидаемая остановка фонового цикла.
            }
        }

        _disposeCts.Dispose();
    }

    private string GetCalcServiceStatusText()
    {
        return _serviceStatus?.Availability == CalcServiceAvailabilityDto.Online ? "ONLINE" : "OFFLINE";
    }

    private BadgeStyle GetCalcServiceBadgeStyle()
    {
        return _serviceStatus?.Availability == CalcServiceAvailabilityDto.Online
            ? BadgeStyle.Success
            : BadgeStyle.Danger;
    }
