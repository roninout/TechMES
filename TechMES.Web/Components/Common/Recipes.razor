@page "/recipes"
@using System.Globalization
@using TechMES.Contracts.Recipes
@using TechMES.Contracts.Param
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Options
@implements IDisposable
@inject RecipeApiClient RecipeApi
@inject ILogger<Recipes> Logger
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IOptions<ParamUiOptions> ParamOptions
@inject NavigationManager Navigation

<PageTitle>Recipes</PageTitle>

<div class="recipes-page">
    <RecipeEditorNavigation View="recipes" FamilyId="@EditorFamilyId" Disabled="@IsBusy" />

    <div class="recipes-toolbar">
        <div class="recipes-selectors">
            <div class="recipes-field">
                <RadzenLabel Text="Unit" Component="recipe-unit" />
                <RadzenDropDown TValue="int?" Name="recipe-unit" Data="@_catalog.Pages" TextProperty="Page" ValueProperty="Id" Value="@_selectedPageId" Change="@OnPageChangedAsync" AllowClear="true" Placeholder="All units" Disabled="@IsBusy" Style="width: 190px;" />
            </div>

            <div class="recipes-field recipes-field-wide">
                <RadzenLabel Text="Recipe" Component="recipe-selection" />
                <RadzenDropDown TValue="int?" Name="recipe-selection" Data="@_availableRecipes" TextProperty="DisplayName" ValueProperty="Id" Value="@_selectedRecipeId" Change="@OnRecipeChangedAsync" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Disabled="@IsBusy" Style="width: 100%;" />
            </div>
        </div>

        <h2 class="recipes-title">Recipes</h2>

        <div class="recipes-toolbar-right">
            <div class="recipes-edit-mode" title="@(_canEdit ? "Edit saved recipe values" : "Sign in to edit recipe values")">
                <RadzenLabel Text="Edit values" Component="recipe-edit-values" />
                <RadzenSwitch Name="recipe-edit-values" @bind-Value="_editValues" Disabled="@(!_canEdit || IsBusy)" />
            </div>

            <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light" Disabled="@IsBusy" Click="@RefreshAsync" />
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">@_error</RadzenAlert>
    }

    <div class="recipes-management">
        <RadzenButton Text="New" Icon="add" ButtonStyle="ButtonStyle.Light" Disabled="@(!_canEdit || IsBusy || NewRecipeSourceId is null)" Click="@(() => ChangeRecipeAsync(RecipeChangeOperation.Create))" />
        <RadzenButton Text="Copy" Icon="content_copy" ButtonStyle="ButtonStyle.Light" Disabled="@(!CanManageRecipe)" Click="@(() => ChangeRecipeAsync(RecipeChangeOperation.Copy))" />
        <RadzenButton Text="Rename" Icon="drive_file_rename_outline" ButtonStyle="ButtonStyle.Light" Disabled="@(!CanManageRecipe)" Click="@(() => ChangeRecipeAsync(RecipeChangeOperation.Rename))" />

        <span class="recipes-management-divider" aria-hidden="true"></span>

        <RadzenButton Text="Add stage" Icon="playlist_add" ButtonStyle="ButtonStyle.Light" Disabled="@(!CanAddStage)" Click="@AddStageAsync" />
        <RadzenButton Text="Up" Icon="arrow_upward" ButtonStyle="ButtonStyle.Light" Disabled="@(!CanMoveStageUp)" Click="@(() => ChangeStageAsync(RecipeStageChangeOperation.MoveUp))" />
        <RadzenButton Text="Down" Icon="arrow_downward" ButtonStyle="ButtonStyle.Light" Disabled="@(!CanMoveStageDown)" Click="@(() => ChangeStageAsync(RecipeStageChangeOperation.MoveDown))" />
        <RadzenButton Text="Delete stage" Icon="delete_outline" ButtonStyle="ButtonStyle.Danger" Disabled="@(!CanChangeStage)" Click="@(() => ChangeStageAsync(RecipeStageChangeOperation.Delete))" />
    </div>

    <RadzenCard class="recipes-card">
        <div class="recipes-heading">
            <span class="recipes-name">@(_snapshot?.Recipe.DisplayName ?? "Select a recipe")</span>

            @if (_snapshot is not null)
            {
                <RadzenBadge Text="@($"Stages: {Stages.Count}")" BadgeStyle="BadgeStyle.Light" />

                @if (SelectedPage?.RecipeId == _snapshot.Recipe.Id)
                {
                    <RadzenBadge Text="Current" BadgeStyle="BadgeStyle.Success" />
                }
            }
        </div>

        <RadzenDataGrid @key="_snapshot" Data="@Stages" TItem="RecipeStageDto" @bind-Value="_selectedStages" SelectionMode="DataGridSelectionMode.Single" AllowRowSelectOnRowClick="@(!IsBusy)" AllowSorting="false" AllowFiltering="false" AllowPaging="false" AllowColumnResize="true" IsLoading="@_loading" ShowEmptyMessage="@(!_loading)" EmptyText="No recipe stages to display." Density="Density.Compact" class="recipes-grid">
            <LoadingTemplate>
                <JournalGridLoading />
            </LoadingTemplate>

            <Columns>
                <RadzenDataGridColumn TItem="RecipeStageDto" Property="Number" Title="№" Width="60px" Frozen="true" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn TItem="RecipeStageDto" Property="Name" Title="Stage" Width="280px" Frozen="true" />

                @* Auto отображается только как параметр шаблона вместе с остальными параметрами. *@
                @foreach (var column in Columns)
                {
                    <RadzenDataGridColumn @key="column.Id" TItem="RecipeStageDto" Title="@column.Name" Width="@(column.Kind == RecipeParameterKind.CheckBox ? "80px" : "120px")" TextAlign="TextAlign.Center">
                        <HeaderTemplate>
                            <div class="recipes-column-heading" title="@column.TagSuffix">
                                <span>@column.Name</span>
                                <small>@column.Description.Replace("\\n", "\n", StringComparison.Ordinal)</small>
                            </div>
                        </HeaderTemplate>

                        <Template Context="stage">
                            @if (stage.Parameters.TryGetValue(column.Id, out var parameter))
                            {
                                <button type="button" class="recipes-value" disabled="@(!_editValues || !_canEdit || IsBusy)" title="@(_editValues ? "Edit saved value" : "Enable Edit values to change this parameter")" @onclick="@(() => EditParameterAsync(stage, column))">
                                    @if (column.Kind == RecipeParameterKind.CheckBox)
                                    {
                                        var isChecked = parameter.Value != 0;

                                        <span role="img" aria-label="@(isChecked ? "On" : "Off")" title="@(isChecked ? "On" : "Off")" class="@(isChecked ? "recipes-check is-on" : "recipes-check")">
                                            <RadzenIcon Icon="@(isChecked ? "check_box" : "check_box_outline_blank")" />
                                        </span>
                                    }
                                    else
                                    {
                                        <span>@FormatValue(parameter.Value, column.Format)</span>
                                    }
                                </button>
                            }
                            else
                            {
                                <span class="recipes-empty-cell" title="Not used in this stage">—</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGrid>

    </RadzenCard>
</div>

@code {
    private readonly CancellationTokenSource _stop = new();
    private RecipeCatalogDto _catalog = new();
    private List<RecipeListItemDto> _availableRecipes = [];
    private RecipeSnapshotDto? _snapshot;
    private int? _selectedPageId;
    private int? _selectedRecipeId;
    private bool _catalogLoaded;
    private bool _loading;
    private bool _editingValue;
    private bool _dialogOpen;
    private bool _editValues;
    private bool _canEdit;
    private bool _disposed;
    private string? _error;

    private bool IsBusy => _loading || _editingValue || _managingRecipe || _changingStage;
    private RecipePageDto? SelectedPage => _catalog.Pages.FirstOrDefault(page => page.Id == _selectedPageId);
    private IReadOnlyList<RecipeStageDto> Stages => _snapshot?.Stages ?? [];
    private IReadOnlyList<RecipeColumnDto> Columns => _snapshot?.Columns ?? [];

    /// <summary>
    /// Определяет режим пользователя и получает первый рецепт.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (_disposed)
            return;

        _canEdit = state.User.Identity?.IsAuthenticated == true;
        await RefreshAsync();
    }

    /// <summary>
    /// Перечитывает каталог и рецепт, сохраняя существующий выбор пользователя.
    /// </summary>
    private Task RefreshAsync()
    {
        return RunAsync(ct => ReloadCatalogAndRecipeAsync(_selectedRecipeId, ct));
    }

    /// <summary>
    /// Смена объекта выбирает назначенный ему рецепт.
    /// Очистка Unit показывает весь каталог.
    /// </summary>
    private Task OnPageChangedAsync(object? value)
    {
        return RunAsync(async ct =>
        {
            _selectedPageId = value is int id ? id : null;

            SelectAvailableRecipes(null);
            await LoadSelectedRecipeAsync(ct);
        });
    }

    /// <summary>
    /// Читает только выбранный рецепт, не загружая каталог повторно.
    /// </summary>
    private Task OnRecipeChangedAsync(object? value)
    {
        return RunAsync(async ct =>
        {
            _selectedRecipeId = value is int id ? id : null;
            await LoadSelectedRecipeAsync(ct);
        });
    }

    /// <summary>
    /// Сохраняет отбор старого UI по базовому рецепту и имени страницы.
    /// Назначенный объекту текущий рецепт доступен всегда.
    /// </summary>
    private void SelectAvailableRecipes(int? preferredRecipeId)
    {
        var page = SelectedPage;

        _availableRecipes = page is null ? _catalog.Recipes.ToList() : _catalog.Recipes.Where(recipe =>
            recipe.Id == page.RecipeId || (recipe.Id != page.BaseRecipeId && recipe.BaseRecipeId == page.BaseRecipeId && recipe.Name.Contains(page.Page, StringComparison.OrdinalIgnoreCase))).ToList();

        if (preferredRecipeId.HasValue && _availableRecipes.Any(recipe => recipe.Id == preferredRecipeId))
        {
            _selectedRecipeId = preferredRecipeId;
            return;
        }

        _selectedRecipeId = page is not null && _availableRecipes.Any(recipe => recipe.Id == page.RecipeId) ? page.RecipeId : _availableRecipes.FirstOrDefault()?.Id;
    }

    /// <summary>
    /// Читает рецепт и восстанавливает выбранную стадию только в пределах этого рецепта.
    /// Отменённый ответ не заменяет данные после ухода со страницы.
    /// </summary>
    private async Task LoadSelectedRecipeAsync(CancellationToken ct)
    {
        if (_selectedRecipeId is not int recipeId)
        {
            RestoreStageSelection(null);
            return;
        }

        var selectedStageId = _stageSelectionRecipeId == recipeId ? _selectedStages.FirstOrDefault()?.Id : null;

        var snapshot = await RecipeApi.GetAsync(recipeId, ct);
        ct.ThrowIfCancellationRequested();

        _snapshot = snapshot;
        RestoreStageSelection(selectedStageId);
    }

    /// <summary>
    /// Не допускает параллельных загрузок и управляет индикатором ожидания.
    /// </summary>
    private async Task RunAsync(Func<CancellationToken, Task> load)
    {
        if (IsBusy || _disposed)
            return;

        var ct = _stop.Token;

        _loading = true;
        _error = null;
        _snapshot = null;

        try
        {
            await load(ct);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // Навигация со страницы отменяет незавершённые HTTP-запросы.
        }
        catch (Exception ex)
        {
            if (!_disposed)
            {
                Logger.LogError(ex, "Failed to load recipes.");
                _error = ex.Message;
            }
        }
        finally
        {
            if (!_disposed)
                _loading = false;
        }
    }

    /// <summary>
    /// Использует существующий ParamWriteDialog для числа или checkbox.
    /// После успешного сохранения обновляет одну ячейку без пересоздания таблицы.
    /// </summary>
    private async Task EditParameterAsync(RecipeStageDto stage, RecipeColumnDto column)
    {
        if (IsBusy || _disposed || !_canEdit || !_editValues || _snapshot is null || !stage.Parameters.TryGetValue(column.Id, out var parameter))
            return;

        var recipeId = _snapshot.Recipe.Id;
        var expectedValue = parameter.Value;
        var ct = _stop.Token;

        _editingValue = true;
        _error = null;

        try
        {
            var item = new ParamItemDto
            {
                Name = column.Name,
                Kind = column.Kind == RecipeParameterKind.CheckBox ? ParamValueKind.Boolean : ParamValueKind.Number,
                ValueText = FormatValue(expectedValue, column.Format),
                NumericValue = expectedValue,
                BooleanValue = column.Kind == RecipeParameterKind.CheckBox ? expectedValue != 0 : null,
                Unit = column.Description,
                CanWrite = true
            };

            var parameters = new Dictionary<string, object?> { [nameof(ParamWriteDialog.Item)] = item };

            if (column.Kind == RecipeParameterKind.CheckBox)
                parameters[nameof(ParamWriteDialog.InitialBooleanValue)] = expectedValue == 0;

            _dialogOpen = true;

            var dialogResult = await DialogService.OpenAsync<ParamWriteDialog>($"Recipe value: {column.Name}", parameters, new DialogOptions { Width = "420px", CloseDialogOnOverlayClick = false, CloseDialogOnEsc = true });

            _dialogOpen = false;
            ct.ThrowIfCancellationRequested();

            if (dialogResult is not ParamWriteDialogResult write)
                return;

            if (!double.TryParse(write.Value, NumberStyles.Float, CultureInfo.InvariantCulture, out var value) || !double.IsFinite(value))
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Recipe", "Enter a valid number.", 3500);
                return;
            }

            if (value == expectedValue)
                return;

            if (ParamOptions.Value.ConfirmWrites)
            {
                _dialogOpen = true;

                var confirmed = await DialogService.Confirm($"Save recipe value to database?\n\nStage: {stage.Number}. {stage.Name}\nParameter: {column.Name}\nCurrent: {FormatValue(expectedValue, column.Format)}\nNew: {FormatValue(value, column.Format)}", "Confirm recipe change", new ConfirmOptions { OkButtonText = "Save", CancelButtonText = "Cancel" });

                _dialogOpen = false;
                ct.ThrowIfCancellationRequested();

                if (confirmed != true)
                    return;
            }

            var result = await RecipeApi.SaveParameterAsync(recipeId, new RecipeParameterSaveRequest
            {
                ParameterId = parameter.Id,
                StageId = stage.Id,
                BaseParameterId = column.Id,
                ExpectedValue = expectedValue,
                Value = value
            }, ct);

            ct.ThrowIfCancellationRequested();

            if (result.Status != RecipeParameterSaveStatus.Saved || result.Value is not double savedValue)
                throw new InvalidOperationException("Unexpected recipe save response. Refresh the recipe to verify the value.");

            parameter.Value = savedValue;

            NotificationService.Notify(NotificationSeverity.Success, "Recipe", "Value saved to database.", 2500);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // Пользователь покинул страницу.
        }
        catch (Exception ex)
        {
            if (!_disposed)
            {
                Logger.LogError(ex, "Failed to save recipe {RecipeId}, parameter {ParameterId}.", recipeId, parameter.Id);

                _error = ex is HttpRequestException { StatusCode: not null } ? ex.Message : "Save result could not be confirmed. Refresh the recipe. " + ex.Message;
            }
        }
        finally
        {
            _dialogOpen = false;
            _editingValue = false;
        }
    }

    /// <summary>
    /// Сохраняет точность N1–N4; разделители тысяч не добавляются.
    /// </summary>
    private static string FormatValue(double value, RecipeParameterFormat format)
    {
        var digits = (int)format;
        return value.ToString(digits is >= 1 and <= 4 ? $"F{digits}" : "G", CultureInfo.CurrentCulture);
    }

    /// <summary>
    /// При уходе отменяет запросы и закрывает принадлежащий странице диалог.
    /// </summary>
    public void Dispose()
    {
        _disposed = true;
        _stop.Cancel();

        if (_dialogOpen)
            DialogService.Close();

        _stop.Dispose();
    }
}