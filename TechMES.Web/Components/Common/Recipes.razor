@page "/recipes"
@using System.Globalization
@using Microsoft.AspNetCore.Components.Routing
@using TechMES.Contracts.Recipes
@using TechMES.Contracts.Param
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject RecipeApiClient RecipeApi
@inject ILogger<Recipes> Logger
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>@(EditorMode ? "Recipe editor" : "Recipes")</PageTitle>
<NavigationLock ConfirmExternalNavigation="@HasRecipeChanges" OnBeforeInternalNavigation="@BeforeRecipeNavigationAsync" />

<div class="recipes-page @(EditorMode ? "recipes-editor" : "recipes-view")">
    @if (EditorMode)
    {
        <RecipeEditorHeader Title="Recipe editor">
            <Left>
                <RecipeEditorNavigation View="recipes" FamilyId="@EditorFamilyId" Disabled="@(IsBusy || _dialogOpen)" Back="@OpenRecipes" />
            </Left>
            <Right>
                <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light" Disabled="@(IsBusy || _dialogOpen)" Click="@RefreshAsync" />
                <RadzenButton Text="Save" Icon="save" IsBusy="@_savingDraft" BusyText="Saving..." Disabled="@(!CanSaveRecipe)" Click="@SaveRecipeAsync" />
            </Right>
        </RecipeEditorHeader>
    }
    else
    {
        <div class="recipes-toolbar">
            <div class="recipes-selectors">
                <div class="recipes-field">
                    <RadzenLabel Text="Unit" Component="recipe-unit" />
                    <RadzenDropDown @key="_selectorRevision" TValue="int?" Name="recipe-unit" Data="@_catalog.Pages" TextProperty="Page" ValueProperty="Id" Value="@_selectedPageId" Change="@OnPageChangedAsync" AllowClear="true" Placeholder="All units" Disabled="@(IsBusy || _dialogOpen)" Style="width: 190px;" />
                </div>
                <div class="recipes-field recipes-field-wide">
                    <RadzenLabel Text="Recipe" Component="recipe-selection" />
                    <RadzenDropDown @key="_selectorRevision" TValue="int?" Name="recipe-selection" Data="@_availableRecipes" TextProperty="DisplayName" ValueProperty="Id" Value="@_selectedRecipeId" Change="@OnRecipeChangedAsync" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Disabled="@(IsBusy || _dialogOpen)" Style="width: 100%;" />
                </div>
            </div>

            <h2 class="recipes-title">Recipes</h2>

            <div class="recipes-toolbar-right">
                <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light" Disabled="@IsBusy" Click="@RefreshAsync" />
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">@_error</RadzenAlert>
    }

    <div class="recipes-workspace @(EditorMode ? "recipes-workspace-editor" : "")">
        @if (EditorMode)
        {
            <aside class="recipes-template-list" aria-label="Stage templates">
                <RadzenTextBox @bind-Value="_templateSearch" Immediate="true" Placeholder="Search stages..." Style="width: 100%;" AriaLabel="Search stage templates" />

                <div class="recipes-template-cards">
                    @foreach (var template in FilteredStageTemplates)
                    {
                        <div @key="template.Id" class="recipes-template-item" draggable="@(CanAddStage ? "true" : "false")" @ondragstart="@(() => BeginTemplateDrag(template.Id))" @ondragend="@ClearStageDrag">
                            <RadzenCard class="recipes-template-card">
                                <RadzenIcon Icon="view_agenda" class="recipes-template-icon" />

                                <div class="recipes-template-text">
                                    <strong>@template.Code</strong>
                                    <small>@template.Name</small>
                                </div>

                                <RadzenBadge Text="@template.ParameterCount.ToString()" BadgeStyle="BadgeStyle.Light" />

                                @if (IsStageTemplateUsed(template.Id))
                                {
                                    <span class="recipes-template-used" title="Used in this recipe" aria-label="Used in this recipe">
                                        <RadzenIcon Icon="check_circle" />
                                    </span>
                                }
                            </RadzenCard>
                        </div>
                    }

                    @if (!FilteredStageTemplates.Any())
                    {
                        <small class="recipes-template-empty">@(_stageTemplates.Templates.Count == 0 ? "No stage templates in this family." : "No stages match the search.")</small>
                    }
                </div>
            </aside>
        }

        <RadzenCard class="recipes-card">
            @if (EditorMode)
            {
                <div class="recipes-card-toolbar">
                    <div class="recipes-selectors">
                        <div class="recipes-field">
                            <RadzenLabel Text="Unit" Component="recipe-unit" />
                            <RadzenDropDown @key="_selectorRevision" TValue="int?" Name="recipe-unit" Data="@_catalog.Pages" TextProperty="Page" ValueProperty="Id" Value="@_selectedPageId" Change="@OnPageChangedAsync" AllowClear="true" Placeholder="All units" Disabled="@(IsBusy || _dialogOpen)" Style="width: 190px;" />
                        </div>
                        <div class="recipes-field recipes-field-wide">
                            <RadzenLabel Text="Recipe" Component="recipe-selection" />
                            <RadzenDropDown @key="_selectorRevision" TValue="int?" Name="recipe-selection" Data="@_availableRecipes" TextProperty="DisplayName" ValueProperty="Id" Value="@_selectedRecipeId" Change="@OnRecipeChangedAsync" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Disabled="@(IsBusy || _dialogOpen)" Style="width: 100%;" />
                        </div>
                    </div>

                    <div class="recipes-management">
                        <RadzenButton Text="New" Icon="add" ButtonStyle="ButtonStyle.Light" Disabled="@(!_canEdit || IsBusy || _dialogOpen || _uncertainDraft || NewRecipeSourceId is null)" Click="@(() => ChangeRecipeAsync(RecipeChangeOperation.Create))" />
                        <RadzenButton Text="Copy" Icon="content_copy" ButtonStyle="ButtonStyle.Light" Disabled="@(!CanManageRecipe)" Click="@(() => ChangeRecipeAsync(RecipeChangeOperation.Copy))" />
                        <RadzenButton Text="Rename" Icon="drive_file_rename_outline" ButtonStyle="ButtonStyle.Light" Disabled="@(!CanManageRecipe)" Click="@(() => ChangeRecipeAsync(RecipeChangeOperation.Rename))" />
                    </div>
                </div>
            }

            <div class="recipes-heading">
                <span class="recipes-name">@(_snapshot?.Recipe.DisplayName ?? "Select a recipe")</span>

                @if (_snapshot is not null)
                {
                    <RadzenBadge Text="@($"Stages: {Stages.Count}")" BadgeStyle="BadgeStyle.Light" />

                    @if (SelectedPage?.RecipeId == _snapshot.Recipe.Id)
                    {
                        <RadzenBadge Text="Current" BadgeStyle="BadgeStyle.Success" />
                    }
                }

                @if (!EditorMode)
                {
                    <div class="recipes-open-editor">
                        <RadzenButton Text="Edit recipes" Icon="edit_note" ButtonStyle="ButtonStyle.Light" Disabled="@IsBusy" Click="@OpenEditor" />
                    </div>
                }
            </div>

            <div class="recipes-grid-host" @ondragover:preventDefault="@(EditorMode && CanAddStage)" @ondrop="@DropStageAtEndAsync">
                <RadzenDataGrid RowRender="@RenderStageRow" @key="_snapshot" Data="@Stages" TItem="RecipeStageDto" @bind-Value="_selectedStages" SelectionMode="DataGridSelectionMode.Single" AllowRowSelectOnRowClick="@(!IsBusy)" AllowSorting="false" AllowFiltering="false" AllowPaging="false" AllowColumnResize="true" IsLoading="@_loading" ShowEmptyMessage="@(!_loading)" EmptyText="No recipe stages to display." Density="Density.Compact" class="recipes-grid">
                    <LoadingTemplate>
                        <JournalGridLoading />
                    </LoadingTemplate>

                    <Columns>
                        <RadzenDataGridColumn TItem="RecipeStageDto" Property="Number" Title="№" Width="60px" Frozen="true" TextAlign="TextAlign.Center" />

                        <RadzenDataGridColumn TItem="RecipeStageDto" Property="Name" Title="@(EditorMode && _showStageTags ? "PLC tag prefix" : "Stage")" Width="280px" Frozen="true">
                            <Template Context="stage">
                                <div class="recipes-stage-label" title="@stage.Name">
                                    @if (EditorMode && string.IsNullOrWhiteSpace(stage.TagPrefix))
                                    {
                                        <span class="recipes-prefix-warning" title="PLC tag prefix is not assigned." aria-label="PLC tag prefix is not assigned.">
                                            <RadzenIcon Icon="warning_amber" />
                                        </span>
                                    }

                                    <span>@(EditorMode && _showStageTags ? string.IsNullOrWhiteSpace(stage.TagPrefix) ? "Not assigned" : stage.TagPrefix : stage.Name)</span>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        @* Auto остаётся обычным параметром шаблона. *@
                        @foreach (var column in Columns)
                        {
                            <RadzenDataGridColumn @key="column.Id" TItem="RecipeStageDto" Title="@column.Name" Width="@(column.Kind == RecipeParameterKind.CheckBox ? "80px" : "120px")" TextAlign="TextAlign.Center">
                                <HeaderTemplate>
                                    <div class="recipes-column-heading" title="@column.TagSuffix">
                                        <span>@column.Name</span>
                                        <small>@column.Description.Replace("\\n", "\n", StringComparison.Ordinal)</small>
                                    </div>
                                </HeaderTemplate>

                                <Template Context="stage">
                                    @if (stage.Parameters.TryGetValue(column.Id, out var parameter))
                                    {
                                        <button type="button" class="recipes-value" disabled="@(!CanAddStage)" title="@(EditorMode ? "Edit recipe value" : "Saved recipe value")" @onclick="@(() => EditParameterAsync(stage, column))">
                                            @if (column.Kind == RecipeParameterKind.CheckBox)
                                            {
                                                var isChecked = parameter.Value != 0;

                                                <span role="img" aria-label="@(isChecked ? "On" : "Off")" title="@(isChecked ? "On" : "Off")" class="@(isChecked ? "recipes-check is-on" : "recipes-check")">
                                                    <RadzenIcon Icon="@(isChecked ? "check_box" : "check_box_outline_blank")" />
                                                </span>
                                            }
                                            else
                                            {
                                                <span>@FormatValue(parameter.Value, column.Format)</span>
                                            }
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="recipes-empty-cell" title="Not used in this stage">—</span>
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                        }

                        @if (EditorMode)
                        {
                            <RadzenDataGridColumn TItem="RecipeStageDto" Width="72px" MaxWidth="72px" Sortable="false" Filterable="false" Resizable="false" TextAlign="TextAlign.Center">
                                <Template Context="stage">
                                    <div class="recipes-delete-action" @onclick:stopPropagation="true">
                                        <RadzenButton Icon="delete_outline" ButtonStyle="ButtonStyle.Danger" Shade="Shade.Lighter" Variant="Variant.Flat" Size="ButtonSize.Small" class="recipes-delete-button" Disabled="@(!CanAddStage)" Click="@(() => ChangeStageAsync(RecipeStageChangeOperation.Delete, stage))" aria-label="Delete stage" title="Delete stage" />
                                    </div>
                                </Template>
                            </RadzenDataGridColumn>
                        }
                    </Columns>
                </RadzenDataGrid>

                @if (EditorMode)
                {
                    <div class="recipes-drop-end @(_dropAtEnd ? "recipes-drop-end-active" : "")" @ondragenter="@MarkStageDropEnd">
                        <span>Drop a stage here to append</span>

                        <div class="recipes-tag-switch">
                            <RadzenLabel Text="PLC tag prefix" Component="recipe-show-stage-tags" />
                            <RadzenSwitch Name="recipe-show-stage-tags" @bind-Value="_showStageTags" Disabled="@IsBusy" />
                        </div>
                    </div>
                }
            </div>
        </RadzenCard>
    </div>
</div>

@code {
    private readonly CancellationTokenSource _stop = new();
    private RecipeCatalogDto _catalog = new();
    private List<RecipeListItemDto> _availableRecipes = [];
    private RecipeSnapshotDto? _snapshot;
    private int? _selectedPageId;
    private int? _selectedRecipeId;
    private bool _catalogLoaded;
    private bool _loading;
    private bool _editingValue;
    private bool _dialogOpen;
    private bool _canEdit;
    private bool _disposed;
    private string? _error;

    private bool IsBusy => _loading || _editingValue || _managingRecipe || _changingStage || _savingDraft;
    private RecipePageDto? SelectedPage => _catalog.Pages.FirstOrDefault(page => page.Id == _selectedPageId);
    private IReadOnlyList<RecipeStageDto> Stages => _snapshot?.Stages ?? [];
    private IReadOnlyList<RecipeColumnDto> Columns => _snapshot?.Columns ?? [];

    /// <summary>Определяет пользователя и загружает первый рецепт.</summary>
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (_disposed) return;

        _canEdit = EditorMode && state.User.Identity?.IsAuthenticated == true;

        await RefreshAsync();
    }

    /// <summary>Перечитывает данные после подтверждения отказа от черновика.</summary>
    private async Task RefreshAsync()
    {
        if (IsBusy || _dialogOpen || !await DiscardRecipeAsync()) return;

        await RunAsync(ct => ReloadCatalogAndRecipeAsync(_selectedRecipeId, ct));
    }

    /// <summary>Меняет Unit после проверки несохранённых изменений.</summary>
    private async Task OnPageChangedAsync(object? value)
    {
        var id = value is int number ? number : (int?)null;

        if (id == _selectedPageId || IsBusy || _dialogOpen) return;
        if (!await DiscardRecipeAsync()) { _selectorRevision++; return; }

        await RunAsync(async ct => { _selectedPageId = id; SelectAvailableRecipes(null); await LoadSelectedRecipeAsync(ct); });
    }

    /// <summary>Предупреждает о черновике при выборе другого рецепта.</summary>
    private async Task OnRecipeChangedAsync(object? value)
    {
        var id = value is int number ? number : (int?)null;

        if (id == _selectedRecipeId || IsBusy || _dialogOpen) return;
        if (!await DiscardRecipeAsync()) { _selectorRevision++; return; }

        await RunAsync(async ct => { _selectedRecipeId = id; await LoadSelectedRecipeAsync(ct); });
    }

    /// <summary>Сохраняет прежний отбор по семейству и имени Unit.</summary>
    private void SelectAvailableRecipes(int? preferredRecipeId)
    {
        var page = SelectedPage;

        _availableRecipes = page is null ? _catalog.Recipes.ToList() : _catalog.Recipes.Where(recipe =>
            recipe.Id == page.RecipeId || (recipe.Id != page.BaseRecipeId && recipe.BaseRecipeId == page.BaseRecipeId && recipe.Name.Contains(page.Page, StringComparison.OrdinalIgnoreCase))).ToList();

        if (preferredRecipeId.HasValue && _availableRecipes.Any(recipe => recipe.Id == preferredRecipeId))
        {
            _selectedRecipeId = preferredRecipeId;
            return;
        }

        _selectedRecipeId = page is not null && _availableRecipes.Any(recipe => recipe.Id == page.RecipeId) ? page.RecipeId : _availableRecipes.FirstOrDefault()?.Id;
    }

    /// <summary>Загружает снимок, шаблоны и метаданные локального редактора.</summary>
    private async Task LoadSelectedRecipeAsync(CancellationToken ct)
    {
        ClearStageDrag();

        if (_selectedRecipeId is not int recipeId)
        {
            _snapshot = _savedSnapshot = null;
            _hasRecipeChanges = false;
            _stageTemplates = new();
            _stageDefinitions = [];

            RestoreStageSelection(null);
            return;
        }

        var selectedStageId = _stageSelectionRecipeId == recipeId ? _selectedStages.FirstOrDefault()?.Id : null;
        var snapshot = await RecipeApi.GetAsync(recipeId, ct);
        var templates = EditorMode ? await RecipeApi.GetStageTemplatesAsync(recipeId, ct) : new RecipeStageTemplateCatalogDto();
        var parameters = EditorMode ? await RecipeApi.GetBaseParametersAsync(ct) : new RecipeBaseParameterCatalogDto();
        var definitions = EditorMode ? await RecipeApi.GetBaseStagesAsync(templates.BaseRecipeId, ct) : new List<RecipeBaseStageDto>();

        ct.ThrowIfCancellationRequested();

        _snapshot = snapshot;
        _savedSnapshot = CloneRecipe(snapshot);
        _savedRecipeStamp = System.Text.Json.JsonSerializer.Serialize(_savedSnapshot);
        _hasRecipeChanges = false;
        _stageTemplates = templates;
        _parameterCatalog = parameters;
        _stageDefinitions = definitions;
        _nextDraftStageId = -1;
        _uncertainDraft = false;

        RestoreStageSelection(selectedStageId);
    }

    /// <summary>Не допускает параллельных загрузок и управляет индикатором.</summary>
    private async Task RunAsync(Func<CancellationToken, Task> load)
    {
        if (IsBusy || _disposed) return;

        var ct = _stop.Token;

        _loading = true;
        _error = null;
        _snapshot = null;

        try
        {
            await load(ct);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            if (!_disposed)
            {
                Logger.LogError(ex, "Failed to load recipes.");
                _error = ex.Message;
            }
        }
        finally
        {
            if (!_disposed) _loading = false;
        }
    }

    /// <summary>Общий ParamWriteDialog изменяет значение только в черновике.</summary>
    private async Task EditParameterAsync(RecipeStageDto stage, RecipeColumnDto column)
    {
        if (!CanAddStage || _disposed || _snapshot is null || !stage.Parameters.TryGetValue(column.Id, out var parameter)) return;

        var ct = _stop.Token;

        _editingValue = true;
        _dialogOpen = true;

        try
        {
            var item = new ParamItemDto { Name = column.Name, Kind = column.Kind == RecipeParameterKind.CheckBox ? ParamValueKind.Boolean : ParamValueKind.Number, ValueText = FormatValue(parameter.Value, column.Format), NumericValue = parameter.Value, BooleanValue = column.Kind == RecipeParameterKind.CheckBox ? parameter.Value != 0 : null, Unit = column.Description, CanWrite = true };
            var parameters = new Dictionary<string, object?> { [nameof(ParamWriteDialog.Item)] = item };

            if (column.Kind == RecipeParameterKind.CheckBox)
                parameters[nameof(ParamWriteDialog.InitialBooleanValue)] = parameter.Value == 0;

            var input = await DialogService.OpenAsync<ParamWriteDialog>($"Recipe value: {column.Name}", parameters, new DialogOptions { Width = "420px", CloseDialogOnOverlayClick = false, CloseDialogOnEsc = true });

            ct.ThrowIfCancellationRequested();

            if (input is not ParamWriteDialogResult write) return;

            if (!double.TryParse(write.Value, NumberStyles.Float, CultureInfo.InvariantCulture, out var value) || !double.IsFinite(value) || (column.Kind == RecipeParameterKind.CheckBox && value != 0 && value != 1))
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Recipe", "Enter a valid value.", 3500);
                return;
            }

            parameter.Value = value;
            MarkRecipeChanges();
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            if (!_disposed) _error = ex.Message;
        }
        finally
        {
            _dialogOpen = false;
            _editingValue = false;
        }
    }

    /// <summary>Сохраняет точность без разделителей тысяч.</summary>
    private static string FormatValue(double value, RecipeParameterFormat format)
    {
        var digits = (int)format;

        return value.ToString(digits is >= 1 and <= 4 ? $"F{digits}" : "G", CultureInfo.CurrentCulture);
    }

    /// <summary>Отменяет запросы и закрывает принадлежащий странице диалог.</summary>
    public void Dispose()
    {
        _disposed = true;
        _stop.Cancel();

        if (_dialogOpen) DialogService.Close();

        _stop.Dispose();
    }
}