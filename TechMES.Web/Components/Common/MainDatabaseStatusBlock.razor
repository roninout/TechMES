@using TechMES.Contracts.Runtime
@inject RuntimeStatusApiClient RuntimeStatusApi
@implements IAsyncDisposable

<div class="server-status-column" aria-label="Main DB server status">
    @foreach (var role in new[] { "Primary", "Secondary" })
    {
        var server = role == "Primary" ? _state?.Primary : _state?.Secondary;
        var status = Describe(_state, server, DateTimeOffset.UtcNow);

        <RadzenBadge Text="@($"DB: {status.Text}")" BadgeStyle="@status.Style" title="@($"{role}. {(_error.Length > 0 ? _error : status.Hint)}")" />
    }
</div>

@code {
    private readonly CancellationTokenSource _stop = new();
    private readonly PeriodicTimer _timer = new(TimeSpan.FromSeconds(5));

    private MainDatabaseHealthResponse? _state;
    private string _error = "";
    private Task? _loop;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync(_stop.Token);

        if (!_disposed)
            _loop = RunAsync(_stop.Token);
    }

    /// <summary>
    /// WEB читает готовый снимок Runtime, не запускает дополнительную проверку БД.
    /// </summary>
    private async Task RefreshAsync(CancellationToken ct)
    {
        try
        {
            var state = await RuntimeStatusApi.GetDatabaseHealthAsync(ct);

            if (_disposed)
                return;

            _state = state;
            _error = "";
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            _state = null;
            _error = "Unable to read Main DB status from Runtime.";
        }
    }

    private async Task RunAsync(CancellationToken ct)
    {
        try
        {
            while (await _timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(async () =>
                {
                    await RefreshAsync(ct);

                    if (!_disposed)
                        StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
    }

    /// <summary>
    /// Отдельно показывает доступный сервер в режиме read-only.
    /// </summary>
    private static (string Text, BadgeStyle Style, string Hint) Describe(MainDatabaseHealthResponse? state, MainDatabaseServerState? server, DateTimeOffset now)
    {
        if (state is null || server is null)
            return ("Unknown", BadgeStyle.Light, "Waiting for Main DB health data.");

        if (!state.Enabled || !server.Configured)
            return ("N/A", BadgeStyle.Light, !state.Enabled ? "Main DB provider is disabled." : $"Main DB {server.Role} is not configured.");

        if (server.CheckedAtUtc is null)
            return ("Unknown", BadgeStyle.Light, server.Message);

        if (now - server.CheckedAtUtc.Value > TimeSpan.FromSeconds(Math.Max(5, state.HealthPeriodSeconds) * 3d))
            return ("Unknown", BadgeStyle.Warning, "Main DB health data is stale.");

        if (server.Connected && !server.CanWrite)
            return ("Read-only", BadgeStyle.Warning, server.Message);

        var hint = $"{server.Message} Active: {state.ActiveRole ?? "None"}; checked {server.CheckedAtUtc.Value.ToLocalTime():dd.MM.yyyy HH:mm:ss}";

        return (server.Connected ? "Online" : "Offline", server.Connected ? BadgeStyle.Success : BadgeStyle.Danger, hint);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;
        _stop.Cancel();
        _timer.Dispose();

        if (_loop is not null)
            await _loop;

        _stop.Dispose();
    }
}