@using TechMES.Contracts.Recipes

<RadzenCard Style="@($"padding: 9px {(Removable ? 28 : 9)}px 9px 9px; height: 100%; min-width: 0; box-sizing: border-box;")">
    <div style="display: flex; gap: 6px; align-items: flex-start;">
        <RadzenIcon Icon="@(Parameter.Kind == RecipeParameterKind.CheckBox ? "check_box" : "pin")" Style="color: var(--rz-text-secondary-color); flex-shrink: 0;" />
        <strong style="overflow-wrap: anywhere;">@Parameter.Name</strong>
    </div>

    <div style="font-size: 12px; overflow-wrap: anywhere; margin-top: 4px;">@Parameter.Tag</div>

    <div style="font-size: 11px; color: var(--rz-text-secondary-color); margin-top: 4px;">
        ID: @Parameter.Id · Order: @Parameter.Order · Family: @Parameter.BaseRecipeId
    </div>

    @if (Parameter.Kind != RecipeParameterKind.CheckBox)
    {
        <div style="font-size: 11px; color: var(--rz-text-secondary-color);">@Units · @Format</div>
    }
</RadzenCard>

@code {
    [Parameter, EditorRequired] public RecipeBaseParameterDto Parameter { get; set; } = new();
    [Parameter] public bool Removable { get; set; }

    private string Units => Parameter.Description.Replace("\\n", "").Replace("\r", "").Replace("\n", "").Trim();
    private string Format => Parameter.Format == RecipeParameterFormat.Default ? "—" : "#." + new string('#', Math.Clamp((int)Parameter.Format, 1, 4));
}