@using TechMES.Contracts.Recipes

<div class="parameter-view @(Compact ? "parameter-compact" : "") @(Used ? "parameter-used" : "")" title="@(Used ? "Already used in this stage" : Parameter.Name)">
    <RadzenCard class="parameter-surface" Style="@(Removable ? "padding-right: 27px;" : null)">
        <div class="parameter-content">
            <RadzenIcon Icon="@(Parameter.Kind == RecipeParameterKind.CheckBox ? "toggle_on" : "calculate")" class="parameter-icon" />

            <div class="parameter-text">
                <div class="parameter-heading">
                    <strong>@Parameter.Tag</strong>

                    @if (Units.Length > 0 && Parameter.Kind != RecipeParameterKind.CheckBox)
                    {
                        <span class="parameter-units">(@Units)</span>
                    }
                </div>

                <div class="parameter-description" title="@Parameter.Name">@Parameter.Name</div>
            </div>

            @if (Used)
            {
                <span class="parameter-used-mark" title="Already used in this stage" aria-label="Already used in this stage">
                    <RadzenIcon Icon="check_circle" />
                </span>
            }
        </div>
    </RadzenCard>
</div>

@code {
    [Parameter, EditorRequired] public RecipeBaseParameterDto Parameter { get; set; } = new();
    [Parameter] public bool Removable { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool Used { get; set; }

    // Скрываем разделители старой программы только при отображении; данные БД не меняем.
    private string Units => Parameter.Description.Replace("\\n", "").Replace("\r", "").Replace("\n", "").Trim();
}