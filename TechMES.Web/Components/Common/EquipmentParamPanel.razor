    /// <summary>
    /// Читает UI-настройки Param-графика из appsettings.json.
    /// </summary>
    protected override void OnInitialized()
    {
        var options = ParamOptions.Value;

        _windowMinutes = Math.Clamp(options.TrendWindowMinutes, 1, 240);
        _trendHistoryMinutes = Math.Clamp(
            Math.Max(options.TrendHistoryMinutes, _windowMinutes),
            _windowMinutes,
            24 * 60);
        _confirmWrites = options.ConfirmWrites;
    }

    /// <summary>
    /// Реагирует на смену Equipment/route mode: отменяет старые запросы,
    /// загружает новую панель и включает polling только когда Param видим.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (!IsActive)
        {
            StopRefreshLoop();
            CancelActiveLoads();
            return;
        }

        var currentName = Equipment?.Name;

        if (string.Equals(_loadedEquipmentName, currentName, StringComparison.OrdinalIgnoreCase))
        {
            StartRefreshLoop();
            return;
        }

        StopRefreshLoop();
        CancelActiveLoads();

        _loadedEquipmentName = currentName;
        _snapshot = null;
        _trend = null;
        _tune = null;
        _tuneTrend = null;
        _hasTuneSettingsLoadedFromStore = false;
        _isTuneCalculating = false;
        _tuneVisibleFromUtc = null;
        _tuneVisibleToUtc = null;
        _fixedTuneToUtc = null;
        _plcRefs = null;
        _diDoRefs = null;
        _dryRun = null;
        _atvRef = null;
        _fixedTrendToUtc = null;
        _chartViewVersion++;
        _tuneChartViewVersion++;
        _statusText = "";
        _tuneStatusText = "";
        _tuneIssueCode = PidTuneIssueCode.None;
        _tuneSettingsStatusText = "";

        if (Equipment is null)
            return;

        await LoadAsync(showLoading: true, includeTrend: ShouldLoadVisibleTrend, ct: GetActiveLoadToken());
        StartRefreshLoop();
    }

