    /// <summary>
    /// Save разрешается после успешной проверки PV/SP.
    ///
    /// Test Kp обязателен для ClosedLoop.
    /// Для других моделей он необязателен, но если пользователь его ввёл,
    /// этот тег также должен пройти Check.
    /// </summary>
    private bool CanSaveTune
    {
        get
        {
            if (_isTuneSaving || _tune?.Settings is null || !_tune.Settings.PvTrendFound || !_tune.Settings.SpTrendFound)
                return false;

            var testKpEntered = !string.IsNullOrWhiteSpace(_tune.Settings.TestKpTag);

            if (_tuneCalculationModel == TuneModelClosedLoop && !testKpEntered)
                return false;

            if (testKpEntered && !_tune.Settings.TestKpFound)
                return false;

            return CalculateTune().IsValid;
        }
    }

    /// <summary>
    /// FOPDT и Integrating требуют одновременно PV и OUT/ManTune.
    ///
    /// ClosedLoop определяет Tu только по PV, поэтому тренд OUT ему не нужен.
    /// Test Kp берётся из online-тега и проверяется уже идентификатором,
    /// чтобы при отсутствии значения пользователь получил понятную диагностику.
    /// </summary>
    private bool CanCalculateTune
    {
        get
        {
            if (_isTuneCalculating || _tuneTrend is null)
                return false;

            var hasPv = _tuneTrend.Points.Any(point => point.Series.Equals("Pv", StringComparison.OrdinalIgnoreCase));

            if (!hasPv)
                return false;

            if (_tuneCalculationModel == TuneModelClosedLoop)
                return true;

            return _tuneTrend.Points.Any(point => point.Series.Equals("ManTune", StringComparison.OrdinalIgnoreCase));
        }
    }

    /// <summary>
    /// Компактное отображение рассчитанных PID-значений.
    /// </summary>
    private static string FormatTuneNumber(double? value)
    {
        return value.HasValue
            ? value.Value.ToString("0.###", CultureInfo.InvariantCulture)
            : "";
    }

    private IReadOnlyList<TuneOption> TuneMethodOptions => _tuneCalculationModel switch
    {
        TuneModelIntegrating => TuneIntegratingMethods,
        TuneModelClosedLoop => TuneClosedLoopMethods,
        _ => TuneFopdtMethods
    };

    private void NormalizeTuneCalculationMethod()
    {
        if (TuneMethodOptions.Any(item => item.Value == _tuneCalculationMethod))
            return;

        _tuneCalculationMethod = TuneMethodOptions[0].Value;
    }

    private PidTuneCalculationResult CalculateTune()
    {
        NormalizeTuneCalculationMethod();
        return PidTuneCalculator.Calculate(BuildTuneCalculationRequest());
    }

