@using TechMES.Contracts.Equipment
@using TechMES.Contracts.Param
@using TechMES.Contracts.Param.Tuning
@using System.Globalization
@using TechMES.Web.Settings
@inject ParamApiClient ParamApi
@inject Microsoft.Extensions.Options.IOptions<ParamUiOptions> ParamOptions
@inject DialogService DialogService
@inject NotificationService NotificationService
@implements IDisposable

<div class="equipment-param-panel">
    @if (Equipment is null)
    {
        <RadzenCard>
            <RadzenText Text="No selected equipment"
                        TextStyle="TextStyle.Subtitle1"
                        Style="color: gray;" />
        </RadzenCard>
    }
    else
    {
        <RadzenCard class="equipment-param-summary-card">
            <div class="equipment-param-summary">
                @* Param намеренно показывает только идентификационную строку.
                   Полная карточка с полями, логотипом и фотографией остается в EquipmentInfoPanel. *@
                <div class="equipment-selected-header equipment-param-selected-header">
                    <EquipmentTypeBadge TypeGroup="@Equipment.TypeGroup" />

                    <div class="equipment-param-title-block">
                        <div class="equipment-param-title-row">
                            <div class="equipment-selected-title">
                                <RadzenText Text="@Equipment.Name" TextStyle="TextStyle.H6" />
                            </div>

                            @if (!Equipment.IsGroup)
                            {
                                <RadzenButton Icon="@GetFavoriteIcon(Equipment)"
                                              ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.Small"
                                              Disabled="@(!CanEditFavorites || IsFavoriteSaving)"
                                              class="@GetFavoriteButtonClass(Equipment)"
                                              title="@(CanEditFavorites ? "Favorite" : "Login is required to use Favorites")"
                                              Click="@ToggleFavoriteAsync" />
                            }
                        </div>

                        @* В Param показываем компактную подпись тем же текстом, который виден в дереве слева.
                           Пустое описание или дубль имени не отображаются, чтобы верхняя карточка не раздувалась. *@
                        @{
                            var paramDescription = GetParamDescriptionText(Equipment);
                        }

                        @if (!string.IsNullOrWhiteSpace(paramDescription))
                        {
                            <div class="equipment-param-description">@paramDescription</div>
                        }
                    </div>
                </div>
            </div>
        </RadzenCard>

        @if (!string.IsNullOrWhiteSpace(_statusText))
        {
            <RadzenAlert AlertStyle="@_statusStyle"
                         ShowIcon="true"
                         AllowClose="true"
                         Close="@(() => _statusText = string.Empty)">
                @_statusText
            </RadzenAlert>
        }

        <div class="equipment-param-tabs">
            @if (_isLoading)
            {
                <TechMesLoadingBar />
            }
            else if (_snapshot is null)
            {
                <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true">
                    Param data is not loaded.
                </RadzenAlert>
            }
            else if (!_snapshot.Supported)
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true">
                    @DisplayValue(_snapshot.Message)
                </RadzenAlert>
            }
            else
            {
                <RadzenTabs RenderMode="TabRenderMode.Server"
                            SelectedIndex="@SelectedTabIndex"
                            Change="@OnTabChangedAsync">
                    <Tabs>
                        @* Иконки вкладок Param остаются themed: Radzen сам окрашивает их по активной теме и состоянию вкладки. *@
                        <RadzenTabsItem Text="Graph" Icon="area_chart">
                            <div class="param-graph-panel">
                                <div class="param-toolbar">
                                    <div class="param-toolbar-side-slot">
                                        @if (IsAiEquipment)
                                        {
                                            @* Поле R вынесено в общий верхний row Graph, чтобы оно не попадало
                                               внутрь абсолютной зоны барграфов и не нарушало их выравнивание с ECharts. *@
                                            <div class="param-toolbar-r-field-shell">
                                                <RadzenFormField AllowFloatingLabel="false"
                                                                 Text="R"
                                                                 Variant="Variant.Outlined"
                                                                 class="param-toolbar-r-field">
                                                    <RadzenTextBox Value='@GetSnapshotItemDisplayValue("R")'
                                                                   ReadOnly="true"
                                                                   class="param-toolbar-r-value" />
                                                </RadzenFormField>
                                            </div>
                                        }
                                        else if (IsVgaEquipment || IsAtvEquipment)
                                        {
                                            @* Поле Man для VGA вынесено в ту же верхнюю строку, где у AI находится R.
                                               Так боковая WPF-like панель остается только шкалой и не сдвигает барграфы относительно plot-area ECharts. *@
                                            <div class="@GetVgaManToolbarFieldShellClass()"
                                                 title="@GetVgaManToolbarFieldTitle()"
                                                 @onclick="@RequestVgaManToolbarWriteAsync">
                                                <RadzenFormField AllowFloatingLabel="false"
                                                                 Text="Man"
                                                                 Variant="Variant.Outlined"
                                                                 class="param-toolbar-r-field">
                                                    <RadzenTextBox Value='@GetSnapshotItemDisplayValue("Man")'
                                                                   ReadOnly="true"
                                                                   Disabled="@IsVgaManToolbarFieldDisabled"
                                                                   class="param-toolbar-r-value" />
                                                </RadzenFormField>
                                            </div>
                                        }
                                        else if (IsVgaElEquipment)
                                        {
                                            @* VGA_EL повторяет WPF-логику Graph: State находится над Man.
                                               Оба поля держим в верхней строке, чтобы левая шкала CurrPos/R оставалась выровненной с plot-area ECharts. *@
                                            <div class="param-toolbar-vga-el-state-man">
                                                <div class="@GetVgaManToolbarFieldShellClass()"
                                                     title="@GetVgaManToolbarFieldTitle()"
                                                     @onclick="@RequestVgaManToolbarWriteAsync">
                                                    <RadzenFormField AllowFloatingLabel="false"
                                                                     Text="Man"
                                                                     Variant="Variant.Outlined"
                                                                     class="param-toolbar-r-field">
                                                        <RadzenTextBox Value='@GetSnapshotItemDisplayValue("Man")'
                                                       ReadOnly="true"
                                                                       Disabled="@IsVgaManToolbarFieldDisabled"
                                                                       class="param-toolbar-r-value" />
                                                    </RadzenFormField>
                                                </div>

                                                <div class="param-toolbar-vga-el-state-text">
                                                    @GetVgaElStateDisplayValue()
                                                </div>
                                            </div>
                                        }
                                        else if (IsMotorEquipment)
                                        {
                                            @* У Motor нет верхнего writable-поля вроде VGA Man, но State должен жить в том же
                                               месте, что и у VGA_EL: над левой WPF-like зоной, не внутри самой кнопочной станции. *@
                                            <div class="param-toolbar-vga-el-state-man param-toolbar-motor-state-shell">
                                                <div class="param-toolbar-motor-state-anchor" aria-hidden="true"></div>

                                                <div class="param-toolbar-vga-el-state-text param-toolbar-motor-state-text">
                                                    @GetMotorStateDisplayValue()
                                                </div>
                                            </div>
                                        }
                                        else if (IsVgdEquipment)
                                        {
                                            @* VGD repeats the Motor graph layout: State is shown above the side command station,
                                               while the station itself only contains Open/Close and Mode. *@
                                            <div class="param-toolbar-vga-el-state-man param-toolbar-motor-state-shell">
                                                <div class="param-toolbar-motor-state-anchor" aria-hidden="true"></div>

                                                <div class="param-toolbar-vga-el-state-text param-toolbar-motor-state-text">
                                                    @GetVgdStateDisplayValue()
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    @* Пустая колонка между полем R и уведомлением Forced.
                                       Ее ширина задается в CSS через --param-toolbar-spacer-width,
                                       чтобы можно было точно подвинуть alert, не меняя разметку графика. *@
                                    <div class="param-toolbar-spacer" aria-hidden="true"></div>

                                    <div class="param-toolbar-alert-slot">
                                        @if (IsGraphForcedChannelActive)
                                        {
                                            @* Forced-состояние выводим над графиком, чтобы боковая панель с барграфами
                                               не меняла свою геометрию и продолжала совпадать с plot-area ECharts. *@
                                            <RadzenAlert AllowClose="false"
                                                         AlertStyle="AlertStyle.Warning"
                                                         Variant="Variant.Flat"
                                                         Shade="Shade.Lighter"
                                                         ShowIcon="true"
                                                         class="param-graph-alert param-forced-alert">
                                                Forced chanel!
                                            </RadzenAlert>
                                        }

                                        @if (IsGraphChannelErrorActive)
                                        {
                                            @* AlarmHealth переносим из бокового WPF-блока наверх:
                                               предупреждение остается видимым, но больше не меняет высоту/позицию барграфов. *@
                                            <RadzenAlert AllowClose="false"
                                                         AlertStyle="AlertStyle.Danger"
                                                         Variant="Variant.Flat"
                                                         Shade="Shade.Lighter"
                                                         ShowIcon="true"
                                                         class="param-graph-alert param-channel-error-alert">
                                                Chanel error!
                                            </RadzenAlert>
                                        }

                                        @if (IsGraphVgaElAlarmActive)
                                        {
                                            <RadzenAlert AllowClose="false"
                                                         AlertStyle="AlertStyle.Danger"
                                                         Variant="Variant.Flat"
                                                         Shade="Shade.Lighter"
                                                         ShowIcon="true"
                                                         class="param-graph-alert param-channel-error-alert">
                                                Alarm active!
                                            </RadzenAlert>
                                        }

                                        @if (IsGraphVgaElOpenAlarmActive)
                                        {
                                            <RadzenAlert AllowClose="false"
                                                         AlertStyle="AlertStyle.Danger"
                                                         Variant="Variant.Flat"
                                                         Shade="Shade.Lighter"
                                                         ShowIcon="true"
                                                         class="param-graph-alert param-channel-error-alert">
                                                Open alarm!
                                            </RadzenAlert>
                                        }

                                        @if (IsGraphVgaElCloseAlarmActive)
                                        {
                                            <RadzenAlert AllowClose="false"
                                                         AlertStyle="AlertStyle.Danger"
                                                         Variant="Variant.Flat"
                                                         Shade="Shade.Lighter"
                                                         ShowIcon="true"
                                                         class="param-graph-alert param-channel-error-alert">
                                                Close alarm!
                                            </RadzenAlert>
                                        }

                                        @if (IsGraphMotorTimeWorkActive)
                                        {
                                            @* Time Work у Motor больше не находится внутри боковой станции:
                                               предупреждение выводим в общей alert-строке Graph рядом с другими состояниями. *@
                                            <RadzenAlert AllowClose="false"
                                                         AlertStyle="AlertStyle.Info"
                                                         Variant="Variant.Flat"
                                                         Shade="Shade.Lighter"
                                                         ShowIcon="true"
                                                         class="param-graph-alert param-motor-time-work-alert">
                                                Time Work!
                                            </RadzenAlert>
                                        }

                                        @if (IsGraphVgdAlarmActive)
                                        {
                                            <RadzenAlert AllowClose="false"
                                                         AlertStyle="AlertStyle.Danger"
                                                         Variant="Variant.Flat"
                                                         Shade="Shade.Lighter"
                                                         ShowIcon="true"
                                                         class="param-graph-alert param-channel-error-alert">
                                                Alarm active!
                                            </RadzenAlert>
                                        }
                                    </div>

                                    <RadzenButton Icon="skip_next"
                                                  ButtonStyle="ButtonStyle.Light"
                                                  class="param-live-button"
                                                  title="Go to latest"
                                                  Click="@GoLiveAsync" />
                                </div>

                                <div class="param-graph-layout">
                                    <ParamGraphSidePanel Equipment="@Equipment"
                                                         Snapshot="@_snapshot"
                                                         OnWriteRequested="@(item => BeginParamWriteAsync(item))"
                                                         OnBooleanWriteRequested="@(request => BeginParamWriteAsync(request))" />

                                    <div class="param-graph-main">
                                        @if (_trend is null || _trend.Points.Count == 0)
                                        {
                                            <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true">
                                                @DisplayValue(_trend?.Message ?? "Trend points are not loaded yet.")
                                            </RadzenAlert>
                                        }
                                        else
                                        {
                                            <div class="param-chart-shell">
                                                <EquipmentTrendChart Trend="@_trend"
                                                                     ViewKey="@ChartViewKey"
                                                                     Unit="@_snapshot.Unit"
                                                                     RenderStyle="@EquipmentTrendRenderStyle.Area"
                                                                     GoToLatestVersion="@_chartViewVersion"
                                                                     LatestWindowMinutes="@_windowMinutes"
                                                                     VisibleFromUtc="@GetVisibleFromUtc()"
                                                                     VisibleToUtc="@GetVisibleToUtc()"
                                                                     CanLoadOlder="@CanScrollGraphBackward"
                                                                     CanLoadNewer="@CanScrollGraphForward"
                                                                     OnHistoryRequested="@OnChartHistoryRequestedAsync" />
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="param-graph-footer">
                                    <span class="param-status">@FormatGraphStatus()</span>
                                </div>
                            </div>
                        </RadzenTabsItem>

                        @if (IsMotorEquipment)
                        {
                            @* Для Motor порядок вкладок повторяет текущий WEB/WPF-сценарий:
                               сначала reference pages, затем аварии и в самом конце общий список All. *@
                            @if (HasPage(ParamPageKind.Plc))
                            {
                                <RadzenTabsItem Text="PLC" Icon="developer_board">
                                    @if (_isRefsLoading && SelectedTabKind == ParamPanelTabKind.Plc)
                                    {
                                        <TechMesLoadingBar />
                                    }
                                    else
                                    {
                                        <ParamPlcRefsView Response="@_plcRefs"
                                                          OnSelectEquipment="@SelectEquipmentByNameAsync"
                                                          OnWriteRequested="@BeginTargetParamWriteAsync" />
                                    }
                                </RadzenTabsItem>
                            }

                            @if (HasPage(ParamPageKind.Atv))
                            {
                                <RadzenTabsItem Text="ATV" Icon="electric_bolt">
                                    @if (_isRefsLoading && SelectedTabKind == ParamPanelTabKind.Atv)
                                    {
                                        <TechMesLoadingBar />
                                    }
                                    else
                                    {
                                        <ParamAtvRefView Response="@_atvRef"
                                                         OnSelectEquipment="@SelectEquipmentByNameAsync"
                                                         OnWriteRequested="@BeginTargetParamWriteAsync" />
                                    }
                                </RadzenTabsItem>
                            }

                            @if (HasTimeItems)
                            {
                                <RadzenTabsItem Text="TimeWork" Icon="timer">
                                    <ParamMotorTimeWorkView Items="@_snapshot.Items"
                                                            OnWriteRequested="@(item => BeginParamWriteAsync(item))"
                                                            OnBooleanWriteRequested="@(request => BeginParamWriteAsync(request))" />
                                </RadzenTabsItem>
                            }

                            @if (HasPage(ParamPageKind.DryRun))
                            {
                                <RadzenTabsItem Text="DryRun" Icon="speed">
                                    @if (_isRefsLoading && SelectedTabKind == ParamPanelTabKind.DryRun)
                                    {
                                        <TechMesLoadingBar />
                                    }
                                    else
                                    {
                                        <ParamDryRunView Response="@_dryRun"
                                                         OnSelectEquipment="@SelectEquipmentByNameAsync"
                                                         OnWriteRequested="@BeginTargetParamWriteAsync" />
                                    }
                                </RadzenTabsItem>
                            }

                            @if (HasPage(ParamPageKind.DiDo))
                            {
                                <RadzenTabsItem Text="DI/DO" Icon="settings_input_component">
                                    @if (_isRefsLoading && SelectedTabKind == ParamPanelTabKind.DiDo)
                                    {
                                        <TechMesLoadingBar />
                                    }
                                    else
                                    {
                                        <ParamDiDoRefsView Response="@_diDoRefs"
                                                           OnSelectEquipment="@SelectEquipmentByNameAsync" />
                                    }
                                </RadzenTabsItem>
                            }

                            @if (HasAlarmItems)
                            {
                                <RadzenTabsItem Text="Alarm" Icon="notifications_active">
                                    <ParamMotorAlarmView Items="@_snapshot.Items"
                                                         OnWriteRequested="@(item => BeginParamWriteAsync(item))"
                                                         OnBooleanWriteRequested="@(request => BeginParamWriteAsync(request))" />
                                </RadzenTabsItem>
                            }

                            <RadzenTabsItem Text="All" Icon="dataset">
                                <div class="param-motor-all-panels">
                                    <ParamAiPanel Title="Motor values" Icon="dataset">
                                        <ParamItemsTable Items="@_snapshot.Items"
                                                         OnWriteRequested="@BeginParamWriteAsync" />
                                    </ParamAiPanel>

                                    <ParamAiPanel Title="ATV" Icon="electric_bolt">
                                        @if (_isRefsLoading && SelectedTabKind == ParamPanelTabKind.MotorAll)
                                        {
                                            <TechMesLoadingBar />
                                        }
                                        else
                                        {
                                            <ParamAtvRefView Response="@_atvRef"
                                                             TableOnly="true"
                                                             OnSelectEquipment="@SelectEquipmentByNameAsync"
                                                             OnWriteRequested="@BeginTargetParamWriteAsync" />
                                        }
                                    </ParamAiPanel>
                                </div>
                            </RadzenTabsItem>
                        }
                        else if (IsVgdEquipment)
                        {
                            @* VGD keeps a compact WPF-like order: Graph, PLC, DI/DO, Alarm, then the raw All table. *@
                            @if (HasPage(ParamPageKind.Plc))
                            {
                                <RadzenTabsItem Text="PLC" Icon="developer_board">
                                    @if (_isRefsLoading && SelectedTabKind == ParamPanelTabKind.Plc)
                                    {
                                        <TechMesLoadingBar />
                                    }
                                    else
                                    {
                                        <ParamPlcRefsView Response="@_plcRefs"
                                                          OnSelectEquipment="@SelectEquipmentByNameAsync"
                                                          OnWriteRequested="@BeginTargetParamWriteAsync" />
                                    }
                                </RadzenTabsItem>
                            }

                            @if (HasPage(ParamPageKind.DiDo))
                            {
                                <RadzenTabsItem Text="DI/DO" Icon="settings_input_component">
                                    @if (_isRefsLoading && SelectedTabKind == ParamPanelTabKind.DiDo)
                                    {
                                        <TechMesLoadingBar />
                                    }
                                    else
                                    {
                                        <ParamDiDoRefsView Response="@_diDoRefs"
                                                           OnSelectEquipment="@SelectEquipmentByNameAsync" />
                                    }
                                </RadzenTabsItem>
                            }

                            @if (HasAlarmItems)
                            {
                                <RadzenTabsItem Text="Alarm" Icon="notifications_active">
                                    <ParamVgdAlarmView Items="@_snapshot.Items"
                                                       OnWriteRequested="@(item => BeginParamWriteAsync(item))"
                                                       OnBooleanWriteRequested="@(request => BeginParamWriteAsync(request))" />
                                </RadzenTabsItem>
                            }

                            <RadzenTabsItem Text="All" Icon="dataset">
                                <ParamItemsTable Items="@_snapshot.Items"
                                                 OnWriteRequested="@BeginParamWriteAsync" />
                            </RadzenTabsItem>
                        }
                        else if (IsAtvEquipment)
                        {
                            @* ATV keeps its own compact order: Graph, ATV reference/settings page, Alarm, then All. *@
                            @if (HasPage(ParamPageKind.Atv))
                            {
                                <RadzenTabsItem Text="ATV" Icon="electric_bolt">
                                    @if (_isRefsLoading && SelectedTabKind == ParamPanelTabKind.Atv)
                                    {
                                        <TechMesLoadingBar />
                                    }
                                    else
                                    {
                                        <ParamAtvRefView Response="@_atvRef"
                                                         OnSelectEquipment="@SelectEquipmentByNameAsync"
                                                         OnWriteRequested="@BeginTargetParamWriteAsync" />
                                    }
                                </RadzenTabsItem>
                            }

                            @if (HasAlarmItems)
                            {
                                <RadzenTabsItem Text="Alarm" Icon="notifications_active">
                                    <ParamAiAlarmView Items="@_snapshot.Items"
                                                      OnWriteRequested="@(item => BeginParamWriteAsync(item))"
                                                      OnBooleanWriteRequested="@(request => BeginParamWriteAsync(request))" />
                                </RadzenTabsItem>
                            }

                            <RadzenTabsItem Text="All" Icon="dataset">
                                <ParamItemsTable Items="@_snapshot.Items"
                                                 OnWriteRequested="@BeginParamWriteAsync" />
                            </RadzenTabsItem>
                        }
                        else
                        {
                        @if (HasSpecializedSettingsItems)
                        {
                            <RadzenTabsItem Text="Settings" Icon="tune">
                                @if (IsDiDoEquipment)
                                {
                                    <ParamDigitalSettingsView Items="@_snapshot.Items"
                                                              OnWriteRequested="@(item => BeginParamWriteAsync(item))"
                                                              OnBooleanWriteRequested="@(request => BeginParamWriteAsync(request))" />
                                }
                                else if (IsVgaEquipment)
                                {
                                    <ParamVgaSettingsView Items="@_snapshot.Items"
                                                          OnWriteRequested="@(item => BeginParamWriteAsync(item))"
                                                          OnBooleanWriteRequested="@(request => BeginParamWriteAsync(request))" />
                                }
                                else if (IsVgaElEquipment)
                                {
                                    <ParamVgaElSettingsView Items="@_snapshot.Items"
                                                            OnWriteRequested="@(item => BeginParamWriteAsync(item))"
                                                            OnBooleanWriteRequested="@(request => BeginParamWriteAsync(request))" />
                                }
                                else
                                {
                                    <ParamAiSettingsView Items="@_snapshot.Items"
                                                         OnWriteRequested="@(item => BeginParamWriteAsync(item))"
                                                         OnBooleanWriteRequested="@(request => BeginParamWriteAsync(request))" />
                                }
                            </RadzenTabsItem>
                        }

                        @if (!UsesSpecializedParamTabs && !IsMotorEquipment)
                        {
                            <RadzenTabsItem Text="All" Icon="dataset">
                                <ParamItemsTable Items="@_snapshot.Items"
                                                 OnWriteRequested="@BeginParamWriteAsync" />
                            </RadzenTabsItem>
                        }

                        @if (HasAlarmItems)
                        {
                            <RadzenTabsItem Text="Alarm" Icon="notifications_active">
                                @if (IsMotorEquipment)
                                {
                                    <ParamMotorAlarmView Items="@_snapshot.Items"
                                                         OnWriteRequested="@(item => BeginParamWriteAsync(item))"
                                                         OnBooleanWriteRequested="@(request => BeginParamWriteAsync(request))" />
                                }
                                else if (UsesAnalogSpecializedTabs)
                                {
                                    @if (IsVgaElEquipment)
                                    {
                                        <ParamVgaElAlarmView Items="@_snapshot.Items"
                                                             OnWriteRequested="@(item => BeginParamWriteAsync(item))"
                                                             OnBooleanWriteRequested="@(request => BeginParamWriteAsync(request))" />
                                    }
                                    else
                                    {
                                        <ParamAiAlarmView Items="@_snapshot.Items"
                                                          OnWriteRequested="@(item => BeginParamWriteAsync(item))"
                                                          OnBooleanWriteRequested="@(request => BeginParamWriteAsync(request))" />
                                    }
                                }
                                else
                                {
                                    <ParamItemsTable Items="@GetAlarmItems()"
                                                     OnWriteRequested="@BeginParamWriteAsync" />
                                }
                            </RadzenTabsItem>
                        }

                        @if (IsVgaEquipment)
                        {
                            var tuneSettings = EnsureTuneSettings();
                            var tuneResult = CalculateTune();

                            <RadzenTabsItem Text="Tune" Icon="query_stats">
                                @if (_isLoading && SelectedTabKind == ParamPanelTabKind.Tune)
                                {
                                    <TechMesLoadingBar />
                                }
                                else
                                {
                                    <div class="param-tune-panel">
                                        @if (!string.IsNullOrWhiteSpace(_tune?.Message ?? _tuneStatusText))
                                        {
                                            <RadzenAlert AlertStyle="@_tuneStatusStyle" ShowIcon="true">
                                                @DisplayValue(_tune?.Message ?? _tuneStatusText)
                                            </RadzenAlert>
                                        }

                                        <div class="param-tune-graph-layout">
                                            <div class="param-tune-bars">
                                                <ParamGraphVerticalBar Label="Out"
                                                                       Value="@_tune?.ManTuneValue"
                                                                       Min="@(_tune?.ManTuneMin ?? 0)"
                                                                       Max="@(_tune?.ManTuneMax ?? 100)"
                                                                       FillColor="#4F81BD" />
                                                <ParamGraphVerticalBar Label="Sp"
                                                                       Value="@_tune?.SpValue"
                                                                       Min="@(tuneSettings.SpMin ?? 0)"
                                                                       Max="@(tuneSettings.SpMax ?? 100)"
                                                                       FillColor="#F59E0B" />
                                                <ParamGraphVerticalBar Label="Pv"
                                                                       Value="@_tune?.PvValue"
                                                                       Min="@(tuneSettings.PvMin ?? 0)"
                                                                       Max="@(tuneSettings.PvMax ?? 100)"
                                                                       FillColor="#2E7D32" />
                                            </div>

                                            <div class="param-tune-chart">
                                                <div class="param-tune-chart-toolbar">
                                                    <RadzenButton Icon="skip_next"
                                                                  ButtonStyle="ButtonStyle.Light"
                                                                  class="param-live-button"
                                                                  title="Go to latest"
                                                                  Click="@GoTuneLiveAsync" />
                                                </div>

                                                @if (_tuneTrend is null || _tuneTrend.Points.Count == 0)
                                                {
                                                    <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true">
                                                        @DisplayValue(_tuneTrend?.Message ?? "Tune trend points are not loaded yet.")
                                                    </RadzenAlert>
                                                }
                                                else
                                                {
                                                    <div class="param-chart-shell">
                                                        <EquipmentTrendChart Trend="@_tuneTrend"
                                                                             ViewKey="@TuneChartViewKey"
                                                                             RenderStyle="@EquipmentTrendRenderStyle.Line"
                                                                             SeriesDisplayNames="@TuneSeriesDisplayNames"
                                                                             GoToLatestVersion="@_tuneChartViewVersion"
                                                                             LatestWindowMinutes="@_windowMinutes"
                                                                             VisibleFromUtc="@GetTuneVisibleFromUtc()"
                                                                             VisibleToUtc="@GetTuneVisibleToUtc()"
                                                                             CanLoadOlder="@CanScrollTuneBackward"
                                                                             CanLoadNewer="@CanScrollTuneForward"
                                                                             OnHistoryRequested="@OnTuneChartHistoryRequestedAsync"
                                                                             OnVisibleWindowChanged="@OnTuneVisibleWindowChangedAsync" />
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <ParamAiPanel Title="PID Tune" Icon="query_stats">
                                            <div class="param-tune-form">
                                                    <div class="param-tune-row param-tune-header-row">
                                                        <RadzenFormField AllowFloatingLabel="false" Text="Process model" class="param-tune-tag-field">
                                                            <RadzenDropDown TValue="string"
                                                                            Data="@TuneModelOptions"
                                                                            TextProperty="Text"
                                                                            ValueProperty="Value"
                                                                            @bind-Value="_tuneCalculationModel"
                                                                            Change="@(_ => NormalizeTuneCalculationMethod())"
                                                                            Style="width: 100%;" />
                                                        </RadzenFormField>
                                                        <RadzenFormField AllowFloatingLabel="false" Text="Tune method" class="param-tune-tag-field">
                                                            <RadzenDropDown TValue="string"
                                                                            Data="@TuneMethodOptions"
                                                                            TextProperty="Text"
                                                                            ValueProperty="Value"
                                                                            @bind-Value="_tuneCalculationMethod"
                                                                            Style="width: 100%;" />
                                                        </RadzenFormField>
                                                        <span class="param-tune-help">@tuneResult.Message</span>
                                                        <div class="param-tune-info-slot">
                                                            <RadzenButton Icon="info"
                                                                          ButtonStyle="ButtonStyle.Light"
                                                                          Variant="Variant.Flat"
                                                                          Size="ButtonSize.Medium"
                                                                          title="Описание модели и метода настройки"
                                                                          class="param-tune-info-button"
                                                                          Click="@OpenTuneInfoAsync" />
                                                        </div>
                                                    </div>

                                                    @if (_tuneCalculationModel == TuneModelFopdt)
                                                    {
                                                        <div class="param-tune-input-row">
                                                            <RadzenFormField AllowFloatingLabel="false" Text="K" class="param-tune-number-field">
                                                                <RadzenNumeric TValue="double?" @bind-Value="_tuneFopdtK" />
                                                            </RadzenFormField>
                                                            <RadzenFormField AllowFloatingLabel="false" Text="Tau, sec" class="param-tune-number-field">
                                                                <RadzenNumeric TValue="double?" @bind-Value="_tuneFopdtTau" />
                                                            </RadzenFormField>
                                                            <RadzenFormField AllowFloatingLabel="false" Text="Theta, sec" class="param-tune-number-field">
                                                                <RadzenNumeric TValue="double?" @bind-Value="_tuneFopdtTheta" />
                                                            </RadzenFormField>
                                                            <RadzenFormField AllowFloatingLabel="false" Text="Tau c, sec" class="param-tune-number-field">
                                                                <RadzenNumeric TValue="double?" @bind-Value="_tuneFopdtTauC" Disabled="@(_tuneCalculationMethod != TuneMethodFopdtSimcPid)" />
                                                            </RadzenFormField>
                                                        </div>
                                                    }
                                                    else if (_tuneCalculationModel == TuneModelIntegrating)
                                                    {
                                                        <div class="param-tune-input-row">
                                                            <RadzenFormField AllowFloatingLabel="false" Text="ki" class="param-tune-number-field">
                                                                <RadzenNumeric TValue="double?" @bind-Value="_tuneIntegratingKi" />
                                                            </RadzenFormField>
                                                            <RadzenFormField AllowFloatingLabel="false" Text="Theta, sec" class="param-tune-number-field">
                                                                <RadzenNumeric TValue="double?" @bind-Value="_tuneIntegratingTheta" />
                                                            </RadzenFormField>
                                                            <RadzenFormField AllowFloatingLabel="false" Text="Tau c, sec" class="param-tune-number-field">
                                                                <RadzenNumeric TValue="double?" @bind-Value="_tuneIntegratingTauC" Disabled="@(_tuneCalculationMethod == TuneMethodIntegratingZn)" />
                                                            </RadzenFormField>
                                                        </div>
                                                    }
                                                    else if (_tuneCalculationModel == TuneModelClosedLoop)
                                                    {
                                                        <div class="param-tune-input-row">
                                                            <RadzenFormField AllowFloatingLabel="false" Text="Ku" class="param-tune-number-field">
                                                                <RadzenNumeric TValue="double?" @bind-Value="_tuneClosedKu" />
                                                            </RadzenFormField>

                                                            <RadzenFormField AllowFloatingLabel="false" Text="Tu, sec" class="param-tune-number-field">
                                                                <RadzenNumeric TValue="double?" @bind-Value="_tuneClosedTu" />
                                                            </RadzenFormField>

                                                            <RadzenFormField AllowFloatingLabel="false" Text="Test Kp" class="param-tune-number-field">
                                                                <RadzenTextBox Value="@FormatTuneNumber(_tune?.TestKpValue)" ReadOnly="true" />
                                                            </RadzenFormField>
                                                        </div>
                                                    }

                                                    <div class="param-tune-result-row">
                                                        <RadzenFormField AllowFloatingLabel="false" Text="Kp" class="param-tune-result-field">
                                                            <RadzenTextBox Value="@FormatTuneNumber(tuneResult.Kp)" ReadOnly="true" />
                                                        </RadzenFormField>
                                                        <RadzenFormField AllowFloatingLabel="false" Text="Ti" class="param-tune-result-field">
                                                            <RadzenTextBox Value="@FormatTuneNumber(tuneResult.Ti)" ReadOnly="true" />
                                                        </RadzenFormField>
                                                        <RadzenFormField AllowFloatingLabel="false" Text="Td" class="param-tune-result-field">
                                                            <RadzenTextBox Value="@FormatTuneNumber(tuneResult.Td)" ReadOnly="true" />
                                                        </RadzenFormField>
                                                        @if (_isTuneCalculating)
                                                        {
                                                            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" class="param-tune-progress" />
                                                        }
                                                        else
                                                        {
                                                            @if (CanOpenTuneIssue)
                                                            {
                                                                <button type="button"
                                                                        class="param-status param-status-link"
                                                                        title="Открыть объяснение"
                                                                        @onclick="OpenTuneIssueAsync">
                                                                    <RadzenIcon Icon="help_outline" />
                                                                    <span>@_tuneStatusText</span>
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <span class="param-status">@_tuneStatusText</span>
                                                            }
                                                        }
                                                        <RadzenButton Text="Calculate"
                                                                      Icon="calculate"
                                                                      ButtonStyle="ButtonStyle.Light"
                                                                      Click="@CalculateTuneFromVisibleTrendAsync"
                                                                      Disabled="@(!CanCalculateTune)" />
                                                    </div>
                                            </div>
                                        </ParamAiPanel>

                                            <ParamAiPanel Title="Settings"
                                                          Icon="settings"
                                                          InitiallyCollapsed="true">

                                                <div class="param-tune-form">

                                                    <div class="param-tune-settings-row">
                                                        <RadzenFormField AllowFloatingLabel="false"
                                                                         Text="Pv trend tag"
                                                                         class="param-tune-tag-field">
                                                            <RadzenTextBox @bind-Value="TunePv" />
                                                        </RadzenFormField>

                                                        <RadzenFormField AllowFloatingLabel="false"
                                                                         Text="Pv min"
                                                                         class="param-tune-number-field param-tune-range-field">
                                                            <RadzenNumeric TValue="double?"
                                                                           @bind-Value="TunePvMin" />
                                                        </RadzenFormField>

                                                        <RadzenFormField AllowFloatingLabel="false"
                                                                         Text="Pv max"
                                                                         class="param-tune-number-field param-tune-range-field">
                                                            <RadzenNumeric TValue="double?"
                                                                           @bind-Value="TunePvMax" />
                                                        </RadzenFormField>
                                                    </div>

                                                    <div class="param-tune-settings-row">
                                                        <RadzenFormField AllowFloatingLabel="false"
                                                                         Text="Sp trend tag"
                                                                         class="param-tune-tag-field">
                                                            <RadzenTextBox @bind-Value="TuneSp" />
                                                        </RadzenFormField>

                                                        <RadzenFormField AllowFloatingLabel="false"
                                                                         Text="Sp min"
                                                                         class="param-tune-number-field param-tune-range-field">
                                                            <RadzenNumeric TValue="double?"
                                                                           @bind-Value="TuneSpMin" />
                                                        </RadzenFormField>

                                                        <RadzenFormField AllowFloatingLabel="false"
                                                                         Text="Sp max"
                                                                         class="param-tune-number-field param-tune-range-field">
                                                            <RadzenNumeric TValue="double?"
                                                                           @bind-Value="TuneSpMax" />
                                                        </RadzenFormField>
                                                    </div>

                                                    @*
                                                    Test Kp - обычный online-тег. Для него Check делает только числовой TagRead. В Trend он никогда не добавляется.
                                                    *@
                                                    <div class="param-tune-settings-row">
                                                        <RadzenFormField AllowFloatingLabel="false"
                                                                         Text="Test Kp online tag"
                                                                         class="param-tune-tag-field">
                                                            <RadzenTextBox @bind-Value="TuneTestKpTag" />
                                                        </RadzenFormField>

                                                        <RadzenFormField AllowFloatingLabel="false"
                                                                         Text="Test Kp value"
                                                                         class="param-tune-number-field param-tune-range-field">
                                                            <RadzenTextBox Value="@FormatTuneNumber(_tune?.TestKpValue)"
                                                                           ReadOnly="true" />
                                                        </RadzenFormField>
                                                    </div>

                                                    <div class="param-tune-settings-actions">
                                                        <span class="param-status">
                                                            @_tuneSettingsStatusText
                                                        </span>

                                                        <RadzenButton Text="Check"
                                                                      Icon="manage_search"
                                                                      ButtonStyle="ButtonStyle.Light"
                                                                      Click="@CheckTuneTagsAsync"
                                                                      Disabled="@_isTuneChecking" />

                                                        <RadzenButton Text="Save"
                                                                      Icon="save"
                                                                      ButtonStyle="ButtonStyle.Light"
                                                                      Click="@SaveTuneAsync"
                                                                      Disabled="@(!CanSaveTune)" />
                                                    </div>

                                                </div>
                                            </ParamAiPanel>
                                    </div>
                                }
                            </RadzenTabsItem>
                        }

                        @if (IsVgaElEquipment && HasPage(ParamPageKind.DiDo))
                        {
                            <RadzenTabsItem Text="DI/DO" Icon="settings_input_component">
                                @if (_isRefsLoading && SelectedTabKind == ParamPanelTabKind.DiDo)
                                {
                                    <TechMesLoadingBar />
                                }
                                else
                                {
                                    <ParamDiDoRefsView Response="@_diDoRefs"
                                                       OnSelectEquipment="@SelectEquipmentByNameAsync" />
                                }
                            </RadzenTabsItem>
                        }

                        @if (UsesSpecializedParamTabs)
                        {
                            <RadzenTabsItem Text="All" Icon="dataset">
                                <ParamItemsTable Items="@_snapshot.Items"
                                                 OnWriteRequested="@BeginParamWriteAsync" />
                            </RadzenTabsItem>
                        }

                        @if (HasTimeItems)
                        {
                            <RadzenTabsItem Text="TimeWork" Icon="timer">
                                @if (IsMotorEquipment)
                                {
                                    <ParamMotorTimeWorkView Items="@_snapshot.Items"
                                                            OnWriteRequested="@(item => BeginParamWriteAsync(item))"
                                                            OnBooleanWriteRequested="@(request => BeginParamWriteAsync(request))" />
                                }
                                else
                                {
                                    <ParamItemsTable Items="@GetTimeItems()"
                                                     OnWriteRequested="@BeginParamWriteAsync" />
                                }
                            </RadzenTabsItem>
                        }

                        @if (HasPage(ParamPageKind.Plc))
                        {
                            <RadzenTabsItem Text="PLC" Icon="developer_board">
                                @if (_isRefsLoading && SelectedTabKind == ParamPanelTabKind.Plc)
                                {
                                    <TechMesLoadingBar />
                                }
                                else
                                {
                                    <ParamPlcRefsView Response="@_plcRefs"
                                                      OnSelectEquipment="@SelectEquipmentByNameAsync"
                                                      OnWriteRequested="@BeginTargetParamWriteAsync" />
                                }
                            </RadzenTabsItem>
                        }

                        @if (!IsVgaElEquipment && HasPage(ParamPageKind.DiDo))
                        {
                            <RadzenTabsItem Text="DI/DO" Icon="settings_input_component">
                                @if (_isRefsLoading && SelectedTabKind == ParamPanelTabKind.DiDo)
                                {
                                    <TechMesLoadingBar />
                                }
                                else
                                {
                                    <ParamDiDoRefsView Response="@_diDoRefs"
                                                       OnSelectEquipment="@SelectEquipmentByNameAsync" />
                                }
                            </RadzenTabsItem>
                        }

                        @if (HasPage(ParamPageKind.DryRun))
                        {
                            <RadzenTabsItem Text="DryRun" Icon="speed">
                                @if (_isRefsLoading && SelectedTabKind == ParamPanelTabKind.DryRun)
                                {
                                    <TechMesLoadingBar />
                                }
                                else
                                {
                                    <ParamDryRunView Response="@_dryRun"
                                                     OnSelectEquipment="@SelectEquipmentByNameAsync"
                                                     OnWriteRequested="@BeginTargetParamWriteAsync" />
                                }
                            </RadzenTabsItem>
                        }

                        @if (HasPage(ParamPageKind.Atv))
                        {
                            <RadzenTabsItem Text="ATV" Icon="electric_bolt">
                                @if (_isRefsLoading && SelectedTabKind == ParamPanelTabKind.Atv)
                                {
                                    <TechMesLoadingBar />
                                }
                                else
                                {
                                    <ParamAtvRefView Response="@_atvRef"
                                                     OnSelectEquipment="@SelectEquipmentByNameAsync"
                                                     OnWriteRequested="@BeginTargetParamWriteAsync" />
                                }
                            </RadzenTabsItem>
                        }

                        @if (IsMotorEquipment)
                        {
                            @* Motor оставляет All последней вкладкой. Первая панель показывает весь текущий snapshot,
                               вторая панель повторяет бывшую вкладку ATV, чтобы связанный привод был рядом с Motor-данными. *@
                            <RadzenTabsItem Text="All" Icon="dataset">
                                <div class="param-motor-all-panels">
                                    <ParamAiPanel Title="Motor values" Icon="dataset">
                                        <ParamItemsTable Items="@_snapshot.Items"
                                                         OnWriteRequested="@BeginParamWriteAsync" />
                                    </ParamAiPanel>

                                    <ParamAiPanel Title="ATV" Icon="electric_bolt">
                                        @if (_isRefsLoading && SelectedTabKind == ParamPanelTabKind.MotorAll)
                                        {
                                            <TechMesLoadingBar />
                                        }
                                        else
                                        {
                                            <ParamAtvRefView Response="@_atvRef"
                                                             TableOnly="true"
                                                             OnSelectEquipment="@SelectEquipmentByNameAsync"
                                                             OnWriteRequested="@BeginTargetParamWriteAsync" />
                                        }
                                    </ParamAiPanel>
                                </div>
                            </RadzenTabsItem>
                        }
                        }
                    </Tabs>
                </RadzenTabs>
            }
        </div>
    }
</div>

@code {
    /// <summary>
    /// Токен текущей загрузки snapshot/trend/reference pages.
    /// При переключении оборудования старые запросы отменяются.
    /// </summary>
    private CancellationTokenSource _loadCts = new();

    /// <summary>
    /// Токен фонового polling-а Param snapshot/trend.
    /// </summary>
    private CancellationTokenSource? _refreshCts;

    /// <summary>
    /// Задача фонового polling loop.
    /// </summary>
    private Task? _refreshTask;

    /// <summary>
    /// Имя оборудования, для которого сейчас загружена Param-панель.
    /// </summary>
    private string? _loadedEquipmentName;

    /// <summary>
    /// Последний snapshot текущих значений Param items.
    /// </summary>
    private ParamSnapshotResponse? _snapshot;

    /// <summary>
    /// Буфер тренда для вкладки Graph.
    /// </summary>
    private ParamTrendResponse? _trend;

    /// <summary>
    /// Runtime-данные и сохраненные настройки вкладки Tune для VGA.
    /// </summary>
    private ParamTuneRuntimeResponse? _tune;

    /// <summary>
    /// Отдельный line-тренд вкладки Tune: он не смешивается с основным Graph.
    /// </summary>
    private ParamTrendResponse? _tuneTrend;

    /// <summary>
    /// Отображаемые имена серий Tune-графика.
    /// Техническое имя ManTune сохраняется для чтения OUT и PID-расчета.
    /// </summary>
    private static readonly IReadOnlyDictionary<string, string> TuneSeriesDisplayNames =
        new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["ManTune"] = "Out"
        };

    /// <summary>
    /// Версия Tune-графика, чтобы JS сбрасывал старый zoom при смене оборудования или сохранении тегов.
    /// </summary>
    private int _tuneChartViewVersion;

    /// <summary>
    /// true после первой загрузки Tune-настроек из PostgreSQL для выбранного оборудования.
    /// Пока пользователь вводит PV/SP, последующие runtime refresh обновляют график,
    /// но не перезатирают черновик полей значениями из БД.
    /// </summary>
    private bool _hasTuneSettingsLoadedFromStore;

    /// <summary>
    /// true, пока Runtime последовательно проверяет оба трендовых тега PV и SP.
    /// </summary>
    private bool _isTuneChecking;

    /// <summary>
    /// true, пока настройки Tune сохраняются в PostgreSQL.
    /// </summary>
    private bool _isTuneSaving;

    /// <summary>
    /// true, пока по видимой области графика определяется FOPDT-модель
    /// и рассчитываются начальные SIMC PI-настройки.
    /// </summary>
    private bool _isTuneCalculating;

    /// <summary>
    /// Левая граница видимого окна Tune-графика, которую сообщает ECharts после zoom/pan.
    /// </summary>
    private DateTime? _tuneVisibleFromUtc;

    /// <summary>
    /// Правая граница видимого окна Tune-графика, которую сообщает ECharts после zoom/pan.
    /// </summary>
    private DateTime? _tuneVisibleToUtc;

    /// <summary>
    /// Правая граница исторического буфера Tune.
    /// null означает live-режим, в котором polling может заменять буфер свежими точками.
    /// После прокрутки за левый край хранит границу истории и защищает объединенный
    /// буфер от перезаписи очередным периодическим обновлением.
    /// </summary>
    private DateTime? _fixedTuneToUtc;

    /// <summary>
    /// Текст результата расчета PID-настроек по видимой области Tune-графика.
    /// </summary>
    private string _tuneStatusText = "";

    /// <summary>
    /// Тип текущей ошибки расчета. Код управляет контекстной справкой,
    /// а отображаемый текст остается кратким статусом для пользователя.
    /// </summary>
    private PidTuneIssueCode _tuneIssueCode = PidTuneIssueCode.None;

    /// <summary>
    /// Независимый текст результата проверки и сохранения тегов в панели Settings.
    /// Он не перезаписывает статус расчета, который отображается в панели PID Tune.
    /// </summary>
    private string _tuneSettingsStatusText = "";

    /// <summary>
    /// Цвет alert-статуса во вкладке Tune.
    /// </summary>
    private AlertStyle _tuneStatusStyle = AlertStyle.Info;

    /// <summary>
    /// Расчетная модель PID Tune. Теги и тренды приходят из Runtime,
    /// а это поле управляет только локальной формулой Kp/Ti/Td.
    /// </summary>
    private string _tuneCalculationModel = TuneModelFopdt;

    /// <summary>
    /// Выбранный метод расчета PID Tune из логики Excel-калькулятора.
    /// </summary>
    private string _tuneCalculationMethod = TuneMethodFopdtSimcPid;

    private double? _tuneFopdtK = 1.5;
    private double? _tuneFopdtTau = 120;
    private double? _tuneFopdtTheta = 15;
    private double? _tuneFopdtTauC = 15;
    private double? _tuneIntegratingKi = 0.0007;
    private double? _tuneIntegratingTheta = 20;
    private double? _tuneIntegratingTauC = 480;
    private double? _tuneClosedKu = 4;
    private double? _tuneClosedTu = 90;

    /// <summary>
    /// Read-only reference page PLC.
    /// </summary>
    private ParamPlcRefsResponse? _plcRefs;

    /// <summary>
    /// Read-only reference page DI/DO.
    /// </summary>
    private ParamDiDoRefsResponse? _diDoRefs;

    /// <summary>
    /// Read-only reference page DryRun.
    /// </summary>
    private ParamDryRunResponse? _dryRun;

    /// <summary>
    /// Read-only reference page ATV.
    /// </summary>
    private ParamAtvRefResponse? _atvRef;

    /// <summary>
    /// Индекс выбранной вкладки RadzenTabs.
    /// </summary>
    private string _selectedTabKey = GraphTabKey;

    /// <summary>
    /// Видимое live-окно графика в минутах.
    /// </summary>
    private int _windowMinutes = 30;

    /// <summary>
    /// Исторический буфер, который заранее загружается для плавной прокрутки графика.
    /// </summary>
    private int _trendHistoryMinutes = 240;

    /// <summary>
    /// Правая граница фиксированного исторического окна; null означает live-режим.
    /// </summary>
    private DateTime? _fixedTrendToUtc;

    /// <summary>
    /// Версия графика. Увеличение версии сбрасывает JS zoom state.
    /// </summary>
    private int _chartViewVersion;

    /// <summary>
    /// true, пока идет первая загрузка панели.
    /// </summary>
    private bool _isLoading;

    /// <summary>
    /// true, пока идет refresh snapshot/trend, чтобы не запускать параллельные опросы CtApi.
    /// </summary>
    private bool _isRefreshing;

    /// <summary>
    /// true, пока загружается выбранная reference page.
    /// </summary>
    private bool _isRefsLoading;

    /// <summary>
    /// true, пока выполняется write-запрос в Runtime.Service.
    /// </summary>
    private bool _isWriting;

    /// <summary>
    /// true, пока открыт Radzen write-dialog.
    /// Защищает switch-строки от повторного OpenAsync в рамках одного UI-клика.
    /// </summary>
    private bool _isWriteDialogOpen;

    /// <summary>
    /// Длительность импульса для Motor-кнопок Ack/Reset.
    /// WPF держал единицу около трех секунд, чтобы Citect успел обработать one-shot команду.
    /// </summary>
    private static readonly TimeSpan ParamPulseResetDelay = TimeSpan.FromSeconds(3);

    /// <summary>
    /// Защита от обновления UI после уничтожения компонента.
    /// </summary>
    private bool _isDisposed;

    /// <summary>
    /// Status message Param-панели.
    /// </summary>
    private string _statusText = "";

    /// <summary>
    /// Стиль status alert Param-панели.
    /// </summary>
    private AlertStyle _statusStyle = AlertStyle.Info;

    /// <summary>
    /// Param item, для которого открыт write editor.
    /// </summary>
    private bool _confirmWrites;

    /// <summary>
    /// Legacy-state для старого inline write-flow.
    /// Разметка этого flow уже удалена, а новые записи идут через ParamWriteDialog.
    /// Поля оставлены до отдельной чистки методов, чтобы не смешивать UI-перенос с большим refactor.
    /// </summary>
    private ParamItemDto? _writeItem;

    /// <summary>
    /// Legacy-value для старого inline write-flow.
    /// </summary>
    private string _writeValueText = "";

    /// <summary>
    /// Legacy-bool для старого inline write-flow.
    /// </summary>
    private bool _writeBooleanValue;

    /// <summary>
    /// Legacy-comment для старого inline write-flow; в новом flow комментарий формируется автоматически.
    /// </summary>
