    /// <summary>
    /// Собирает параметры формы Tune в DTO, который понимает общий PID-калькулятор.
    /// </summary>
    private PidTuneCalculationRequest BuildTuneCalculationRequest()
    {
        return new PidTuneCalculationRequest
        {
            ProcessModel = _tuneCalculationModel,
            TuneMethod = _tuneCalculationMethod,
            FopdtK = _tuneFopdtK,
            FopdtTau = _tuneFopdtTau,
            FopdtTheta = _tuneFopdtTheta,
            FopdtTauC = _tuneFopdtTauC,
            IntegratingKi = _tuneIntegratingKi,
            IntegratingTheta = _tuneIntegratingTheta,
            IntegratingTauC = _tuneIntegratingTauC,
            ClosedLoopKu = _tuneClosedKu,
            ClosedLoopTu = _tuneClosedTu
        };
    }

    /// <summary>
    /// Автоматически идентифицирует выбранную пользователем модель
    /// по фактически видимой области Tune-графика.
    ///
    /// FOPDT:
    ///     PV + OUT -> K, Tau, Theta, TauC.
    ///
    /// Integrating:
    ///     PV + OUT -> ki, Theta, TauC.
    ///
    /// ClosedLoop:
    ///     PV + online Test Kp -> Ku, Tu.
    ///
    /// После идентификации параметры передаются существующему
    /// PidTuneCalculator, который рассчитывает Kp/Ti/Td
    /// по выбранному методу настройки.
    /// </summary>
    private async Task CalculateTuneFromVisibleTrendAsync()
    {
        if (_tuneTrend is null)
            return;

        var selectedModel = _tuneCalculationModel;
        var selectedMethod = _tuneCalculationMethod;

        _isTuneCalculating = true;
        _tuneIssueCode = PidTuneIssueCode.None;

        try
        {
            var fromUtc = GetTuneVisibleFromUtc() ?? _tuneTrend.FromUtc;
            var toUtc = GetTuneVisibleToUtc() ?? _tuneTrend.ToUtc;
            var pv = GetTuneSamples("Pv", fromUtc, toUtc);

            IReadOnlyList<PidTuningSample> output = selectedModel == TuneModelClosedLoop
                    ? []
                    : GetTuneSamples("ManTune", fromUtc, toUtc);

            var identification = PidProcessIdentifier.Identify(selectedModel,pv,output,_tune?.TestKpValue);

            if (!identification.IsSuccess)
            {
                _tuneStatusStyle = AlertStyle.Warning;
                _tuneStatusText = identification.ErrorMessage;
                _tuneIssueCode = identification.IssueCode == PidTuneIssueCode.None ? PidTuneIssueCode.Unknown : identification.IssueCode;

                return;
            }

            switch (selectedModel)
            {
                case TuneModelFopdt:
                    _tuneFopdtK = identification.K;
                    _tuneFopdtTau = identification.Tau;
                    _tuneFopdtTheta = identification.Theta;
                    _tuneFopdtTauC = identification.TauC;

                    break;

                case TuneModelIntegrating:
                    _tuneIntegratingKi = identification.Ki;
                    _tuneIntegratingTheta = identification.Theta;
                    _tuneIntegratingTauC = identification.TauC;

                    break;

                case TuneModelClosedLoop:
                    _tuneClosedKu = identification.Ku;
                    _tuneClosedTu = identification.Tu;

                    break;
            }

             // Асинхронная работа не должна менять выбранные модель и метод настройки.
            _tuneCalculationModel = selectedModel;
            _tuneCalculationMethod = selectedMethod;

            var selectedTune = CalculateTune();

            if (!selectedTune.IsValid)
            {
                _tuneStatusStyle = AlertStyle.Warning;
                _tuneStatusText = selectedTune.Message;
                _tuneIssueCode = PidTuneIssueCode.InvalidControllerParameters;

                return;
            }

            _tuneStatusStyle = AlertStyle.Success;
            _tuneIssueCode = PidTuneIssueCode.None;
            _tuneStatusText = BuildTuneCalculationStatus(selectedModel, selectedTune, identification);

            NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "PID Tune",
                    Detail = "Calculation completed.",
                    Duration = 2500
                });
        }
        finally
        {
            _isTuneCalculating = false;

            if (!_isDisposed)
                await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Формирует итоговый статус расчета вместе с диагностикой
    /// качества автоматической идентификации.
    /// </summary>
    private string BuildTuneCalculationStatus(string processModel, PidTuneCalculationResult tuneResult, PidProcessIdentificationResult identification)
    {
        var modelParameters =
            processModel switch
            {
                TuneModelIntegrating =>
                    $"ki={FormatTuneNumber(_tuneIntegratingKi)}, "
                    + $"Theta={FormatTuneNumber(_tuneIntegratingTheta)}, "
                    + $"Tau c={FormatTuneNumber(_tuneIntegratingTauC)}",

                TuneModelClosedLoop =>
                    $"Ku={FormatTuneNumber(_tuneClosedKu)}, "
                    + $"Tu={FormatTuneNumber(_tuneClosedTu)}",

                _ =>
                    $"K={FormatTuneNumber(_tuneFopdtK)}, "
                    + $"Tau={FormatTuneNumber(_tuneFopdtTau)}, "
                    + $"Theta={FormatTuneNumber(_tuneFopdtTheta)}, "
                    + $"Tau c={FormatTuneNumber(_tuneFopdtTauC)}"
            };

        var controllerParameters =
            $"Kp={FormatTuneNumber(tuneResult.Kp)}, "
            + $"Ti={FormatTuneNumber(tuneResult.Ti)}, "
            + $"Td={FormatTuneNumber(tuneResult.Td)}";

        var quality =
            processModel switch
            {
                TuneModelClosedLoop =>
                    $"A={FormatTuneNumber(identification.OscillationAmplitude)}, "
                    + $"period CV={FormatTuneNumber(identification.PeriodCv)}, "
                    + $"amplitude CV={FormatTuneNumber(identification.AmplitudeCv)}, "
                    + $"amplitude ratio={FormatTuneNumber(identification.AmplitudeTrendRatio)}",

                _ =>
                    $"R²={FormatTuneNumber(identification.R2)}, "
                    + $"RMSE={FormatTuneNumber(identification.Rmse)}"
            };

        return
            $"Calculation completed. "
            + $"{modelParameters}, "
            + $"{controllerParameters}, "
            + $"{quality}, "
            + $"method={tuneResult.Message}, "
            + $"points={identification.PointsUsed}.";
    }


    /// <summary>
    /// Достает точки выбранной серии из текущего видимого окна Tune-графика.
    /// Для расчета используется RawValue, потому Value уже масштабирован в общую ось 0..100.
    /// </summary>
    private IReadOnlyList<PidTuningSample> GetTuneSamples(string seriesName, DateTime fromUtc, DateTime toUtc)
    {
        var normalizedFromUtc = NormalizeTrendPointUtc(fromUtc);
        var normalizedToUtc = NormalizeTrendPointUtc(toUtc);

        return _tuneTrend?.Points
            .Where(point => point.Series.Equals(seriesName, StringComparison.OrdinalIgnoreCase))
            .Select(point => new
            {
                TimeUtc = NormalizeTrendPointUtc(point.Time),
                point.RawValue
            })
            .Where(point => point.TimeUtc >= normalizedFromUtc
                            && point.TimeUtc <= normalizedToUtc
                            && !double.IsNaN(point.RawValue)
                            && !double.IsInfinity(point.RawValue))
            .OrderBy(point => point.TimeUtc)
            .Select(point => new PidTuningSample(point.TimeUtc, point.RawValue))
            .ToList()
            ?? [];
    }

    /// <summary>
    /// Приводит DateTime из DTO к UTC так же, как это делает ECharts-компонент.
    /// </summary>
    private static DateTime NormalizeTrendPointUtc(DateTime value)
    {
        return value.Kind switch
        {
            DateTimeKind.Utc => value,
            DateTimeKind.Local => value.ToUniversalTime(),
            _ => DateTime.SpecifyKind(value, DateTimeKind.Local).ToUniversalTime()
        };
    }

    /// <summary>
    /// Загружает сохраненные настройки PID Tune, текущие значения ManTune/PV/SP и line-тренды.
    /// </summary>
    private async Task LoadTuneAsync(string equipmentName, CancellationToken ct)
    {
        var draftSettings = _hasTuneSettingsLoadedFromStore
            && _tune?.Settings is not null
            && string.Equals(_tune.Settings.EquipmentName, equipmentName, StringComparison.OrdinalIgnoreCase)
                ? _tune.Settings
                : null;

        var runtimeTune = await ParamApi.GetTuneAsync(
            equipmentName,
            _trendHistoryMinutes,
            null,
            null,
            ct,
            draftSettings);

        if (draftSettings is not null)
            runtimeTune.Settings = draftSettings;
        else
            _hasTuneSettingsLoadedFromStore = true;

        _tune = runtimeTune;
        _tuneTrend = runtimeTune.Trend;
        _tuneVisibleFromUtc ??= runtimeTune.Trend?.ToUtc.AddMinutes(-_windowMinutes);
        _tuneVisibleToUtc ??= runtimeTune.Trend?.ToUtc;

        if (!string.IsNullOrWhiteSpace(runtimeTune.Message))
            _tuneStatusStyle = runtimeTune.Supported ? AlertStyle.Info : AlertStyle.Warning;
    }

    /// <summary>
    /// Проверяет PID Tune-теги одной операцией.
    ///
    /// PV/SP:
    ///     numeric TagRead + trend-reference.
    ///
    /// Test Kp:
    ///     только numeric TagRead.
    ///
    /// Для FOPDT/Integrating пустой Test Kp допустим.
    /// Для ClosedLoop Test Kp обязателен.
    /// Если Test Kp введён в любой модели, он всегда должен пройти Check.
    /// </summary>
    private async Task CheckTuneTagsAsync()
    {
        if (Equipment is null)
            return;

        var settings =
            EnsureTuneSettings();

        var pvTag =
            (settings.Pv ?? "").Trim();

        var spTag =
            (settings.Sp ?? "").Trim();

        var testKpTag =
            (settings.TestKpTag ?? "").Trim();

        if (string.IsNullOrWhiteSpace(pvTag)
            || string.IsNullOrWhiteSpace(spTag))
        {
            _tuneSettingsStatusText =
                string.IsNullOrWhiteSpace(pvTag)
                && string.IsNullOrWhiteSpace(spTag)
                    ? "Enter PV and SP trend tags."
                    : string.IsNullOrWhiteSpace(pvTag)
                        ? "Enter PV trend tag."
                        : "Enter SP trend tag.";

            return;
        }

        var testKpRequired =
            _tuneCalculationModel == TuneModelClosedLoop
            || !string.IsNullOrWhiteSpace(testKpTag);

        if (_tuneCalculationModel == TuneModelClosedLoop
            && string.IsNullOrWhiteSpace(testKpTag))
        {
            settings.TestKpFound = false;

            if (_tune is not null)
                _tune.TestKpValue = null;

            _tuneSettingsStatusText =
                "Enter Test Kp online tag for ClosedLoop.";

            return;
        }

        _isTuneChecking = true;

        _tuneSettingsStatusText =
            testKpRequired
                ? "Checking PV/SP trends and Test Kp online tag..."
                : "Checking PV and SP trend tags...";

        try
        {
            var pvResult =
                await ParamApi.CheckTuneTagAsync(
                    Equipment.Name,
                    new ParamTuneCheckRequest
                    {
                        TagName = pvTag,
                        RequireTrend = true
                    },
                    GetActiveLoadToken());

            var spResult =
                await ParamApi.CheckTuneTagAsync(
                    Equipment.Name,
                    new ParamTuneCheckRequest
                    {
                        TagName = spTag,
                        RequireTrend = true
                    },
                    GetActiveLoadToken());

            ParamTuneCheckResponse? testKpResult = null;

            if (testKpRequired)
            {
                testKpResult =
                    await ParamApi.CheckTuneTagAsync(
                        Equipment.Name,
                        new ParamTuneCheckRequest
                        {
                            TagName = testKpTag,
                            RequireTrend = false
                        },
                        GetActiveLoadToken());
            }

            settings.Pv =
                pvResult.TagName;

            settings.PvTrendFound =
                pvResult.Found;

            settings.Sp =
                spResult.TagName;

            settings.SpTrendFound =
                spResult.Found;

            if (testKpResult is not null)
            {
                settings.TestKpTag =
                    testKpResult.TagName;

                settings.TestKpFound =
                    testKpResult.Found;

                if (_tune is not null)
                {
                    _tune.TestKpValue =
                        testKpResult.CurrentValue;
                }
            }
            else
            {
                settings.TestKpFound = false;

                if (string.IsNullOrWhiteSpace(
                        settings.TestKpTag)
                    && _tune is not null)
                {
                    _tune.TestKpValue = null;
                }
            }

            _tuneSettingsStatusText =
                BuildTuneTagCheckStatus(
                    pvResult,
                    spResult,
                    testKpResult);

            /*
             * Перечитываем Runtime один раз:
             * график получает проверенные PV/SP,
             * а Test Kp - свежее online-значение.
             */
            await LoadTuneAsync(
                Equipment.Name,
                GetActiveLoadToken());
        }
        catch (OperationCanceledException)
            when (_isDisposed || !IsActive)
        {
        }
        catch (Exception ex)
        {
            _tuneSettingsStatusText =
                "Cannot check PID Tune tags: "
                + ex.Message;

            NotificationService.Notify(
                new NotificationMessage
                {
                    Severity =
                        NotificationSeverity.Error,

                    Summary =
                        "PID Tune",

                    Detail =
                        "Cannot check PID Tune tags.",

                    Duration =
                        3500
                });
        }
        finally
        {
            _isTuneChecking = false;

            if (!_isDisposed)
                StateHasChanged();
        }
    }

    /// <summary>
    /// Формирует единый статус PV/SP/Test Kp Check.
    /// </summary>
    private static string BuildTuneTagCheckStatus(ParamTuneCheckResponse pvResult, ParamTuneCheckResponse spResult, ParamTuneCheckResponse? testKpResult)
    {
        var allFound = pvResult.Found && spResult.Found && (testKpResult is null || testKpResult.Found);

        if (allFound)
        {
            return testKpResult is null
                ? "PV and SP trend tags found."
                : "PV/SP trend tags and Test Kp online tag found.";
        }

        var problems = new List<string>();
        AddTuneTagProblem(problems, "PV", pvResult);
        AddTuneTagProblem(problems, "SP", spResult);

        if (testKpResult is not null)
        {
            AddTuneTagProblem(problems, "Test Kp", testKpResult);
        }

        return string.Join(" ", problems);
    }

    /// <summary>
    /// Добавляет причину ошибки одного Tune-тега.
    /// Для online Test Kp отсутствие trend-reference не является ошибкой.
    /// </summary>
    private static void AddTuneTagProblem(ICollection<string> problems, string role, ParamTuneCheckResponse result)
    {
        if (result.Found)
            return;

        var tagName =
            string.IsNullOrWhiteSpace(
                result.TagName)
                ? "(empty)"
                : result.TagName;

        string reason;

        if (!result.TrendRequired)
        {
            reason =
                result.CurrentValue.HasValue
                    ? "online validation failed"
                    : "numeric online value was not read";
        }
        else
        {
            reason =
                result.TrendFound
                    ? "numeric value was not read"
                    : result.CurrentValue.HasValue
                        ? "trend reference was not found"
                        : "tag was not read and trend reference was not found";
        }

        problems.Add(
            $"{role} tag '{tagName}': {reason}.");
    }

    /// <summary>
    /// Сохраняет проверенные PV/SP/Test Kp теги,
    /// диапазоны и рассчитанные Kp/Ti/Td в PostgreSQL.
    /// </summary>
    private async Task SaveTuneAsync()
    {
        if (Equipment is null || !CanSaveTune)
            return;

        var settings = EnsureTuneSettings();
        var tuneResult = CalculateTune();

        if (!tuneResult.IsValid)
        {
            _tuneSettingsStatusText = tuneResult.Message;
            return;
        }

        _isTuneSaving = true;

        try
        {
            var saved =
                await ParamApi.SaveTuneAsync(Equipment.Name,
                    new ParamTuneSaveRequest
                    {
                        Pv = settings.Pv,
                        PvMin = settings.PvMin,
                        PvMax = settings.PvMax,

                        Sp = settings.Sp,
                        SpMin = settings.SpMin,
                        SpMax = settings.SpMax,

                        TestKpTag =
                            settings.TestKpTag,

                        Kp = tuneResult.Kp,
                        Ti = tuneResult.Ti,
                        Td = tuneResult.Td
                    },
                    GetActiveLoadToken());

            _tune ??= new ParamTuneRuntimeResponse
                    {
                        EquipmentName =
                            Equipment.Name,

                        TypeGroup =
                            Equipment.TypeGroup,

                        Supported =
                            true
                    };

            _tune.Settings = saved;

            _tuneSettingsStatusText = "PID Tune settings saved.";

            await LoadTuneAsync(Equipment.Name, GetActiveLoadToken());

            NotificationService.Notify(new NotificationMessage
                                        {
                                            Severity = NotificationSeverity.Success,
                                            Summary = "PID Tune",
                                            Detail = "Settings saved.",
                                            Duration = 2500
                                        });
        }
        catch (OperationCanceledException) when (_isDisposed || !IsActive)
        {
        }
        catch (Exception ex)
        {
            _tuneSettingsStatusText = "Cannot save Tune settings: " + ex.Message;

            NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "PID Tune",
                    Detail = "Cannot save Tune settings.",
                    Duration = 3500
                });
        }
        finally
        {
            _isTuneSaving = false;

            if (!_isDisposed)
                StateHasChanged();
        }
    }

    /// <summary>
    /// Сливает уже загруженный trend с новым historical chunk без дублей точек.
    /// </summary>
    private static ParamTrendResponse MergeTrends(
        ParamTrendResponse existing,
        ParamTrendResponse chunk)
    {
        var series = existing.Series.Count > 0
            ? existing.Series
            : chunk.Series;

        return new ParamTrendResponse
        {
            EquipmentName = existing.EquipmentName,
            TypeGroup = existing.TypeGroup,
            Supported = existing.Supported || chunk.Supported,
            Message = existing.Message,
            FromUtc = existing.FromUtc <= chunk.FromUtc ? existing.FromUtc : chunk.FromUtc,
            ToUtc = existing.ToUtc >= chunk.ToUtc ? existing.ToUtc : chunk.ToUtc,
            AxisYMin = existing.AxisYMin ?? chunk.AxisYMin,
            AxisYMax = existing.AxisYMax ?? chunk.AxisYMax,
            Series = series,
            Points = existing.Points
                .Concat(chunk.Points)
                .GroupBy(
                    point => new
                    {
                        Series = point.Series.ToUpperInvariant(),
                        Time = point.Time.Ticks
                    })
                .Select(group => group.First())
                .OrderBy(point => point.Time)
                .ThenBy(point => point.Series, StringComparer.OrdinalIgnoreCase)
                .ToList()
        };
    }

