    /// Обрабатывает переключение вкладок: Graph грузит trend,
    /// reference-вкладки грузят только свои read-only страницы.
    /// </summary>
    private async Task OnTabChangedAsync(int index)
    {
        var visibleTabs = GetVisibleTabInfos();
        _selectedTabKey = index >= 0 && index < visibleTabs.Count
            ? visibleTabs[index].Key
            : GraphTabKey;

        if (ShouldLoadVisibleTrend && _snapshot?.Supported == true)
        {
            await LoadAsync(showLoading: false, includeTrend: true, ct: GetActiveLoadToken());
            return;
        }

        if (_snapshot?.Supported == true)
            await LoadSelectedReferencePageAsync(GetActiveLoadToken());
    }

    /// <summary>
    /// Получает от JS-графика запрос подгрузить older/newer segment истории.
    /// </summary>
    private async Task OnChartHistoryRequestedAsync(string direction)
    {
        if (_isRefreshing)
            return;

        if (direction.Equals("older", StringComparison.OrdinalIgnoreCase) && CanScrollGraphBackward)
        {
            await LoadHistorySegmentAsync(direction);
            return;
        }

        if (direction.Equals("newer", StringComparison.OrdinalIgnoreCase) && CanScrollGraphForward)
        {
            await LoadHistorySegmentAsync(direction);
        }
    }

    /// <summary>
    /// Получает от общего ECharts-компонента запрос на соседний участок истории Tune.
    /// Направление и проверки совпадают с вкладкой Graph, но используются отдельные
    /// состояния, чтобы line-график Tune не менял историческое окно основного графика.
    /// </summary>
    private async Task OnTuneChartHistoryRequestedAsync(string direction)
    {
        if (_isRefreshing)
            return;

        if (direction.Equals("older", StringComparison.OrdinalIgnoreCase) && CanScrollTuneBackward)
        {
            await LoadTuneHistorySegmentAsync(direction);
            return;
        }

        if (direction.Equals("newer", StringComparison.OrdinalIgnoreCase) && CanScrollTuneForward)
            await LoadTuneHistorySegmentAsync(direction);
    }

