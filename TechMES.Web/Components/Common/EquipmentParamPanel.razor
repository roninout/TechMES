    /// <summary>
    /// Имя online-тега фактического Kp, с которым выполняется ClosedLoop-тест.
    ///
    /// При ручном изменении старый результат Check и старое online-значение
    /// сбрасываются, чтобы Ku нельзя было получить из устаревшего Test Kp.
    /// </summary>
    private string TuneTestKpTag
