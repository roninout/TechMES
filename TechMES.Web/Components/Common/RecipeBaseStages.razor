@page "/recipes/stages"
@using System.Net
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using TechMES.Contracts.Recipes
@implements IDisposable
@inject RecipeApiClient RecipeApi
@inject DialogService DialogService
@inject NotificationService Notifications
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ILogger<RecipeBaseStages> Logger
@inject ThemeService ThemeService

<PageTitle>Recipe stages</PageTitle>
<NavigationLock ConfirmExternalNavigation="@HasChanges" OnBeforeInternalNavigation="@BeforeNavigationAsync" />

<div class="stage-editor @StageThemeClass">

    <RecipeEditorHeader Title="Base recipe stages">
        <Left>
            <RecipeEditorNavigation View="stages" FamilyId="@_familyId" Disabled="@(_busy || _dialogOpen)" />
        </Left>
        <Right>
            <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light" Disabled="@_busy" Click="@RefreshAsync" />
            <RadzenButton Text="Save" Icon="save" Disabled="@(!CanSave)" Click="@SaveAsync" />
        </Right>
    </RecipeEditorHeader>

    @if (_error is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">@_error</RadzenAlert>
    }

    @if (_loaded && _catalog.Families.Count == 0 && !_busy)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false">No base recipes are configured. Create a base recipe first.</RadzenAlert>
    }
    else if (_familyId.HasValue || _busy)
    {
        <RadzenDropZoneContainer TItem="DragCard" Data="@DragItems" ItemSelector="@SelectItem" CanDrop="@CanDrop" Drop="@Drop" ItemRender="@RenderItem">

            <ChildContent>
                <div class="stage-editor-columns">
                    <aside class="stage-parameter-list">
                        <div class="stage-side-header">
                            <RadzenTextBox @bind-Value="_search" Immediate="true" Placeholder="Search parameters..." Style="width: 100%;" AriaLabel="Search parameters" />
                        </div>

                        <RadzenDropZone TItem="DragCard" Value="@(-1)" class="stage-source" />
                    </aside>

                    <section class="stage-main" aria-busy="@_busy">
                        @if (_busy)
                        {
                            <div class="stage-loading-overlay">
                                <JournalGridLoading />
                            </div>
                        }

                        <div class="stage-main-header">
                            <div class="stage-family-selector">
                                <RadzenDropDown @key="_revision" TValue="int?" Data="@_catalog.Families" TextProperty="Name" ValueProperty="Id" Value="@_familyId" Change="@ChangeFamilyAsync" AllowClear="false" Disabled="@(_busy || _dialogOpen)" Style="width: 100%;" AriaLabel="Base recipe" />
                            </div>

                            @if (_draft is not null)
                            {
                                <div class="stage-name-field">
                                    <label for="recipe-stage-name">Name</label>
                                    <RadzenTextBox id="recipe-stage-name" @bind-Value="_draft.Name" Immediate="true" Disabled="@(!CanEdit)" Style="width: 100%;" aria-label="Stage name" />
                                </div>

                                <div class="stage-code-field">
                                    <label for="recipe-stage-code">Code</label>
                                    <RadzenTextBox id="recipe-stage-code" @bind-Value="_draft.Code" Immediate="true" Disabled="@(!CanEdit)" Style="width: 80px;" aria-label="Template code" />
                                </div>
                            }

                            <div class="stage-main-actions">
                                <RadzenButton Text="New stage" Icon="add_circle_outline" ButtonStyle="ButtonStyle.Success" Shade="Shade.Lighter" Variant="Variant.Flat" Disabled="@(!CanManage)" Click="@NewStageAsync" />
                                <RadzenButton Text="Delete" Icon="delete_outline" ButtonStyle="ButtonStyle.Danger" Shade="Shade.Lighter" Variant="Variant.Flat" Disabled="@(!CanDeleteStage)" Click="@DeleteAsync" />
                            </div>

                            @if (_draft is not null && string.IsNullOrWhiteSpace(_draft.Code))
                            {
                                <small class="stage-validation">Code is required.</small>
                            }
                        </div>

                        @if (_draft is not null)
                        {
                            <div class="stage-canvas">
                                <div class="stage-slot-grid">
                                    @for (var i = 0; i < RecipeBaseStageDto.SlotCount; i++)
                                    {
                                        var slot = i;

                                        <RadzenDropZone @key="slot" TItem="DragCard" Value="@slot" class="stage-slot">
                                            <small class="stage-slot-number">@(slot + 1)</small>

                                            @if (_draft.Slots[slot] is null)
                                            {
                                                <span class="stage-empty">Drop parameter</span>
                                            }
                                        </RadzenDropZone>
                                    }
                                </div>

                                @if (_draft.Overflow.Count > 0)
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false">Place or remove the extra cards before saving. The stage has @RecipeBaseStageDto.SlotCount slots.</RadzenAlert>
                                    <RadzenDropZone TItem="DragCard" Value="@(-2)" class="stage-overflow" />
                                }
                            </div>
                        }
                        else if (!_busy)
                        {
                            <div class="stage-no-selection">Select a stage on the right or create a new stage.</div>
                        }
                    </section>

                    <aside class="stage-definition-list">
                        <div class="stage-side-header">
                            <RadzenTextBox @bind-Value="_stageSearch" Immediate="true" Placeholder="Search stages..." Style="width: 100%;" AriaLabel="Search stages" />
                        </div>

                        <div class="stage-definition-cards" role="group" aria-label="Stage templates">
                            @foreach (var stage in FilteredStages)
                            {
                                var selected = stage.Id == SelectedStageId;

                                <button @key="stage.Id" type="button" class="stage-definition-button @(selected ? "stage-definition-selected" : "")" aria-pressed="@(selected ? "true" : "false")" disabled="@(_busy || _dialogOpen)" @onclick="@(() => SelectStageAsync(stage.Id))">
                                    <RadzenCard class="stage-definition-card">
                                        <div class="stage-definition-content">
                                            <RadzenIcon Icon="view_agenda" class="stage-definition-icon" />

                                            <div class="stage-definition-text">
                                                <div class="stage-definition-code">@stage.Code</div>
                                                <div class="stage-definition-name">@stage.Name</div>
                                            </div>

                                            <div class="stage-definition-status">
                                                <RadzenBadge Text="@stage.ParameterCount.ToString()" BadgeStyle="BadgeStyle.Light" class="stage-definition-count" />

                                                @if (stage.UsedInRecipes)
                                                {
                                                    <span class="stage-definition-used" title="Used in recipes" aria-label="Used in recipes">
                                                        <RadzenIcon Icon="check_circle" />
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </RadzenCard>
                                </button>
                            }

                            @if (!FilteredStages.Any())
                            {
                                <small class="stage-hint">@(_stages.Count == 0 ? "No stages in this base recipe." : "No stages match the search.")</small>
                            }
                        </div>
                    </aside>
                </div>
            </ChildContent>

            <Template Context="card">
                <div class="stage-card">
                    <RecipeStageParameterCard Parameter="@card.Parameter" Removable="@(card.Zone != -1)" Compact="@(card.Zone != -1)" Used="@(card.Zone == -1 && IsUsed(card.Parameter.Id))" />

                    @if (card.Zone != -1)
                    {
                        <button type="button" class="stage-card-clear" disabled="@(!CanEdit)" title="Remove from stage" @onclick="@(() => Clear(card))" @onclick:stopPropagation="true">
                            <RadzenIcon Icon="close" />
                        </button>
                    }
                </div>
            </Template>
        </RadzenDropZoneContainer>
    }
</div>

@code {
        private sealed record DragCard(RecipeBaseParameterDto Parameter, int Zone);

    private readonly CancellationTokenSource _stop = new();
    private RecipeBaseParameterCatalogDto _catalog = new();
    private List<RecipeBaseStageDto> _stages = [];
    private RecipeBaseStageDto? _draft, _original;
    private int? _familyId;
    private int _revision;
    private string _search = "";
    private string _stageSearch = "";
    private string? _error;
    private bool _busy, _dialogOpen, _loaded, _canEdit, _uncertain, _disposed;

    private bool CanManage => _canEdit && !_busy && !_dialogOpen && !_uncertain && !_disposed && _familyId.HasValue;
    private bool CanDeleteStage => CanManage && _original is { Id: > 0 };
    private bool CanEdit => CanManage && _draft is not null;
    private bool HasChanges => _draft is not null && (_original is null || JsonSerializer.Serialize(_draft) != JsonSerializer.Serialize(_original));
    private bool CanSave => CanEdit && HasChanges && !string.IsNullOrWhiteSpace(_draft!.Name) && !string.IsNullOrWhiteSpace(_draft.Code) && _draft.Slots.Count == RecipeBaseStageDto.SlotCount && _draft.Overflow.Count == 0;
    private int? SelectedStageId => _draft is { Id: > 0 } ? _draft.Id : null;

    private string StageThemeClass => ThemeService.Theme?.Contains("dark", StringComparison.OrdinalIgnoreCase) == true ? "stage-editor-dark" : "stage-editor-light";

    /// <summary>Поиск стадий работает внутри текущего семейства и не меняет выбранный черновик.</summary>
    private IEnumerable<RecipeBaseStageDto> FilteredStages => _stages.Where(stage => stage.Name.Contains(_stageSearch.Trim(), StringComparison.OrdinalIgnoreCase) || stage.Code.Contains(_stageSearch.Trim(), StringComparison.OrdinalIgnoreCase));

    /// <summary>Обновляет цвет центральных карточек при переключении темы.</summary>
    private void OnThemeChanged() => _ = InvokeAsync(() => { if (!_disposed) StateHasChanged(); });

    /// <summary>Копирует определение вместе с коллекциями, не изменяя загруженный каталог.</summary>
    private static RecipeBaseStageDto Clone(RecipeBaseStageDto value) => JsonSerializer.Deserialize<RecipeBaseStageDto>(JsonSerializer.Serialize(value))!;

        /// <summary>Отмечает параметр в каталоге, пока он находится в ячейке или среди лишних карточек.</summary>
    private bool IsUsed(int parameterId) => _draft is not null && (_draft.Slots.Contains(parameterId) || _draft.Overflow.Contains(parameterId));

    /// <summary>Источник слева и занятые ячейки — разные drag items одного параметра.</summary>
    private List<DragCard> DragItems
    {
        get
        {
            var result = _catalog.Parameters.Where(parameter => parameter.BaseRecipeId == _familyId && (parameter.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || parameter.Tag.Contains(_search, StringComparison.OrdinalIgnoreCase))).OrderBy(parameter => parameter.Order).Select(parameter => new DragCard(parameter, -1)).ToList();

            RecipeBaseParameterDto Find(int id) => _catalog.Parameters.FirstOrDefault(parameter => parameter.Id == id) ?? new() { Id = id, Name = $"Parameter [{id}] — refresh metadata" };

            if (_draft is null) return result;

            for (var i = 0; i < RecipeBaseStageDto.SlotCount; i++)
                if (_draft.Slots[i] is int id) result.Add(new(Find(id), i));

            result.AddRange(_draft.Overflow.Select(id => new DragCard(Find(id), -2)));

            return result;
        }
    }

    /// <summary>Назначает карточку только её зоне.</summary>
    private bool SelectItem(DragCard item, Radzen.Blazor.RadzenDropZone<DragCard> zone) => zone.Value is int value && item.Zone == value;

    /// <summary>Запрещает чужие семейства, дубликаты и незаметную замену занятого слота.</summary>
    private bool CanDrop(RadzenDropZoneItemEventArgs<DragCard> args)
    {
        if (!CanEdit || args.Item is not { } item || args.ToZone?.Value is not int target) return false;

        var validSource = item.Zone == -1 ? !IsUsed(item.Parameter.Id)
            : item.Zone == -2 ? _draft!.Overflow.Contains(item.Parameter.Id)
            : item.Zone >= 0 && item.Zone < RecipeBaseStageDto.SlotCount && _draft!.Slots[item.Zone] == item.Parameter.Id;

        if (!validSource) return false;
        if (target == -1) return item.Zone != -1;
        if (target < 0 || target >= RecipeBaseStageDto.SlotCount || target == item.Zone || item.Parameter.BaseRecipeId != _familyId) return false;

        return item.Zone >= 0 || _draft!.Slots[target] is null;
    }

    /// <summary>Слева копируем; между слотами переносим или меняем карточки местами.</summary>
    private void Drop(RadzenDropZoneItemEventArgs<DragCard> args)
    {
        if (!CanDrop(args) || args.Item is not { } item || args.ToZone?.Value is not int target) return;

        if (target == -1)
        {
            Clear(item);
            return;
        }

        if (item.Zone >= 0) _draft!.Slots[item.Zone] = _draft.Slots[target];
        else if (item.Zone == -2) _draft!.Overflow.Remove(item.Parameter.Id);

        _draft!.Slots[target] = item.Parameter.Id;
    }

    /// <summary>Очистка меняет только черновик; удаление значений подтверждается при Save.</summary>
    private void Clear(DragCard item)
    {
        if (!CanEdit) return;

        if (item.Zone == -2) _draft!.Overflow.Remove(item.Parameter.Id);
        else if (item.Zone >= 0 && item.Zone < RecipeBaseStageDto.SlotCount && _draft!.Slots[item.Zone] == item.Parameter.Id) _draft.Slots[item.Zone] = null;
    }

    /// <summary>Блокирует перетаскивание использованных карточек каталога и весь Drag & Drop в режиме чтения.</summary>
    private void RenderItem(RadzenDropZoneItemRenderEventArgs<DragCard> args)
    {
        var usedSource = args.Item is { Zone: -1 } item && IsUsed(item.Parameter.Id);

        args.Attributes["draggable"] = CanEdit && !usedSource ? "true" : "false";
    }

    /// <summary>Подключает смену темы и загружает семейство с учётом текущего пользователя.</summary>
    protected override async Task OnInitializedAsync()
    {
        ThemeService.ThemeChanged += OnThemeChanged;

        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (_disposed) return;

        _canEdit = state.User.Identity?.IsAuthenticated == true;

        await ReloadAsync(RecipeEditorNavigation.ReadFamily(Navigation.Uri), null);
    }

    /// <summary>Применяет новый снимок только после успешного завершения обоих запросов.</summary>
    private async Task LoadCoreAsync(int? familyId, int? selectedId, CancellationToken ct)
    {
        var catalog = await RecipeApi.GetBaseParametersAsync(ct);
        var family = catalog.Families.FirstOrDefault(item => item.Id == familyId) ?? catalog.Families.FirstOrDefault();
        var stages = family is null ? [] : await RecipeApi.GetBaseStagesAsync(family.Id, ct);

        ct.ThrowIfCancellationRequested();

        _catalog = catalog;
        _familyId = family?.Id;
        _stages = stages;

        var selected = stages.FirstOrDefault(stage => stage.Id == selectedId) ?? stages.FirstOrDefault();

        _original = selected is null ? null : Clone(selected);
        _draft = selected is null ? null : Clone(selected);
        _loaded = true;
        _uncertain = false;
        _revision++;
    }

    /// <summary>Управляет загрузкой и сохраняет старый черновик при ошибке запроса.</summary>
    private async Task ReloadAsync(int? familyId, int? selectedId)
    {
        if (_busy || _disposed) return;

        _busy = true;
        _error = null;

        var ct = _stop.Token;

        try
        {
            await LoadCoreAsync(familyId, selectedId, ct);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load stage templates.");

            if (!_disposed) _error = ex.Message;
        }
        finally
        {
            _busy = false;
            _revision++;
        }
    }

    /// <summary>Подтверждает отказ от черновика перед сменой контекста.</summary>
    private async Task<bool> DiscardAsync()
    {
        if (!HasChanges) return true;

        _dialogOpen = true;

        try
        {
            return await DialogService.Confirm("Discard unsaved stage changes?", "Unsaved changes") == true && !_disposed;
        }
        finally
        {
            _dialogOpen = false;
        }
    }

    /// <summary>Меняет семейство целиком: параметры, список стадий и выбранный шаблон.</summary>
    private async Task ChangeFamilyAsync(object value)
    {
        if (_busy || _dialogOpen || _disposed || value is not int id || id == _familyId) return;

        if (!await DiscardAsync())
        {
            _revision++;
            return;
        }

        await ReloadAsync(id, null);

        if (!_disposed && _familyId == id && !HasChanges)
            Navigation.NavigateTo($"/recipes/stages?family={id}", replace: true);
    }

    /// <summary>Переключает шаблон без скрытого сохранения предыдущего.</summary>
    private async Task SelectStageAsync(object value)
    {
        if (_busy || _dialogOpen || _disposed || value is not int id || id == SelectedStageId) return;

        if (!await DiscardAsync())
        {
            _revision++;
            return;
        }

        var stage = _stages.FirstOrDefault(item => item.Id == id);

        _original = stage is null ? null : Clone(stage);
        _draft = stage is null ? null : Clone(stage);
        _revision++;
    }

    /// <summary>Создаёт локальное определение, которое получит ID только после Save.</summary>
    private async Task NewStageAsync()
    {
        if (!CanManage || !await DiscardAsync()) return;

        _original = null;
        _draft = new() { FamilyId = _familyId!.Value, Name = "New stage" };
        _revision++;
    }

    /// <summary>Перечитывает каталог после подтверждения отказа от черновика.</summary>
    private async Task RefreshAsync()
    {
        if (_busy || _dialogOpen || _disposed || !await DiscardAsync()) return;

        await ReloadAsync(_familyId, SelectedStageId);
    }

    /// <summary>Сохраняет черновик через общий анализ и подтверждение.</summary>
    private Task SaveAsync() => CanSave ? ExecuteStageChangeAsync(false) : Task.CompletedTask;

    /// <summary>Анализирует удаление сохранённой стадии; использование в рецептах проверяет сервер.</summary>
    private async Task DeleteAsync()
    {
        if (!CanDeleteStage || !await DiscardAsync()) return;

        await ExecuteStageChangeAsync(true);
    }

    /// <summary>Выполняет подтверждённое сохранение или удаление без автоматического повтора запроса.</summary>
    private async Task ExecuteStageChangeAsync(bool delete)
    {
        if (delete ? !CanDeleteStage : !CanSave) return;

        var value = delete ? _original! : _draft!;
        var request = new RecipeBaseStageRequest { FamilyId = _familyId!.Value, Original = _original is null ? null : Clone(_original), Value = Clone(value), Delete = delete };
        var ct = _stop.Token;
        var started = false;
        var completed = false;

        _busy = true;
        _error = null;

        try
        {
            var preview = await RecipeApi.PreviewBaseStageAsync(request, ct);
            ct.ThrowIfCancellationRequested();

            _dialogOpen = true;
            var confirmed = await DialogService.OpenAsync<RecipeBaseStagePreviewDialog>(delete ? "Review stage deletion" : "Review stage synchronization", new Dictionary<string, object?> { [nameof(RecipeBaseStagePreviewDialog.Preview)] = preview }, new DialogOptions { Width = "min(1100px, 96vw)", CloseDialogOnOverlayClick = false });
            _dialogOpen = false;

            ct.ThrowIfCancellationRequested();

            if (confirmed is not bool accepted || !accepted || !preview.CanSave) return;

            request.PreviewToken = preview.Token;
            started = true;

            var result = await RecipeApi.SaveBaseStageAsync(request, ct);

            if (result.Status != RecipeChangeStatus.Saved || result.StageId <= 0)
                throw new InvalidOperationException("Unexpected stage operation result. Press Refresh.");

            completed = true;
            _uncertain = true;

            await LoadCoreAsync(_familyId, delete ? null : result.StageId, ct);

            Notifications.Notify(NotificationSeverity.Success, "Recipe stages", delete ? "Stage deleted." : "Stage saved and all recipe instances synchronized.", 3500);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Stage operation failed. Delete={Delete}", delete);

            if (!_disposed)
            {
                var rejected = ex is HttpRequestException { StatusCode: HttpStatusCode.BadRequest or HttpStatusCode.Forbidden or HttpStatusCode.Conflict };
                _uncertain = started && !rejected;

                _error = completed ? "Operation completed, but reload failed. Press Refresh. " + ex.Message : _uncertain ? "Operation result is uncertain. Press Refresh before editing again. " + ex.Message : ex.Message;
            }
        }
        finally
        {
            _busy = false;
            _dialogOpen = false;
        }
    }

    /// <summary>Защищает черновик и незавершённую запись при переходе между режимами.</summary>
    private async Task BeforeNavigationAsync(LocationChangingContext context)
    {
        if (_busy || _dialogOpen || !await DiscardAsync()) context.PreventNavigation();
    }

    /// <summary>Отключает события темы, останавливает запросы и закрывает принадлежащий странице диалог.</summary>
    public void Dispose()
    {
        _disposed = true;
        ThemeService.ThemeChanged -= OnThemeChanged;
        _stop.Cancel();

        if (_dialogOpen) DialogService.Close();

        _stop.Dispose();
    }
}