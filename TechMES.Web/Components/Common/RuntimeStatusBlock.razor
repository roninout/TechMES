@inject RuntimeStatusApiClient RuntimeStatusApi
@inject RuntimeEndpointSelector RuntimeEndpoints
@inject IConfiguration Configuration
@implements IAsyncDisposable

@{
    var replication = SelectReplicationSnapshot();
}

<section class="runtime-diagnostics" aria-label="Диагностика серверов TechMES">
    <div class="diagnostics-summary">
        <span class="summary-item" title="Компьютер, на котором выполняется этот экземпляр WEB">
            <RadzenIcon Icon="desktop_windows" aria-hidden="true" />
            <strong>WEB</strong> @Environment.MachineName
        </span>

        <span class="summary-item @RoutingTone" aria-live="polite" title="Готовый Runtime по последнему опросу. Перед каждым рабочим запросом адрес проверяется заново.">
            <RadzenIcon Icon="@RoutingIcon" aria-hidden="true" />
            @RoutingText
        </span>

        <span class="checked-time" title="Время последнего прямого опроса Runtime">
            <RadzenIcon Icon="schedule" aria-hidden="true" />
            @CheckedText
        </span>

        <details class="diagnostics-details">
            <summary>
                <RadzenIcon Icon="info" aria-hidden="true" />
                Подробнее
            </summary>

            <div class="details-panel">
                <strong>Диагностика узлов</strong>

                @if (!string.IsNullOrEmpty(_activityError))
                {
                    <p class="tone-danger">@_activityError</p>
                }

                @for (var index = 0; index < _states.Length; index++)
                {
                    var state = _states[index];
                    <article>
                        <strong>@state.Endpoint.Authority</strong>
                        <pre>@BuildRuntimeHint(state)</pre>
                        <pre>@(DescribeCalc(index).Hint)</pre>
                    </article>
                }

                @if (_states.Length == 1)
                {
                    <p>Второй отдельный адрес Runtime отсутствует.</p>
                }

                <div class="health-details">
                    <strong>WEB и Host по профилям</strong>
                    @for (var index = 0; index < 2; index++)
                    {
                        <article>
                            <strong>@(index == 0 ? "Primary" : "Secondary")</strong>
                            <pre>WEB: @DescribeWeb(index).Hint</pre>
                            <pre>Host: @DescribeHost(index).Hint</pre>
                        </article>
                    }
                </div>

                <div class="health-details">
                    <strong>Репликация PostgreSQL</strong>
                    @if (replication is { } snapshot)
                    {
                        <p>Снимок Runtime @snapshot.Endpoint.Authority · @(snapshot.Snapshot!.PostgreSql.Topology)</p>
                        @for (var index = 0; index < 2; index++)
                        {
                            <pre>@(DescribeReplication(replication, index).Hint)</pre>
                        }
                    }
                    else
                    {
                        <p>Данные о репликации пока недоступны.</p>
                    }
                </div>

                <div class="health-details">
                    Messages storage: @(CurrentHealth?.MessageStorageProvider ?? "Unknown")
                    · Health: @(_healthReadAt?.ToLocalTime().ToString("HH:mm:ss") ?? "—")
                </div>

                @if (!string.IsNullOrEmpty(_healthError))
                {
                    <div class="tone-warning">Health: @_healthError</div>
                }
            </div>
        </details>

        <button type="button" class="diagnostic-refresh" disabled="@(_isLoading || _isServiceLoading)" @onclick="RefreshAsync" title="Обновить диагностику" aria-label="Обновить диагностику">
            <RadzenIcon Icon="refresh" aria-hidden="true" />
        </button>
    </div>

    <div class="diagnostics-body">
        <div class="dependency-table" aria-label="Диагностика SCADA, Runtime, WEB, Host, Calc и баз данных">
            <span class="dependency-heading">Профиль</span>

            <span class="dependency-heading">
                <RadzenIcon Icon="settings_ethernet" aria-hidden="true" />
                SCADA
            </span>

            <span class="dependency-heading" title="Режим каждого настроенного Runtime">
                <RadzenIcon Icon="dns" aria-hidden="true" />
                Runtime
            </span>

            <span class="dependency-heading" title="Прямой health WEB по адресу каждого профиля">
                <RadzenIcon Icon="desktop_windows" aria-hidden="true" />
                WEB
            </span>

            <span class="dependency-heading" title="Host, VIP и автоматика на каждом узле">
                <RadzenIcon Icon="hub" aria-hidden="true" />
                Host
            </span>

            <span class="dependency-heading" title="Calc 1 и Calc 2 относятся к адресам Runtime 1 и Runtime 2">
                <RadzenIcon Icon="calculate" aria-hidden="true" />
                Calc
            </span>

            <span class="dependency-heading">
                <RadzenIcon Icon="dns" aria-hidden="true" />
                ODBC
            </span>

            <span class="dependency-heading">
                <RadzenIcon Icon="storage" aria-hidden="true" />
                Main DB
            </span>

            <span class="dependency-heading" title="Репликация по профилям Main DB">
                <RadzenIcon Icon="sync" aria-hidden="true" />
                PostgreSQL
            </span>

            <div class="server-status-column server-roles">
                <span>Primary</span>
                <span>Secondary</span>
            </div>

            <ScadaServerStatusBlock />

            <div class="server-status-column" aria-label="Режимы обоих Runtime" aria-live="polite">
                @for (var index = 0; index < 2; index++)
                {
                    var runtime = DescribeRuntime(index);
                    <RadzenBadge Text="@($"Runtime {index + 1}: {runtime.Text}")" BadgeStyle="@runtime.Style" title="@runtime.Hint" />
                }
            </div>

            <div class="server-status-column" aria-label="Состояние WEB на каждом узле">
                @for (var index = 0; index < 2; index++)
                {
                    var web = DescribeWeb(index);
                    <RadzenBadge Text="@($"WEB {index + 1}: {web.Text}")" BadgeStyle="@web.Style" title="@web.Hint" />
                }
            </div>

            <div class="server-status-column" aria-label="Состояние Host, VIP и автоматики на каждом узле">
                @for (var index = 0; index < 2; index++)
                {
                    var host = DescribeHost(index);
                    var probe = NodeServicesAt(index)?.Host;
                    var owner = probe?.Ownership;
                    <div class="host-status-row">
                        <RadzenBadge Text="@($"Host: {host.Text}")" BadgeStyle="@host.Style" title="@host.Hint" />
                        @if (probe?.Online == true)
                        {
                            var vip = DescribeVip(owner);
                            <RadzenBadge Text="@($"VIP: {vip.Text}")" BadgeStyle="@vip.Style" title="@host.Hint" />
                        }
                        @if (owner is not null)
                        {
                            <RadzenBadge Text="@($"Epoch: {owner.Grant.Epoch}")" BadgeStyle="BadgeStyle.Base" title="@host.Hint" />
                            @if (owner.Node == owner.Coordinator && owner.WebFailover is { } auto)
                            {
                                var style = auto.State == "Blocked" ? BadgeStyle.Warning : auto.Enabled ? BadgeStyle.Info : BadgeStyle.Base;
                                <RadzenBadge Text="@($"Auto: {auto.State}")" BadgeStyle="@style" title="@auto.Details" />
                            }
                        }
                    </div>
                }
            </div>

            <div class="server-status-column" aria-label="Локальная служба Calc на каждом Runtime">
                @for (var index = 0; index < 2; index++)
                {
                    var calc = DescribeCalc(index);
                    <RadzenBadge Text="@($"Calc {index + 1}: {calc.Text}")" BadgeStyle="@calc.Style" title="@calc.Hint" />
                }
            </div>

            <OdbcServerStatusBlock />
            <MainDatabaseStatusBlock />

            <div class="server-status-column" aria-label="Репликация PostgreSQL по профилям Main DB">
                @for (var index = 0; index < 2; index++)
                {
                    var wal = DescribeReplication(replication, index);
                    <RadzenBadge Text="@($"WAL: {wal.Text}")" BadgeStyle="@wal.Style" title="@wal.Hint" />
                }
            </div>

        </div>

        <div class="runtime-nodes" aria-label="Адреса, команды и операции Runtime">
            @for (var index = 0; index < 2; index++)
            {
                var state = _states.ElementAtOrDefault(index);
                var unconfigured = index == 1 && _states.Length == 1;

                <div class="runtime-node" title="@(state is null ? unconfigured ? "Второй адрес пустой или совпадает с первым." : "Ожидание данных Runtime." : BuildRuntimeHint(state))">
                    <span class="node-address">
                        @(state?.Endpoint.Authority ?? (unconfigured ? "нет отдельного адреса" : "—"))
                    </span>

                    <span class="node-commands" title="Разрешение рабочих команд данным Runtime">
                        <RadzenIcon Icon="@(IsReady(state) ? "verified_user" : "lock")" aria-hidden="true" />
                        @(state?.Activity is null || !IsFresh(state) ? "Команды: ?" : state.Activity.CanExecuteCommands ? "Команды: да" : "Команды: нет")
                    </span>

                    <span class="node-operations" title="Число выполняющихся операций">
                        Ops: @(IsFresh(state) ? state?.Activity?.PendingOperations.ToString() ?? "—" : "—")
                    </span>
                </div>
            }
        </div>
    </div>
</section>
