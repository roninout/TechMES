@inject RuntimeStatusApiClient RuntimeStatusApi
@inject RuntimeEndpointSelector RuntimeEndpoints
@implements IAsyncDisposable

<section class="runtime-diagnostics" aria-label="Диагностика серверов TechMES">
    <div class="diagnostics-summary">
        <span class="summary-item" title="Компьютер, на котором выполняется этот экземпляр WEB">
            <RadzenIcon Icon="desktop_windows" aria-hidden="true" />
            <strong>WEB</strong> @Environment.MachineName
        </span>

        <span class="summary-item @RoutingTone" aria-live="polite" title="Готовый Runtime по последнему опросу. Перед каждым рабочим запросом адрес проверяется заново.">
            <RadzenIcon Icon="@RoutingIcon" aria-hidden="true" />
            @RoutingText
        </span>

        <span class="checked-time" title="Время последнего прямого опроса Runtime">
            <RadzenIcon Icon="schedule" aria-hidden="true" />
            @CheckedText
        </span>

        <details class="diagnostics-details">
            <summary>
                <RadzenIcon Icon="info_outline" aria-hidden="true" />
                Подробнее
            </summary>

            <div class="details-panel">
                <strong>Runtime — состояние каждого узла</strong>

                @if (!string.IsNullOrEmpty(_activityError))
                {
                    <p class="tone-danger">@_activityError</p>
                }

                @foreach (var state in _states)
                {
                    <article>
                        <strong>@state.Endpoint.Authority</strong>
                        <pre>@BuildRuntimeHint(state)</pre>
                    </article>
                }

                @if (_states.Length == 1)
                {
                    <p>Второй отдельный адрес Runtime отсутствует.</p>
                }

                <div class="health-details">
                    Messages storage: @(CurrentHealth?.MessageStorageProvider ?? "Unknown")
                    · Health: @(_healthReadAt?.ToLocalTime().ToString("HH:mm:ss") ?? "—")
                </div>

                @if (!string.IsNullOrEmpty(_healthError))
                {
                    <div class="tone-warning">Health: @_healthError</div>
                }
            </div>
        </details>

        <button type="button" class="diagnostic-refresh" disabled="@_isLoading" @onclick="RefreshAsync" title="Обновить Runtime и health" aria-label="Обновить диагностику Runtime">
            <RadzenIcon Icon="refresh" aria-hidden="true" />
        </button>
    </div>

    <div class="diagnostics-body">
        <div class="dependency-table" aria-label="Зависимости: строки Primary и Secondary относятся к профилям подключения">
            <span class="dependency-heading">Профиль</span>
            <span class="dependency-heading">
                <RadzenIcon Icon="settings_ethernet" aria-hidden="true" />
                SCADA
            </span>
            <span class="dependency-heading">
                <RadzenIcon Icon="dns" aria-hidden="true" />
                ODBC
            </span>
            <span class="dependency-heading">
                <RadzenIcon Icon="storage" aria-hidden="true" />
                Main DB
            </span>

            <div class="server-status-column server-roles">
                <span>Primary</span>
                <span>Secondary</span>
            </div>

            <ScadaServerStatusBlock />
            <OdbcServerStatusBlock />
            <MainDatabaseStatusBlock />
        </div>

        <div class="runtime-nodes" aria-label="Режимы обоих Runtime">
            @for (var index = 0; index < 2; index++)
            {
                var state = _states.ElementAtOrDefault(index);
                var unconfigured = index == 1 && _states.Length == 1;

                <div class="runtime-node" title="@(state is null ? unconfigured ? "Второй адрес пустой или совпадает с первым." : "Ожидание данных Runtime." : BuildRuntimeHint(state))">
                    <span class="node-label">
                        <RadzenIcon Icon="dns" aria-hidden="true" />
                        Runtime @(index + 1)
                    </span>

                    <span class="node-address">
                        @(state?.Endpoint.Authority ?? (unconfigured ? "нет отдельного адреса" : "—"))
                    </span>

                    <span class="state-pill @(unconfigured ? "tone-muted" : NodeTone(state))" aria-live="polite">
                        <RadzenIcon Icon="@(unconfigured ? "remove_circle_outline" : NodeIcon(state))" aria-hidden="true" />
                        @(unconfigured ? "Disabled" : NodeText(state))
                    </span>

                    <span class="node-commands" title="Разрешение рабочих команд данным Runtime">
                        <RadzenIcon Icon="@(IsReady(state) ? "verified_user" : "lock_outline")" aria-hidden="true" />
                        @(state?.Activity is null || !IsFresh(state) ? "Команды: ?" : state.Activity.CanExecuteCommands ? "Команды: да" : "Команды: нет")
                    </span>

                    <span class="node-operations" title="Число выполняющихся операций">
                        Ops: @(IsFresh(state) ? state?.Activity?.PendingOperations.ToString() ?? "—" : "—")
                    </span>
                </div>
            }
        </div>
    </div>
</section>