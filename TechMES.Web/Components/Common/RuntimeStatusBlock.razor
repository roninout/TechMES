@using TechMES.Contracts.Runtime
@inject RuntimeStatusApiClient RuntimeStatusApi
@implements IAsyncDisposable

<div class="runtime-status">
    <div class="server-status-column server-roles" aria-hidden="true">
        <span>Primary</span>
        <span>Secondary</span>
    </div>

    <ScadaServerStatusBlock />
    <OdbcServerStatusBlock />
    <MainDatabaseStatusBlock />

    <div class="runtime-details" title="@BuildRuntimeHint()">
        <div class="runtime-badges" role="status" aria-live="polite">
            <RadzenBadge Text="@GetRuntimeText()" BadgeStyle="@GetRuntimeStyle()" />
        </div>

        <span class="runtime-storage">@GetRuntimeDetails()</span>
    </div>

    <RadzenButton class="status-refresh" Icon="refresh" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Disabled="@_isLoading" Click="@RefreshAsync" title="Refresh Runtime status" />
</div>

@code {
    private readonly CancellationTokenSource _stop = new();
    private readonly PeriodicTimer _activityTimer = new(TimeSpan.FromSeconds(5));
    private readonly PeriodicTimer _healthTimer = new(TimeSpan.FromSeconds(30));

    private RuntimeActivityStatusResponse? _activity;
    private RuntimeHealthResponse? _health;
    private DateTimeOffset? _activityReadAt;
    private bool _isLoading;
    private bool _isHealthLoading;
    private bool _disposed;
    private string _activityError = "";
    private string _healthError = "";
    private Task? _activityLoop;
    private Task? _healthLoop;

    protected override async Task OnInitializedAsync()
    {
        // Общая проверка хранилища не задерживает получение режима Runtime.
        _healthLoop = RunHealthLoopAsync(_stop.Token);

        await RefreshActivityAsync();

        if (!_disposed)
            _activityLoop = RunActivityLoopAsync(_stop.Token);
    }

    /// <summary>
    /// Кнопка обновляет обе части диагностики.
    /// Проверка хранилища не блокирует отдельный периодический опрос режима.
    /// </summary>
    private async Task RefreshAsync()
    {
        await Task.WhenAll(RefreshActivityAsync(), RefreshHealthAsync());
    }

    /// <summary>
    /// Endpoint возвращает только состояние процесса из памяти Runtime.
    /// Active/Standby не определяются по доступности PostgreSQL.
    /// </summary>
    private async Task RefreshActivityAsync()
    {
        if (_disposed || _isLoading)
            return;

        _isLoading = true;

        try
        {
            var activity = await RuntimeStatusApi.GetActivityStatusAsync(_stop.Token);

            if (_disposed)
                return;

            _activity = activity;
            _activityReadAt = DateTimeOffset.Now;
            _activityError = "";
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            // Старый зелёный статус не сохраняем после потери связи с Runtime.
            _activity = null;
            _activityError = ex.Message;
        }
        finally
        {
            _isLoading = false;

            if (!_disposed)
                StateHasChanged();
        }
    }

    /// <summary>
    /// Сохраняет прежнюю проверку /api/health раз в 30 секунд.
    /// Она используется для информации о хранилище, отдельно от режима Runtime.
    /// </summary>
    private async Task RefreshHealthAsync()
    {
        if (_disposed || _isHealthLoading)
            return;

        _isHealthLoading = true;

        try
        {
            var health = await RuntimeStatusApi.GetHealthAsync(_stop.Token);

            if (_disposed)
                return;

            _health = health;
            _healthError = health.Error ?? "";
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _health = null;
            _healthError = ex.Message;
        }
        finally
        {
            _isHealthLoading = false;

            if (!_disposed)
                StateHasChanged();
        }
    }

    /// <summary>
    /// Обновляет режим Runtime независимо от длительности проверки хранилища.
    /// </summary>
    private async Task RunActivityLoopAsync(CancellationToken ct)
    {
        try
        {
            while (await _activityTimer.WaitForNextTickAsync(ct))
                await InvokeAsync(RefreshActivityAsync);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
    }

    private async Task RunHealthLoopAsync(CancellationToken ct)
    {
        try
        {
            do
            {
                await InvokeAsync(RefreshHealthAsync);
            }
            while (await _healthTimer.WaitForNextTickAsync(ct));
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
    }

    private string GetRuntimeText()
    {
        if (_activity is not null)
            return $"Runtime: {_activity.Mode}";

        return _activityError.Length > 0 ? "Runtime: Offline" : "Runtime: Checking...";
    }

    private BadgeStyle GetRuntimeStyle()
    {
        if (_activity is null)
            return _activityError.Length > 0 ? BadgeStyle.Danger : BadgeStyle.Light;

        return _activity.Mode switch
        {
            "Active" => _activity.CanExecuteCommands ? BadgeStyle.Success : BadgeStyle.Warning,
            "Standby" => BadgeStyle.Info,
            "Starting" or "Draining" => BadgeStyle.Warning,
            "Faulted" => BadgeStyle.Danger,
            _ => BadgeStyle.Light
        };
    }

    private string GetRuntimeDetails()
    {
        var operations = _activity is null ? "?" : _activity.PendingOperations.ToString();
        var storage = _health?.MessageStorageProvider ?? "Unknown";

        return $"Ops: {operations} · {storage}";
    }

    /// <summary>
    /// Подробности доступны наведением на обе строки существующей колонки Runtime.
    /// </summary>
    private string BuildRuntimeHint()
    {
        var storage = $"Storage: {_health?.MessageStorageProvider ?? "Unknown"}";
        var healthError = _healthError.Length == 0 ? "" : $"\nHealth error: {_healthError}";

        if (_activity is null)
            return $"{(_activityError.Length > 0 ? _activityError : "Waiting for Runtime status.")}\n{storage}{healthError}";

        var commands = _activity.CanExecuteCommands ? "Allowed" : "Blocked";
        var requested = _activity.StandbyRequested ? "Standby" : "Active";
        var changed = _activity.ChangedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss");
        var received = _activityReadAt?.ToString("dd.MM.yyyy HH:mm:ss") ?? "Unknown";

        return $"Node: {_activity.NodeId}\nMode: {_activity.Mode}\nRequested: {requested}\nCommands: {commands}\nPending operations: {_activity.PendingOperations}\nInstance: {_activity.InstanceId}\nActivation: {_activity.ActivationId ?? "None"}\nChanged: {changed}\nReceived: {received}\nReason: {_activity.Reason}\n{storage}{healthError}";
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;
        _stop.Cancel();
        _activityTimer.Dispose();
        _healthTimer.Dispose();

        try
        {
            await Task.WhenAll(_activityLoop ?? Task.CompletedTask, _healthLoop ?? Task.CompletedTask);
        }
        finally
        {
            _stop.Dispose();
        }
    }
}