@inject RuntimeStatusApiClient RuntimeStatusApi
@implements IAsyncDisposable

<div class="runtime-status">
    <ScadaServerStatusBlock />
    <OdbcServerStatusBlock />

    <div class="runtime-details">
        <div class="runtime-badges">
            @if (_isLoading && _health is null)
            {
                <RadzenBadge Text="Runtime: checking..." BadgeStyle="BadgeStyle.Light" />
            }
            else if (_health?.IsHealthy == true)
            {
                <RadzenBadge Text="Runtime: Online" BadgeStyle="BadgeStyle.Success" />
                <RadzenBadge Text="@($"DB: {_health.Database}")" BadgeStyle="BadgeStyle.Success" />
            }
            else
            {
                <RadzenBadge Text="Runtime: Offline" BadgeStyle="BadgeStyle.Danger" title="@_errorText" />
            }
        </div>

        <span class="runtime-storage" title="@(_health is null ? _errorText : $"Storage: {_health.MessageStorageProvider}")">@(_health is null ? "Storage: Unknown" : $"Storage: {_health.MessageStorageProvider}")</span>
    </div>

    <RadzenButton class="status-refresh" Icon="refresh" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Disabled="@_isLoading" Click="@RefreshAsync" title="Refresh Runtime status" />
</div>

@code {
    private readonly CancellationTokenSource _stop = new();
    private readonly PeriodicTimer _timer = new(TimeSpan.FromSeconds(30));

    private RuntimeHealthResponse? _health;
    private bool _isLoading;
    private bool _disposed;
    private string _errorText = "";
    private Task? _loop;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();

        if (!_disposed)
            _loop = RunHealthLoopAsync(_stop.Token);
    }

    /// <summary>
    /// Сохраняет прежний опрос Runtime/DB.
    /// Статусы CtApi и ODBC обновляются независимо каждые 5 секунд.
    /// </summary>
    private async Task RefreshAsync()
    {
        if (_disposed || _isLoading)
            return;

        _isLoading = true;

        try
        {
            var health = await RuntimeStatusApi.GetHealthAsync(_stop.Token);

            if (_disposed)
                return;

            _health = health;
            _errorText = health.IsHealthy ? "" : health.Error ?? "Runtime Service health check failed.";
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _health = null;
            _errorText = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// Периодически обновляет Runtime/DB без опроса производственных данных.
    /// </summary>
    private async Task RunHealthLoopAsync(CancellationToken ct)
    {
        try
        {
            while (await _timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(async () =>
                {
                    await RefreshAsync();

                    if (!_disposed)
                        StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;
        _stop.Cancel();
        _timer.Dispose();

        if (_loop is not null)
            await _loop;

        _stop.Dispose();
    }
}