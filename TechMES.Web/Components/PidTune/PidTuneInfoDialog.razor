@using TechMES.Contracts.Param.Tuning
@inject DialogService DialogService

<div class="pid-tune-info">
    <RadzenAlert AlertStyle="AlertStyle.Warning"
                 Variant="Variant.Flat"
                 Shade="Shade.Lighter"
                 AllowClose="false">
        Полученные коэффициенты являются стартовыми настройками.
        Перед записью в контроллер проверьте направление действия, диапазоны OUT,
        anti-windup, ограничения исполнительного механизма и реакцию объекта в безопасном режиме.
    </RadzenAlert>

    <section class="pid-tune-info-section">
        <h3>@Content.Model.Title</h3>

        <div class="pid-tune-equation">
            @Content.Model.Equation
        </div>

        <p>@Content.Model.Description</p>

        <div class="pid-tune-values">
            @foreach (var item in Content.Model.Values)
            {
                <div class="pid-tune-value-symbol">@item.Symbol</div>
                <div class="pid-tune-value-description">@item.Description</div>
                <div class="pid-tune-value-current">@item.CurrentValue</div>
            }
        </div>
    </section>

    <section class="pid-tune-info-section pid-tune-identification-section">
        <h3>@Content.Identification.Title</h3>
        <p>@Content.Identification.Description</p>

        <h4>Расчетные формулы</h4>

        <div class="pid-tune-formulas">
            @foreach (var formula in Content.Identification.Formulas)
            {
                <code>@formula</code>
            }
        </div>

        <h4>Порядок анализа тренда и критерии приемки</h4>

        <ol class="pid-tune-steps">
            @foreach (var step in Content.Identification.Steps)
            {
                <li>@step</li>
            }
        </ol>

        @if (!string.IsNullOrWhiteSpace(Content.Identification.Warning))
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning"
                         Variant="Variant.Flat"
                         Shade="Shade.Lighter"
                         AllowClose="false"
                         class="pid-tune-identification-warning">
                @Content.Identification.Warning
            </RadzenAlert>
        }

        <h4>Диагностика последнего автоматического расчета</h4>

        @if (Identification is null)
        {
            <p class="pid-tune-muted">
                Автоматическая идентификация для текущего состояния формы еще не выполнялась.
                Нажмите Calculate на выбранном участке тренда.
            </p>
        }
        else
        {
            <div class="pid-tune-identification-state">
                @if (Identification.IsSuccess)
                {
                    <RadzenIcon Icon="check_circle" />
                    <span>Модель успешно идентифицирована.</span>
                }
                else
                {
                    <RadzenIcon Icon="warning" />
                    <span>@Identification.ErrorMessage</span>
                }
            </div>
        }

        <div class="pid-tune-values">
            @foreach (var item in Content.Identification.Diagnostics)
            {
                <div class="pid-tune-value-symbol">@item.Symbol</div>
                <div class="pid-tune-value-description">@item.Description</div>
                <div class="pid-tune-value-current">@item.CurrentValue</div>
            }
        </div>
    </section>

    <section class="pid-tune-info-section">
        <h3>@Content.Method.Title</h3>
        <p>@Content.Method.Description</p>

        <div class="pid-tune-formulas">
            @foreach (var formula in Content.Method.Formulas)
            {
                <code>@formula</code>
            }
        </div>
    </section>

    <section class="pid-tune-info-section">
        <h3>Форма регулятора и результат</h3>

        <div class="pid-tune-equation">
            u(t) = Kp * [ e(t) + (1 / Ti) * integral(e(t)) dt + Td * de(t) / dt ]
        </div>

        <p>
            TechMES возвращает Kp, Ti и Td в идеальной/ISA-форме.
            При переносе в ПЛК или SCADA необходимо убедиться, что конкретный PID-блок
            использует ту же параметризацию. Некоторые контроллеры вместо Ti/Td принимают Ki/Kd
            или используют series/interacting форму.
        </p>

        <div class="pid-tune-values">
            @foreach (var item in Content.ResultValues)
            {
                <div class="pid-tune-value-symbol">@item.Symbol</div>
                <div class="pid-tune-value-description">@item.Description</div>
                <div class="pid-tune-value-current">@item.CurrentValue</div>
            }
        </div>

        @if (!Content.HasValidResult)
        {
            <p class="pid-tune-invalid-result">
                Текущих исходных данных недостаточно для корректного расчета всех коэффициентов.
            </p>
        }
    </section>

    <section class="pid-tune-info-section">
        <h3>Первоисточники и область их применения</h3>

        <div class="pid-tune-source-list">
            @foreach (var source in Content.Sources)
            {
                <div class="pid-tune-source-item">
                    <div class="pid-tune-source-title">
                        @if (string.IsNullOrWhiteSpace(source.Url))
                        {
                            <span>@source.Title</span>
                        }
                        else
                        {
                            <a href="@source.Url"
                               target="_blank"
                               rel="noopener noreferrer">
                                @source.Title
                            </a>
                        }
                    </div>

                    <div class="pid-tune-source-scope">
                        @source.Scope
                    </div>
                </div>
            }
        </div>

        <p class="pid-tune-muted">
            Пороговые значения R², CV, диапазоны гистерезиса и проверки качества
            являются критериями реализации TechMES. Они документируются здесь отдельно
            и не приписываются классическим публикациям Ziegler-Nichols, Cohen-Coon,
            SIMC, AMIGO или Tyreus-Luyben.
        </p>
    </section>

    <div class="pid-tune-info-footer">
        <RadzenButton Text="Закрыть"
                      Icon="close"
                      ButtonStyle="ButtonStyle.Light"
                      Click="@Close" />
    </div>
</div>

@code {
    /// <summary>
    /// Текущие параметры модели и метода.
    /// </summary>
    [Parameter]
    public PidTuneCalculationRequest Request { get; set; } = new();

    /// <summary>
    /// Текущий результат расчета Kp/Ti/Td.
    /// </summary>
    [Parameter]
    public PidTuneCalculationResult Result { get; set; } =
        PidTuneCalculationResult.Invalid("");

    /// <summary>
    /// Последний результат автоматической идентификации по видимой области графика.
    /// Может быть null, если Calculate еще не выполнялся или исходные теги были изменены.
    /// </summary>
    [Parameter]
    public PidProcessIdentificationResult? Identification { get; set; }

    private PidTuneInfoContent Content =>
        PidTuneInfoCatalog.Create(
            Request,
            Result,
            Identification);

    private void Close()
    {
        DialogService.Close();
    }
}
