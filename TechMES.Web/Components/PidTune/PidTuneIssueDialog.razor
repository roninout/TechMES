@using TechMES.Contracts.Param.Tuning
@inject DialogService DialogService

<div class="pid-tune-issue">
    <RadzenAlert AlertStyle="AlertStyle.Warning"
                 Variant="Variant.Flat"
                 Shade="Shade.Lighter"
                 AllowClose="false">
        @Message
    </RadzenAlert>

    <section class="pid-tune-issue-section">
        <h3>@Content.Title</h3>
        <p>@Content.Explanation</p>
    </section>

    <section class="pid-tune-issue-section">
        <h3>Как должен выглядеть выбранный участок</h3>

        <PidTuneIssueDiagram IssueCode="@IssueCode"
                             ProcessModel="@ProcessModel" />

        <p class="pid-tune-diagram-caption">
            @Content.DiagramCaption
        </p>
    </section>

    <section class="pid-tune-issue-section">
        <h3>Что сделать</h3>
        <p>@Content.Recommendation</p>

        <ul>
            @foreach (var item in Content.Checklist)
            {
                <li>@item</li>
            }
        </ul>
    </section>

    <div class="pid-tune-issue-footer">
        <RadzenButton Text="Закрыть"
                      Icon="close"
                      ButtonStyle="ButtonStyle.Light"
                      Click="@Close" />
    </div>
</div>

@code {
    [Parameter]
    public PidTuneIssueCode IssueCode { get; set; } =
        PidTuneIssueCode.Unknown;

    [Parameter]
    public string Message { get; set; } = "";

    /// <summary>
    /// Нужен для выбора корректной справки и диаграммы:
    /// FOPDT, Integrating или ClosedLoop.
    /// </summary>
    [Parameter]
    public string ProcessModel { get; set; } =
        PidTuneProcessModel.Fopdt;

    private PidTuneIssueContent Content =>
        PidTuneIssueCatalog.Get(
            IssueCode,
            ProcessModel);

    private void Close()
    {
        DialogService.Close();
    }
}
