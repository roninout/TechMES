    private double? GetLastOutputNumber(string key)
    {
        return TryGetRuntimeNumber(State?.LastOutputs, key, out var value) ? value : null;
    }

    /// <summary>
    /// Возвращает значение только если конкретный сохранённый Job input
    /// действительно является Tag binding.
    ///
    /// Это важно для миграции Version 1:
    /// старые Constant CompN/Perc нельзя принимать за текущие SCADA значения.
    /// </summary>
    private double? GetRuntimeTagInputNumber(string key)
    {
        var input = FindJobInput(key);

        if (input?.SourceType != CalcInputSourceTypeDto.Tag)
            return null;

        return TryGetRuntimeNumber(State?.LastInputs, key, out var value) ? value : null;
    }

    private double? GetProcessCurrentValue(DensityProcessBindingEditor binding)
    {
        return GetRuntimeTagInputNumber(binding.Parameter.Key) ?? binding.CurrentValue;
    }

    private string GetProcessRuntimeTag(DensityProcessBindingEditor binding)
    {
        var stored = FindJobInput(binding.Parameter.Key);

        if (stored?.SourceType == CalcInputSourceTypeDto.Tag && !string.IsNullOrWhiteSpace(stored.TagName))
            return stored.TagName;

        if (binding.IsLinked)
            return binding.ResolvedTagName;

        return "Not linked";
    }

    private double? GetLiveScadaValue(string itemName)
    {
        return _liveScadaValues.TryGetValue(itemName, out var value) ? value : null;
    }

    /// <summary>
    /// Текущее состояние SCADA ITEM Sel.
    ///
    /// Контракт Density:
    ///
    ///     Sel = 0 -> SCADA использует ValHmi;
    ///     Sel = 1 -> SCADA использует ValCalc.
    ///
    /// Sel является только read-only диагностическим значением.
    /// TechMES его не изменяет и не записывает.
    /// </summary>
    private bool? IsCalculatedValueSelected
    {
        get
        {
            var value = GetLiveScadaValue("Sel");

            if (!value.HasValue || !double.IsFinite(value.Value))
                return null;

            return value.Value >= 0.5d;
        }
    }

