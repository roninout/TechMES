    /// <summary>
    /// Формирует снимок только редактируемой пользователем конфигурации.
    ///
    /// Текущие SCADA CompN, PercN, DeltaD и ValHmi сюда не входят,
    /// поэтому изменение технологического процесса не создаёт Unsaved state.
    /// </summary>
    private string BuildEditorSignature()
    {
        var parts = new List<string>
    {
        $"enabled={_enabled}",
        $"writes={_allowOutputWrites}",
        $"processParameterCount={_processParameterCount}"
    };

        foreach (var binding in ActiveProcessBindings)
            parts.Add($"{binding.Parameter.Key}={binding.SourceText.Trim()}");

        for (var index = 0; index < MaxComponentCount; index++)
        {
            var code = (_components.ElementAtOrDefault(index)?.SubstanceCode ?? "").Trim();
            parts.Add($"component{index}={code}");
        }

        return string.Join("|", parts);
    }

    private void CaptureSavedEditorState()
    {
        _savedEditorSignature = BuildEditorSignature();
    }

