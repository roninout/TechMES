    // Density own SCADA values
    // ============================================================

    /// <summary>
    /// Читает read-only SCADA-параметры Density.
    ///
    /// Если работающий Job уже содержит Tag input и LastInputs,
    /// повторный HTTP/CtApi read для этого параметра не нужен.
    ///
    /// ValHmi всегда читается отдельно, потому что он намеренно
    /// не входит в Calculation Job.
    /// </summary>
    private async Task RefreshDensityScadaValuesAsync(bool force = false)
    {
        if (_isReadingScada)
            return;

        var modelChanged = !string.Equals(_scadaRefreshModelName, Model.Name, StringComparison.OrdinalIgnoreCase);
        var now = DateTimeOffset.UtcNow;

        if (modelChanged)
        {
            _scadaRefreshModelName = Model.Name;
            _liveScadaValues.Clear();
            force = true;
        }

        if (!force && now < _nextScadaRefreshUtc)
            return;

        _nextScadaRefreshUtc = now.AddSeconds(5);
        _isReadingScada = true;
        _scadaReadError = "";

        try
        {
            var itemsToRead = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
            {
                "ValHmi"
            };

            if (!GetRuntimeTagInputNumber(ComponentCountKey).HasValue)
                itemsToRead.Add("CompN");

            if (!GetRuntimeTagInputNumber(CorrectionKey).HasValue)
                itemsToRead.Add("DeltaD");

            for (var index = 0; index < MaxComponentCount; index++)
            {
                if (!GetRuntimeTagInputNumber(GetComponentPercentKey(index)).HasValue)
                    itemsToRead.Add($"Perc{index}");
            }

            var reads = await Task.WhenAll(itemsToRead.Select(ReadDensityScadaItemAsync));

            foreach (var read in reads)
                _liveScadaValues[read.ItemName] = read.Success ? read.Value : null;

            var failed = reads.Where(read => !read.Success && !string.IsNullOrWhiteSpace(read.Message)).ToList();

            if (failed.Count > 0)
                _scadaReadError = string.Join(" ", failed.Select(read => $"{read.ItemName}: {read.Message}"));
        }
        finally
        {
            _isReadingScada = false;
        }
    }

    /// <summary>
    /// Читает один уже известный ITEM Density через его реальный Variable Tag.
    ///
    /// Используется тот же общий ParamApi.CheckNumericTagAsync,
    /// который сейчас обслуживает Test Kp.
    /// </summary>
    private async Task<DensityScadaReadResult> ReadDensityScadaItemAsync(string itemName)
    {
        var tagName = GetItemTag(Model, itemName);

        if (string.IsNullOrWhiteSpace(tagName))
            return DensityScadaReadResult.Failed(itemName, $"ITEM {itemName} was not found in Calc Model.");

        try
        {
            var response = await ParamApi.CheckNumericTagAsync(new ParamTagCheckRequest
            {
                TagName = tagName,
                RequireTrend = false
            });

            if (response.Found && response.CurrentValue.HasValue)
                return DensityScadaReadResult.Successful(itemName, response.CurrentValue.Value);

            return DensityScadaReadResult.Failed(itemName, response.Message ?? "Numeric value was not read.");
        }
        catch (Exception ex)
        {
            return DensityScadaReadResult.Failed(itemName, ex.Message);
        }
    }

    // ============================================================
    // Mixture
    // ============================================================

    /// <summary>
    /// Из Job восстанавливаем только соответствие Perc-slot -> Substance.
    ///
    /// CompN и проценты из Job больше не читаются как Constants.
    /// </summary>
    private void BuildComponentConfiguration()
    {
        _components.Clear();

        for (var index = 0; index < MaxComponentCount; index++)
        {
            _components.Add(new DensityComponentEditor
            {
                Index = index,
                SubstanceCode = ReadStoredString(GetComponentCodeKey(index), "")
            });
        }
    }

    /// <summary>
    /// Проверяет текущую SCADA-смесь и нашу настройку SubstanceCode.
    ///
    /// Математическое ядро повторит эту проверку во время выполнения Job.
    /// Здесь она нужна для понятного UI ещё до Save.
    /// </summary>
    private string MixtureValidationError
    {
        get
        {
            if (!CurrentComponentCount.HasValue)
                return "SCADA CompN was not read as an integer value from 1 to 5.";

            var componentCount = CurrentComponentCount.Value;
            var usedCodes = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var totalPercent = 0d;

            for (var index = 0; index < componentCount; index++)
            {
                var component = _components[index];

                if (string.IsNullOrWhiteSpace(component.SubstanceCode))
                    return $"Substance for component {index + 1} is not selected.";

                if (!usedCodes.Add(component.SubstanceCode.Trim()))
                    return $"Substance '{component.SubstanceCode}' is specified more than once.";

                var percent = GetCurrentPercent(index);

                if (!percent.HasValue)
                    return $"SCADA Perc{index} value is not available.";

                if (!double.IsFinite(percent.Value) || percent.Value < 0d || percent.Value > 100d)
                    return $"SCADA Perc{index} must be between 0 and 100%.";

                totalPercent += percent.Value;
            }

            if (Math.Abs(totalPercent - 100d) > PercentageTolerance)
                return $"SCADA mixture percentages must total 100%. Current total: {totalPercent:0.###}%.";

            return "";
        }
    }

    // ============================================================
    // Save
    // ============================================================

    private async Task CreateJobAsync()
    {
        if (Definition is null || !IsConfigurationReady)
            return;

        _isSaving = true;

        try
        {
            var allowWrites = _allowOutputWrites && IsOutputBindingReady;

            var request = new CalcJobSaveRequest
            {
                EquipmentName = Model.Name,
                Name = $"{Model.Name} Density",
                Description = Model.Description,
                DefinitionCode = Definition.Code,
                DefinitionVersion = Definition.Version,
                Enabled = _enabled,
                PeriodMs = 5000,
                WriteEnabled = allowWrites,
                SortOrder = 0,
                ExpectedRevision = null,
                Inputs = BuildDensityInputs(),
                Outputs = BuildDensityOutputs(allowWrites)
            };

            await CalcApi.CreateJobAsync(request);

            NotificationService.Notify(NotificationSeverity.Success, "Calculations", $"Density Job created for {Model.Name}.", 4000);
            await JobChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Calculations", ex.Message, 6000);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SaveJobAsync()
    {
        if (Job is null || Definition is null || !IsConfigurationReady)
            return;

        _isSaving = true;

        try
        {
            var allowWrites = _allowOutputWrites && IsOutputBindingReady;

            var request = new CalcJobSaveRequest
            {
                EquipmentName = Job.EquipmentName,
                Name = Job.Name,
                Description = Job.Description,
                DefinitionCode = Definition.Code,
                DefinitionVersion = Definition.Version,
                Enabled = _enabled,
                PeriodMs = Job.PeriodMs,
                WriteEnabled = allowWrites,
                SortOrder = Job.SortOrder,
                ExpectedRevision = Job.Revision,
                Inputs = BuildDensityInputs(),
                Outputs = BuildDensityOutputs(allowWrites)
            };

            await CalcApi.UpdateJobAsync(Job.Id, request);

            NotificationService.Notify(NotificationSeverity.Success, "Calculations", $"Density configuration saved for {Model.Name}.", 4000);
            await JobChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Calculations", ex.Message, 6000);
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>
    /// Формирует окончательный Density Job.
    ///
    /// ProcessInput:
    /// сохраняются только после успешного Resolve/Check.
    ///
    /// CompN:
    /// всегда Density ITEM CompN.
    ///
    /// Perc0...Perc4:
    /// всегда соответствующие Density SCADA ITEM.
    ///
    /// DeltaD:
    /// всегда Density ITEM DeltaD.
    ///
    /// componentNCode:
    /// единственная постоянная настройка состава.
    ///
    /// ValHmi здесь отсутствует.
    /// </summary>
    private List<CalcJobInputSaveDto> BuildDensityInputs()
    {
        var result = new List<CalcJobInputSaveDto>();

        foreach (var binding in _processBindings.OrderBy(binding => binding.Parameter.Order))
        {
            if (!binding.IsLinked)
                continue;

            result.Add(new CalcJobInputSaveDto
            {
                ParameterKey = binding.Parameter.Key,
                SourceType = CalcInputSourceTypeDto.Tag,
                TagName = binding.ResolvedTagName,
                MaxAgeSeconds = binding.MaxAgeSeconds,
                SortOrder = binding.Parameter.Order
            });
        }

        AddFixedTagInput(result, ComponentCountKey, ComponentCountTag);
        AddFixedTagInput(result, CorrectionKey, DeltaDTag);

        // Все Perc0...Perc4 являются SCADA inputs.
        // Даже если CompN сейчас меньше пяти, структура Equipment фиксированная.
        for (var index = 0; index < MaxComponentCount; index++)
            AddFixedTagInput(result, GetComponentPercentKey(index), GetPercTag(index));

        // SubstanceCode сохраняем как Constants.
        // Неактивные уже настроенные слоты тоже можно сохранить:
        // они не участвуют в формуле, пока CompN их не включает.
        for (var index = 0; index < MaxComponentCount; index++)
        {
            var code = _components[index].SubstanceCode.Trim();
            var parameter = GetParameter(GetComponentCodeKey(index));

            if (parameter is not null && code.Length > 0)
                result.Add(CreateConstantInput(parameter, code));
        }

        return result.OrderBy(input => input.SortOrder).ToList();
    }

    private void AddFixedTagInput(List<CalcJobInputSaveDto> target, string parameterKey, string? tagName)
    {
        if (string.IsNullOrWhiteSpace(tagName))
            return;

        var parameter = GetParameter(parameterKey);

        if (parameter is null)
            return;

        target.Add(new CalcJobInputSaveDto
        {
            ParameterKey = parameter.Key,
            SourceType = CalcInputSourceTypeDto.Tag,
            TagName = tagName,
            SortOrder = parameter.Order
        });
    }

    /// <summary>
    /// Density имеет ровно один output: ValCalc.
    ///
    /// Scale = 10 пока сохраняем из уже перенесённого legacy-контракта.
    /// Это не пользовательская настройка UI.
    ///
    /// Offset всегда 0.
    /// Реальная коррекция приходит отдельным SCADA input DeltaD.
    /// </summary>
    private List<CalcJobOutputSaveDto> BuildDensityOutputs(bool allowWrites)
    {
        if (Definition is null)
            return [];

        var output = Definition.Outputs.Single(item => string.Equals(item.Key, "density", StringComparison.OrdinalIgnoreCase));

        return
        [
            new CalcJobOutputSaveDto
            {
                OutputKey = output.Key,
                TagName = DensityOutputTag,
                WriteEnabled = allowWrites,
                Scale = 10d,
                Offset = 0d,
                SortOrder = output.Order
            }
        ];
    }

    private static CalcJobInputSaveDto CreateConstantInput(CalcParameterDefinitionDto parameter, object value)
    {
        return new CalcJobInputSaveDto
        {
            ParameterKey = parameter.Key,
            SourceType = CalcInputSourceTypeDto.Constant,
            ConstantValue = JsonSerializer.SerializeToElement(value),
            SortOrder = parameter.Order
        };
    }

    // ============================================================
    // Unsaved state
    // ============================================================

    /// <summary>
    /// В signature входят только редактируемые пользователем настройки.
    ///
    /// SCADA CompN/Perc/DeltaD/ValHmi сюда не входят,
    /// поэтому изменение процесса не создаёт ложный Unsaved state.
    /// </summary>
    private string BuildEditorSignature()
    {
        var parts = new List<string>
        {
            $"enabled={_enabled}",
            $"writes={_allowOutputWrites}"
        };

        foreach (var binding in _processBindings.OrderBy(binding => binding.Parameter.Order))
            parts.Add($"{binding.Parameter.Key}={binding.SourceText.Trim()}:{binding.MaxAgeSeconds?.ToString(CultureInfo.InvariantCulture) ?? ""}");

        for (var index = 0; index < MaxComponentCount; index++)
            parts.Add($"component{index}={_components.ElementAtOrDefault(index)?.SubstanceCode.Trim() ?? ""}");

        return string.Join("|", parts);
    }

    private void CaptureSavedEditorState()
    {
        _savedEditorSignature = BuildEditorSignature();
    }

