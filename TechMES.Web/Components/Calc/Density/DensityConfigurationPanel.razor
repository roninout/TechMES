    /// <summary>
    /// Возвращает код компонента именно из сохранённого Job.
    ///
    /// Это важно для верхней панели:
    /// несохранённое изменение ComboBox в Settings не должно подменять
    /// состав, с которым сейчас реально работает Calc.Service.
    ///
    /// Для нового, ещё не созданного Job используем текущий editor только
    /// как предварительное отображение.
    /// </summary>
    private string GetLiveComponentCode(int index)
    {
        var stored = FindJobInput(GetComponentCodeKey(index));

        if (stored?.SourceType == CalcInputSourceTypeDto.Constant
            && stored.ConstantValue.HasValue
            && stored.ConstantValue.Value.ValueKind == JsonValueKind.String)
        {
            return stored.ConstantValue.Value.GetString()?.Trim() ?? "";
        }

        return _components.ElementAtOrDefault(index)?.SubstanceCode?.Trim() ?? "";
    }

    /// <summary>
    /// Формирует данные Pie по фактическому составу смеси.
    ///
    /// Percent определяет геометрический размер сектора.
    ///
    /// DensityKgPerM3 является фактической плотностью компонента,
    /// которая участвовала в последнем успешном расчёте Calc.Service.
    ///
    /// Никаких координат labels здесь больше не рассчитываем:
    /// их положение полностью определяет RadzenPieSeries.
    /// </summary>
    private IReadOnlyList<DensityPieItem> BuildLivePieItems()
    {
        if (!CurrentComponentCount.HasValue)
            return [];

        var result = new List<DensityPieItem>();

        for (var index = 0; index < CurrentComponentCount.Value; index++)
        {
            var code = GetLiveComponentCode(index);
            var percent = GetCurrentPercent(index);

            if (string.IsNullOrWhiteSpace(code) || !percent.HasValue || percent.Value <= 0d)
                continue;

            result.Add(new DensityPieItem(
                Index: index,
                Code: code,
                LegendText: $"{code} {percent.Value:0.#}%",
                Percent: percent.Value,
                DensityKgPerM3: GetLastOutputNumber($"component{index}Density")));
        }

        return result;
    }

    /// <summary>
    /// Текст внутри сектора Pie.
    /// Размер сектора задаётся Percent, а внутри показываем рассчитанную Density компонента.
    /// </summary>
    private static string FormatPieItemDensity(DensityPieItem item)
    {
        return item.DensityKgPerM3.HasValue
            ? item.DensityKgPerM3.Value.ToString("0.###", CultureInfo.InvariantCulture)
            : "-";
    }

    /// <summary>
    /// Формирует заголовок фактически работающей смеси.
    ///
    /// SubstanceCode берём из сохранённого Job,
    /// а проценты - из текущих SCADA PercN.
    ///
    /// Например:
    ///
    ///     Butene_1 (45%) - Water (55%)
    ///
    /// Поэтому несохранённое изменение ComboBox не подменяет
    /// верхнюю Runtime-панель существующего Job.
    /// </summary>
    private string GetLiveMixtureTitle()
    {
        if (!CurrentComponentCount.HasValue)
            return "Mixture";

        var components = new List<string>();

        for (var index = 0; index < CurrentComponentCount.Value; index++)
        {
            var code = GetLiveComponentCode(index);
            var percent = GetCurrentPercent(index);

            if (string.IsNullOrWhiteSpace(code))
                continue;

            components.Add(percent.HasValue
                ? $"{code} ({percent.Value:0.#}%)"
                : code);
        }

        return components.Count > 0
            ? string.Join(" - ", components)
            : "Mixture";
    }

    private static string FormatPieDensity(double? value)
    {
        return value.HasValue
            ? value.Value.ToString("0.###", CultureInfo.InvariantCulture)
            : "-";
    }

    // ============================================================
    // Formatting
    // ============================================================

    private static string GetNumberFormat(CalcParameterDefinitionDto parameter)
    {
        var decimals = Math.Clamp(parameter.Decimals, 0, 6);
        var pattern = decimals == 0 ? "0" : "0." + new string('#', decimals);

        return string.IsNullOrWhiteSpace(parameter.Unit) ? pattern : $"{pattern}' {parameter.Unit}'";
    }

    private static string GetSwitchStateText(bool value)
    {
        return value ? "on" : "off";
    }

    private static string GetSwitchStateClass(bool value)
    {
        return value ? "is-on" : "is-off";
    }

