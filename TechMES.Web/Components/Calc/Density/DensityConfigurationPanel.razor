@using System.Globalization
@using System.Text.Json
@using TechMES.Contracts.Equipment
@using TechMES.Contracts.Param
@inject CalcApiClient CalcApi
@inject ParamApiClient ParamApi
@inject ParamWriteCoordinator ParamWriteCoordinator
@inject CalcProcessInputResolver ProcessInputResolver
@inject NotificationService NotificationService

<div class="density-configuration-host">

    @if (_isLoadingDefinition)
    {
        <div class="density-loading">

            <TechMesLoadingBar Label="Loading Density configuration" />

            <div class="density-loading-content">

                <RadzenIcon Icon="hourglass_top"
                            class="density-loading-icon" />

                <div class="density-loading-title">
                    Loading Density configuration...
                </div>

                <div class="density-loading-model">
                    @Model.Name
                </div>

            </div>

        </div>
    }
    else if (Definition is null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger"
                     AllowClose="false"
                     ShowIcon="true">

            @(_loadError.Length > 0
                ? _loadError
                : "Density calculation definition is not available.")

        </RadzenAlert>
    }
    else
    {
        <div class="density-configuration">

            @* ============================================================
               ВЕРХНЯЯ ПАНЕЛЬ
               
               В отличие от Tank здесь нет SVG.
               
               Панель показывает только текущее рабочее состояние:
               - рассчитанную Density;
               - текущие значения всех ProcessInput;
               - текущую Density correction.
               
               Все значения берутся из сохранённого Runtime State,
               поэтому несохранённые Settings не подменяют фактическое
               состояние работающего Calc Job.
               ============================================================ *@
            @{
                var primaryProcessBars = BuildPrimaryProcessBars();
                var processBarCount = primaryProcessBars.Count;
                var pieItems = BuildLivePieItems();
            }

            <div class="density-live-panel">

                @* ============================================================
                   HEADER
                   ============================================================ *@
                <div class="density-live-header">

                    <div class="density-live-mixture-title">

                        <RadzenIcon Icon="@GetLiveMixturePhaseIcon()"
                                    class="density-live-mixture-phase-icon" />

                        <span>
                            @GetLiveMixtureTitle()
                        </span>

                    </div>

                    <div class="density-toolbar-enabled">

                        <span class="density-switch-state @GetSwitchStateClass(_enabled)">
                            @GetSwitchStateText(_enabled)
                        </span>

                        <RadzenSwitch @bind-Value="_enabled"
                                      Disabled="@(_isSaving || (!_enabled && !IsConfigurationReady))" />

                        <span class="density-switch-label">
                            Enabled
                        </span>

                    </div>

                </div>


                <div class="density-panel-separator"></div>


                @* Предупреждение о выключенной записи ValCalc здесь больше не показываем.
                Allow output writes является штатной настройкой, а не Runtime error. *@

                @if (HasUnsavedChanges)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning"
                                 Variant="Variant.Flat"
                                 Shade="Shade.Lighter"
                                 AllowClose="false"
                                 ShowIcon="true"
                                 class="density-live-status-alert">

                        Unsaved changes. Runtime continues using the last saved configuration.

                    </RadzenAlert>
                }
                else if (State?.Status == CalcJobStateStatusDto.Error)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger"
                                 Variant="Variant.Flat"
                                 Shade="Shade.Lighter"
                                 AllowClose="false"
                                 ShowIcon="true"
                                 class="density-live-status-alert">

                        @(State.ReasonMessage ?? "Density calculation failed.")

                    </RadzenAlert>
                }
                else if (State?.Status == CalcJobStateStatusDto.Skipped)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning"
                                 Variant="Variant.Flat"
                                 Shade="Shade.Lighter"
                                 AllowClose="false"
                                 ShowIcon="true"
                                 class="density-live-status-alert">

                        @(State.ReasonMessage ?? "Density calculation was skipped.")

                    </RadzenAlert>
                }


                @* ============================================================
                   MAIN LIVE AREA
                   ============================================================ *@
                <div class="density-live-layout density-live-layout-bars-@processBarCount">


                    @* ========================================================
                       LEFT - TEMPERATURE / PRESSURE
                       ======================================================== *@

                    @if (primaryProcessBars.Count > 0)
                    {
                        <div class="density-process-bars density-process-bars-@processBarCount">

                            @foreach (var bar in primaryProcessBars)
                            {
                                <div class="density-process-meter">

                                    @* =========================================================
                                       READONLY CURRENT VALUE

                                       Верхнее поле имеет фиксированную ширину.
                                       Сам вертикальный bar ниже центрируется относительно
                                       именно этого поля, а не относительно числовой шкалы.
                                       ========================================================= *@
                                    <div class="density-process-meter-readout">

                                        <RadzenFormField AllowFloatingLabel="false"
                                                         Text="@bar.ItemName"
                                                         Variant="Variant.Outlined"
                                                         class="density-process-form-field">

                                            <RadzenNumeric TValue="double?"
                                                           Value="@bar.Value"
                                                           ReadOnly="true"
                                                           ShowUpDown="false"
                                                           Format="0.###"
                                                           class="density-process-top-value" />

                                        </RadzenFormField>

                                    </div>


                                    @* =========================================================
                                       VERTICAL BAR
                                       ========================================================= *@
                                    <div class="density-process-meter-body">

                                        <ParamGraphVerticalBar Label="@bar.ItemName"
                                                               Value="@bar.Value"
                                                               Min="@bar.Min"
                                                               Max="@bar.Max"
                                                               FillColor="@bar.FillColor" />

                                    </div>


                                    @* Unit находится сразу под bargraph, как в существующей VGA-панели. *@
                                    <div class="density-process-meter-unit">
                                        @(string.IsNullOrWhiteSpace(bar.Unit) ? "-" : bar.Unit)
                                    </div>


                                    <div class="density-process-meter-title">
                                        @bar.Name
                                    </div>


                                    <div class="density-process-meter-source"
                                         title="@bar.Source">
                                        @bar.Source
                                    </div>

                                </div>
                            }

                        </div>
                    }

                    <div class="density-live-center">

                        @* ========================================================
                           MAIN DENSITY CARD
                           Верх: собственный расчёт TechMES.
                           Низ: фактическое выбранное SCADA значение.
                           Sel:
                               0 -> Current value / ValHmi;
                               1 -> Calculated value / ValCalc.
                           ======================================================== *@
                        <div class="density-main-card">


                            @* ====================================================
                               TECHMES CALCULATED VALUE
                               ==================================================== *@
                            <div class="density-value-row">

                                <div class="density-selection-title density-selection-title-techmes @(IsTechMesOutputWriteEnabled ? "is-selected" : "")">

                                    <div class="density-selection-mark">

                                        @if (IsTechMesOutputWriteEnabled)
                                        {
                                            <RadzenIcon Icon="check"
                                                        class="density-selection-icon" />
                                        }

                                    </div>

                                    <span>
                                        TechMES calculated value
                                    </span>

                                </div>

                                <div class="density-value-controls">

                                    <div class="density-delta-placeholder"
                                         aria-hidden="true">
                                    </div>

                                    <RadzenFormField AllowFloatingLabel="false"
                                                     Text="Density"
                                                     Variant="Variant.Outlined"
                                                     class="density-main-form-field density-result-form-field">

                                        <RadzenNumeric TValue="double?"
                                                       Value="@GetLastOutputNumber("density")"
                                                       ReadOnly="true"
                                                       ShowUpDown="false"
                                                       Format="0.###' kg/m³'"
                                                       class="density-main-value-input density-result-value-input" />

                                    </RadzenFormField>

                                </div>

                            </div>


                            <div class="density-card-separator"></div>


                            @* ====================================================
           CURRENT VALUE / ValHmi

           Sel = 0 -> эта строка активна.
           ==================================================== *@
                            <div class="density-value-row">

                                <div class="density-selection-title @(IsCalculatedValueSelected == false ? "is-selected" : "")">

                                    <div class="density-selection-mark">

                                        @if (IsCalculatedValueSelected == false)
                                        {
                                            <RadzenIcon Icon="check"
                                                        class="density-selection-icon" />
                                        }

                                    </div>

                                    <span>
                                        Current value
                                    </span>

                                </div>

                                <div class="density-value-controls">

                                    <div class="density-delta-placeholder"
                                         aria-hidden="true">
                                    </div>

                                    <RadzenFormField AllowFloatingLabel="false"
                                                     Text="ValHmi"
                                                     Variant="Variant.Outlined"
                                                     class="density-main-form-field">

                                        <RadzenNumeric TValue="double?"
                                                       Value="@CurrentDensityHmi"
                                                       ReadOnly="true"
                                                       ShowUpDown="false"
                                                       Format="0.###' kg/m³'"
                                                       class="density-main-value-input" />

                                    </RadzenFormField>

                                </div>

                            </div>


                            @* ====================================================
           CALCULATED VALUE / Delta + ValCalc

           Sel = 1 -> эта строка активна.
           ==================================================== *@
                            <div class="density-value-row">

                                <div class="density-selection-title @(IsCalculatedValueSelected == true ? "is-selected" : "")">

                                    <div class="density-selection-mark">

                                        @if (IsCalculatedValueSelected == true)
                                        {
                                            <RadzenIcon Icon="check"
                                                        class="density-selection-icon" />
                                        }

                                    </div>

                                    <span>
                                        Calculated value
                                    </span>

                                </div>

                                <div class="density-value-controls">

                                    <div class="@GetDeltaDWriteFieldClass()" title="@GetDeltaDWriteFieldTitle()" @onclick="@RequestDeltaDWriteAsync">

                                        <RadzenFormField AllowFloatingLabel="false"
                                                         Text="Delta"
                                                         Variant="Variant.Outlined"
                                                         class="density-delta-form-field">

                                            <RadzenNumeric TValue="double?"
                                                           Value="@CurrentDeltaD"
                                                           ReadOnly="true"
                                                           ShowUpDown="false"
                                                           Format="0.###"
                                                           class="density-delta-input" />

                                        </RadzenFormField>

                                    </div>

                                    <RadzenFormField AllowFloatingLabel="false"
                                                     Text="ValCalc"
                                                     Variant="Variant.Outlined"
                                                     class="density-main-form-field">

                                        <RadzenNumeric TValue="double?"
                                                       Value="@CurrentDensityCalcEngineering"
                                                       ReadOnly="true"
                                                       ShowUpDown="false"
                                                       Format="0.###' kg/m³'"
                                                       class="density-main-value-input" />

                                    </RadzenFormField>

                                </div>

                            </div>

                        </div>


                        @* ========================================================
       ADDITIONAL PARAMETERS
       ======================================================== *@
                        @foreach (var binding in ActiveProcessBindings.Skip(2).Where(binding => binding.IsLinked))
                        {
                            <div class="density-additional-card">

                                <div class="density-value-row">

                                    <div class="density-value-group-title">
                                        @GetProcessDisplayName(binding)
                                    </div>

                                    <div class="density-value-controls">

                                        <div class="density-delta-placeholder"
                                             aria-hidden="true">
                                        </div>

                                        <RadzenFormField AllowFloatingLabel="false"
                                                         Text="@GetProcessRuntimeTag(binding)"
                                                         Variant="Variant.Outlined"
                                                         class="density-main-form-field">

                                            <RadzenNumeric TValue="double?"
                                                           Value="@GetProcessCurrentValue(binding)"
                                                           ReadOnly="true"
                                                           ShowUpDown="false"
                                                           Format="@GetNumberFormat(binding.Parameter)"
                                                           class="density-main-value-input" />

                                        </RadzenFormField>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>


                    @* ========================================================
                       RIGHT - MIXTURE PIE
                       ======================================================== *@
                    <div class="density-pie-column">

                        @if (pieItems.Count > 0)
                        {
                            <div class="density-pie-shell">

                                <RadzenChart class="density-pie-chart">

                                    <TechMesPieSeries TItem="DensityPieItem"
                                                      Data="@pieItems"
                                                      CategoryProperty="@nameof(DensityPieItem.LegendText)"
                                                      ValueProperty="@nameof(DensityPieItem.Percent)"
                                                      DataLabelText="@FormatPieItemDensity"
                                                      StartAngle="90"
                                                      StrokeWidth="2"
                                                      ShowTooltipOnLegend="true">

                                        <ChildContent>

                                            @* Положение подписей полностью рассчитывает штатный Radzen. Inside размещает подписи внутри соответствующих секторов Pie. Мы не вычисляем координаты самостоятельно. *@
                                            <RadzenSeriesDataLabels Visible="true"
                                                                    Position="DataLabelPosition.Inside"
                                                                    Appearance="DataLabelAppearance.Chip"
                                                                    AllowOverlap="true" />

                                        </ChildContent>

                                        <TooltipTemplate Context="item">

                                            <div class="density-pie-tooltip">

                                                <strong>@item.Code</strong>

                                                <div>
                                                    @item.Percent.ToString("0.###", CultureInfo.InvariantCulture) %
                                                </div>

                                                <div>
                                                    Density:
                                                    @FormatPieDensity(item.DensityKgPerM3)
                                                    kg/m³
                                                </div>

                                            </div>

                                        </TooltipTemplate>

                                    </TechMesPieSeries>

                                    <RadzenLegend Position="LegendPosition.Bottom" />

                                </RadzenChart>

                            </div>
                        }
                        else
                        {
                            <div class="density-pie-empty"> Mixture data is not available. </div>
                        }

                    </div>


                </div>

            </div>


            @* ============================================================
               SETTINGS
               
               Здесь находится всё, что пользователь действительно
               конфигурирует:
               
               - SCADA bindings ProcessInput;
               - состав смеси;
               - correction fallback;
               - output write permission.
               ============================================================ *@
            <section class="density-settings-column">

                <ParamAiPanel Title="Settings"
                              Icon="settings"
                              InitiallyCollapsed="true">

                    <div class="density-settings-body">

                        @* ==================================================
                           PROCESS INPUT BINDINGS
                           ================================================== *@
                        <section class="density-process-settings">

                            @{
                                var visibleBindings = ActiveProcessBindings;
                            }

                            @for (var index = 0; index < visibleBindings.Count; index++)
                            {
                                var binding = visibleBindings[index];

                                <div class="density-process-row">

                                    <div class="density-settings-index">
                                        @(index + 1)
                                    </div>

                                    <RadzenTextBox Value="@binding.SourceText"
                                                   Change="@((string value) => OnProcessSourceChanged(binding, value))"
                                                   Placeholder="Equipment.ITEM or SCADA tag"
                                                   Disabled="@(_isSaving || _isCheckingBindings)"
                                                   class="density-process-tag" />

                                    <div class="density-process-status">
                                        <RadzenBadge Text="@GetBindingBadgeText(binding)"
                                                     BadgeStyle="@GetBindingBadgeStyle(binding)" />
                                    </div>

                                    <div class="density-process-name">
                                        @binding.Parameter.Name
                                    </div>

                                    <div class="density-process-action">

                                        @if (index == 0)
                                        {
                                            <RadzenNumeric TValue="int"
                                                           Value="@_processParameterCount"
                                                           Change="@OnProcessParameterCountChanged"
                                                           Min="2"
                                                           Max="5"
                                                           Step="1"
                                                           Disabled="@(_isSaving || _isCheckingBindings)"
                                                           class="density-process-count" />
                                        }
                                        else if (index == 1)
                                        {
                                            <RadzenButton Text="Check"
                                                          Icon="manage_search"
                                                          ButtonStyle="ButtonStyle.Light"
                                                          Disabled="@(_isSaving || _isCheckingBindings)"
                                                          Click="@CheckProcessBindingsAsync"
                                                          class="density-process-check" />
                                        }

                                    </div>

                                </div>
                            }

                        </section>


                        <div class="density-settings-separator"></div>


                        @* ==================================================
                           MIXTURE
                           ================================================== *@
                        <section class="density-mixture-settings">

                            <div class="density-mixture-header">

                                <div class="density-mixture-title">
                                    <RadzenIcon Icon="science" />
                                    <span>Mixture</span>
                                </div>

                                <div class="density-mixture-phase">

                                    <span class="density-mixture-phase-text">
                                        @MixturePhaseText
                                    </span>

                                    @* false = Liquid  -> water_drop true  = Vapour  -> air
                                       ToggleButton не имеет собственного видимого background: оставляем только картинку Material Icon. *@
                                    <RadzenToggleButton Value="@_isVaporMixture"
                                                        Change="@OnMixturePhaseChanged"
                                                        Icon="water_drop"
                                                        ToggleIcon="air"
                                                        ButtonStyle="ButtonStyle.Light"
                                                        ToggleButtonStyle="ButtonStyle.Light"
                                                        Variant="Variant.Text"
                                                        ToggleVariant="Variant.Text"
                                                        Disabled="@_isSaving"
                                                        class="density-mixture-phase-toggle"
                                                        title="Switch Liquid / Vapour" />

                                </div>

                            </div>

                            @if (CurrentComponentCount is { } componentCount)
                            {
                                @for (var index = 0; index < componentCount; index++)
                                {
                                    var component = _components[index];

                                    <div class="density-mixture-row">

                                        <div class="density-settings-index">
                                            @(index + 1)
                                        </div>

                                        <RadzenDropDown TValue="string"
                                                        Data="@FilteredSubstanceOptions"
                                                        TextProperty="@nameof(CalcParameterOptionDto.Name)"
                                                        ValueProperty="@nameof(CalcParameterOptionDto.Value)"
                                                        @bind-Value="component.SubstanceCode"
                                                        Placeholder="Select component..."
                                                        Disabled="@_isSaving"
                                                        class="density-mixture-component" />

                                        <div></div>

                                        <div></div>

                                        <RadzenNumeric TValue="double?"
                                                       Value="@GetCurrentPercent(index)"
                                                       Format="0.###' %'"
                                                       Disabled="true"
                                                       ShowUpDown="false"
                                                       class="density-mixture-percent" />

                                    </div>
                                }
                            }

                            @if (!string.IsNullOrWhiteSpace(MixtureValidationError))
                            {
                                <RadzenAlert AlertStyle="AlertStyle.Warning"
                                             AllowClose="false"
                                             ShowIcon="true"
                                             class="density-settings-warning">

                                    @MixtureValidationError

                                </RadzenAlert>
                            }

                        </section>


                        <div class="density-settings-separator"></div>


                        <div class="density-write-settings">

                            <div>

                                <div class="density-write-title">
                                    Allow output writes
                                </div>

                                <div class="density-write-description">
                                    Write calculated Density to SCADA ValCalc
                                </div>

                            </div>

                            <div class="density-write-switch">

                                <span class="density-switch-state @GetSwitchStateClass(_allowOutputWrites)">
                                    @GetSwitchStateText(_allowOutputWrites)
                                </span>

                                <RadzenSwitch @bind-Value="_allowOutputWrites"
                                                Disabled="@(_isSaving || (!_allowOutputWrites && (!IsConfigurationReady || !IsOutputBindingReady)))" />

                            </div>

                        </div>


                        @if (!IsOutputBindingReady)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Danger"
                                            AllowClose="false"
                                            ShowIcon="true"
                                            class="density-settings-warning">

                                Density Equipment does not contain ITEM ValCalc.
                                Output writes cannot be enabled.

                            </RadzenAlert>
                        }


                    </div>

                </ParamAiPanel>


                <div class="density-actions">

                    @if (Job is null)
                    {
                        <RadzenButton Text="Create job"
                                      Icon="add"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Disabled="@(_isSaving || !IsConfigurationReady)"
                                      Click="@CreateJobAsync" />
                    }
                    else
                    {
                        <RadzenButton Text="Save"
                                      Icon="save"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Disabled="@(_isSaving || !HasUnsavedChanges || !IsConfigurationReady)"
                                      Click="@SaveJobAsync" />
                    }

                </div>

            </section>

        </div>
    }

</div>


@code {
    private const string DensityDefinitionCode = "mixture.density";
    private const string ComponentCountKey = "componentCount";
    private const string CorrectionKey = "densityCorrection";

    private const int MinProcessParameterCount = 2;
    private const int MaxProcessParameterCount = 5;
    private int _processParameterCount = MinProcessParameterCount;

    private const int MaxComponentCount = 5;
    private const double PercentageTolerance = 1e-6;

    [Parameter, EditorRequired]
    public CalcModelDto Model { get; set; } = default!;

    [Parameter]
    public CalcJobDto? Job { get; set; }

    [Parameter]
    public CalcJobStateDto? State { get; set; }

    [Parameter]
    public IReadOnlyList<EquipmentDto> EquipmentCatalog { get; set; } = [];

    [Parameter]
    public EventCallback JobChanged { get; set; }

    private CalcDefinitionDto? _definition;

    private readonly List<DensityProcessBindingEditor> _processBindings = [];
    private readonly List<DensityComponentEditor> _components = [];
    private readonly Dictionary<string, double?> _liveScadaValues = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, ParamSnapshotResponse> _linkedAiSnapshots = new(StringComparer.OrdinalIgnoreCase);

    private string _contextKey = "";
    private string _savedEditorSignature = "";
    private string _loadError = "";
    private string _scadaReadError = "";
    private string _scadaRefreshModelName = "";

    private DateTimeOffset _nextScadaRefreshUtc = DateTimeOffset.MinValue;

    private bool _enabled;
    private bool _allowOutputWrites;

    // false = Liquid; true  = Vapor. Это только состояние редактора Settings.
    // В Calc Job отдельное поле Phase не сохраняем: после загрузки фаза однозначно восстанавливается по уже сохранённым SubstanceCode.
    private bool _isVaporMixture;

    private bool _isLoadingDefinition;
    private bool _isSaving;
    private bool _isCheckingBindings;
    private bool _isReadingScada;
    private bool _isWritingDeltaD;

    // ============================================================
    // Common Param write-flow
    // ============================================================

    /// <summary>
    /// Открывает общий Param write-dialog для Density.DeltaD и после успешной записи перечитывает фактическое значение из SCADA.
    /// Все окончательные проверки выполняются Runtime: Calc Catalog, ITEM allow-list, Windows user/groups, тип Number, tag resolve и CtApi write settings.
    /// </summary>
    private async Task RequestDeltaDWriteAsync()
    {
        if (_isSaving || _isWritingDeltaD)
            return;

        var tagName = DeltaDTag;
        if (string.IsNullOrWhiteSpace(tagName))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Param write", "Density ITEM 'DeltaD' was not found.", 4000);
            return;
        }

        var currentValue = CurrentDeltaD;
        var item = new ParamItemDto
        {
            Name = "DeltaD",
            Kind = ParamValueKind.Number,
            ValueText = currentValue?.ToString("0.###############", CultureInfo.InvariantCulture),
            NumericValue = currentValue,
            Unit = "kg/m³",
            TagName = tagName,
            CanWrite = true
        };

        _isWritingDeltaD = true;

        try
        {
            var response = await ParamWriteCoordinator.WriteAsync(Model.Name, item);
            if (response?.Success != true)
                return;

            await RefreshDensityScadaValuesAsync(force: true);
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _isWritingDeltaD = false;
        }
    }

    private string GetDeltaDWriteFieldClass()
    {
        return !_isSaving && !_isWritingDeltaD && !string.IsNullOrWhiteSpace(DeltaDTag) ? "density-delta-write-field is-writable" : "density-delta-write-field is-disabled";
    }

    private string GetDeltaDWriteFieldTitle()
    {
        if (string.IsNullOrWhiteSpace(DeltaDTag))
            return "Density ITEM 'DeltaD' was not found";

        return _isWritingDeltaD ? "Param write is in progress" : "Write DeltaD";
    }

    private CalcDefinitionDto? Definition => _definition;

    // ============================================================
    // SCADA ITEM mapping
    // ============================================================

    private string? ComponentCountTag => GetItemTag(Model, "CompN");
    private string? DeltaDTag => GetItemTag(Model, "DeltaD");
    private string? DensityHmiTag => GetItemTag(Model, "ValHmi");
    private string? DensityOutputTag => GetItemTag(Model, "ValCalc");

    private string? GetPercTag(int index)
    {
        return GetItemTag(Model, $"Perc{index}");
    }

    /// <summary>
    /// Показывает, разрешена ли запись рассчитанного TechMES Density в SCADA ValCalc в текущей СОХРАНЁННОЙ конфигурации Job.
    /// Используем Job.WriteEnabled, а не редактируемый _allowOutputWrites, потому что верхняя панель отображает фактическое состояние Runtime.
    /// Если пользователь изменил Allow output writes, но ещё не нажал Save, верхняя панель продолжает показывать реально работающую конфигурацию.
    /// </summary>
    private bool IsTechMesOutputWriteEnabled => Job?.WriteEnabled == true;

    // ============================================================
    // Current values
    // ============================================================

    /// <summary>
    /// Возвращает текущее количество компонентов.
    ///
    /// Для работающего Job первым источником является LastInputs,
    /// но только если componentCount действительно сохранён как Tag binding.
    ///
    /// До создания Job значение читается непосредственно из SCADA CompN
    /// через общий Param numeric tag check.
    /// </summary>
    private int? CurrentComponentCount
    {
        get
        {
            var rawValue = GetRuntimeTagInputNumber(ComponentCountKey) ?? GetLiveScadaValue("CompN");

            if (!rawValue.HasValue || !double.IsFinite(rawValue.Value))
                return null;

            var value = (int)Math.Round(rawValue.Value);

            if (Math.Abs(rawValue.Value - value) > 1e-6 || value < 1 || value > MaxComponentCount)
                return null;

            return value;
        }
    }

    private double? GetCurrentPercent(int index)
    {
        return GetRuntimeTagInputNumber(GetComponentPercentKey(index)) ?? GetLiveScadaValue($"Perc{index}");
    }

    // DeltaD является редактируемым SCADA ITEM, поэтому фактическое значение SCADA имеет приоритет над LastInputs работающего Job.
    private double? CurrentDeltaD => GetLiveScadaValue("DeltaD") ?? GetRuntimeTagInputNumber(CorrectionKey);

    // ValHmi уже находится в инженерных единицах и отображается как есть.
    private double? CurrentDensityHmi => GetLiveScadaValue("ValHmi");

    // ValCalc читается как фактическое значение SCADA-тега.
    // При записи Density Runtime применяет output Scale/Offset. Поэтому для отображения выполняем обратное преобразование:
    //
    //     engineering = (SCADA - Offset) / Scale
    //
    // Сейчас Density использует Scale = 10, Offset = 0, но UI не хардкодит это правило и читает его из сохранённого Job.
    private double? CurrentDensityCalcEngineering
    {
        get
        {
            var scadaValue = GetLiveScadaValue("ValCalc");

            if (!scadaValue.HasValue)
                return null;

            var output = Job?.Outputs.FirstOrDefault(item => string.Equals(item.OutputKey, "density", StringComparison.OrdinalIgnoreCase));
            var scale = output?.Scale ?? 10d;
            var offset = output?.Offset ?? 0d;

            if (!double.IsFinite(scale) || Math.Abs(scale) < double.Epsilon || !double.IsFinite(offset))
                return null;

            return (scadaValue.Value - offset) / scale;
        }
    }

    private const string LiquidSubstancePhase = "liquid";
    private const string VaporSubstancePhase = "vapor";

    private IReadOnlyList<CalcParameterOptionDto> SubstanceOptions => GetParameter("component0Code")?.Options ?? [];

    /// <summary>
    /// Текущая выбранная глобальная фаза смеси в Settings.
    ///
    /// Внутри Calc используется настоящий SubstancePhase.
    /// WEB получает его транспортное представление через CalcParameterOptionDto.Phase.
    ///
    /// Поэтому здесь больше нет анализа пользовательского Name.
    /// </summary>
    private string SelectedSubstancePhase => _isVaporMixture ? VaporSubstancePhase : LiquidSubstancePhase;

    /// <summary>
    /// Возвращает только компоненты текущей глобальной фазы смеси.
    ///
    /// Phase приходит отдельным полем Definition DTO:
    ///
    ///     liquid
    ///     vapor
    ///
    /// Отображаемый Name компонента в фильтрации больше не участвует.
    /// </summary>
    private IReadOnlyList<CalcParameterOptionDto> FilteredSubstanceOptions => SubstanceOptions.Where(option => string.Equals(option.Phase, SelectedSubstancePhase, StringComparison.OrdinalIgnoreCase)).ToArray();

    /// <summary>
    /// Определяет фазу конкретного сохранённого SubstanceCode.
    ///
    /// Поиск выполняется по стабильному Value,
    /// а физическая фаза берётся только из отдельного Option.Phase.
    /// </summary>
    private bool IsVaporSubstanceCode(string? substanceCode)
    {
        if (string.IsNullOrWhiteSpace(substanceCode))
            return false;

        var option = SubstanceOptions.FirstOrDefault(item => string.Equals(item.Value, substanceCode.Trim(), StringComparison.OrdinalIgnoreCase));

        return string.Equals(option?.Phase, VaporSubstancePhase, StringComparison.OrdinalIgnoreCase);
    }

    private string MixturePhaseText => _isVaporMixture ? "Vapour" : "Liquid";

    private string MixturePhaseIcon => _isVaporMixture ? "air" : "water_drop";

    /// <summary>
    /// Верхняя live-панель должна показывать фазу реально сохранённой смеси,
    /// а не несохранённого состояния переключателя Settings.
    ///
    /// Для нового Job сохранённой смеси ещё нет,
    /// поэтому используется текущее состояние редактора.
    /// </summary>
    private string GetLiveMixturePhaseIcon()
    {
        if (CurrentComponentCount.HasValue)
        {
            for (var index = 0; index < CurrentComponentCount.Value; index++)
            {
                var code = GetLiveComponentCode(index);

                if (!string.IsNullOrWhiteSpace(code))
                    return IsVaporSubstanceCode(code) ? "air" : "water_drop";
            }
        }

        return MixturePhaseIcon;
    }

    /// <summary>
    /// Возвращает только те ProcessInput, которые сейчас включены пользователем.
    /// Первые два параметра всегда активны: Temperature и Pressure.
    /// Дополнительные ProcessInput появляются последовательно при увеличении количества параметров от 3 до 5.
    /// </summary>
    private IReadOnlyList<DensityProcessBindingEditor> ActiveProcessBindings => _processBindings
        .OrderBy(binding => binding.Parameter.Order)
        .Take(_processParameterCount)
        .ToList();

    // ============================================================
    // Readiness
    // ============================================================

    /// <summary>
    /// Проверяет готовность всех активных ProcessInput.
    ///
    /// Возможны три ситуации.
    ///
    /// 1. Binding успешно проверен:
    ///    параметр готов независимо от наличия DefaultValue.
    ///
    /// 2. Поле пустое, но Calculation Definition имеет DefaultValue:
    ///    параметр также готов.
    ///    Именно так работает optional Pressure.
    ///
    /// 3. Поле пустое и DefaultValue отсутствует либо пользователь
    ///    ввёл значение, которое не удалось разрешить:
    ///    параметр не готов.
    ///
    /// Благодаря этому Additional parameter остаётся обязательным
    /// после его включения пользователем, потому что у резервных
    /// дополнительных параметров DefaultValue отсутствует.
    /// </summary>
    private bool IsProcessBindingsReady => ActiveProcessBindings.All(IsProcessBindingReady);

    private static bool IsProcessBindingReady(DensityProcessBindingEditor binding)
    {
        if (binding.IsLinked)
            return true;

        // Если пользователь что-то ввёл, это значение обязательно должно пройти реальный Runtime Check.
        if (!string.IsNullOrWhiteSpace(binding.SourceText))
            return false;

        // Пустой ProcessInput разрешён только тогда, когда сам Definition явно определяет значение по умолчанию.
        return HasProcessDefaultValue(binding.Parameter);
    }

    private static bool HasProcessDefaultValue(CalcParameterDefinitionDto parameter)
    {
        return parameter.DefaultValue.HasValue
            && parameter.DefaultValue.Value.ValueKind != JsonValueKind.Null
            && parameter.DefaultValue.Value.ValueKind != JsonValueKind.Undefined;
    }

    /// <summary>
    /// Проверяем полную SCADA-структуру Density Equipment.
    ///
    /// Perc0...Perc4 должны существовать независимо от текущего CompN,
    /// потому что это фиксированный контракт Density Equipment Type.
    /// </summary>
    private bool IsDensityScadaStructureReady =>
        !string.IsNullOrWhiteSpace(ComponentCountTag)
        && !string.IsNullOrWhiteSpace(DeltaDTag)
        && Enumerable.Range(0, MaxComponentCount).All(index => !string.IsNullOrWhiteSpace(GetPercTag(index)));

    private bool IsDensityScadaValuesReady
    {
        get
        {
            if (!CurrentComponentCount.HasValue || !CurrentDeltaD.HasValue)
                return false;

            for (var index = 0; index < CurrentComponentCount.Value; index++)
            {
                if (!GetCurrentPercent(index).HasValue)
                    return false;
            }

            return true;
        }
    }

    private bool IsOutputBindingReady => !string.IsNullOrWhiteSpace(DensityOutputTag);

    private bool IsConfigurationReady =>
        Definition is not null
        && IsProcessBindingsReady
        && IsDensityScadaStructureReady
        && IsDensityScadaValuesReady
        && IsOutputBindingReady
        && string.IsNullOrWhiteSpace(MixtureValidationError);

    /// <summary>
    /// Старый Job Version 1 использовал Constants для CompN/Perc.
    ///
    /// После установки Definition Version 2 такой Job должен быть явно
    /// пересохранён, чтобы получить новые SCADA bindings.
    /// Поэтому version mismatch также считается изменением конфигурации.
    /// </summary>
    private bool HasDefinitionVersionChange =>
        Job is not null
        && Definition is not null
        && !string.Equals(Job.DefinitionVersion, Definition.Version, StringComparison.Ordinal);

    private bool HasUnsavedChanges =>
        HasDefinitionVersionChange
        || !string.Equals(_savedEditorSignature, BuildEditorSignature(), StringComparison.Ordinal);

    public bool HasPendingChanges => HasUnsavedChanges;

    // ============================================================
    // Lifecycle
    // ============================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadDefinitionAsync();

        if (Definition is null)
            return;

        SynchronizeConfiguration(force: true);

        // Сразу после восстановления редактора фиксируем его как сохранённое состояние.
        //
        // Это нужно сделать ДО любых await:
        // иначе Blazor может успеть выполнить промежуточный render и показать
        // ложное сообщение Unsaved changes, хотя пользователь ничего не менял.
        CaptureSavedEditorState();

        // Читаем собственные SCADA items Density:
        // ValHmi, ValCalc, CompN, PercN, DeltaD.
        await RefreshDensityScadaValuesAsync(force: true);

        // Проверяем сохранённые ProcessInput.
        // После этого Equipment.ITEM bindings получают реальный LINKED.
        await ValidateStoredProcessBindingsAsync();

        // Теперь, когда bindings гарантированно проверены,
        // сразу загружаем AI snapshot для bargraph.
        //
        // Поэтому Temperature/Pressure bar появляются сразу,
        // а не только после следующего 5-секундного refresh.
        await RefreshLinkedAiSnapshotsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Definition is null)
            return;

        var contextChanged = SynchronizeConfiguration();

        if (contextChanged)
        {
            // Новая модель/Job только что восстановлены из сохранённой конфигурации. Это НЕ пользовательское изменение.
            // Фиксируем signature немедленно, до первого await, чтобы при переключении между Density не мигал Unsaved changes.
            CaptureSavedEditorState();
        }

        await RefreshDensityScadaValuesAsync();

        if (contextChanged)
        {
            // RefreshDensityScadaValuesAsync мог выполняться ещё до того, как сохранённые Equipment.ITEM bindings получили LINKED.
            // Поэтому сначала выполняем реальную проверку bindings, а затем ещё раз сразу запрашиваем AI snapshots.
            await ValidateStoredProcessBindingsAsync();
            await RefreshLinkedAiSnapshotsAsync();
        }
    }

    /// <summary>
    /// Загружает установленный Runtime Density Definition.
    ///
    /// WEB не хранит собственную копию списка ProcessInput:
    /// Temperature, Pressure и будущие параметры приходят из Definition.
    /// </summary>
    private async Task LoadDefinitionAsync()
    {
        _isLoadingDefinition = true;
        _loadError = "";

        try
        {
            var definitions = await CalcApi.GetDefinitionsAsync();
            _definition = definitions.FirstOrDefault(definition => string.Equals(definition.Code, DensityDefinitionCode, StringComparison.OrdinalIgnoreCase));

            if (_definition is null)
                _loadError = "Density calculation definition is not available in Runtime.";
        }
        catch (Exception ex)
        {
            _loadError = "Cannot load Density calculation definition: " + ex.Message;
            _definition = null;
        }
        finally
        {
            _isLoadingDefinition = false;
        }
    }

    /// <summary>
    /// Восстанавливает редактируемую конфигурацию из Calc Job.
    ///
    /// Live SCADA CompN/Perc/DeltaD сюда не копируются.
    /// Они существуют независимо от WEB-конфигурации и читаются отдельно.
    /// </summary>
    private bool SynchronizeConfiguration(bool force = false)
    {
        if (Definition is null)
            return false;

        var structureSignature = string.Join("|", Model.ItemTags
            .OrderBy(pair => pair.Key, StringComparer.OrdinalIgnoreCase)
            .ThenBy(pair => pair.Value, StringComparer.OrdinalIgnoreCase)
            .Select(pair => $"{pair.Key}={pair.Value}"));

        var newContextKey = $"{Model.Name}|{Job?.Id}|{Job?.Revision}|{Definition.Version}|{structureSignature}";

        if (!force && string.Equals(_contextKey, newContextKey, StringComparison.Ordinal))
            return false;

        _contextKey = newContextKey;

        BuildProcessBindings();
        BuildComponentConfiguration();

        // Сохранённое Enabled/WriteEnabled не должны автоматически выключаться
        // только потому, что в момент открытия страницы SCADA ещё не успела прочитаться.
        _enabled = Job?.Enabled == true;
        _allowOutputWrites = Job?.WriteEnabled == true;

        _nextScadaRefreshUtc = DateTimeOffset.MinValue;

        return true;
    }

    // ============================================================
    // ProcessInput resolving
    // ============================================================

    /// <summary>
    /// Строит редакторы всех доступных ProcessInput.
    ///
    /// SourceText восстанавливается из SourceReference — то есть пользователь
    /// снова видит, например, S03.R02.TT01.R.
    ///
    /// ResolvedTagName содержит реальный Variable Tag, который читает Calc.Service.
    ///
    /// Для старых Job, созданных до SourceReference, используем TagName
    /// как backward-compatible отображаемое значение.
    /// </summary>
    private void BuildProcessBindings()
    {
        _processBindings.Clear();

        if (Definition is null)
            return;

        foreach (var parameter in Definition.Parameters.Where(parameter => parameter.Role == CalcParameterRoleDto.ProcessInput).OrderBy(parameter => parameter.Order))
        {
            var stored = FindJobInput(parameter.Key);
            var storedTag = stored?.SourceType == CalcInputSourceTypeDto.Tag ? stored.TagName?.Trim() ?? "" : "";
            var storedSourceReference = stored?.SourceType == CalcInputSourceTypeDto.Tag ? stored.SourceReference?.Trim() ?? "" : "";

            // Старые Job ещё не имеют SourceReference.
            // Для них в поле продолжаем показывать сохранённый Variable Tag.
            var sourceText = storedSourceReference.Length > 0 ? storedSourceReference : storedTag;

            var currentValue = 0d;
            var hasRuntimeValue = storedTag.Length > 0 && TryGetRuntimeNumber(State?.LastInputs, parameter.Key, out currentValue);

            _processBindings.Add(new DensityProcessBindingEditor
            {
                Parameter = parameter,
                SourceText = sourceText,
                ResolvedTagName = storedTag,
                ValidatedSourceText = hasRuntimeValue ? sourceText : "",
                CurrentValue = hasRuntimeValue ? currentValue : null,
                Resolution = hasRuntimeValue ? storedSourceReference.Length > 0 ? $"Saved {storedSourceReference}" : "Saved Runtime tag" : "",
                MaxAgeSeconds = stored?.SourceType == CalcInputSourceTypeDto.Tag ? stored.MaxAgeSeconds : null,
                CheckState = hasRuntimeValue ? DensityBindingCheckState.Linked : DensityBindingCheckState.NotChecked
            });
        }

        // Для нового Job активны два штатных входа: Temperature и Pressure.
        //
        // Для сохранённого Job число восстанавливается по реально сохранённым
        // ProcessInput Tag bindings, поэтому отдельное поле в PostgreSQL не требуется.
        var configuredProcessInputs = _processBindings.Count(binding =>
        {
            var stored = FindJobInput(binding.Parameter.Key);
            return stored?.SourceType == CalcInputSourceTypeDto.Tag && !string.IsNullOrWhiteSpace(stored.TagName);
        });

        _processParameterCount = Math.Clamp(configuredProcessInputs, MinProcessParameterCount, MaxProcessParameterCount);
    }

    /// <summary>
    /// После загрузки сохранённого Job проверяет те bindings,
    /// для которых Runtime State ещё не дал подтверждённого значения.
    ///
    /// Это позволяет открыть выключенный Job и всё равно увидеть
    /// реальный статус Temperature/Pressure.
    /// </summary>
    private async Task ValidateStoredProcessBindingsAsync()
    {
        foreach (var binding in _processBindings.Where(binding => !binding.IsLinked && !string.IsNullOrWhiteSpace(binding.SourceText)))
            await ResolveProcessBindingAsync(binding);
    }

    /// <summary>
    /// Выполняет Check всех ProcessInput.
    ///
    /// Для каждого параметра используется CalcProcessInputResolver:
    /// сначала Runtime AI.R, затем direct numeric Variable Tag.
    /// </summary>
    private async Task CheckProcessBindingsAsync()
    {
        if (_isCheckingBindings)
            return;

        _isCheckingBindings = true;

        try
        {
            foreach (var binding in ActiveProcessBindings)
                await ResolveProcessBindingAsync(binding);

            await RefreshLinkedAiSnapshotsAsync();
            NotificationService.Notify(IsProcessBindingsReady ? NotificationSeverity.Success : NotificationSeverity.Warning,"Density", IsProcessBindingsReady ? "Required process bindings are valid." : "Some required process bindings were not resolved.", 4000);
        }
        finally
        {
            _isCheckingBindings = false;
        }
    }

    private async Task ResolveProcessBindingAsync(DensityProcessBindingEditor binding)
    {
        var source = binding.SourceText.Trim();

        binding.ResolvedTagName = "";
        binding.ValidatedSourceText = "";
        binding.CurrentValue = null;
        binding.Resolution = "";
        binding.Message = "";

        if (source.Length == 0)
        {
            // Пустое поле допустимо только для параметра,
            // которому Calculation Definition явно задал DefaultValue.
            //
            // Для Density Pressure это 1.01325 bar(abs).
            if (HasProcessDefaultValue(binding.Parameter))
            {
                binding.CheckState = DensityBindingCheckState.NotChecked;
                binding.Message = "Default value will be used.";
                return;
            }

            binding.CheckState = binding.Parameter.IsRequired
                ? DensityBindingCheckState.NotFound
                : DensityBindingCheckState.NotChecked;

            binding.Message = binding.Parameter.IsRequired
                ? "Source is required."
                : "Process input must be configured when it is enabled.";

            return;
        }

        binding.CheckState = DensityBindingCheckState.Checking;

        var resolution = await ProcessInputResolver.ResolveAsync(source, EquipmentCatalog);

        if (!resolution.Success || string.IsNullOrWhiteSpace(resolution.ResolvedTagName) || !resolution.CurrentValue.HasValue)
        {
            binding.CheckState = DensityBindingCheckState.NotFound;
            binding.Message = resolution.Message ?? "Process input was not resolved.";
            return;
        }

        binding.ResolvedTagName = resolution.ResolvedTagName;
        binding.ValidatedSourceText = source;
        binding.CurrentValue = resolution.CurrentValue;
        binding.Resolution = resolution.Resolution ?? "";
        binding.CheckState = DensityBindingCheckState.Linked;
    }

    /// <summary>
    /// Любое изменение пользовательской ссылки сбрасывает предыдущий Check.
    ///
    /// То есть после изменения даже одного символа прежний LINKED
    /// больше не считается действительным.
    /// </summary>
    private void OnProcessSourceChanged(DensityProcessBindingEditor binding, string? value)
    {
        var normalized = (value ?? "").Trim();

        if (string.Equals(binding.SourceText, normalized, StringComparison.Ordinal))
            return;

        binding.SourceText = normalized;
        binding.ResolvedTagName = "";
        binding.ValidatedSourceText = "";
        binding.CurrentValue = null;
        binding.Resolution = "";
        binding.Message = "";
        binding.CheckState = DensityBindingCheckState.NotChecked;
    }

    /// <summary>
    /// Изменяет количество активных Process parameters.
    ///
    /// При уменьшении количества дополнительные строки скрываются, но их текущее содержимое в редакторе сразу не уничтожается.
    /// При следующем Save в Job попадут только активные строки.
    /// </summary>
    private void OnProcessParameterCountChanged(int value)
    {
        _processParameterCount = Math.Clamp(value, MinProcessParameterCount, MaxProcessParameterCount);
    }

    // ============================================================
    // ProcessInput AI visualization
    // ============================================================

    /// <summary>
    /// Обновляет Param snapshot только для тех Linked ProcessInput,
    /// которые были разрешены как Equipment.ITEM и принадлежат AI Equipment.
    ///
    /// Direct Variable Tag сюда намеренно не попадает:
    /// для него у нас нет гарантированного Equipment Min/Max контракта.
    /// </summary>
    private async Task RefreshLinkedAiSnapshotsAsync()
    {
        var equipments = new Dictionary<string, EquipmentDto>(StringComparer.OrdinalIgnoreCase);

        foreach (var binding in ActiveProcessBindings)
        {
            if (TryGetLinkedAiEquipment(binding, out var equipment, out _))
                equipments[equipment.Name] = equipment;
        }

        var activeNames = equipments.Keys.ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var oldName in _linkedAiSnapshots.Keys.Where(name => !activeNames.Contains(name)).ToList())
            _linkedAiSnapshots.Remove(oldName);

        if (equipments.Count == 0)
            return;

        var reads = await Task.WhenAll(equipments.Values.Select(async equipment =>
        {
            try
            {
                var snapshot = await ParamApi.GetSnapshotAsync(equipment.Name);

                return new DensityAiSnapshotRead(
                    EquipmentName: equipment.Name,
                    Snapshot: snapshot.Supported && snapshot.TypeGroup == EquipmentTypeGroup.AI ? snapshot : null);
            }
            catch
            {
                return new DensityAiSnapshotRead(equipment.Name, null);
            }
        }));

        foreach (var read in reads)
        {
            if (read.Snapshot is not null)
                _linkedAiSnapshots[read.EquipmentName] = read.Snapshot;
            else
                _linkedAiSnapshots.Remove(read.EquipmentName);
        }
    }

    /// <summary>
    /// Определяет, что Linked ProcessInput был введён именно в формате
    /// Equipment.ITEM и Equipment относится к группе AI.
    ///
    /// Для direct Variable Tag метод возвращает false.
    /// </summary>
    private bool TryGetLinkedAiEquipment(DensityProcessBindingEditor binding, out EquipmentDto equipment, out string itemName)
    {
        equipment = null!;
        itemName = "";

        if (!binding.IsLinked || string.IsNullOrWhiteSpace(binding.ValidatedSourceText))
            return false;

        var source = binding.ValidatedSourceText.Trim();

        var candidate = EquipmentCatalog
            .Where(item => !item.IsGroup && item.TypeGroup == EquipmentTypeGroup.AI && !string.IsNullOrWhiteSpace(item.Name))
            .OrderByDescending(item => item.Name.Length)
            .FirstOrDefault(item => source.StartsWith(item.Name + ".", StringComparison.OrdinalIgnoreCase));

        if (candidate is null)
            return false;

        var sourceItemName = source[(candidate.Name.Length + 1)..].Trim();

        if (sourceItemName.Length == 0)
            return false;

        equipment = candidate;
        itemName = sourceItemName;

        return true;
    }

    /// <summary>
    /// Формирует bargraph для первых двух штатных ProcessInput:
    ///
    ///     Temperature
    ///     Pressure.
    ///
    /// В результат попадают только реально отображаемые bargraph.
    ///
    /// Условия отображения остаются прежними:
    ///
    /// - ProcessInput должен иметь статус LINKED;
    /// - source должен быть Equipment.ITEM;
    /// - Equipment должен относиться к AI;
    /// - snapshot должен содержать корректные Min/Max;
    /// - должно существовать текущее числовое значение.
    ///
    /// В отличие от предыдущей реализации здесь не создаются
    /// искусственные пустые слоты.
    ///
    /// Поэтому:
    ///
    ///     0 bar -> левая область полностью отсутствует;
    ///     1 bar -> область занимает ширину одного элемента;
    ///     2 bar -> область занимает ширину двух элементов.
    ///
    /// Центральная область автоматически занимает освободившееся место.
    /// </summary>
    private IReadOnlyList<DensityProcessBarView> BuildPrimaryProcessBars()
    {
        var result = new List<DensityProcessBarView>(2);

        foreach (var binding in _processBindings
            .OrderBy(binding => binding.Parameter.Order)
            .Take(2))
        {
            var bar = BuildLiveProcessBar(binding);

            if (bar is not null)
                result.Add(bar);
        }

        return result;
    }

    /// <summary>
    /// Пытается построить один AI bargraph для ProcessInput.
    ///
    /// Bargraph существует только после реального LINKED и только для AI Equipment.
    /// Direct Variable Tag в bargraph не превращаем, потому что у него нет
    /// гарантированной Equipment-структуры Min/Max.
    /// </summary>
    private DensityProcessBarView? BuildLiveProcessBar(DensityProcessBindingEditor binding)
    {
        if (!TryGetLinkedAiEquipment(binding, out var equipment, out var itemName))
            return null;

        if (!_linkedAiSnapshots.TryGetValue(equipment.Name, out var snapshot))
            return null;

        if (!TryGetAiBounds(snapshot, itemName, out var min, out var max))
            return null;

        var value = GetProcessCurrentValue(binding);

        if (!value.HasValue)
            return null;

        return new DensityProcessBarView(
            ParameterKey: binding.Parameter.Key,
            Name: GetProcessDisplayName(binding),
            Source: binding.ValidatedSourceText,
            ItemName: itemName,
            Value: value.Value,
            Min: min,
            Max: max,
            Unit: string.IsNullOrWhiteSpace(snapshot.Unit) ? binding.Parameter.Unit ?? "" : snapshot.Unit.Trim(),
            FillColor: GetProcessBarColor(binding));
    }

    /// <summary>
    /// Возвращает диапазон шкалы для конкретного AI ITEM.
    ///
    /// Стандартный AI R использует MinR/MaxR.
    /// PLC Value использует Min/Max.
    ///
    /// Для будущих ITEM допускаем структуру MinITEM/MaxITEM,
    /// но если такой пары нет, bargraph не показываем.
    /// </summary>
    private static bool TryGetAiBounds(ParamSnapshotResponse snapshot, string itemName, out double min, out double max)
    {
        min = 0d;
        max = 0d;

        double? minValue;
        double? maxValue;

        if (itemName.Equals("R", StringComparison.OrdinalIgnoreCase))
        {
            minValue = GetSnapshotNumber(snapshot, "MinR");
            maxValue = GetSnapshotNumber(snapshot, "MaxR");
        }
        else if (itemName.Equals("Value", StringComparison.OrdinalIgnoreCase))
        {
            minValue = GetSnapshotNumber(snapshot, "Min");
            maxValue = GetSnapshotNumber(snapshot, "Max");
        }
        else
        {
            minValue = GetSnapshotNumber(snapshot, $"Min{itemName}");
            maxValue = GetSnapshotNumber(snapshot, $"Max{itemName}");
        }

        if (!minValue.HasValue || !maxValue.HasValue || !double.IsFinite(minValue.Value) || !double.IsFinite(maxValue.Value))
            return false;

        if (Math.Abs(maxValue.Value - minValue.Value) < double.Epsilon)
            return false;

        min = minValue.Value;
        max = maxValue.Value;

        return true;
    }

    private static double? GetSnapshotNumber(ParamSnapshotResponse snapshot, params string[] names)
    {
        var item = snapshot.Items.FirstOrDefault(candidate => names.Any(name => candidate.Name.Equals(name, StringComparison.OrdinalIgnoreCase)));

        if (item is null)
            return null;

        if (item.NumericValue.HasValue)
            return item.NumericValue.Value;

        if (double.TryParse(item.ValueText?.Replace(',', '.'), NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed))
            return parsed;

        return null;
    }

    private static string GetProcessDisplayName(DensityProcessBindingEditor binding)
    {
        return binding.Parameter.Order switch
        {
            1 => "Temperature",
            2 => "Pressure",
            3 => "Additional parameter 1",
            4 => "Additional parameter 2",
            5 => "Additional parameter 3",
            _ => binding.Parameter.Name
        };
    }

    private static string GetProcessBarColor(DensityProcessBindingEditor binding)
    {
        return binding.Parameter.Order switch
        {
            1 => "#4f81bd",
            2 => "#4f9a50",
            3 => "#8064a2",
            4 => "#c27c3a",
            5 => "#6f6f6f",
            _ => "#4f81bd"
        };
    }

