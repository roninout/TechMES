    private enum DensityBindingCheckState
    {
        NotChecked,
        Checking,
        Linked,
        NotFound
    }

    private sealed class DensityProcessBindingEditor
    {
        public CalcParameterDefinitionDto Parameter { get; set; } = new();

        // То, что пользователь ввёл в Settings.
        public string SourceText { get; set; } = "";

        // Реальный Variable Tag, который после успешного Check
        // будет сохранён в Calc Job.
        public string ResolvedTagName { get; set; } = "";

        // SourceText, для которого последний Check был успешным.
        // Если пользователь меняет SourceText, IsLinked сразу становится false.
        public string ValidatedSourceText { get; set; } = "";

        public string Resolution { get; set; } = "";
        public string Message { get; set; } = "";

        public int? MaxAgeSeconds { get; set; }
        public double? CurrentValue { get; set; }

        public DensityBindingCheckState CheckState { get; set; }

        public bool IsLinked =>
            CheckState == DensityBindingCheckState.Linked
            && !string.IsNullOrWhiteSpace(ResolvedTagName)
            && string.Equals(SourceText.Trim(), ValidatedSourceText, StringComparison.OrdinalIgnoreCase);
    }

    private sealed class DensityComponentEditor
    {
        public int Index { get; set; }
        public string SubstanceCode { get; set; } = "";
    }

