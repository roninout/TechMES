    private CalcParameterDefinitionDto? GetParameter(string key)
    {
        return Definition?.Parameters.FirstOrDefault(parameter => string.Equals(parameter.Key, key, StringComparison.OrdinalIgnoreCase));
    }

    private CalcJobInputDto? FindJobInput(string key)
    {
        return Job?.Inputs.FirstOrDefault(input => string.Equals(input.ParameterKey, key, StringComparison.OrdinalIgnoreCase));
    }

    private static string GetComponentCodeKey(int index)
    {
        return $"component{index}Code";
    }

    private static string GetComponentPercentKey(int index)
    {
        return $"component{index}Percent";
    }

    private string ReadStoredString(string key, string defaultValue)
    {
        var input = FindJobInput(key);

        if (input?.SourceType == CalcInputSourceTypeDto.Constant
            && input.ConstantValue.HasValue
            && input.ConstantValue.Value.ValueKind == JsonValueKind.String)
        {
            return input.ConstantValue.Value.GetString()?.Trim() ?? defaultValue;
        }

        return defaultValue;
    }

    // ============================================================
    // SCADA ITEM helper
    // ============================================================

    private static string? GetItemTag(CalcModelDto? model, string itemName)
    {
        if (model?.ItemTags is null || model.ItemTags.Count == 0 || string.IsNullOrWhiteSpace(itemName))
            return null;

        if (model.ItemTags.TryGetValue(itemName, out var tagName) && !string.IsNullOrWhiteSpace(tagName))
            return tagName.Trim();

        var item = model.ItemTags.FirstOrDefault(pair => string.Equals(pair.Key, itemName, StringComparison.OrdinalIgnoreCase));

        return !string.IsNullOrWhiteSpace(item.Value) ? item.Value.Trim() : null;
    }

    // ============================================================
    // Runtime JSON helper
    // ============================================================

    private static bool TryGetRuntimeNumber(JsonElement? source, string key, out double value)
    {
        value = 0d;

        if (!source.HasValue || source.Value.ValueKind != JsonValueKind.Object)
            return false;

        foreach (var property in source.Value.EnumerateObject())
        {
            if (!string.Equals(property.Name, key, StringComparison.OrdinalIgnoreCase))
                continue;

            return property.Value.ValueKind == JsonValueKind.Number
                && property.Value.TryGetDouble(out value)
                && double.IsFinite(value);
        }

        return false;
    }

