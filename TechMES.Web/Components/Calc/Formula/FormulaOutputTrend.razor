@using Microsoft.Extensions.Options
@using TechMES.Contracts.Param
@using TechMES.Web.Settings
@implements IAsyncDisposable
@inject ParamApiClient ParamApi
@inject IOptions<ParamUiOptions> ParamOptions

@if (_supported && TrendAvailable != false)
{
    <div class="formula-output-trend">
        <div class="formula-output-trend-toolbar">
            <div class="formula-trend-date-controls">
                <RadzenDatePicker TValue="DateTime" Value="@_selectedDate" Change="@OnDateChangedAsync" ShowInput="false" ShowTime="false" AllowClear="false" DateFormat="dd.MM.yyyy" Max="@DateTime.Today" Disabled="@_loading" />
                <span class="formula-trend-date">@_selectedDate.ToString("dd.MM.yyyy")</span>
            </div>

            <RadzenButton Text="Live" Icon="update" ButtonStyle="@(_live ? ButtonStyle.Success : ButtonStyle.Light)" Size="ButtonSize.Small" IsBusy="@_loading" BusyText="Loading..." Disabled="@_loading" Click="@GoLiveAsync" />
        </div>

        @if (_points.Count > 0)
        {
            <RadzenChart @ref="_chart" AllowZoom="true" AllowPan="true" ViewStart="@_viewStart" ViewEnd="@_viewEnd" ViewChange="@OnViewChanged" Style="height:360px; width:100%;">
                <RadzenLineSeries Data="@_points" CategoryProperty="Time" ValueProperty="Value" Title="@TagName" Stroke="var(--rz-primary)" StrokeWidth="2">
                    <TooltipTemplate Context="point">
                        <div class="formula-trend-tooltip">
                            <strong>@TagName</strong>
                            <div>@point.Time.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</div>
                            <div>Value: @point.Value.ToString("0.######")</div>
                        </div>
                    </TooltipTemplate>

                    <ChildContent>
                        <RadzenSeriesDataLabels Display="DataLabelDisplay.FirstLast" Appearance="DataLabelAppearance.Chip" Position="DataLabelPosition.Auto" FormatString="{0:0.###}" />
                    </ChildContent>
                </RadzenLineSeries>

                <RadzenCategoryAxis Min="@AxisFrom" Max="@AxisTo" Formatter="@FormatAxisTime" Padding="0">
                    <RadzenGridLines Visible="true" />
                </RadzenCategoryAxis>

                @*<RadzenValueAxis Min="@(HasScale ? Minimum : null)" Max="@(HasScale ? Maximum : null)" FormatString="{0:0.###}">*@

                <RadzenValueAxis FormatString="{0:0.###}">
                    <RadzenGridLines Visible="true" />
                </RadzenValueAxis>

                <RadzenLegend Visible="true" Position="LegendPosition.Bottom" />
                <RadzenChartTooltipOptions Shared="false" />
            </RadzenChart>

            @if (_navigatorPoints.Count > 1)
            {
                <div class="formula-trend-navigator" @onpointerdown="PauseLive">
                    <RadzenRangeNavigator @key="_navigatorPoints" Start="@_viewStart" End="@_viewEnd" StartChanged="@OnNavigatorStartChanged" EndChanged="@OnNavigatorEndChanged" ShowHandleLabels="true" HandleLabelFormatter="@FormatNavigatorTime" Style="height:80px; width:100%;">
                        <RadzenRangeNavigatorLineSeries Data="@_navigatorPoints" CategoryProperty="Time" ValueProperty="Value" Stroke="var(--rz-primary)" />
                    </RadzenRangeNavigator>
                </div>
            }
        }

        @if (_message.Length > 0)
        {
            <div class="formula-output-trend-message">@_message</div>
        }
    </div>
}

@code {
    // История ограничена выбранными календарными сутками.
    private const int RequestChunkMinutes = 60;

    // Запас на сутки с переводом часов назад: 25 часов по одной точке в секунду.
    private const int MaxStoredPoints = 25 * 60 * 60 + 1;
    private const int MaxChartPoints = 1_200;
    private const int MaxNavigatorPoints = 600;
    private const int RequestTimeoutSeconds = 30;

    [Parameter] public string TagName { get; set; } = "";
    [Parameter] public bool? TrendAvailable { get; set; }
    [Parameter] public double? Minimum { get; set; }
    [Parameter] public double? Maximum { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private RadzenChart? _chart;
    private bool _reloadChart;
    private double? _navigatorStart;
    private PeriodicTimer? _timer;
    private Task? _pollTask;

    private List<TrendPoint> _history = [];
    private List<TrendPoint> _points = [];
    private List<TrendPoint> _navigatorPoints = [];

    private string _tag = "", _message = "";
    private bool _started, _supported, _loading, _disposed, _live = true;
    private bool? _lastAvailability;
    private int _windowMinutes;
    private DateTime _fromUtc, _toUtc, _selectedDate, _dayFromUtc, _dayToUtc;
    private int _selectionVersion;
    private double _viewStart, _viewEnd = 1;

    private bool HasScale => Minimum.HasValue && Maximum.HasValue && double.IsFinite(Minimum.Value) && double.IsFinite(Maximum.Value) && Minimum.Value < Maximum.Value;

    // Границы определяются полной историей, а не прореженным видимым участком.
    private DateTime AxisFrom => _history.Count > 1 ? _history[0].Time : _fromUtc;
    private DateTime AxisTo => _history.Count > 1 ? _history[^1].Time : _toUtc;

    // Данные и шкалы храним в UTC, местное время используем только для подписей.
    private static DateTime AsUtc(DateTime value) => value.Kind == DateTimeKind.Unspecified ? DateTime.SpecifyKind(value, DateTimeKind.Utc) : value.ToUniversalTime();
    private static string FormatAxisTime(object value) => value is DateTime time ? AsUtc(time).ToLocalTime().ToString("HH:mm") : "";
    private static string FormatNavigatorTime(object value) => value is DateTime time ? AsUtc(time).ToLocalTime().ToString("dd.MM HH:mm") : "";

    private static (DateTime From, DateTime To) GetDayBounds(DateTime date, TimeZoneInfo zone)
    {
        var midnight = DateTime.SpecifyKind(date.Date, DateTimeKind.Unspecified);
        return (TimeZoneInfo.ConvertTimeToUtc(midnight, zone), TimeZoneInfo.ConvertTimeToUtc(midnight.AddDays(1), zone));
    }

    private void BeginDay(DateTime date)
    {
        _selectedDate = date.Date;
        (_dayFromUtc, _dayToUtc) = GetDayBounds(_selectedDate, TimeZoneInfo.Local);
        _selectionVersion++;
        _history = [];
        _points = [];
        _navigatorPoints = [];
        _navigatorStart = null;
        _message = "";
        _fromUtc = _toUtc = default;
        _viewStart = 0;
        _viewEnd = 1;
    }

    private async Task OnDateChangedAsync(DateTime? value)
    {
        if (_loading || _disposed || !value.HasValue || value.Value.Date > DateTime.Today) return;

        BeginDay(value.Value);
        _live = _selectedDate == DateTime.Today;
        await LoadAsync(reset: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_reloadChart && _chart is not null && !_disposed)
        {
            _reloadChart = false;
            await _chart.Reload();
        }
    }

    private void PauseLive() => _live = false;

    private void OnNavigatorStartChanged(double value)
    {
        // Radzen передаёт Start и End двумя callback: применяем их вместе во втором.
        _navigatorStart = value;
        _live = false;
    }

    private void OnNavigatorEndChanged(double value)
    {
        OnViewChanged(new ChartViewChangeEventArgs { ViewStart = _navigatorStart ?? _viewStart, ViewEnd = value });
        _navigatorStart = null;
    }

    protected override void OnInitialized()
    {
        // Используем общее live-окно: в текущих настройках проекта это 30 минут.
        _windowMinutes = Math.Clamp(ParamOptions.Value.TrendWindowMinutes, 1, 240);
        BeginDay(DateTime.Today);
    }

    protected override async Task OnParametersSetAsync()
    {
        var tag = TagName.Trim();
        var changed = !_started || !string.Equals(_tag, tag, StringComparison.Ordinal);
        var confirmed = TrendAvailable == true && _lastAvailability != true;
        _lastAvailability = TrendAvailable;

        if (changed)
        {
            _tag = tag;
            _started = true;
            BeginDay(DateTime.Today);
            _supported = TrendAvailable == true;
            _live = true;
        }

        if (tag.Length == 0 || TrendAvailable == false)
        {
            _live = true;
            _supported = false;
            _history = [];
            _points = [];
            _navigatorPoints = [];
            return;
        }

        if (changed || (confirmed && !_supported))
            await LoadAsync(reset: true);

        if (_timer is null && !_disposed)
        {
            // Как и online-значение Output, историю обновляем раз в 5 секунд.
            _timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
            _pollTask = PollAsync();
        }
    }

    private async Task PollAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                await InvokeAsync(async () =>
                {
                    if (_disposed || _loading || !_live || TrendAvailable == false || _tag.Length == 0) return;

                    if (_selectedDate != DateTime.Today)
                        BeginDay(DateTime.Today);

                    await LoadAsync(reset: _toUtc == default || !_supported);

                    if (!_disposed)
                        StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested) { }
    }

    private async Task GoLiveAsync()
    {
        if (_loading || _disposed) return;

        if (_selectedDate != DateTime.Today)
            BeginDay(DateTime.Today);

        _live = true;
        await LoadAsync(reset: _toUtc == default || !_supported);
    }

    private void OnViewChanged(ChartViewChangeEventArgs args)
    {
        if (Math.Abs(args.ViewStart - _viewStart) < 0.000001 && Math.Abs(args.ViewEnd - _viewEnd) < 0.000001) return;

        _viewStart = Math.Clamp(args.ViewStart, 0, 1);
        _viewEnd = Math.Clamp(args.ViewEnd, _viewStart, 1);
        _live = false;

        RefreshChartPoints();
    }

    private async Task LoadAsync(bool reset = false)
    {
        if (_loading || _disposed || TrendAvailable == false || _tag.Length == 0) return;

        _loading = true;

        var tag = _tag;
        var version = _selectionVersion;
        var followLive = _live;
        var now = DateTime.UtcNow;
        var dayEnd = _dayToUtc;
        var to = now < dayEnd ? now : dayEnd;

        // Полный день читаем при выборе даты/первом открытии.
        // При обновлении Live читаем только новые данные с перекрытием 5 секунд.
        var from = reset || _toUtc == default ? _dayFromUtc : _toUtc.AddSeconds(-5);
        if (from < _dayFromUtc) from = _dayFromUtc;

        try
        {
            if (from >= to) return;

            using var requestCts = CancellationTokenSource.CreateLinkedTokenSource(_cts.Token);
            requestCts.CancelAfter(TimeSpan.FromSeconds(RequestTimeoutSeconds));

            var response = await ReadRangeAsync(tag, from, to, dayEnd, version, requestCts.Token);

            if (_disposed || tag != _tag || version != _selectionVersion || TrendAvailable == false) return;
            if (followLive && !_live) return;

            _supported = response.Supported;

            if (!_supported)
            {
                _history = [];
                _points = [];
                _navigatorPoints = [];
                return;
            }

            var incoming = response.Points.Select(point => new TrendPoint { Time = AsUtc(point.Time), Value = point.Value });
            var existing = reset ? Enumerable.Empty<TrendPoint>() : _history;

            // Сохраняем всю историю выбранных суток, включая ранее загруженные точки.
            var history = existing.Concat(incoming).Where(point => point.Time >= _dayFromUtc && point.Time <= to && point.Time < dayEnd)
                .GroupBy(point => point.Time)
                .Select(group => group.Last())
                .OrderBy(point => point.Time)
                .Take(MaxStoredPoints + 1)
                .ToList();

            if (history.Count > MaxStoredPoints)
                throw new InvalidDataException();

            _fromUtc = _dayFromUtc;
            _toUtc = to;
            _history = history;
            _navigatorPoints = ReducePoints(_history, MaxNavigatorPoints);

            if (_selectedDate == DateTime.Today)
                SetVisibleRange(AxisTo.AddMinutes(-_windowMinutes), AxisTo);
            else
                SetVisibleRange(AxisFrom, AxisTo);

            RefreshChartPoints();
            _message = _history.Count == 0 ? "No trend data was returned for the selected day." : "";
        }
        catch (Exception) when (_disposed || version != _selectionVersion) { }
        catch (InvalidDataException)
        {
            _live = false;
            _message = "Too many trend samples. Previously loaded data is retained. Select another date or Live.";
        }
        catch (OperationCanceledException)
        {
            _live = false;
            _message = "Trend request timed out. Previously loaded data is retained. Select a date again or Live.";
        }
        catch (Exception)
        {
            // При ошибке прекращаем автоматические повторы, чтобы не создавать очередь запросов.
            _live = false;
            _message = "Trend data could not be loaded. Previously loaded data is retained. Select a date again or Live.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<ParamTrendResponse> ReadRangeAsync(string tag, DateTime from, DateTime to, DateTime dayEnd, int version, CancellationToken cancellationToken)
    {
        // Последовательные запросы не более часа. Общий timeout ограничивает всю операцию.
        var samples = new Dictionary<DateTime, ParamTrendPointDto>();

        for (var cursor = from; cursor < to;)
        {
            cancellationToken.ThrowIfCancellationRequested();
            if (version != _selectionVersion) throw new OperationCanceledException();

            var end = cursor.AddMinutes(RequestChunkMinutes);
            if (end > to) end = to;

            var response = await ParamApi.GetTagTrendAsync(tag, cursor, end, cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();
            if (version != _selectionVersion) throw new OperationCanceledException();
            if (!response.Supported) return response;

            foreach (var point in response.Points)
            {
                var time = AsUtc(point.Time);
                if (!double.IsFinite(point.Value) || time < cursor || time > end || time >= dayEnd) continue;

                // Граничная точка соседних запросов учитывается один раз.
                samples[time] = new ParamTrendPointDto { Time = time, Value = point.Value };
                if (samples.Count > MaxStoredPoints) throw new InvalidDataException();
            }

            cursor = end;
        }

        return new ParamTrendResponse { Supported = true, FromUtc = from, ToUtc = to, Points = samples.Values.ToList() };
    }

    private void RefreshChartPoints()
    {
        if (_history.Count == 0)
        {
            _points = [];
            return;
        }

        var from = AxisFrom.AddTicks((long)((AxisTo - AxisFrom).Ticks * _viewStart));
        var to = AxisFrom.AddTicks((long)((AxisTo - AxisFrom).Ticks * _viewEnd));
        var first = _history.FindIndex(point => point.Time >= from);

        if (first < 0)
            first = _history.Count;

        var end = first;

        while (end < _history.Count && _history[end].Time <= to)
            end++;

        // Сохраняем первую/последнюю видимую точку и по одной соседней для непрерывной линии.
        _points = ReducePoints(_history.GetRange(first, end - first), MaxChartPoints - 2);

        if (first > 0)
            _points.Insert(0, _history[first - 1]);

        if (end < _history.Count)
            _points.Add(_history[end]);

        _reloadChart = true;
    }

    private static List<TrendPoint> ReducePoints(List<TrendPoint> source, int limit)
    {
        if (source.Count <= limit)
            return source.ToList();

        // Для каждого участка оставляем минимум и максимум в исходном временном порядке.
        // Это сохраняет экстремумы лучше, чем выбор каждой N-й точки.
        var result = new List<TrendPoint>(limit) { source[0] };
        var buckets = (limit - 2) / 2;
        var innerCount = source.Count - 2;

        for (var bucket = 0; bucket < buckets; bucket++)
        {
            var start = 1 + (int)((long)bucket * innerCount / buckets);
            var end = 1 + (int)((long)(bucket + 1) * innerCount / buckets);
            var min = start;
            var max = start;

            for (var index = start + 1; index < end; index++)
            {
                if (source[index].Value < source[min].Value)
                    min = index;

                if (source[index].Value > source[max].Value)
                    max = index;
            }

            result.Add(source[Math.Min(min, max)]);

            if (min != max)
                result.Add(source[Math.Max(min, max)]);
        }

        result.Add(source[^1]);
        return result;
    }

    private void SetVisibleRange(DateTime from, DateTime to)
    {
        var ticks = (AxisTo - AxisFrom).Ticks;

        if (ticks <= 0) return;

        _viewStart = Math.Clamp((double)(from - AxisFrom).Ticks / ticks, 0, 1);
        _viewEnd = Math.Clamp((double)(to - AxisFrom).Ticks / ticks, _viewStart, 1);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _cts.Cancel();
        _timer?.Dispose();

        if (_pollTask is not null)
            await _pollTask;

        _cts.Dispose();
    }

    public sealed class TrendPoint
    {
        public DateTime Time { get; set; }
        public double Value { get; set; }
    }
}