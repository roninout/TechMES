@using TechMES.Web.Components.Common

<ScadaTrendChart Series="@_series" AutoScale="true" />

@code {
    [Parameter] public string TagName { get; set; } = "";
    [Parameter] public bool? TrendAvailable { get; set; }
    [Parameter] public ScadaTrendStyle Style { get; set; } = ScadaTrendStyle.Line;
    [Parameter] public string Color { get; set; } = "var(--rz-primary)";

    // Совместимость с существующим вызовом из FormulaConfigurationPanel.
    [Parameter] public double? Minimum { get; set; }
    [Parameter] public double? Maximum { get; set; }

    private IReadOnlyList<ScadaTrendSeries> _series = [];

    protected override void OnParametersSet()
    {
        _series = string.IsNullOrWhiteSpace(TagName) ? [] : [new ScadaTrendSeries { TagName = TagName, TrendAvailable = TrendAvailable, Style = Style, Color = Color }];
    }
}