<div class="formula-panel">
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">@_error</RadzenAlert>
    }

    @if (!_loaded && _error.Length == 0)
    {
        <TechMesLoadingBar Label="Loading Formula" />
    }

    @if (_loaded)
    {
        <section class="formula-section">
            <strong>Current values</strong>

            <div class="formula-grid">
                <RadzenFormField Text="Last calculated result" Variant="Variant.Outlined">
                    <RadzenNumeric TValue="double?" Value="@RuntimeResult" ReadOnly="true" ShowUpDown="false" Format="0.######" Style="width:100%;" />
                </RadzenFormField>

                <RadzenFormField Text="Saved output tag value" Variant="Variant.Outlined">
                    <RadzenNumeric TValue="double?" Value="@_outputValue" ReadOnly="true" ShowUpDown="false" Format="0.######" Style="width:100%;" />
                </RadzenFormField>

                <div class="formula-hint">Status: @(HasCurrentState ? State!.Status.ToString() : "Waiting") · Completed: @FormatTime(HasCurrentState ? State?.LastCompletedAtUtc : null)</div>
                <div class="formula-hint">@(SavedOutputTag.Length > 0 ? SavedOutputTag : "Output tag is not configured") · Read: @FormatTime(_outputReadAt)</div>
            </div>

            @if (HasCurrentState && State?.Status is CalcJobStateStatusDto.Error or CalcJobStateStatusDto.Skipped)
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false">@State.ReasonMessage</RadzenAlert>
            }

            @if (_liveError.Length > 0)
            {
                <div class="formula-error">@_liveError</div>
            }
        </section>

        <fieldset class="formula-section" disabled="@IsBusy">
            <div class="formula-toolbar">
                <strong>Formula settings</strong>

                <div class="formula-switch">
                    <RadzenSwitch 
                        Value="@_enabled" 
                        Change="@ChangeEnabled" 
                        Disabled="@IsBusy" 
                        InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = "Enabled" })" />
                    <span>Enabled</span>
                </div>

            </div>

            @if (HasPendingChanges)
            {
                <div class="formula-hint">Unsaved changes. The running calculation uses the last saved settings.</div>
            }

            <div class="formula-grid">
                <div class="formula-field">
                    <RadzenLabel Text="Name *" />
                    <RadzenTextBox @bind-Value="_name" Style="width:100%;" />
                </div>

                <div class="formula-field">
                    <RadzenLabel Text="Period, ms *" />
                    <RadzenNumeric TValue="int" @bind-Value="_periodMs" Min="1" Style="width:100%;" />
                </div>

                <div class="formula-field formula-full">
                    <RadzenLabel Text="Description" />
                    <RadzenTextArea @bind-Value="_description" Rows="2" Style="width:100%;" />
                </div>
            </div>

            <div class="formula-toolbar formula-gap">
                <strong>Process variables</strong>

                <div class="formula-buttons">
                    <RadzenButton Text="Remove" Icon="remove" ButtonStyle="ButtonStyle.Light" Disabled="@(IsBusy || _variables.Count <= 1)" Click="@(() => ChangeVariableCount(false))" />
                    <RadzenButton Text="Add" Icon="add" ButtonStyle="ButtonStyle.Secondary" Disabled="@(IsBusy || _variables.Count >= 26)" Click="@(() => ChangeVariableCount(true))" />
                </div>
            </div>

            @foreach (var item in _variables)
            {
                <div class="formula-variable" @key="item.Key">
                    <RadzenBadge Text="@($"[{item.Key}]")" BadgeStyle="BadgeStyle.Info" />
                    <RadzenTextBox Value="@item.Source" Change="@((string? value) => ChangeSource(item, value))" Placeholder="Equipment.ITEM or SCADA tag" Style="width:100%;" />
                    <RadzenButton Text="Check" Icon="manage_search" ButtonStyle="ButtonStyle.Light" Disabled="@(IsBusy || item.Source.Length == 0)" Click="@(() => CheckInputAsync(item))" />
                    <RadzenBadge Text="@(item.Checked ? "LINKED" : item.HasTag ? "SAVED" : "NOT CHECKED")" BadgeStyle="@(item.Checked ? BadgeStyle.Success : BadgeStyle.Light)" />
                    <span class="formula-value">@FormatNumber(InputValue(item))</span>

                    @if (item.Message.Length > 0)
                    {
                        <div class="formula-variable-message">@item.Message</div>
                    }
                </div>
            }

            <RadzenButton Text="Check all inputs" Icon="fact_check" ButtonStyle="ButtonStyle.Light" Disabled="@IsBusy" Click="@CheckAllAsync" />

            <div class="formula-field formula-gap">
                <RadzenLabel Text="Expression *" />
                <RadzenTextArea Value="@_expression" Change="@ChangeExpression" Rows="6" Placeholder="sqrt(pow([a], 2) + pow([b], 2))" Style="width:100%; font-family:Consolas, monospace;" />
                <div class="formula-hint">Variables: [a]..[z]. Constants: pi, e. Decimal separator: dot.</div>
                <div class="formula-hint">Functions: abs, min, max, round, floor, ceil, sqrt, pow, exp, ln, log10, logn, sin, cos, tan, asin, acos, atan, atan2, clamp, if.</div>
            </div>

            <div class="formula-grid">
                <div class="formula-field">
                    <RadzenLabel Text="Output minimum" />
                    <RadzenNumeric 
                        TValue="double?" 
                        Value="@_minimum" 
                        Change="@((double? value) => ChangeRange(value, true))" 
                        ShowUpDown="false" Style="width:100%;" />
                </div>

                <div class="formula-field">
                    <RadzenLabel Text="Output maximum" />
                    <RadzenNumeric 
                        TValue="double?" 
                        Value="@_maximum" 
                        Change="@((double? value) => ChangeRange(value, false))" 
                        ShowUpDown="false" Style="width:100%;" />
                </div>
            </div>

            @if (ConfigurationError.Length > 0)
            {
                <div class="formula-error">@ConfigurationError</div>
            }

            <div class="formula-buttons formula-gap">
                <RadzenButton 
                    Text="Test formula" 
                    Icon="calculate" 
                    ButtonStyle="ButtonStyle.Secondary" 
                    Disabled="@(IsBusy || ConfigurationError.Length > 0 || _variables.Any(item => item.Source.Length == 0))" 
                    Click="@TestAsync" />

                @if (TestPassed)
                {
                    <RadzenBadge 
                        Text="@($"Result: {FormatNumber(_testResult)}")" 
                        BadgeStyle="BadgeStyle.Success" />
                }

                <span class="formula-error">@_testMessage</span>
            </div>

            <div class="formula-field formula-gap">
                <RadzenLabel Text="Output trend tag" />

                <div class="formula-output">
                    <RadzenTextBox Value="@_outputTag" Change="@ChangeOutput" Placeholder="SCADA variable tag with a trend" Style="width:100%;" />
                    <RadzenButton 
                        Text="Check output" 
                        Icon="query_stats" 
                        ButtonStyle="ButtonStyle.Light" 
                        Disabled="@(IsBusy || _outputTag.Length == 0)" 
                        Click="@CheckOutputAsync" />
                </div>

                <div class="formula-hint">@_outputMessage</div>
            </div>

            <div class="formula-toolbar formula-gap">
                <div class="formula-switch">
                    <RadzenSwitch 
                        Value="@_allowWrites" 
                        Change="@((bool value) => _allowWrites = value && CanEnableWrites)" 
                        Disabled="@(IsBusy || (!_allowWrites && !CanEnableWrites))" 
                        InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = "Allow output writes" })" />

                    <span>Allow output writes</span>

                </div>

                <RadzenButton 
                    Text="@(_job is null ? "Create job" : "Save")" 
                    Icon="save" 
                    Disabled="@(IsBusy || !CanSave || (_job is not null && !HasPendingChanges))" 
                    Click="@SaveAsync" />
            </div>

            <div class="formula-hint">To enable writes: enable the Job, enter both output limits, test the formula and check the output tag. Changes take effect after saving.</div>
            <div class="formula-hint">Test formula reads current inputs and calculates a result without writing to the output tag.</div>
        </fieldset>
    }
</div>