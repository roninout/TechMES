    /// <summary>
    /// Читает собственные read-only ITEM Content Equipment:
    ///
    ///     ValHmi
    ///     ValCalc
    ///     Sel
    ///
    /// Частота ограничена пятью секундами,
    /// как в CapacityConfigurationPanel.
    ///
    /// Параллельно обновляет AI snapshots,
    /// необходимые для Temperature / Pressure bargraph.
    /// </summary>
    private async Task RefreshContentScadaValuesAsync(bool force = false)
    {
        if (_isReadingScada)
            return;

        var modelChanged = !string.Equals(_scadaRefreshModelName, Model.Name, StringComparison.OrdinalIgnoreCase);
        var now = DateTimeOffset.UtcNow;

        if (modelChanged)
        {
            _scadaRefreshModelName = Model.Name;
            _liveScadaValues.Clear();
            _linkedAiSnapshots.Clear();

            force = true;
        }

        if (!force && now < _nextScadaRefreshUtc)
            return;

        _nextScadaRefreshUtc = now.AddSeconds(5);
        _isReadingScada = true;

        try
        {
            var itemsToRead = new List<string>
        {
            "Select",
            "Value",
            "Config"
        };

            for (var index = 0; index < MaxContentItemCount; index++)
            {
                itemsToRead.Add($"Param{index}");
                itemsToRead.Add($"Param{index}_Dp");
                itemsToRead.Add($"Param{index}_Dt");
            }

            var reads = await Task.WhenAll(itemsToRead.Select(ReadContentScadaItemAsync));

            foreach (var read in reads)
                _liveScadaValues[read.ItemName] = read.Success ? read.Value : null;

            await RefreshLinkedAiSnapshotsAsync();
        }
        finally
        {
            _isReadingScada = false;
        }
    }

    /// <summary>
    /// Читает один ITEM текущего Content Equipment
    /// через его реальный Variable Tag.
    /// </summary>
    private async Task<ContentScadaReadResult> ReadContentScadaItemAsync(string itemName)
    {
        var tagName = GetItemTag(Model, itemName);

        if (string.IsNullOrWhiteSpace(tagName))
            return ContentScadaReadResult.Failed(itemName, $"ITEM {itemName} was not found in Calc Model.");

        try
        {
            var response = await ParamApi.CheckNumericTagAsync(new ParamTagCheckRequest
            {
                TagName = tagName,
                RequireTrend = false
            });

            if (response.Found && response.CurrentValue.HasValue)
                return ContentScadaReadResult.Successful(itemName, response.CurrentValue.Value);

            return ContentScadaReadResult.Failed(itemName, response.Message ?? "Numeric value was not read.");
        }
        catch (Exception ex)
        {
            return ContentScadaReadResult.Failed(itemName, ex.Message);
        }
    }

    // ============================================================
    // ProcessInput AI visualization
    // ============================================================

    /// <summary>
    /// Получает Param snapshot только для LINKED ProcessInput,
    /// который был введён как Equipment.ITEM и относится к AI.
    ///
    /// Именно из snapshot берём реальные Min / Max для bargraph.
    /// Direct Variable Tag без Equipment contract в bargraph не показываем.
    /// </summary>
    private async Task RefreshLinkedAiSnapshotsAsync()
    {
        var equipments = new Dictionary<string, EquipmentDto>(StringComparer.OrdinalIgnoreCase);

        foreach (var binding in _processBindings.OrderBy(binding => binding.Parameter.Order).Take(2))
        {
            if (TryGetLinkedAiEquipment(binding, out var equipment, out _))
                equipments[equipment.Name] = equipment;
        }

        var activeNames = equipments.Keys.ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var oldName in _linkedAiSnapshots.Keys.Where(name => !activeNames.Contains(name)).ToList())
        {
            _linkedAiSnapshots.Remove(oldName);
        }

        if (equipments.Count == 0)
            return;

        var reads = await Task.WhenAll(equipments.Values.Select(async equipment =>
            {
                try
                {
                    var snapshot = await ParamApi.GetSnapshotAsync(equipment.Name);
                    return new ContentAiSnapshotRead(EquipmentName: equipment.Name, Snapshot: snapshot.Supported && snapshot.TypeGroup == EquipmentTypeGroup.AI ? snapshot : null);
                }
                catch
                {
                    return new ContentAiSnapshotRead(equipment.Name, null);
                }
            }));


        foreach (var read in reads)
        {
            if (read.Snapshot is not null)
                _linkedAiSnapshots[read.EquipmentName] = read.Snapshot;
            else
                _linkedAiSnapshots.Remove(read.EquipmentName);
        }
    }

    /// <summary>
    /// Определяет, что ProcessInput был введён именно
    /// как Equipment.ITEM AI Equipment.
    ///
    /// Например:
    ///
    ///     S25.K01.TT01.R
    ///     S25.K01.PT01.R
    /// </summary>
    private bool TryGetLinkedAiEquipment(ContentProcessBindingEditor binding, out EquipmentDto equipment, out string itemName)
    {
        equipment = null!;
        itemName = "";

        if (!binding.IsLinked || string.IsNullOrWhiteSpace(binding.ValidatedSourceText))
            return false;

        var source = binding.ValidatedSourceText.Trim();
        var candidate = EquipmentCatalog
            .Where(item => !item.IsGroup && item.TypeGroup == EquipmentTypeGroup.AI && !string.IsNullOrWhiteSpace(item.Name))
            .OrderByDescending(item => item.Name.Length)
            .FirstOrDefault(item => source.StartsWith(item.Name + ".", StringComparison.OrdinalIgnoreCase));

        if (candidate is null)
            return false;

        var sourceItemName = source[(candidate.Name.Length + 1)..].Trim();

        if (sourceItemName.Length == 0)
            return false;

        equipment = candidate;
        itemName = sourceItemName;

        return true;
    }

    /// <summary>
    /// Строит только два штатных Content ProcessInput:
    ///
    ///     Temperature
    ///     Pressure.
    ///
    /// Принцип полностью такой же, как у Capacity.
    /// </summary>
    private IReadOnlyList<ContentProcessBarView> BuildPrimaryProcessBars()
    {
        var result = new List<ContentProcessBarView>(2);

        foreach (var binding in _processBindings.OrderBy(binding => binding.Parameter.Order).Take(2))
        {
            var bar = BuildLiveProcessBar(binding);

            if (bar is not null)
                result.Add(bar);
        }

        return result;
    }

    /// <summary>
    /// Создаёт один bargraph.
    ///
    /// Bar существует только если:
    ///
    ///     - binding LINKED;
    ///     - source = Equipment.ITEM;
    ///     - Equipment = AI;
    ///     - snapshot содержит Min / Max;
    ///     - есть текущее числовое значение.
    /// </summary>
    private ContentProcessBarView? BuildLiveProcessBar(ContentProcessBindingEditor binding)
    {
        if (!TryGetLinkedAiEquipment(binding, out var equipment, out var itemName))
            return null;

        if (!_linkedAiSnapshots.TryGetValue(equipment.Name, out var snapshot))
            return null;

        if (!TryGetAiBounds(snapshot, itemName, out var min, out var max))
            return null;

        var value = GetProcessCurrentValue(binding);

        if (!value.HasValue)
            return null;


        return new ContentProcessBarView(
            ParameterKey: binding.Parameter.Key,
            Name: GetProcessDisplayName(binding),
            Source: binding.ValidatedSourceText,
            ItemName: itemName,
            Value: value.Value,
            Min: min,
            Max: max,
            Unit: string.IsNullOrWhiteSpace(snapshot.Unit)
                ? binding.Parameter.Unit ?? ""
                : snapshot.Unit.Trim(),
            FillColor: GetProcessBarColor(binding));
    }

    /// <summary>
    /// Определяет Min / Max AI ITEM.
    ///
    /// R:
    ///     MinR / MaxR
    ///
    /// Value:
    ///     Min / Max
    ///
    /// Остальные:
    ///     MinITEM / MaxITEM.
    /// </summary>
    private static bool TryGetAiBounds(ParamSnapshotResponse snapshot, string itemName, out double min, out double max)
    {
        min = 0d;
        max = 0d;

        double? minValue;
        double? maxValue;

        if (itemName.Equals("R", StringComparison.OrdinalIgnoreCase))
        {
            minValue = GetSnapshotNumber(snapshot, "MinR");
            maxValue = GetSnapshotNumber(snapshot, "MaxR");
        }
        else if (itemName.Equals("Value", StringComparison.OrdinalIgnoreCase))
        {
            minValue = GetSnapshotNumber(snapshot, "Min");
            maxValue = GetSnapshotNumber(snapshot, "Max");
        }
        else
        {
            minValue = GetSnapshotNumber(snapshot, $"Min{itemName}");
            maxValue = GetSnapshotNumber(snapshot, $"Max{itemName}");
        }

        if (!minValue.HasValue || !maxValue.HasValue || !double.IsFinite(minValue.Value) || !double.IsFinite(maxValue.Value))
            return false;

        if (Math.Abs(maxValue.Value - minValue.Value) < double.Epsilon)
            return false;

        min = minValue.Value;
        max = maxValue.Value;

        return true;
    }

    private static double? GetSnapshotNumber(ParamSnapshotResponse snapshot, params string[] names)
    {
        var item = snapshot.Items.FirstOrDefault(candidate => names.Any(name => candidate.Name.Equals(name, StringComparison.OrdinalIgnoreCase)));

        if (item is null)
            return null;

        if (item.NumericValue.HasValue)
            return item.NumericValue.Value;

        if (double.TryParse(item.ValueText?.Replace(',', '.'), NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed))
            return parsed;

        return null;
    }

    private static string GetProcessDisplayName(ContentProcessBindingEditor binding)
    {
        return binding.Parameter.Order switch
        {
            1 => "Temperature",
            2 => "Pressure",
            _ => binding.Parameter.Name
        };
    }

    private static string GetProcessBarColor(ContentProcessBindingEditor binding)
    {
        return binding.Parameter.Order switch
        {
            1 => "#4f81bd",
            2 => "#4f9a50",
            _ => "#4f81bd"
        };
    }

