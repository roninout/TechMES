    private static string GetContentComponentCaption(CalcOutputDefinitionDto output)
    {
        var name = output.Name?.Trim() ?? output.Key;

        const string contentSuffix = " content";

        if (name.EndsWith(contentSuffix, StringComparison.OrdinalIgnoreCase))
            name = name[..^contentSuffix.Length];

        var code = output.Key;

        const string percentSuffix = "Percent";

        if (code.EndsWith(percentSuffix, StringComparison.OrdinalIgnoreCase))
            code = code[..^percentSuffix.Length];

        code = code.Equals("water", StringComparison.OrdinalIgnoreCase)
            ? "Water"
            : code.ToUpperInvariant();

        return $"{code} — {name} (liquid)";
    }

