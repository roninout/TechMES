    /// <summary>
    /// Pie строится по ВСЕМ рассчитанным outputs физической системы.
    ///
    /// Например content.acn-water:
    ///
    ///     acnPercent   = 72.4
    ///     waterPercent = 27.6
    ///
    /// Размер каждого сектора = процент.
    ///
    /// В отличие от Capacity никаких дополнительных значений
    /// внутри Pie нет.
    /// </summary>
    private IReadOnlyList<ContentPieItem> BuildLivePieItems()
    {
        if (LiveDefinition is null)
            return [];

        var result = new List<ContentPieItem>();

        foreach (var output in LiveDefinition.Outputs.OrderBy(output => output.Order))
        {
            var value = GetLastOutputNumber(output.Key);

            if (!value.HasValue || !double.IsFinite(value.Value) || value.Value <= 0d)
                continue;

            result.Add(new ContentPieItem(
                Key: output.Key,
                Name: output.Name,
                LegendText: $"{output.Name} {value.Value:0.#}%",
                Percent: value.Value));
        }

        return result;
    }

    /// <summary>
    /// Текст непосредственно внутри Pie sector.
    ///
    /// Только процент.
    /// </summary>
    private static string FormatPieItemPercent(ContentPieItem item)
    {
        return $"{item.Percent.ToString("0.#", CultureInfo.InvariantCulture)}%";
    }

