@using System.Globalization
@using System.Text.Json
@using TechMES.Contracts.Equipment
@using TechMES.Contracts.Param
@inject CalcApiClient CalcApi
@inject ParamApiClient ParamApi
@inject CalcProcessInputResolver ProcessInputResolver
@inject NotificationService NotificationService


<div class="content-configuration-host">

    @if (_isLoadingDefinitions)
    {
        <div class="content-loading">

            <TechMesLoadingBar Label="Loading Content configuration" />

            <div class="content-loading-content">

                <RadzenIcon Icon="hourglass_top"
                            class="content-loading-icon" />

                <div class="content-loading-title">
                    Loading Content configuration...
                </div>

                <div class="content-loading-model">
                    @Model.Name
                </div>

            </div>

        </div>
    }
    else if (_contentDefinitions.Count == 0 || Definition is null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger"
                     ShowIcon="true"
                     AllowClose="false">

            @(_loadError.Length > 0
                ? _loadError
                : "Content calculation definitions are not available.")

        </RadzenAlert>
    }
    else
    {
        <div class="content-configuration">

            @* ============================================================
               ВЕРХНЯЯ LIVE-ПАНЕЛЬ

               По структуре повторяет Capacity:

                   LEFT
                       Temperature
                       Pressure

                   CENTER
                       TechMES calculated value
                       Current value / ValHmi
                       Calculated value / ValCalc

                   RIGHT
                       Pie по рассчитанному Content.

               Отличия Content:

                   - Delta отсутствует полностью;
                   - Pie показывает процент каждого компонента;
                   - физическая система берётся из Content Definition.
               ============================================================ *@

            @{
                var primaryProcessBars = BuildPrimaryProcessBars();
                var processBarCount = primaryProcessBars.Count;
                var pieItems = BuildLivePieItems();
            }

            <div class="content-live-panel">

                @* ========================================================
                   HEADER
                   ======================================================== *@
                <div class="content-live-header">

                    <div class="content-live-title">

                        <RadzenIcon Icon="science"
                                    class="content-live-title-icon" />

                        <span>
                            @GetLiveContentTitle()
                        </span>

                    </div>


                    <div class="content-toolbar-enabled">

                        <span class="content-switch-state @GetSwitchStateClass(_enabled)">
                            @GetSwitchStateText(_enabled)
                        </span>

                        <RadzenSwitch @bind-Value="_enabled"
                                      Disabled="@(_isSaving || (!_enabled && !IsConfigurationReady))" />

                        <span class="content-switch-label">
                            Enabled
                        </span>

                    </div>

                </div>


                <div class="content-panel-separator"></div>


                @* ========================================================
                   RUNTIME STATUS
                   ======================================================== *@
                @if (HasUnsavedChanges)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning"
                                 Variant="Variant.Flat"
                                 Shade="Shade.Lighter"
                                 AllowClose="false"
                                 ShowIcon="true"
                                 class="content-live-status-alert">

                        Unsaved changes. Runtime continues using the last saved configuration.

                    </RadzenAlert>
                }
                else if (State?.Status == CalcJobStateStatusDto.Error)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger"
                                 Variant="Variant.Flat"
                                 Shade="Shade.Lighter"
                                 AllowClose="false"
                                 ShowIcon="true"
                                 class="content-live-status-alert">

                        @(State.ReasonMessage ?? "Content calculation failed.")

                    </RadzenAlert>
                }
                else if (State?.Status == CalcJobStateStatusDto.Skipped)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning"
                                 Variant="Variant.Flat"
                                 Shade="Shade.Lighter"
                                 AllowClose="false"
                                 ShowIcon="true"
                                 class="content-live-status-alert">

                        @(State.ReasonMessage ?? "Content calculation was skipped.")

                    </RadzenAlert>
                }


                @* ========================================================
                   MAIN LIVE AREA
                   ======================================================== *@
                <div class="content-live-layout content-live-layout-bars-@processBarCount">


                    @* ====================================================
                       LEFT — TEMPERATURE / PRESSURE

                       Полностью повторяем принцип Capacity:
                       bargraph появляется только для успешно LINKED
                       Equipment.ITEM AI-параметра, для которого можем
                       получить Min/Max.
                       ==================================================== *@
                    @if (primaryProcessBars.Count > 0)
                    {
                        <div class="content-process-bars content-process-bars-@processBarCount">

                            @foreach (var bar in primaryProcessBars)
                            {
                                <div class="content-process-meter">

                                    <div class="content-process-meter-readout">

                                        <RadzenFormField AllowFloatingLabel="false"
                                                         Text="@bar.ItemName"
                                                         Variant="Variant.Outlined"
                                                         class="content-process-form-field">

                                            <RadzenNumeric TValue="double?"
                                                           Value="@bar.Value"
                                                           ReadOnly="true"
                                                           ShowUpDown="false"
                                                           Format="0.###"
                                                           class="content-process-top-value" />

                                        </RadzenFormField>

                                    </div>


                                    <div class="content-process-meter-body">

                                        <ParamGraphVerticalBar Label="@bar.ItemName"
                                                               Value="@bar.Value"
                                                               Min="@bar.Min"
                                                               Max="@bar.Max"
                                                               FillColor="@bar.FillColor" />

                                    </div>


                                    <div class="content-process-meter-unit">
                                        @(string.IsNullOrWhiteSpace(bar.Unit) ? "-" : bar.Unit)
                                    </div>


                                    <div class="content-process-meter-title">
                                        @bar.Name
                                    </div>


                                    <div class="content-process-meter-source"
                                         title="@bar.Source">

                                        @bar.Source

                                    </div>

                                </div>
                            }

                        </div>
                    }


                    @* ====================================================
                       CENTER
                       ==================================================== *@
                    <div class="content-live-center">

                        <div class="content-main-card">


                            @* =================================================
                               TECHMES CALCULATED VALUE

                               Показываем не произвольный первый output,
                               а именно тот Definition output, который
                               сохранён на ITEM ValCalc этого Content Equipment.
                               ================================================= *@
                            <div class="content-value-row">

                                <div class="content-selection-title content-selection-title-techmes @(IsTechMesOutputWriteEnabled ? "is-selected" : "")">

                                    <div class="content-selection-mark">

                                        @if (IsTechMesOutputWriteEnabled)
                                        {
                                            <RadzenIcon Icon="check"
                                                        class="content-selection-icon" />
                                        }

                                    </div>

                                    <span>
                                        TechMES calculated value
                                    </span>

                                </div>


                                <div class="content-value-controls">

                                    <RadzenFormField AllowFloatingLabel="false"
                                                     Text="Content"
                                                     Variant="Variant.Outlined"
                                                     class="content-main-form-field content-result-form-field">

                                        <RadzenNumeric TValue="double?"
                                                       Value="@CurrentTechMesContent"
                                                       ReadOnly="true"
                                                       ShowUpDown="false"
                                                       Format="0.###' %'"
                                                       class="content-main-value-input content-result-value-input" />

                                    </RadzenFormField>

                                </div>

                            </div>


                            <div class="content-card-separator"></div>


                            @* =================================================
                               CURRENT VALUE / ValHmi

                               Sel = 0 -> текущим значением SCADA является ValHmi.
                               ================================================= *@
                            <div class="content-value-row">

                                <div class="content-selection-title">

                                    <div class="content-selection-mark"></div>

                                    <span>
                                        Current value
                                    </span>

                                </div>


                                <div class="content-value-controls">

                                    <RadzenFormField AllowFloatingLabel="false"
                                                     Text="Value"
                                                     Variant="Variant.Outlined"
                                                     class="content-main-form-field">

                                        <RadzenNumeric TValue="double?"
                                                       Value="@CurrentContentHmi"
                                                       ReadOnly="true"
                                                       ShowUpDown="false"
                                                       Format="0.##' %'"
                                                       class="content-main-value-input" />

                                    </RadzenFormField>

                                </div>

                            </div>


                            @* =================================================
                               CALCULATED VALUE / ValCalc

                               В Content Delta нет вообще.
                               Никакого placeholder под Delta также не оставляем.

                               Sel = 1 -> текущим значением SCADA является ValCalc.
                               ================================================= *@
                            <div class="content-value-row">

                                <div class="content-selection-title">

                                    <div class="content-selection-mark"></div>

                                    <span>
                                        Calculated value
                                    </span>

                                </div>


                                <div class="content-value-controls">

                                    <RadzenFormField AllowFloatingLabel="false"
                                                     Text="@CurrentCalculatedItemName"
                                                     Variant="Variant.Outlined"
                                                     class="content-main-form-field">

                                        <RadzenNumeric TValue="double?"
                                                       Value="@CurrentContentCalcEngineering"
                                                       ReadOnly="true"
                                                       ShowUpDown="false"
                                                       Format="0.##' %'"
                                                       class="content-main-value-input" />

                                    </RadzenFormField>

                                </div>

                            </div>

                        </div>

                    </div>


                    @* ====================================================
                       RIGHT — CONTENT PIE

                       Размер сектора = рассчитанный процент компонента.

                       Внутри сектора отображаем только:
                           72.5%
                           27.5%

                       Никаких дополнительных физических величин,
                       как у Capacity, здесь нет.
                       ==================================================== *@
                    <div class="content-pie-column">

                        @if (pieItems.Count > 0)
                        {
                            <div class="content-pie-shell">

                                <RadzenChart class="content-pie-chart">

                                    <TechMesPieSeries TItem="ContentPieItem"
                                                      Data="@pieItems"
                                                      CategoryProperty="@nameof(ContentPieItem.LegendText)"
                                                      ValueProperty="@nameof(ContentPieItem.Percent)"
                                                      DataLabelText="@FormatPieItemPercent"
                                                      StartAngle="90"
                                                      StrokeWidth="2"
                                                      ShowTooltipOnLegend="true">

                                        <ChildContent>

                                            <RadzenSeriesDataLabels Visible="true"
                                                                    Position="DataLabelPosition.Inside"
                                                                    Appearance="DataLabelAppearance.Chip"
                                                                    AllowOverlap="true" />

                                        </ChildContent>

                                        <TooltipTemplate Context="item">

                                            <div class="content-pie-tooltip">

                                                <strong>
                                                    @item.Name
                                                </strong>

                                                <div>
                                                    @item.Percent.ToString("0.###", CultureInfo.InvariantCulture) %
                                                </div>

                                            </div>

                                        </TooltipTemplate>

                                    </TechMesPieSeries>

                                    <RadzenLegend Position="LegendPosition.Bottom" />

                                </RadzenChart>

                            </div>
                        }
                        else
                        {
                            <div class="content-pie-empty">
                                Content data is not available.
                            </div>
                        }

                    </div>


                </div>

            </div>


            @* ============================================================
               SETTINGS

               Первый этап:

                   1. Temperature
                   2. Pressure

                   separator

                   Content system ComboBox

               На этом пока заканчиваем.

               configurationCode / output mappings / writes здесь
               сейчас специально НЕ отображаем — добавим следующим этапом.
               Существующую backend-логику пока не удаляем.
               ============================================================ *@
            <section class="content-settings-column">

                <ParamAiPanel Title="Settings"
                              Icon="settings"
                              InitiallyCollapsed="true">

                    <div class="content-settings-body">


                        @* ==================================================
                           PROCESS INPUT BINDINGS
                           ================================================== *@
                        <section class="content-process-settings">

                            @{
                                var visibleBindings = _processBindings
                                    .OrderBy(binding => binding.Parameter.Order)
                                    .Take(2)
                                    .ToList();
                            }

                            @for (var index = 0; index < visibleBindings.Count; index++)
                            {
                                var binding = visibleBindings[index];

                                <div class="content-process-row">

                                    <div class="content-settings-index">
                                        @(index + 1)
                                    </div>


                                    <RadzenTextBox Value="@binding.SourceText"
                                                   Change="@((string value) => OnProcessSourceChanged(binding, value))"
                                                   Placeholder="Equipment.ITEM or SCADA tag"
                                                   Disabled="@(_isSaving || _isCheckingBindings)"
                                                   class="content-process-tag" />


                                    <div class="content-process-status">

                                        <RadzenBadge Text="@GetBindingBadgeText(binding)"
                                                     BadgeStyle="@GetBindingBadgeStyle(binding)" />

                                    </div>


                                    <div class="content-process-name">
                                        @GetProcessDisplayName(binding)
                                    </div>


                                    <div class="content-process-action">

                                        @if (index == 1)
                                        {
                                            <RadzenButton Text="Check"
                                                          Icon="manage_search"
                                                          ButtonStyle="ButtonStyle.Light"
                                                          Disabled="@(_isSaving || _isCheckingBindings)"
                                                          Click="@CheckProcessBindingsAsync"
                                                          class="content-process-check" />
                                        }

                                    </div>

                                </div>
                            }

                        </section>


                        <div class="content-settings-separator"></div>


                        @* ==================================================
                           CONTENT SYSTEM

                           Content имеет фиксированную SCADA-структуру:

                               Sel

                               Param0
                               Param0_Dp
                               Param0_Dt

                               ...

                               Param4
                               Param4_Dp
                               Param4_Dt

                           Sel = индекс выбранного компонента:

                               0 -> Param0
                               1 -> Param1
                               ...
                               4 -> Param4

                           Все Param* в Settings только ReadOnly.
                           ================================================== *@
                        <section class="content-system-settings">

                            <div class="content-system-header">

                                <div class="content-system-title">

                                    <RadzenIcon Icon="science" />

                                    <span>
                                        Content system
                                    </span>

                                </div>

                            </div>


                            @* ==================================================
                               SYSTEM + CONFIGURATION CODE
                               ================================================== *@
                            <div class="content-system-row">

                                <div class="content-system-icon">
                                    <RadzenIcon Icon="percent" />
                                </div>


                                <RadzenDropDown TValue="string"
                                                Data="@_contentDefinitions"
                                                TextProperty="@nameof(CalcDefinitionDto.Name)"
                                                ValueProperty="@nameof(CalcDefinitionDto.Code)"
                                                @bind-Value="_definitionCode"
                                                Change="@(_ => OnDefinitionChanged())"
                                                Placeholder="Select Content system..."
                                                Disabled="@_isSaving"
                                                class="content-system-dropdown" />


                                <RadzenFormField AllowFloatingLabel="false"
                                                 Text="code"
                                                 Variant="Variant.Outlined"
                                                 class="content-code-field">

                                    <RadzenNumeric TValue="int?"
                                                   Value="@CurrentConfigurationCode"
                                                   ReadOnly="true"
                                                   ShowUpDown="false"
                                                   class="content-code-value" />

                                </RadzenFormField>

                            </div>


                            @* ==================================================
                               FIXED CONTENT COMPONENTS
                               ================================================== *@
                            @if (Definition is not null)
                            {
                                var outputs = Definition.Outputs
                                    .OrderBy(output => output.Order)
                                    .Take(MaxContentItemCount)
                                    .ToList();

                                @for (var index = 0; index < outputs.Count; index++)
                                {
                                    var output = outputs[index];
                                    var selected = SelectedContentItemIndex == index;

                                    <div class="content-component-row @(selected ? "is-selected" : "")">

                                        <div class="content-component-selected">

                                            @if (selected)
                                            {
                                                <RadzenIcon Icon="check"
                                                            class="content-component-selected-icon" />
                                            }

                                        </div>


                                        <div class="content-settings-index">
                                            @(index + 1)
                                        </div>


                                        <div class="content-component-name">
                                            @GetContentComponentCaption(output)
                                        </div>


                                        @* По твоему legacy-контракту: dP отображает ParamN_Dt. *@
                                        <RadzenFormField AllowFloatingLabel="false"
                                                         Text="dP"
                                                         Variant="Variant.Outlined"
                                                         class="content-component-delta-field">

                                            <RadzenNumeric TValue="double?"
                                                           Value="@GetContentDp(index)"
                                                           ReadOnly="true"
                                                           ShowUpDown="false"
                                                           Format="0.###' bar'"
                                                           class="content-component-delta-value" />

                                        </RadzenFormField>


                                        @* По твоему legacy-контракту: dT отображает ParamN_Dp. *@
                                        <RadzenFormField AllowFloatingLabel="false"
                                                         Text="dT"
                                                         Variant="Variant.Outlined"
                                                         class="content-component-delta-field">

                                            <RadzenNumeric TValue="double?"
                                                           Value="@GetContentDt(index)"
                                                           ReadOnly="true"
                                                           ShowUpDown="false"
                                                           Format="0.###' °C'"
                                                           class="content-component-delta-value" />

                                        </RadzenFormField>


                                        <RadzenNumeric TValue="double?"
                                                       Value="@GetContentParam(index)"
                                                       ReadOnly="true"
                                                       ShowUpDown="false"
                                                       Format="0.##' %'"
                                                       class="content-component-percent" />

                                    </div>
                                }
                            }

                        </section>


                        <div class="content-settings-separator"></div>


                        @* ==================================================
                           OUTPUT WRITES
                           Полностью повторяем визуальный стиль Capacity.
                           ================================================== *@
                        <div class="content-write-settings">

                            <div>

                                <div class="content-write-title">
                                    Allow output writes
                                </div>

                                <div class="content-write-description">
                                    Write calculated Content to SCADA ValCalc
                                </div>

                            </div>


                            <div class="content-write-switch">

                                <span class="content-switch-state @GetSwitchStateClass(_allowOutputWrites)">
                                    @GetSwitchStateText(_allowOutputWrites)
                                </span>

                                <RadzenSwitch @bind-Value="_allowOutputWrites"
                                              Disabled="@(_isSaving ||
                                                                  (!_allowOutputWrites &&
                                                                   (!IsBaseConfigurationReady ||
                                                                    !IsFixedOutputBindingReady)))" />

                            </div>

                        </div>


                        @if (!IsFixedContentStructureReady)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Danger"
                                         AllowClose="false"
                                         ShowIcon="true"
                                         class="content-settings-warning">

                                Content Equipment does not contain the required
                                Select / Value / ParamN / Config structure.

                            </RadzenAlert>
                        }


                    </div>

                </ParamAiPanel>


                @* ========================================================
                   ACTIONS

                   Оставляем существующие Create / Save.
                   Саму конфигурацию следующими шагами ещё дополним.
                   ======================================================== *@
                <div class="content-actions">

                    @if (Job is null)
                    {
                        <RadzenButton Text="Create job"
                                      Icon="add"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Disabled="@(_isSaving || !IsConfigurationReady)"
                                      Click="@CreateJobAsync" />
                    }
                    else
                    {
                        <RadzenButton Text="Save"
                                      Icon="save"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Disabled="@(_isSaving || !HasUnsavedChanges || !IsConfigurationReady)"
                                      Click="@SaveJobAsync" />
                    }

                </div>

            </section>


        </div>
    }

</div>


@code {
    [Parameter, EditorRequired]
    public CalcModelDto Model { get; set; } = default!;

    [Parameter]
    public CalcJobDto? Job { get; set; }

    [Parameter]
    public CalcJobStateDto? State { get; set; }

    [Parameter]
    public IReadOnlyList<EquipmentDto> EquipmentCatalog { get; set; } = [];

    [Parameter]
    public EventCallback JobChanged { get; set; }

    // ============================================================
    // Definition / editor state
    // ============================================================

    private readonly List<CalcDefinitionDto> _contentDefinitions = [];
    private readonly List<ContentProcessBindingEditor> _processBindings = [];

    // ============================================================
    // Live SCADA state
    //
    // Как и в Capacity, собственные ITEM Content Equipment
    // читаем отдельно от Calculation State.
    //
    // Это прежде всего:
    //
    //     ValHmi
    //     ValCalc
    //     Sel
    //
    // ProcessInput Temperature / Pressure продолжают приходить
    // через Calc Job / ProcessInputResolver.
    // ============================================================

    private readonly Dictionary<string, double?> _liveScadaValues = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, ParamSnapshotResponse> _linkedAiSnapshots = new(StringComparer.OrdinalIgnoreCase);

    private DateTimeOffset _nextScadaRefreshUtc = DateTimeOffset.MinValue;

    private string _scadaRefreshModelName = "";

    // ============================================================
    // Editable values
    // ============================================================

    private string _definitionCode = "";

    private string _contextKey = "";
    private string _savedEditorSignature = "";
    private string _loadError = "";

    private bool _enabled;
    private bool _allowOutputWrites;

    private bool _isLoadingDefinitions;
    private bool _isSaving;
    private bool _isCheckingBindings;
    private bool _isReadingScada;

    // ============================================================
    // Current Definition
    // ============================================================

    /// <summary>
    /// Definition, который сейчас выбран пользователем в Settings.
    ///
    /// Он может отличаться от реально работающего Definition,
    /// если пользователь изменил ComboBox, но ещё не нажал Save.
    /// </summary>
    private CalcDefinitionDto? Definition => _contentDefinitions.FirstOrDefault(definition => string.Equals(definition.Code, _definitionCode, StringComparison.OrdinalIgnoreCase));

    /// <summary>
    /// Definition, с которым реально работает сохранённый Job.
    ///
    /// Верхняя live-панель должна отображать именно Runtime configuration,
    /// а не несохранённое состояние ComboBox.
    ///
    /// Для нового Job сохранённой конфигурации ещё нет,
    /// поэтому используем текущий Definition редактора.
    /// </summary>
    private CalcDefinitionDto? LiveDefinition
    {
        get
        {
            if (Job is not null)
            {
                var storedDefinition = _contentDefinitions.FirstOrDefault(definition =>
                    string.Equals(definition.Code, Job.DefinitionCode, StringComparison.OrdinalIgnoreCase));

                if (storedDefinition is not null)
                    return storedDefinition;
            }

            return Definition;
        }
    }

    // ============================================================
    // SCADA ITEM mapping
    //
    // Реальная фиксированная структура Content Equipment:
    //
    //     Select
    //     Value
    //
    //     Param0 ... Param4
    //     Param0_Dp ... Param4_Dp
    //     Param0_Dt ... Param4_Dt
    //
    //     Config
    //
    // Select:
    //     0 -> Param0
    //     1 -> Param1
    //     ...
    //     4 -> Param4
    //
    // Value:
    //     текущее значение Content.
    //
    // ParamN:
    //     рассчитанное значение соответствующего компонента.
    //
    // ParamN имеют legacy scale:
    //     100 = 1 %
    // ============================================================

    private const int MaxContentItemCount = 5;
    private const double ContentPercentScale = 100d;

    private string? ContentValueTag => GetItemTag(Model, "Value");
    private string? ContentSelectTag => GetItemTag(Model, "Select");
    private string? ContentConfigTag => GetItemTag(Model, "Config");

    private string? GetContentParamTag(int index)
    {
        return GetItemTag(Model, $"Param{index}");
    }

    private string? GetContentParamDpTag(int index)
    {
        return GetItemTag(Model, $"Param{index}_Dp");
    }

    private string? GetContentParamDtTag(int index)
    {
        return GetItemTag(Model, $"Param{index}_Dt");
    }


    // ============================================================
    // Fixed SCADA values
    // ============================================================

    /// <summary>
    /// Select является индексом активного Content-компонента.
    ///
    ///     0 -> Param0
    ///     1 -> Param1
    ///     ...
    ///     4 -> Param4
    /// </summary>
    private int? SelectedContentItemIndex
    {
        get
        {
            var value = GetLiveScadaValue("Select");

            if (!value.HasValue || !double.IsFinite(value.Value))
                return null;

            var index = (int)Math.Round(value.Value);

            if (Math.Abs(value.Value - index) > 0.001d)
                return null;

            return index is >= 0 and < MaxContentItemCount ? index : null;
        }
    }

    /// <summary>
    /// Config является read-only SCADA ITEM.
    /// Его текущее значение используется как configurationCode Calc Job.
    /// </summary>
    private int? CurrentConfigurationCode
    {
        get
        {
            var value = GetLiveScadaValue("Config");

            if (!value.HasValue || !double.IsFinite(value.Value))
                return null;

            var configuration = (int)Math.Round(value.Value);

            return Math.Abs(value.Value - configuration) <= 0.001d ? configuration : null;
        }
    }


    // ============================================================
    // Component values
    // ============================================================

    private static double? ConvertContentRawToPercent(double? rawValue)
    {
        if (!rawValue.HasValue || !double.IsFinite(rawValue.Value))
            return null;

        return rawValue.Value / ContentPercentScale;
    }

    /// <summary>
    /// ParamN хранится в legacy hundredths-of-percent.
    ///
    ///     10011 -> 100.11 %
    ///       -10 ->  -0.10 %
    /// </summary>
    private double? GetContentParam(int index)
    {
        return ConvertContentRawToPercent(GetLiveScadaValue($"Param{index}"));
    }

