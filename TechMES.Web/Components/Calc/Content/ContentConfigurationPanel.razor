    private CalcOutputDefinitionDto? GetSelectedContentOutput(CalcDefinitionDto? definition)
    {
        if (definition is null || !SelectedContentItemIndex.HasValue)
            return null;

        return definition.Outputs
            .OrderBy(output => output.Order)
            .ElementAtOrDefault(SelectedContentItemIndex.Value);
    }

    private CalcOutputDefinitionDto? SelectedContentOutput => GetSelectedContentOutput(Definition);
    private CalcOutputDefinitionDto? SelectedLiveContentOutput => GetSelectedContentOutput(LiveDefinition);


    /// <summary>
    /// Проверяет существование фиксированных ParamN для всех outputs
    /// текущей Content Definition.
    /// </summary>
    private bool IsFixedOutputBindingReady
    {
        get
        {
            if (Definition is null || Definition.Outputs.Count == 0 || Definition.Outputs.Count > MaxContentItemCount)
                return false;

            return Enumerable.Range(0, Definition.Outputs.Count)
                .All(index => !string.IsNullOrWhiteSpace(GetContentParamTag(index)));
        }
    }


    /// <summary>
    /// Проверяет обязательную фиксированную структуру Content Equipment.
    /// </summary>
    private bool IsFixedContentStructureReady =>
        Definition is not null
        && !string.IsNullOrWhiteSpace(ContentValueTag)
        && !string.IsNullOrWhiteSpace(ContentSelectTag)
        && !string.IsNullOrWhiteSpace(ContentConfigTag)
        && IsFixedOutputBindingReady;


    // ============================================================
    // Configuration readiness
    // ============================================================

    private bool IsProcessBindingsReady => _processBindings.Count > 0 && _processBindings.All(binding => binding.IsLinked);

    private bool IsBaseConfigurationReady =>
        Definition is not null
        && IsProcessBindingsReady
        && CurrentConfigurationCode.HasValue
        && IsFixedContentStructureReady;

    private bool IsConfigurationReady => IsBaseConfigurationReady;

    private bool HasDefinitionVersionChange =>
        Job is not null
        && Definition is not null
        && string.Equals(Job.DefinitionCode, Definition.Code, StringComparison.OrdinalIgnoreCase)
        && !string.Equals(Job.DefinitionVersion, Definition.Version, StringComparison.Ordinal);

    private bool HasUnsavedChanges => HasDefinitionVersionChange || !string.Equals(_savedEditorSignature, BuildEditorSignature(), StringComparison.Ordinal);

    public bool HasPendingChanges => Definition is not null && HasUnsavedChanges;

    // ============================================================
    // Lifecycle
    // ============================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadDefinitionsAsync();

        if (_contentDefinitions.Count == 0)
            return;

        SynchronizeConfiguration(force: true);

        // Это восстановленное состояние, а не изменение пользователя.
        CaptureSavedEditorState();

        // Сначала читаем собственные SCADA ITEM Content:
        //
        //     ValHmi
        //     ValCalc
        //     Sel
        //
        // Они не являются Calculation ProcessInput.
        await RefreshContentScadaValuesAsync(force: true);

        // Проверяем сохранённые Temperature / Pressure bindings.
        await ValidateStoredProcessBindingsAsync();

        // После LINKED сразу получаем Min/Max AI,
        // чтобы bargraph появились уже при первом открытии.
        await RefreshLinkedAiSnapshotsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_contentDefinitions.Count == 0)
            return;

        var contextChanged = SynchronizeConfiguration();

        if (contextChanged)
        {
            // Новый Equipment / Job только что восстановлен
            // из сохранённой конфигурации.
            //
            // Это не Unsaved change.
            CaptureSavedEditorState();
        }

        // State страницы обновляется регулярно.
        // SCADA ITEM читаем с собственным 5-секундным throttling,
        // как сделано в Capacity.
        await RefreshContentScadaValuesAsync();

        if (contextChanged)
        {
            await ValidateStoredProcessBindingsAsync();
            await RefreshLinkedAiSnapshotsAsync();
        }
    }

    /// <summary>
    /// Content Definitions загружаются из Runtime.
    ///
    /// WEB не хранит собственного списка физических систем.
    /// Поэтому при добавлении новой Content Definition она автоматически
    /// становится доступна в этом редакторе.
    /// </summary>
    private async Task LoadDefinitionsAsync()
    {
        _isLoadingDefinitions = true;
        _loadError = "";

        try
        {
            var definitions = await CalcApi.GetDefinitionsAsync();

            _contentDefinitions.Clear();
            _contentDefinitions.AddRange(definitions
                .Where(definition => string.Equals(definition.Category, "Content", StringComparison.OrdinalIgnoreCase))
                .OrderBy(definition => definition.Name, StringComparer.OrdinalIgnoreCase));

            if (_contentDefinitions.Count == 0)
                _loadError = "Runtime does not expose any Content calculation definitions.";
        }
        catch (Exception ex)
        {
            _loadError = "Cannot load Content definitions: " + ex.Message;
        }
        finally
        {
            _isLoadingDefinitions = false;
        }
    }

    /// <summary>
    /// Восстанавливает редактор из сохранённого Calc Job.
    ///
    /// Runtime State намеренно не входит в context key:
    /// его обновление каждые две секунды не должно сбрасывать
    /// несохранённые настройки пользователя.
    /// </summary>
    private bool SynchronizeConfiguration(bool force = false)
    {
        var structureSignature = string.Join("|", Model.ItemTags
            .OrderBy(pair => pair.Key, StringComparer.OrdinalIgnoreCase)
            .ThenBy(pair => pair.Value, StringComparer.OrdinalIgnoreCase)
            .Select(pair => $"{pair.Key}={pair.Value}"));

        var newContextKey = $"{Model.Name}|{Job?.Id}|{Job?.Revision}|{structureSignature}";

        if (!force && string.Equals(_contextKey, newContextKey, StringComparison.Ordinal))
            return false;

        _contextKey = newContextKey;

        var storedDefinition = Job is null
            ? null
            : _contentDefinitions.FirstOrDefault(definition => string.Equals(definition.Code, Job.DefinitionCode, StringComparison.OrdinalIgnoreCase));

        _definitionCode = storedDefinition?.Code ?? _contentDefinitions.First().Code;

        _enabled = Job?.Enabled == true;
        _allowOutputWrites = Job?.WriteEnabled == true;

        BuildProcessBindings();

        return true;
    }

    /// <summary>
    /// При смене физической Content-системы ProcessInput сохраняем:
    /// Temperature и Pressure имеют одинаковые стабильные ключи
    /// во всех наших Content Definitions.
    ///
    /// Output mappings сбрасываем намеренно, потому что набор веществ
    /// новой физической системы может быть другим.
    /// </summary>
    private void OnDefinitionChanged()
    {
        if (Definition is null)
            return;

        var previousBindings = _processBindings.ToDictionary(
            binding => binding.Parameter.Key,
            binding => binding,
            StringComparer.OrdinalIgnoreCase);

        BuildProcessBindings();

        foreach (var binding in _processBindings)
        {
            if (!previousBindings.TryGetValue(binding.Parameter.Key, out var previous))
                continue;

            binding.SourceText = previous.SourceText;
            binding.ResolvedTagName = previous.ResolvedTagName;
            binding.ValidatedSourceText = previous.ValidatedSourceText;
            binding.CurrentValue = previous.CurrentValue;
            binding.Resolution = previous.Resolution;
            binding.Message = previous.Message;
            binding.CheckState = previous.CheckState;
            binding.MaxAgeSeconds = previous.MaxAgeSeconds;
        }
    }

    // ============================================================
    // ProcessInput
    // ============================================================

    private void BuildProcessBindings()
    {
        _processBindings.Clear();

        if (Definition is null)
            return;

        foreach (var parameter in Definition.Parameters.Where(parameter => parameter.Role == CalcParameterRoleDto.ProcessInput).OrderBy(parameter => parameter.Order))
        {
            var stored = FindJobInput(parameter.Key);
            var storedTag = stored?.SourceType == CalcInputSourceTypeDto.Tag ? stored.TagName?.Trim() ?? "" : "";
            var storedReference = stored?.SourceType == CalcInputSourceTypeDto.Tag ? stored.SourceReference?.Trim() ?? "" : "";
            var sourceText = storedReference.Length > 0 ? storedReference : storedTag;

             // runtimeValue объявляем заранее.
             // Это необходимо потому, что при storedTag.Length == 0 правая часть выражения && не выполняется вообще.
             // В таком случае out-параметр TryGetRuntimeNumber() не получает значение, и C# справедливо считает runtimeValue потенциально неинициализированным.
            double runtimeValue = 0d;
            var hasRuntimeValue = storedTag.Length > 0 && TryGetRuntimeNumber(State?.LastInputs, parameter.Key, out runtimeValue);

            _processBindings.Add(new ContentProcessBindingEditor
            {
                Parameter = parameter,
                SourceText = sourceText,
                ResolvedTagName = storedTag,
                ValidatedSourceText = hasRuntimeValue ? sourceText : "",
                CurrentValue = hasRuntimeValue ? runtimeValue : null,
                Resolution = hasRuntimeValue ? "Saved Runtime input" : "",
                MaxAgeSeconds = stored?.SourceType == CalcInputSourceTypeDto.Tag ? stored.MaxAgeSeconds : null,
                CheckState = hasRuntimeValue ? ContentBindingCheckState.Linked : ContentBindingCheckState.NotChecked
            });
        }
    }

    private async Task ValidateStoredProcessBindingsAsync()
    {
        foreach (var binding in _processBindings.Where(binding => !binding.IsLinked && !string.IsNullOrWhiteSpace(binding.SourceText)))
        {
            await ResolveProcessBindingAsync(binding);
        }
    }

    private async Task CheckProcessBindingsAsync()
    {
        if (_isCheckingBindings)
            return;

        _isCheckingBindings = true;

        try
        {
            foreach (var binding in _processBindings.OrderBy(binding => binding.Parameter.Order))
                await ResolveProcessBindingAsync(binding);

            NotificationService.Notify(IsProcessBindingsReady ? NotificationSeverity.Success : NotificationSeverity.Warning, "Content", IsProcessBindingsReady
                    ? "Required Content process bindings are valid." : "Some Content process bindings were not resolved.", 4000);
        }
        finally
        {
            _isCheckingBindings = false;
        }
    }

    private async Task ResolveProcessBindingAsync(ContentProcessBindingEditor binding)
    {
        var source = binding.SourceText.Trim();

        binding.ResolvedTagName = "";
        binding.ValidatedSourceText = "";
        binding.CurrentValue = null;
        binding.Resolution = "";
        binding.Message = "";

        if (source.Length == 0)
        {
            binding.CheckState = ContentBindingCheckState.NotFound;
            binding.Message = "Source is required.";
            return;
        }

        binding.CheckState = ContentBindingCheckState.Checking;

        var resolution = await ProcessInputResolver.ResolveAsync(source, EquipmentCatalog);

        if (!resolution.Success || string.IsNullOrWhiteSpace(resolution.ResolvedTagName) || !resolution.CurrentValue.HasValue)
        {
            binding.CheckState = ContentBindingCheckState.NotFound;
            binding.Message = resolution.Message ?? "Process input was not resolved.";
            return;
        }

        binding.ResolvedTagName = resolution.ResolvedTagName.Trim();
        binding.ValidatedSourceText = source;
        binding.CurrentValue = resolution.CurrentValue.Value;
        binding.Resolution = resolution.Resolution ?? "";
        binding.CheckState = ContentBindingCheckState.Linked;
    }

    private static void OnProcessSourceChanged(ContentProcessBindingEditor binding, string? value)
    {
        binding.SourceText = value ?? "";
        binding.ResolvedTagName = "";
        binding.ValidatedSourceText = "";
        binding.CurrentValue = null;
        binding.Resolution = "";
        binding.Message = "";
        binding.CheckState = ContentBindingCheckState.NotChecked;
    }

