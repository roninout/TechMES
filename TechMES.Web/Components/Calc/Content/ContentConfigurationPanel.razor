    /// </summary>
    private sealed record ContentScadaReadResult(string ItemName, bool Success, double? Value, string? Message)
    {
        public static ContentScadaReadResult Successful(string itemName, double value)
        {
            return new ContentScadaReadResult(itemName, true, value, null);
        }

        public static ContentScadaReadResult Failed(string itemName, string? message)
        {
            return new ContentScadaReadResult(itemName, false, null, message);
        }
    }

