@using System.Globalization

<div class="tank-type3-editor">

    <div class="tank-type3-canvas">

        <svg viewBox="0 0 760 620"
             role="img"
             aria-label="Tank Type 3 interactive geometry">

            <defs>

                @* ============================================================
               Clip только рассчитываемого левого отсека.

               dimD задаёт расстояние от левой стенки Tank
               до вертикальной перегородки.

               Правая часть Tank не относится к рассчитываемому объёму
               и поэтому никогда не должна закрашиваться уровнем.
               ============================================================ *@

                <clipPath id="@ClipId">
                    <path d="@LeftCompartmentPath" />
                </clipPath>

            </defs>


            @if (HasLevel)
            {
                <g clip-path="@ClipUrl">

                    <rect class="tank-liquid-fill"
                          x="@Svg(TankLeft)"
                          y="@Svg(FillY)"
                          width="@Svg(TankRight - TankLeft)"
                          height="@Svg(Math.Max(0.0, TankBottomY - FillY))" />

                    <line class="tank-live-level"
                          x1="@Svg(TankLeft - 15.0)"
                          y1="@Svg(FillY)"
                          x2="@Svg(TankRight + 15.0)"
                          y2="@Svg(FillY)" />

                </g>
            }


            @* ============================================================
               Tank body

               Type 3:
               - flat top
               - cylindrical body
               - one lower elliptical head
               ============================================================ *@

            <path class="tank-shape"
                  d="@TankPath" />

            <line class="tank-body-line"
                  x1="@Svg(TankLeft)"
                  y1="@Svg(BodyBottomY)"
                  x2="@Svg(TankRight)"
                  y2="@Svg(BodyBottomY)" />


            @* ============================================================
               Internal partition

               dimD is measured from the left cylindrical wall
               to the vertical partition.

               Inside the lower elliptical head the partition ends
               exactly at the intersection with the head geometry.
               ============================================================ *@

            <line class="tank-internal"
                  x1="@Svg(PartitionX)"
                  y1="@Svg(TankTopY)"
                  x2="@Svg(PartitionX)"
                  y2="@Svg(PartitionBottomY)" />


            @* ============================================================
               dimD
               Distance from left wall to partition
               ============================================================ *@

            <line class="tank-guide-dim"
                  x1="@Svg(TankLeft)"
                  y1="@Svg(TankTopY)"
                  x2="@Svg(TankLeft)"
                  y2="@Svg(DimDScaleY)" />

            <line class="tank-guide-dim"
                  x1="@Svg(PartitionX)"
                  y1="@Svg(TankTopY)"
                  x2="@Svg(PartitionX)"
                  y2="@Svg(DimDScaleY)" />

            <line class="tank-dimension"
                  x1="@Svg(TankLeft)"
                  y1="@Svg(DimDScaleY)"
                  x2="@Svg(PartitionX)"
                  y2="@Svg(DimDScaleY)" />

            <line class="tank-dimension-cap"
                  x1="@Svg(TankLeft)"
                  y1="@Svg(DimDScaleY - ScaleCapHalfWidth)"
                  x2="@Svg(TankLeft)"
                  y2="@Svg(DimDScaleY + ScaleCapHalfWidth)" />

            <line class="tank-dimension-cap"
                  x1="@Svg(PartitionX)"
                  y1="@Svg(DimDScaleY - ScaleCapHalfWidth)"
                  x2="@Svg(PartitionX)"
                  y2="@Svg(DimDScaleY + ScaleCapHalfWidth)" />


            @* ============================================================
               dimA
               Height of cylindrical part
               ============================================================ *@

            <line class="tank-guide-dim"
                  x1="@Svg(LeftDimAScaleX)"
                  y1="@Svg(TankTopY)"
                  x2="@Svg(TankLeft)"
                  y2="@Svg(TankTopY)" />

            <line class="tank-guide-dim"
                  x1="@Svg(LeftDimAScaleX)"
                  y1="@Svg(BodyBottomY)"
                  x2="@Svg(TankLeft)"
                  y2="@Svg(BodyBottomY)" />

            <line class="tank-dimension"
                  x1="@Svg(LeftDimAScaleX)"
                  y1="@Svg(TankTopY)"
                  x2="@Svg(LeftDimAScaleX)"
                  y2="@Svg(BodyBottomY)" />

            <line class="tank-dimension-cap"
                  x1="@Svg(LeftDimAScaleX - ScaleCapHalfWidth)"
                  y1="@Svg(TankTopY)"
                  x2="@Svg(LeftDimAScaleX + ScaleCapHalfWidth)"
                  y2="@Svg(TankTopY)" />

            <line class="tank-dimension-cap"
                  x1="@Svg(LeftDimAScaleX - ScaleCapHalfWidth)"
                  y1="@Svg(BodyBottomY)"
                  x2="@Svg(LeftDimAScaleX + ScaleCapHalfWidth)"
                  y2="@Svg(BodyBottomY)" />


            @* ============================================================
               dimC
               Lower elliptical head height
               ============================================================ *@

            <line class="tank-guide-dim"
                  x1="@Svg(LeftDimCScaleX)"
                  y1="@Svg(BodyBottomY)"
                  x2="@Svg(TankLeft)"
                  y2="@Svg(BodyBottomY)" />

            <line class="tank-guide-dim"
                  x1="@Svg(LeftDimCScaleX)"
                  y1="@Svg(TankBottomY)"
                  x2="@Svg(TankCenterX)"
                  y2="@Svg(TankBottomY)" />

            <line class="tank-dimension"
                  x1="@Svg(LeftDimCScaleX)"
                  y1="@Svg(BodyBottomY)"
                  x2="@Svg(LeftDimCScaleX)"
                  y2="@Svg(TankBottomY)" />

            <line class="tank-dimension-cap"
                  x1="@Svg(LeftDimCScaleX - ScaleCapHalfWidth)"
                  y1="@Svg(BodyBottomY)"
                  x2="@Svg(LeftDimCScaleX + ScaleCapHalfWidth)"
                  y2="@Svg(BodyBottomY)" />

            <line class="tank-dimension-cap"
                  x1="@Svg(LeftDimCScaleX - ScaleCapHalfWidth)"
                  y1="@Svg(TankBottomY)"
                  x2="@Svg(LeftDimCScaleX + ScaleCapHalfWidth)"
                  y2="@Svg(TankBottomY)" />


            @* ============================================================
               dimB
               Tank diameter
               ============================================================ *@

            <line class="tank-guide-dim"
                  x1="@Svg(TankLeft)"
                  y1="@Svg(BodyBottomY)"
                  x2="@Svg(TankLeft)"
                  y2="@Svg(DimBScaleY)" />

            <line class="tank-guide-dim"
                  x1="@Svg(TankRight)"
                  y1="@Svg(BodyBottomY)"
                  x2="@Svg(TankRight)"
                  y2="@Svg(DimBScaleY)" />

            <line class="tank-dimension"
                  x1="@Svg(TankLeft)"
                  y1="@Svg(DimBScaleY)"
                  x2="@Svg(TankRight)"
                  y2="@Svg(DimBScaleY)" />

            <line class="tank-dimension-cap"
                  x1="@Svg(TankLeft)"
                  y1="@Svg(DimBScaleY - ScaleCapHalfWidth)"
                  x2="@Svg(TankLeft)"
                  y2="@Svg(DimBScaleY + ScaleCapHalfWidth)" />

            <line class="tank-dimension-cap"
                  x1="@Svg(TankRight)"
                  y1="@Svg(DimBScaleY - ScaleCapHalfWidth)"
                  x2="@Svg(TankRight)"
                  y2="@Svg(DimBScaleY + ScaleCapHalfWidth)" />


            @* ============================================================
               Sensor zones
               ============================================================ *@

            <line class="tank-zone-guide"
                  x1="@Svg(GetTankRightAtY(TankTopY))"
                  y1="@Svg(TankTopY)"
                  x2="@Svg(RightDeadAreaScaleX)"
                  y2="@Svg(TankTopY)" />

            <line class="tank-zone-guide"
                  x1="@Svg(GetTankRightAtY(UpperDeadBoundaryY))"
                  y1="@Svg(UpperDeadBoundaryY)"
                  x2="@Svg(RightMeasurementScaleX)"
                  y2="@Svg(UpperDeadBoundaryY)" />

            <line class="tank-zone-guide"
                  x1="@Svg(GetTankRightAtY(LowerDeadBoundaryY))"
                  y1="@Svg(LowerDeadBoundaryY)"
                  x2="@Svg(RightMeasurementScaleX)"
                  y2="@Svg(LowerDeadBoundaryY)" />

            <line class="tank-zone-guide"
                  x1="@Svg(GetTankRightAtY(TankBottomY))"
                  y1="@Svg(TankBottomY)"
                  x2="@Svg(RightDeadAreaScaleX)"
                  y2="@Svg(TankBottomY)" />


            @* ============================================================
               Upper dead area
               ============================================================ *@

            <line class="tank-dead-zone"
                  x1="@Svg(RightDeadAreaScaleX)"
                  y1="@Svg(TankTopY)"
                  x2="@Svg(RightDeadAreaScaleX)"
                  y2="@Svg(UpperDeadBoundaryY)" />

            <line class="tank-zone-cap"
                  x1="@Svg(RightDeadAreaScaleX - ScaleCapHalfWidth)"
                  y1="@Svg(TankTopY)"
                  x2="@Svg(RightDeadAreaScaleX + ScaleCapHalfWidth)"
                  y2="@Svg(TankTopY)" />

            <line class="tank-zone-cap"
                  x1="@Svg(RightDeadAreaScaleX - ScaleCapHalfWidth)"
                  y1="@Svg(UpperDeadBoundaryY)"
                  x2="@Svg(RightDeadAreaScaleX + ScaleCapHalfWidth)"
                  y2="@Svg(UpperDeadBoundaryY)" />


            @* ============================================================
               Measurement area
               ============================================================ *@

            <line class="tank-measure-zone"
                  x1="@Svg(RightMeasurementScaleX)"
                  y1="@Svg(UpperDeadBoundaryY)"
                  x2="@Svg(RightMeasurementScaleX)"
                  y2="@Svg(LowerDeadBoundaryY)" />

            <line class="tank-measure-cap"
                  x1="@Svg(RightMeasurementScaleX - ScaleCapHalfWidth)"
                  y1="@Svg(UpperDeadBoundaryY)"
                  x2="@Svg(RightMeasurementScaleX + ScaleCapHalfWidth)"
                  y2="@Svg(UpperDeadBoundaryY)" />

            <line class="tank-measure-cap"
                  x1="@Svg(RightMeasurementScaleX - ScaleCapHalfWidth)"
                  y1="@Svg(LowerDeadBoundaryY)"
                  x2="@Svg(RightMeasurementScaleX + ScaleCapHalfWidth)"
                  y2="@Svg(LowerDeadBoundaryY)" />


            @* ============================================================
               Lower dead area
               ============================================================ *@

            <line class="tank-dead-zone"
                  x1="@Svg(RightDeadAreaScaleX)"
                  y1="@Svg(LowerDeadBoundaryY)"
                  x2="@Svg(RightDeadAreaScaleX)"
                  y2="@Svg(TankBottomY)" />

            <line class="tank-zone-cap"
                  x1="@Svg(RightDeadAreaScaleX - ScaleCapHalfWidth)"
                  y1="@Svg(LowerDeadBoundaryY)"
                  x2="@Svg(RightDeadAreaScaleX + ScaleCapHalfWidth)"
                  y2="@Svg(LowerDeadBoundaryY)" />

            <line class="tank-zone-cap"
                  x1="@Svg(RightDeadAreaScaleX - ScaleCapHalfWidth)"
                  y1="@Svg(TankBottomY)"
                  x2="@Svg(RightDeadAreaScaleX + ScaleCapHalfWidth)"
                  y2="@Svg(TankBottomY)" />

        </svg>


        @if (HasLevel)
        {
            <div class="tank-live-level-overlay"
                 style="@LevelLabelStyle">
                @LevelLabel
            </div>
        }


        @* ============================================================
           dimD
           ============================================================ *@

        <div class="tank-top-field"
             style="@DimDFieldStyle">

            <RadzenFormField Text="dimD"
                             AllowFloatingLabel="false">

                <RadzenNumeric TValue="double"
                               Value="@DimD"
                               Change="@((double value) => DimDChanged.InvokeAsync(value))"
                               Format="0.### mm"
                               Disabled="@Disabled"
                               Style="width:100%;" />

            </RadzenFormField>

        </div>


        @* ============================================================
           dimA
           ============================================================ *@

        <div class="tank-side-field"
             style="@GetLeftFieldStyle(DimACenterY)">

            <RadzenFormField Text="dimA"
                             AllowFloatingLabel="false">

                <RadzenNumeric TValue="double"
                               Value="@DimA"
                               Change="@((double value) => DimAChanged.InvokeAsync(value))"
                               Format="0.### mm"
                               Disabled="@Disabled"
                               Style="width:100%;" />

            </RadzenFormField>

        </div>


        @* ============================================================
           dimC
           ============================================================ *@

        <div class="tank-side-field"
             style="@GetLeftFieldStyle(DimCCenterY)">

            <RadzenFormField Text="dimC"
                             AllowFloatingLabel="false">

                <RadzenNumeric TValue="double"
                               Value="@DimC"
                               Change="@((double value) => DimCChanged.InvokeAsync(value))"
                               Format="0.### mm"
                               Disabled="@Disabled"
                               Style="width:100%;" />

            </RadzenFormField>

        </div>


        @* ============================================================
           dimB
           ============================================================ *@

        <div class="tank-bottom-field"
             style="@DimBFieldStyle">

            <RadzenFormField Text="dimB"
                             AllowFloatingLabel="false">

                <RadzenNumeric TValue="double"
                               Value="@DimB"
                               Change="@((double value) => DimBChanged.InvokeAsync(value))"
                               Format="0.### mm"
                               Disabled="@Disabled"
                               Style="width:100%;" />

            </RadzenFormField>

        </div>


        @* ============================================================
           Upper dead area
           ============================================================ *@

        <div class="tank-side-field"
             style="@GetRightFieldStyle(UpperDeadAreaCenterY)">

            <RadzenFormField Text="Upper dead area"
                             AllowFloatingLabel="false">

                <RadzenNumeric TValue="double"
                               Value="@UpperDeadArea"
                               Change="@((double value) => UpperDeadAreaChanged.InvokeAsync(value))"
                               Format="0.### mm"
                               Disabled="@Disabled"
                               Style="width:100%;" />

            </RadzenFormField>

        </div>


        @* ============================================================
           Measurement area
           ============================================================ *@

        <div class="tank-side-field"
             style="@GetRightFieldStyle(MeasurementAreaCenterY)">

            <RadzenFormField Text="Measurement area"
                             AllowFloatingLabel="false">

                <RadzenNumeric TValue="double"
                               Value="@MeasurementAreaMm"
                               Format="0.### mm"
                               Disabled="true"
                               ShowUpDown="false"
                               Style="width:100%;" />

            </RadzenFormField>

        </div>


        @* ============================================================
           Lower dead area
           ============================================================ *@

        <div class="tank-side-field"
             style="@GetRightFieldStyle(LowerDeadAreaCenterY)">

            <RadzenFormField Text="Lower dead area"
                             AllowFloatingLabel="false">

                <RadzenNumeric TValue="double"
                               Value="@LowerDeadArea"
                               Change="@((double value) => LowerDeadAreaChanged.InvokeAsync(value))"
                               Format="0.### mm"
                               Disabled="@Disabled"
                               Style="width:100%;" />

            </RadzenFormField>

        </div>

    </div>

</div>


@code {
    [Parameter] public double DimA { get; set; }
    [Parameter] public double DimB { get; set; }
    [Parameter] public double DimC { get; set; }
    [Parameter] public double DimD { get; set; }

    [Parameter] public double UpperDeadArea { get; set; }
    [Parameter] public double LowerDeadArea { get; set; }

    [Parameter] public double? LevelPercent { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool CalculateAbove100 { get; set; }

    [Parameter] public EventCallback<double> DimAChanged { get; set; }
    [Parameter] public EventCallback<double> DimBChanged { get; set; }
    [Parameter] public EventCallback<double> DimCChanged { get; set; }
    [Parameter] public EventCallback<double> DimDChanged { get; set; }
    [Parameter] public EventCallback<double> UpperDeadAreaChanged { get; set; }
    [Parameter] public EventCallback<double> LowerDeadAreaChanged { get; set; }

    private readonly string ClipId = $"tankType3Clip_{Guid.NewGuid():N}";

    private const double SvgWidth = 760.0;
    private const double SvgHeight = 620.0;

    private const double TankTopY = 120.0;
    private const double TankBottomY = 425.0;
    private const double TankCenterX = 345.0;
    private const double TankVisualHeight = TankBottomY - TankTopY;

    // Отступы шкал совпадают с Type 1/2.
    private const double ScaleGapFromTank = 68.0;
    private const double ScaleLaneGap = 25.0;
    private const double ScaleCapHalfWidth = 9.0;
    private const double FieldGapFromScale = 35.0;

    // Горизонтальные шкалы dimD и dimB.
    private const double DimDScaleY = 78.0;
    private const double DimBScaleY = 470.0;

    private double TotalLengthMm => Math.Max(0.0, DimA + DimC);
    private double MeasurementAreaMm => Math.Max(0.0, TotalLengthMm - UpperDeadArea - LowerDeadArea);

    // Ширина Tank зависит от отношения dimB к полной высоте.
    // Минимум и максимум нужны только для читаемости схемы.
    private double TankWidth
    {
        get
        {
            if (TotalLengthMm <= 0)
                return 175.0;

            var width = TankVisualHeight * Math.Max(0.0, DimB) / TotalLengthMm;
            return Math.Clamp(width, 175.0, 270.0);
        }
    }

    private double TankLeft => TankCenterX - TankWidth / 2.0;
    private double TankRight => TankCenterX + TankWidth / 2.0;

    // Нижнее эллиптическое днище занимает долю общей высоты,
    // соответствующую реальному dimC.
    //
    // При dimC = 0 днище автоматически вырождается в прямую линию.
    private double HeadVisualHeight
    {
        get
        {
            if (TotalLengthMm <= 0 || DimC <= 0)
                return 0.0;

            var height = TankVisualHeight * DimC / TotalLengthMm;
            return Math.Clamp(height, 0.0, 105.0);
        }
    }

    private double BodyBottomY => TankBottomY - HeadVisualHeight;

    // Левая сторона повторяет Type 1:
    // dimC ближе к Tank, dimA дальше.
    private double LeftDimCScaleX => TankLeft - ScaleGapFromTank;
    private double LeftDimAScaleX => LeftDimCScaleX - ScaleLaneGap;

    // Правая сторона:
    // dead area ближе к Tank, measurement area дальше.
    private double RightDeadAreaScaleX => TankRight + ScaleGapFromTank;
    private double RightMeasurementScaleX => RightDeadAreaScaleX + ScaleLaneGap;

    // dimD всегда физически ограничиваем диаметром только для Preview.
    // Само введённое значение не изменяется и остаётся доступным Validation.
    private double PreviewDimD => DimB > 0 ? Math.Clamp(DimD, 0.0, DimB) : 0.0;

    // X перегородки.
    // dimD отсчитывается от левой цилиндрической стенки.
    private double PartitionX => DimB > 0 ? TankLeft + TankWidth * PreviewDimD / DimB : TankLeft;

    // Нижняя точка перегородки должна попадать точно
    // в эллиптическое днище.
    private double PartitionBottomY
    {
        get
        {
            if (HeadVisualHeight <= 0 || TankWidth <= 0)
                return BodyBottomY;

            var radiusX = TankWidth / 2.0;
            var normalizedX = Math.Clamp((PartitionX - TankCenterX) / radiusX, -1.0, 1.0);
            return BodyBottomY + HeadVisualHeight * Math.Sqrt(Math.Max(0.0, 1.0 - normalizedX * normalizedX));
        }
    }

    private double UpperDeadBoundaryY
    {
        get
        {
            if (TotalLengthMm <= 0)
                return TankTopY;

            return TankTopY + TankVisualHeight * Math.Clamp(UpperDeadArea, 0.0, TotalLengthMm) / TotalLengthMm;
        }
    }

    private double LowerDeadBoundaryY
    {
        get
        {
            if (TotalLengthMm <= 0)
                return TankBottomY;

            return TankBottomY - TankVisualHeight * Math.Clamp(LowerDeadArea, 0.0, TotalLengthMm) / TotalLengthMm;
        }
    }

    private double DimACenterY => (TankTopY + BodyBottomY) / 2.0;
    private double DimCCenterY => (BodyBottomY + TankBottomY) / 2.0;

    private double UpperDeadAreaCenterY => (TankTopY + UpperDeadBoundaryY) / 2.0;
    private double MeasurementAreaCenterY => (UpperDeadBoundaryY + LowerDeadBoundaryY) / 2.0;
    private double LowerDeadAreaCenterY => (LowerDeadBoundaryY + TankBottomY) / 2.0;

    private bool HasLevel => LevelPercent.HasValue && double.IsFinite(LevelPercent.Value) && TotalLengthMm > 0 && MeasurementAreaMm > 0;

    // Level.R остаётся процентом рабочей зоны датчика.
    private double PreviewMeasuredLevelMm => HasLevel ? Math.Max(0.0, MeasurementAreaMm * LevelPercent!.Value / 100.0) : 0.0;

    // Физическая отметка уровня включает Lower dead area.
    private double PreviewLiquidHeightMm
    {
        get
        {
            if (!HasLevel)
                return 0.0;

            var height = LowerDeadArea + PreviewMeasuredLevelMm;

            if (!CalculateAbove100)
                height = Math.Min(height, LowerDeadArea + MeasurementAreaMm);

            return Math.Clamp(height, 0.0, TotalLengthMm);
        }
    }

    private double FillY => TotalLengthMm > 0 ? TankBottomY - TankVisualHeight * PreviewLiquidHeightMm / TotalLengthMm : TankBottomY;

    private string LevelLabel => HasLevel ? $"{LevelPercent!.Value:0.###}% / {PreviewMeasuredLevelMm:0} mm" : "";
    private string ClipUrl => $"url(#{ClipId})";

    // Контур Type 3:
    // плоская верхняя часть + вертикальные стенки +
    // одно нижнее полуэллиптическое днище.
    private string TankPath
    {
        get
        {
            if (HeadVisualHeight <= 0)
            {
                return string.Create(CultureInfo.InvariantCulture,
                    $"M {TankLeft:0.###} {TankTopY:0.###} L {TankRight:0.###} {TankTopY:0.###} L {TankRight:0.###} {TankBottomY:0.###} L {TankLeft:0.###} {TankBottomY:0.###} Z");
            }

            return string.Create(CultureInfo.InvariantCulture,
                $"M {TankLeft:0.###} {TankTopY:0.###} L {TankRight:0.###} {TankTopY:0.###} L {TankRight:0.###} {BodyBottomY:0.###} A {TankWidth / 2.0:0.###} {HeadVisualHeight:0.###} 0 0 1 {TankLeft:0.###} {BodyBottomY:0.###} Z");
        }
    }

    // ============================================================
    // Рассчитываемый левый отсек Type 3.
    //
    // dimD задаёт расстояние от левой стенки Tank до вертикальной перегородки.
    //
    // Эта геометрия используется только для визуального Clip.
    // Расчёт Volume выполняется отдельно в TankType3VolumeDefinition по той же физической границе.
    //
    // В цилиндрической части правая граница отсека = PartitionX.
    //
    // В нижнем эллиптическом днище перегородка заканчивается точно в точке пересечения с эллипсом. Далее границей
    // рассчитываемого отсека становится сам контур днища.
    //
    // При dimD = dimB PartitionX совпадает с правой стенкой, поэтому LeftCompartmentPath становится всем Tank.
    // ============================================================
    private string LeftCompartmentPath
    {
        get
        {
            // Если нижнего эллиптического днища нет, левый отсек является обычным прямоугольником.
            if (HeadVisualHeight <= 0.0)
            {
                return string.Create(CultureInfo.InvariantCulture,
                    $"M {TankLeft:0.###} {TankTopY:0.###} " +
                    $"L {PartitionX:0.###} {TankTopY:0.###} " +
                    $"L {PartitionX:0.###} {TankBottomY:0.###} " +
                    $"L {TankLeft:0.###} {TankBottomY:0.###} Z");
            }

            // Начинаем от левой верхней точки, идём по верху до перегородки,
            // затем вниз до её пересечения с эллиптическим днищем, после чего по настоящей дуге днища возвращаемся
            // к левой цилиндрической стенке.
            return string.Create(CultureInfo.InvariantCulture,
                $"M {TankLeft:0.###} {TankTopY:0.###} " +
                $"L {PartitionX:0.###} {TankTopY:0.###} " +
                $"L {PartitionX:0.###} {PartitionBottomY:0.###} " +
                $"A {TankWidth / 2.0:0.###} {HeadVisualHeight:0.###} 0 0 1 {TankLeft:0.###} {BodyBottomY:0.###} " +
                $"L {TankLeft:0.###} {TankTopY:0.###} Z");
        }
    }

    // Фактическая левая граница Tank на любой высоте.
    private double GetTankLeftAtY(double y)
    {
        if (HeadVisualHeight <= 0 || y <= BodyBottomY)
            return TankLeft;

        var normalizedY = Math.Clamp((y - BodyBottomY) / HeadVisualHeight, 0.0, 1.0);
        var halfWidth = TankWidth / 2.0 * Math.Sqrt(Math.Max(0.0, 1.0 - normalizedY * normalizedY));
        return TankCenterX - halfWidth;
    }

    // Фактическая правая граница Tank на любой высоте.
    private double GetTankRightAtY(double y)
    {
        if (HeadVisualHeight <= 0 || y <= BodyBottomY)
            return TankRight;

        var normalizedY = Math.Clamp((y - BodyBottomY) / HeadVisualHeight, 0.0, 1.0);
        var halfWidth = TankWidth / 2.0 * Math.Sqrt(Math.Max(0.0, 1.0 - normalizedY * normalizedY));
        return TankCenterX + halfWidth;
    }

    // dimA и dimC используют одну левую колонку полей,
    // базой которой является внешняя шкала dimA.
    private string GetLeftFieldStyle(double centerY)
    {
        var fieldRightX = LeftDimAScaleX - FieldGapFromScale;
        var leftPercent = fieldRightX / SvgWidth * 100.0;
        var topPercent = centerY / SvgHeight * 100.0;

        return string.Create(CultureInfo.InvariantCulture, $"left:{leftPercent:0.###}%; top:{topPercent:0.###}%; transform:translate(-100%, -50%);");
    }

    // Все Sensor fields справа находятся в одной колонке.
    private string GetRightFieldStyle(double centerY)
    {
        var fieldLeftX = RightMeasurementScaleX + FieldGapFromScale;
        var leftPercent = fieldLeftX / SvgWidth * 100.0;
        var topPercent = centerY / SvgHeight * 100.0;

        return string.Create(CultureInfo.InvariantCulture, $"left:{leftPercent:0.###}%; top:{topPercent:0.###}%; transform:translateY(-50%);");
    }

    // dimD располагается над своей размерной линией.
    private string DimDFieldStyle
    {
        get
        {
            var centerX = (TankLeft + PartitionX) / 2.0;
            var leftPercent = centerX / SvgWidth * 100.0;
            var topPercent = (DimDScaleY - FieldGapFromScale - 38.0) / SvgHeight * 100.0;

            return string.Create(CultureInfo.InvariantCulture, $"left:{leftPercent:0.###}%; top:{topPercent:0.###}%; transform:translateX(-50%);");
        }
    }

    // dimB располагается под Tank по центру.
    private string DimBFieldStyle
    {
        get
        {
            var leftPercent = TankCenterX / SvgWidth * 100.0;
            var topPercent = (DimBScaleY + FieldGapFromScale) / SvgHeight * 100.0;

            return string.Create(CultureInfo.InvariantCulture, $"left:{leftPercent:0.###}%; top:{topPercent:0.###}%; transform:translateX(-50%);");
        }
    }

    // Подпись уровня следует за фактической линией жидкости.
    private string LevelLabelStyle
    {
        get
        {
            var leftPercent = TankCenterX / SvgWidth * 100.0;
            var labelY = Math.Max(TankTopY + 18.0, FillY - 10.0);
            var topPercent = labelY / SvgHeight * 100.0;

            return string.Create(CultureInfo.InvariantCulture, $"left:{leftPercent:0.###}%; top:{topPercent:0.###}%;");
        }
    }

    private static string Svg(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
}