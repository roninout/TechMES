@using System.Globalization

<div class="tank-type1-editor">

    <div class="tank-type1-canvas">

        <svg viewBox="0 0 760 620"
             role="img"
             aria-label="Tank Type 1 interactive geometry">

            <defs>
                <clipPath id="@ClipId">
                    <path d="@TankPath" />
                </clipPath>
            </defs>


            @if (HasLevel)
            {
                <g clip-path="@ClipUrl">

                    <rect class="tank-liquid-fill"
                          x="@Svg(TankLeft)"
                          y="@Svg(FillY)"
                          width="@Svg(TankWidth)"
                          height="@Svg(Math.Max(0.0, TankBottomY - FillY))" />

                    <line class="tank-live-level"
                          x1="@Svg(TankLeft - 20.0)"
                          y1="@Svg(FillY)"
                          x2="@Svg(TankRight + 20.0)"
                          y2="@Svg(FillY)" />

                </g>
            }


            <path class="tank-shape"
                  d="@TankPath" />


            <line class="tank-body-line"
                  x1="@Svg(TankLeft)"
                  y1="@Svg(BodyTopY)"
                  x2="@Svg(TankRight)"
                  y2="@Svg(BodyTopY)" />

            <line class="tank-body-line"
                  x1="@Svg(TankLeft)"
                  y1="@Svg(BodyBottomY)"
                  x2="@Svg(TankRight)"
                  y2="@Svg(BodyBottomY)" />


            <line class="tank-guide-dim"
                  x1="@Svg(LeftDimCScaleX)"
                  y1="@Svg(TankTopY)"
                  x2="@Svg(GetTankLeftAtY(TankTopY))"
                  y2="@Svg(TankTopY)" />

            <line class="tank-guide-dim"
                  x1="@Svg(LeftDimCScaleX)"
                  y1="@Svg(BodyTopY)"
                  x2="@Svg(GetTankLeftAtY(BodyTopY))"
                  y2="@Svg(BodyTopY)" />

            <line class="tank-dimension"
                  x1="@Svg(LeftDimCScaleX)"
                  y1="@Svg(TankTopY)"
                  x2="@Svg(LeftDimCScaleX)"
                  y2="@Svg(BodyTopY)" />

            <line class="tank-dimension-cap"
                  x1="@Svg(LeftDimCScaleX - ScaleCapHalfWidth)"
                  y1="@Svg(TankTopY)"
                  x2="@Svg(LeftDimCScaleX + ScaleCapHalfWidth)"
                  y2="@Svg(TankTopY)" />

            <line class="tank-dimension-cap"
                  x1="@Svg(LeftDimCScaleX - ScaleCapHalfWidth)"
                  y1="@Svg(BodyTopY)"
                  x2="@Svg(LeftDimCScaleX + ScaleCapHalfWidth)"
                  y2="@Svg(BodyTopY)" />


            <line class="tank-guide-dim"
                  x1="@Svg(LeftDimAScaleX)"
                  y1="@Svg(BodyTopY)"
                  x2="@Svg(TankLeft)"
                  y2="@Svg(BodyTopY)" />

            <line class="tank-guide-dim"
                  x1="@Svg(LeftDimAScaleX)"
                  y1="@Svg(BodyBottomY)"
                  x2="@Svg(TankLeft)"
                  y2="@Svg(BodyBottomY)" />

            <line class="tank-dimension"
                  x1="@Svg(LeftDimAScaleX)"
                  y1="@Svg(BodyTopY)"
                  x2="@Svg(LeftDimAScaleX)"
                  y2="@Svg(BodyBottomY)" />

            <line class="tank-dimension-cap"
                  x1="@Svg(LeftDimAScaleX - ScaleCapHalfWidth)"
                  y1="@Svg(BodyTopY)"
                  x2="@Svg(LeftDimAScaleX + ScaleCapHalfWidth)"
                  y2="@Svg(BodyTopY)" />

            <line class="tank-dimension-cap"
                  x1="@Svg(LeftDimAScaleX - ScaleCapHalfWidth)"
                  y1="@Svg(BodyBottomY)"
                  x2="@Svg(LeftDimAScaleX + ScaleCapHalfWidth)"
                  y2="@Svg(BodyBottomY)" />


            <line class="tank-guide-dim"
                  x1="@Svg(TankLeft)"
                  y1="@Svg(BodyBottomY)"
                  x2="@Svg(TankLeft)"
                  y2="@Svg(DimBScaleY)" />

            <line class="tank-guide-dim"
                  x1="@Svg(TankRight)"
                  y1="@Svg(BodyBottomY)"
                  x2="@Svg(TankRight)"
                  y2="@Svg(DimBScaleY)" />

            <line class="tank-dimension"
                  x1="@Svg(TankLeft)"
                  y1="@Svg(DimBScaleY)"
                  x2="@Svg(TankRight)"
                  y2="@Svg(DimBScaleY)" />

            <line class="tank-dimension-cap"
                  x1="@Svg(TankLeft)"
                  y1="@Svg(DimBScaleY - ScaleCapHalfWidth)"
                  x2="@Svg(TankLeft)"
                  y2="@Svg(DimBScaleY + ScaleCapHalfWidth)" />

            <line class="tank-dimension-cap"
                  x1="@Svg(TankRight)"
                  y1="@Svg(DimBScaleY - ScaleCapHalfWidth)"
                  x2="@Svg(TankRight)"
                  y2="@Svg(DimBScaleY + ScaleCapHalfWidth)" />


            <line class="tank-zone-guide"
                  x1="@Svg(GetTankRightAtY(TankTopY))"
                  y1="@Svg(TankTopY)"
                  x2="@Svg(RightDeadAreaScaleX)"
                  y2="@Svg(TankTopY)" />

            <line class="tank-zone-guide"
                  x1="@Svg(GetTankRightAtY(UpperDeadBoundaryY))"
                  y1="@Svg(UpperDeadBoundaryY)"
                  x2="@Svg(RightMeasurementScaleX)"
                  y2="@Svg(UpperDeadBoundaryY)" />

            <line class="tank-zone-guide"
                  x1="@Svg(GetTankRightAtY(LowerDeadBoundaryY))"
                  y1="@Svg(LowerDeadBoundaryY)"
                  x2="@Svg(RightMeasurementScaleX)"
                  y2="@Svg(LowerDeadBoundaryY)" />

            <line class="tank-zone-guide"
                  x1="@Svg(GetTankRightAtY(TankBottomY))"
                  y1="@Svg(TankBottomY)"
                  x2="@Svg(RightDeadAreaScaleX)"
                  y2="@Svg(TankBottomY)" />


            <line class="tank-dead-zone"
                  x1="@Svg(RightDeadAreaScaleX)"
                  y1="@Svg(TankTopY)"
                  x2="@Svg(RightDeadAreaScaleX)"
                  y2="@Svg(UpperDeadBoundaryY)" />

            <line class="tank-zone-cap"
                  x1="@Svg(RightDeadAreaScaleX - ScaleCapHalfWidth)"
                  y1="@Svg(TankTopY)"
                  x2="@Svg(RightDeadAreaScaleX + ScaleCapHalfWidth)"
                  y2="@Svg(TankTopY)" />

            <line class="tank-zone-cap"
                  x1="@Svg(RightDeadAreaScaleX - ScaleCapHalfWidth)"
                  y1="@Svg(UpperDeadBoundaryY)"
                  x2="@Svg(RightDeadAreaScaleX + ScaleCapHalfWidth)"
                  y2="@Svg(UpperDeadBoundaryY)" />


            <line class="tank-measure-zone"
                  x1="@Svg(RightMeasurementScaleX)"
                  y1="@Svg(UpperDeadBoundaryY)"
                  x2="@Svg(RightMeasurementScaleX)"
                  y2="@Svg(LowerDeadBoundaryY)" />

            <line class="tank-measure-cap"
                  x1="@Svg(RightMeasurementScaleX - ScaleCapHalfWidth)"
                  y1="@Svg(UpperDeadBoundaryY)"
                  x2="@Svg(RightMeasurementScaleX + ScaleCapHalfWidth)"
                  y2="@Svg(UpperDeadBoundaryY)" />

            <line class="tank-measure-cap"
                  x1="@Svg(RightMeasurementScaleX - ScaleCapHalfWidth)"
                  y1="@Svg(LowerDeadBoundaryY)"
                  x2="@Svg(RightMeasurementScaleX + ScaleCapHalfWidth)"
                  y2="@Svg(LowerDeadBoundaryY)" />


            <line class="tank-dead-zone"
                  x1="@Svg(RightDeadAreaScaleX)"
                  y1="@Svg(LowerDeadBoundaryY)"
                  x2="@Svg(RightDeadAreaScaleX)"
                  y2="@Svg(TankBottomY)" />

            <line class="tank-zone-cap"
                  x1="@Svg(RightDeadAreaScaleX - ScaleCapHalfWidth)"
                  y1="@Svg(LowerDeadBoundaryY)"
                  x2="@Svg(RightDeadAreaScaleX + ScaleCapHalfWidth)"
                  y2="@Svg(LowerDeadBoundaryY)" />

            <line class="tank-zone-cap"
                  x1="@Svg(RightDeadAreaScaleX - ScaleCapHalfWidth)"
                  y1="@Svg(TankBottomY)"
                  x2="@Svg(RightDeadAreaScaleX + ScaleCapHalfWidth)"
                  y2="@Svg(TankBottomY)" />

        </svg>

        @if (HasLevel)
        {
            <div class="tank-live-level-overlay"
                 style="@LevelLabelStyle">
                @LevelLabel
            </div>
        }

        <div class="tank-side-field"
             style="@GetRightFieldStyle(MeasurementAreaCenterY)">

            <RadzenFormField Text="Measurement area"
                             AllowFloatingLabel="false">

                <RadzenNumeric TValue="double"
                               Value="@MeasurementAreaMm"
                               Format="0.### mm"
                               Disabled="true"
                               ShowUpDown="false"
                               Style="width:100%;" />

            </RadzenFormField>

        </div>

        <!-- ============================================================
        dimC
        ============================================================ -->
        <div class="tank-side-field"
             style="@GetLeftFieldStyle(DimCCenterY)">

            <RadzenFormField Text="dimC"
                             AllowFloatingLabel="false">

                <RadzenNumeric TValue="double"
                               Value="@DimC"
                               Change="@((double value) => DimCChanged.InvokeAsync(value))"
                               Format="0.### mm"
                               Disabled="@Disabled"
                               Style="width:100%;" />

            </RadzenFormField>

        </div>

        <div class="tank-side-field"
             style="@GetLeftFieldStyle(DimACenterY)">

            <RadzenFormField Text="dimA"
                             AllowFloatingLabel="false">

                <RadzenNumeric TValue="double"
                               Value="@DimA"
                               Change="@((double value) => DimAChanged.InvokeAsync(value))"
                               Format="0.### mm"
                               Disabled="@Disabled"
                               Style="width:100%;" />

            </RadzenFormField>

        </div>

        <div class="tank-side-field"
             style="@GetRightFieldStyle(UpperDeadAreaCenterY)">

            <RadzenFormField Text="Upper dead area"
                             AllowFloatingLabel="false">

                <RadzenNumeric TValue="double"
                               Value="@UpperDeadArea"
                               Change="@((double value) => UpperDeadAreaChanged.InvokeAsync(value))"
                               Format="0.### mm"
                               Disabled="@Disabled"
                               Style="width:100%;" />

            </RadzenFormField>

        </div>

        <div class="tank-side-field"
             style="@GetRightFieldStyle(LowerDeadAreaCenterY)">

            <RadzenFormField Text="Lower dead area"
                             AllowFloatingLabel="false">

                <RadzenNumeric TValue="double"
                               Value="@LowerDeadArea"
                               Change="@((double value) => LowerDeadAreaChanged.InvokeAsync(value))"
                               Format="0.### mm"
                               Disabled="@Disabled"
                               Style="width:100%;" />

            </RadzenFormField>

        </div>

        <div class="tank-bottom-field"
             style="@DimBOverlayStyle">

            <RadzenFormField Text="dimB"
                             AllowFloatingLabel="false">

                <RadzenNumeric TValue="double"
                               Value="@DimB"
                               Change="@((double value) => DimBChanged.InvokeAsync(value))"
                               Format="0.### mm"
                               Disabled="@Disabled"
                               Style="width:100%;" />

            </RadzenFormField>

        </div>

    </div>

</div>


@code {
    [Parameter]
    public double DimA { get; set; }

    [Parameter]
    public double DimB { get; set; }

    [Parameter]
    public double DimC { get; set; }

    [Parameter]
    public double UpperDeadArea { get; set; }

    [Parameter]
    public double LowerDeadArea { get; set; }

    [Parameter]
    public double? LevelPercent { get; set; }

    [Parameter]
    public bool Disabled { get; set; }


    [Parameter]
    public EventCallback<double> DimAChanged { get; set; }

    [Parameter]
    public EventCallback<double> DimBChanged { get; set; }

    [Parameter]
    public EventCallback<double> DimCChanged { get; set; }

    [Parameter]
    public EventCallback<double> UpperDeadAreaChanged { get; set; }

    [Parameter]
    public EventCallback<double> LowerDeadAreaChanged { get; set; }

    private readonly string ClipId = $"tankType1Clip_{Guid.NewGuid():N}";

    private const double SvgWidth = 760.0;
    private const double SvgHeight = 620.0;

    private const double TankTopY = 120.0;
    private const double TankBottomY = 425.0;
    private const double TankCenterX = 345.0;

    private const double TankVisualHeight = TankBottomY - TankTopY;

    // Расстояние от края Tank до ближайшей размерной шкалы.
    private const double ScaleGapFromTank = 68.0;

    // Расстояние между внутренней и внешней размерными шкалами.
    private const double ScaleLaneGap = 25.0;

    // Половина ширины засечки размерной шкалы.
    private const double ScaleCapHalfWidth = 9.0;

    // Одинаковое расстояние от внешней шкалы до поля.
    // Меняя только это значение, можно одновременно приблизить или отдалить все боковые поля.
    private const double FieldGapFromScale = 35.0;

    // Положение горизонтальной размерной линии dimB.
    private const double DimBScaleY = 470.0;

    private double TotalLengthMm => Math.Max(0.0, DimA + DimC * 2.0);

    private double MeasurementAreaMm => Math.Max(0.0, TotalLengthMm - UpperDeadArea - LowerDeadArea);

    // Ширина Tank отображается пропорционально dimB,
    // но имеет разумные визуальные границы, чтобы схема оставалась читаемой на планшете.
    private double TankWidth
    {
        get
        {
            if (TotalLengthMm <= 0)
                return 175.0;

            var proportionalWidth = TankVisualHeight * Math.Max(0.0, DimB) / TotalLengthMm;
            return Math.Clamp(proportionalWidth, 175.0, 270.0);
        }
    }

    private double TankLeft => TankCenterX - TankWidth / 2.0;

    private double TankRight => TankCenterX + TankWidth / 2.0;

    // Высота верхнего и нижнего эллиптических днищ соответствует отношению dimC к полной высоте Tank.
    private double HeadVisualHeight
    {
        get
        {
            if (TotalLengthMm <= 0)
                return 0.0;

            var height = TankVisualHeight * Math.Max(0.0, DimC) / TotalLengthMm;
            return Math.Clamp(height, 0.0, 105.0);
        }
    }

    private double BodyTopY => TankTopY + HeadVisualHeight;

    private double BodyBottomY => TankBottomY - HeadVisualHeight;

    // Левая сторона.
    // dimC находится ближе к Tank.
    // dimA находится дальше и является базовой шкалой для выравнивания всей левой колонки полей.
    private double LeftDimCScaleX => TankLeft - ScaleGapFromTank;

    private double LeftDimAScaleX => LeftDimCScaleX - ScaleLaneGap;

    // Правая сторона зеркальна левой.
    // Dead area находится ближе к Tank.
    // Measurement area находится дальше и является базовой шкалой для выравнивания всей правой колонки полей.
    private double RightDeadAreaScaleX => TankRight + ScaleGapFromTank;

    private double RightMeasurementScaleX => RightDeadAreaScaleX + ScaleLaneGap;

    private double UpperDeadBoundaryY
    {
        get
        {
            if (TotalLengthMm <= 0)
                return TankTopY;

            var value = Math.Clamp(UpperDeadArea, 0.0, TotalLengthMm);

            return TankTopY + TankVisualHeight * value / TotalLengthMm;
        }
    }

    private double LowerDeadBoundaryY
    {
        get
        {
            if (TotalLengthMm <= 0)
                return TankBottomY;

            var value = Math.Clamp(LowerDeadArea, 0.0, TotalLengthMm);

            return TankBottomY - TankVisualHeight * value / TotalLengthMm;
        }
    }

    // Центры измеряемых зон используются только для автоматического вертикального положения полей.
    // Горизонтально dimC и dimA всегда находятся в одной колонке по шкале dimA.
    private double DimCCenterY => (TankTopY + BodyTopY) / 2.0;

    private double DimACenterY => (BodyTopY + BodyBottomY) / 2.0;

    // Справа все поля находятся в одной колонке по шкале Measurement area, но каждое поле центрируется по своей зоне.
    private double UpperDeadAreaCenterY => (TankTopY + UpperDeadBoundaryY) / 2.0;

    private double MeasurementAreaCenterY => (UpperDeadBoundaryY + LowerDeadBoundaryY) / 2.0;

    private double LowerDeadAreaCenterY => (LowerDeadBoundaryY + TankBottomY) / 2.0;

    private bool HasLevel => LevelPercent.HasValue && double.IsFinite(LevelPercent.Value) && TotalLengthMm > 0 && MeasurementAreaMm > 0;

    // Level.R приходит в процентах. Например 49.8 означает 49.8 % рабочей зоны датчика.
    private double PreviewMeasuredLevelMm => HasLevel ? Math.Max(0.0, MeasurementAreaMm * LevelPercent!.Value / 100.0) : 0.0;

    // Физическая отметка уровня отсчитывается от нижней точки Tank и включает нижнюю мёртвую зону.
    private double PreviewLiquidHeightMm => HasLevel ? Math.Clamp(LowerDeadArea + PreviewMeasuredLevelMm, 0.0, TotalLengthMm) : 0.0;

    private double FillY => TotalLengthMm > 0 ? TankBottomY - TankVisualHeight * PreviewLiquidHeightMm / TotalLengthMm : TankBottomY;

    private string LevelLabel => HasLevel ? $"{LevelPercent!.Value:0.###}% / {PreviewMeasuredLevelMm:0} mm" : "";

    private string ClipUrl => $"url(#{ClipId})";

    // Поле dimC и поле dimA используют одну и ту же X-координату. Базой является внешняя шкала dimA.
    private string GetLeftFieldStyle(double centerY)
    {
        var fieldRightX = LeftDimAScaleX - FieldGapFromScale;
        var leftPercent = fieldRightX / SvgWidth * 100.0;
        var topPercent = centerY / SvgHeight * 100.0;

        return string.Create(CultureInfo.InvariantCulture, $"left:{leftPercent:0.###}%; top:{topPercent:0.###}%; transform:translate(-100%, -50%);");
    }

    // Upper dead area, Measurement area и Lower dead area
    // используют одну и ту же X-координату.
    // Базой является внешняя шкала Measurement area.
    private string GetRightFieldStyle(double centerY)
    {
        var fieldLeftX = RightMeasurementScaleX + FieldGapFromScale;
        var leftPercent = fieldLeftX / SvgWidth * 100.0;
        var topPercent = centerY / SvgHeight * 100.0;

        return string.Create(CultureInfo.InvariantCulture, $"left:{leftPercent:0.###}%; top:{topPercent:0.###}%; transform:translateY(-50%);");
    }

    // Поле dimB всегда центрировано относительно Tank.
    // FieldGapFromScale используется и здесь, поэтому общий визуальный отступ остаётся одинаковым.
    private string DimBOverlayStyle
    {
        get
        {
            var leftPercent = TankCenterX / SvgWidth * 100.0;
            var topPercent = (DimBScaleY + FieldGapFromScale) / SvgHeight * 100.0;
            return string.Create(CultureInfo.InvariantCulture, $"left:{leftPercent:0.###}%; top:{topPercent:0.###}%; transform:translateX(-50%);");
        }
    }

    // Подпись текущего уровня всегда следует за фактической линией заполнения.
    private string LevelLabelStyle
    {
        get
        {
            var leftPercent = TankCenterX / SvgWidth * 100.0;
            var labelY = Math.Max(TankTopY + 18.0, FillY - 10.0);
            var topPercent =labelY / SvgHeight * 100.0;

            return string.Create(CultureInfo.InvariantCulture, $"left:{leftPercent:0.###}%; top:{topPercent:0.###}%;");
        }
    }

    // Возвращает фактическую половину ширины Tank
    // на заданной вертикальной координате.
    //
    // В цилиндрической части ширина постоянна.
    // В эллиптическом днище она рассчитывается по уравнению эллипса.
    private double GetTankHalfWidthAtY(double y)
    {
        var radiusX = TankWidth / 2.0;

        if (HeadVisualHeight <= 0)
            return radiusX;

        if (y < BodyTopY)
        {
            var normalizedY = (BodyTopY - y) / HeadVisualHeight;
            normalizedY = Math.Clamp(normalizedY, 0.0, 1.0);
            return radiusX * Math.Sqrt(Math.Max(0.0, 1.0 - normalizedY * normalizedY));
        }

        if (y > BodyBottomY)
        {
            var normalizedY = (y - BodyBottomY) / HeadVisualHeight;
            normalizedY = Math.Clamp(normalizedY, 0.0, 1.0);
            return radiusX * Math.Sqrt(Math.Max(0.0, 1.0 - normalizedY * normalizedY));
        }

        return radiusX;
    }

    private double GetTankLeftAtY(double y)
    {
        return TankCenterX - GetTankHalfWidthAtY(y);
    }

    private double GetTankRightAtY(double y)
    {
        return TankCenterX + GetTankHalfWidthAtY(y);
    }

    // Контур Type 1 строится настоящими эллиптическими дугами.
    // Поэтому TankTopY и TankBottomY являются точными верхней и нижней границами Tank.
    private string TankPath
    {
        get
        {
            var radiusX = TankWidth / 2.0;
            var radiusY = HeadVisualHeight;

            if (radiusY <= 0)
            {
                return
                    $"M {Svg(TankLeft)} {Svg(TankTopY)} " +
                    $"L {Svg(TankRight)} {Svg(TankTopY)} " +
                    $"L {Svg(TankRight)} {Svg(TankBottomY)} " +
                    $"L {Svg(TankLeft)} {Svg(TankBottomY)} Z";
            }

            return
                $"M {Svg(TankLeft)} {Svg(BodyTopY)} " +
                $"A {Svg(radiusX)} {Svg(radiusY)} 0 0 1 {Svg(TankRight)} {Svg(BodyTopY)} " +
                $"L {Svg(TankRight)} {Svg(BodyBottomY)} " +
                $"A {Svg(radiusX)} {Svg(radiusY)} 0 0 1 {Svg(TankLeft)} {Svg(BodyBottomY)} Z";
        }
    }

    private static string Svg(double value)
    {
        return value.ToString("0.###", CultureInfo.InvariantCulture);
    }
}