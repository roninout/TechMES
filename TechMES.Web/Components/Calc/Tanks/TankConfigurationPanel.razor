    private sealed class TankInputEditor
    {
        public CalcParameterDefinitionDto Parameter { get; set; } = new();

        public double NumberValue { get; set; }

        public bool BooleanValue { get; set; }
    }

    private sealed record TankOutputRow(string Key, string Name, string Unit, string? TagName);

    // ============================================================
    // Tank Help
    // ============================================================

    private Dictionary<string, object?> BuildCurrentTestParameters(CalcDefinitionDto definition)
    {
        var result = new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);

        foreach (var parameter in definition.Parameters.OrderBy(parameter => parameter.Order))
        {
            if (string.Equals(parameter.Key, "levelRaw", StringComparison.OrdinalIgnoreCase))
            {
                result[parameter.Key] = GetLastInputNumber("levelRaw") ?? 0.0;
                continue;
            }

            if (string.Equals(parameter.Key, "densityHmi", StringComparison.OrdinalIgnoreCase))
            {
                result[parameter.Key] = GetLastInputNumber("densityHmi") ?? 0.0;
                continue;
            }

            var editor = FindInputEditor(parameter.Key);

            if (parameter.Type == CalcParameterTypeDto.Boolean)
            {
                result[parameter.Key] = editor?.BooleanValue ?? ReadBoolean(parameter.DefaultValue);
                continue;
            }

            result[parameter.Key] = editor?.NumberValue ?? ReadNumber(parameter.DefaultValue);
        }

        return result;
    }

    private async Task OpenTankHelpAsync()
    {
        var definition = SelectedDefinition;

        if (definition is null)
            return;

        _isOpeningHelp = true;

        try
        {
            // Help запускает тот же настоящий алгоритм, который используется Calc.Service.
            var response = await CalcApi.TestAsync( definition.Code, BuildCurrentTestParameters(definition), includeTrace: true);

            await DialogService.OpenAsync<TankCalculationInfoDialog>(
                "Tank volume calculation",
                new Dictionary<string, object?>
                {
                    [nameof(TankCalculationInfoDialog.Definition)] = definition,
                    [nameof(TankCalculationInfoDialog.Result)] = response
                },
                new DialogOptions
                {
                    Width = "980px",
                    Height = "82vh",
                    Resizable = true,
                    Draggable = true,
                    CloseDialogOnEsc = true,
                    CloseDialogOnOverlayClick = true
                });
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Calculations", ex.Message, 6000);
        }
        finally
        {
            _isOpeningHelp = false;
        }
    }
}