@using System.Text.Json
@inject CalcApiClient CalcApi
@inject NotificationService NotificationService

<div class="tank-configuration">

    <!-- ============================================================
         LEFT
         Схема сборника + выбор Tank Type
         ============================================================ -->
    <section class="tank-preview-column">

        <div class="tank-section-header">
            <RadzenIcon Icon="oil_barrel" />
            <span>Tank geometry</span>
        </div>

        @if (_isLoadingDefinitions)
        {
            <div class="tank-loading">
                <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_loadError))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true">
                @_loadError
            </RadzenAlert>
        }
        else if (SelectedDefinition is not null)
        {
            <TankTypePreview TypeNumber="@SelectedTypeNumber" />

            <div class="tank-type-field">
                <RadzenLabel Text="Tank type" />

                <RadzenDropDown TValue="string"
                                Data="@_tankDefinitions"
                                TextProperty="@nameof(CalcDefinitionDto.Name)"
                                ValueProperty="@nameof(CalcDefinitionDto.Code)"
                                Value="@_selectedDefinitionCode"
                                Change="@OnTankTypeChanged"
                                Disabled="@_isSaving"
                                Style="width:100%;" />
            </div>
        }

    </section>


    <!-- ============================================================
         RIGHT
         Параметры выбранного алгоритма
         ============================================================ -->
    <section class="tank-parameters-column">

        <div class="tank-section-header">
            <RadzenIcon Icon="tune" />
            <span>Parameters</span>
        </div>

        @if (!_isLoadingDefinitions && string.IsNullOrWhiteSpace(_loadError) && SelectedDefinition is not null)
        {
            <div class="tank-parameter-table-wrap">

                <table class="tank-parameter-table">

                    <thead>
                        <tr>
                            <th class="tank-use-column">Use</th>
                            <th>Parameter</th>
                            <th class="tank-source-column">Source</th>
                            <th>Value / tag</th>
                            <th class="tank-age-column">Max age, s</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var input in _inputs)
                        {
                            <tr>

                                <!-- Use -->
                                <td class="tank-use-column">
                                    <RadzenCheckBox TValue="bool"
                                                    @bind-Value="input.UseBinding"
                                                    Disabled="@(_isSaving || input.IsRequired)" />
                                </td>


                                <!-- Parameter -->
                                <td>
                                    <div class="tank-parameter-name">
                                        @input.Parameter.Name
                                    </div>

                                    <div class="tank-parameter-key">
                                        @input.Parameter.Key

                                        @if (!string.IsNullOrWhiteSpace(input.Parameter.Unit))
                                        {
                                            <span> · @input.Parameter.Unit</span>
                                        }
                                    </div>
                                </td>


                                <!-- Source -->
                                <td>
                                    <RadzenDropDown TValue="CalcInputSourceTypeDto"
                                                    Data="@GetSourceTypes(input)"
                                                    @bind-Value="input.SourceType"
                                                    Disabled="@(_isSaving || !input.UseBinding)"
                                                    Style="width:100%;" />
                                </td>


                                <!-- Value / tag -->
                                <td>

                                    @if (input.SourceType == CalcInputSourceTypeDto.Tag)
                                    {
                                        <RadzenTextBox @bind-Value="input.TagName"
                                                       Placeholder="SCADA tag"
                                                       Disabled="@(_isSaving || !input.UseBinding)"
                                                       Style="width:100%;" />
                                    }
                                    else if (input.SourceType == CalcInputSourceTypeDto.CalculationOutput)
                                    {
                                        <div class="tank-dependency-source">

                                            <RadzenDropDown TValue="long?"
                                                            Data="@GetDependencyJobs()"
                                                            TextProperty="@nameof(CalcJobDto.Name)"
                                                            ValueProperty="@nameof(CalcJobDto.Id)"
                                                            Value="@input.SourceJobId"
                                                            Change="@((object? value) => OnDependencyJobChanged(input, value))"
                                                            Placeholder="Source job"
                                                            Disabled="@(_isSaving || !input.UseBinding)"
                                                            Style="width:100%;" />

                                            <RadzenDropDown TValue="string"
                                                            Data="@GetDependencyOutputs(input.SourceJobId)"
                                                            TextProperty="@nameof(CalcOutputDefinitionDto.Name)"
                                                            ValueProperty="@nameof(CalcOutputDefinitionDto.Key)"
                                                            @bind-Value="input.SourceOutputKey"
                                                            Placeholder="Output"
                                                            Disabled="@(_isSaving || !input.UseBinding || !input.SourceJobId.HasValue)"
                                                            Style="width:100%;" />

                                        </div>
                                    }
                                    else
                                    {
                                        @switch (input.Parameter.Type)
                                        {
                                            case CalcParameterTypeDto.Number:
                                                <RadzenNumeric TValue="double?"
                                                               @bind-Value="input.NumberValue"
                                                               Disabled="@(_isSaving || !input.UseBinding)"
                                                               Style="width:100%;" />
                                                break;

                                            case CalcParameterTypeDto.Integer:
                                                <RadzenNumeric TValue="int?"
                                                               @bind-Value="input.IntegerValue"
                                                               Disabled="@(_isSaving || !input.UseBinding)"
                                                               Style="width:100%;" />
                                                break;

                                            case CalcParameterTypeDto.Boolean:
                                                <div class="tank-boolean-value">

                                                    <RadzenCheckBox TValue="bool"
                                                                    @bind-Value="input.BooleanValue"
                                                                    Disabled="@(_isSaving || !input.UseBinding)" />

                                                    <span>@(input.BooleanValue ? "True" : "False")</span>

                                                </div>
                                                break;

                                            case CalcParameterTypeDto.Selection:
                                                <RadzenDropDown TValue="string"
                                                                Data="@input.Parameter.Options"
                                                                TextProperty="@nameof(CalcParameterOptionDto.Name)"
                                                                ValueProperty="@nameof(CalcParameterOptionDto.Value)"
                                                                @bind-Value="input.TextValue"
                                                                Disabled="@(_isSaving || !input.UseBinding)"
                                                                Style="width:100%;" />
                                                break;

                                            case CalcParameterTypeDto.Text:
                                                <RadzenTextBox @bind-Value="input.TextValue"
                                                               Disabled="@(_isSaving || !input.UseBinding)"
                                                               Style="width:100%;" />
                                                break;
                                        }
                                    }

                                </td>


                                <!-- Max age -->
                                <td class="tank-age-column">

                                    @if (input.SourceType is CalcInputSourceTypeDto.Tag or CalcInputSourceTypeDto.CalculationOutput)
                                    {
                                        <RadzenNumeric TValue="int?"
                                                       @bind-Value="input.MaxAgeSeconds"
                                                       Min="1"
                                                       Disabled="@(_isSaving || !input.UseBinding)"
                                                       Style="width:100%;" />
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <div class="tank-actions">

                @if (Job is null)
                {
                    <RadzenButton Text="Create job"
                                  Icon="add"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Disabled="@_isSaving"
                                  Click="@CreateJobAsync" />
                }
                else
                {
                    <RadzenButton Text="Save"
                                  Icon="save"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Disabled="@_isSaving"
                                  Click="@SaveJobAsync" />
                }

            </div>
        }

    </section>

</div>


@code {
    [Parameter, EditorRequired]
    public CalcModelDto Model { get; set; } = default!;

    [Parameter]
    public CalcJobDto? Job { get; set; }

    [Parameter]
    public EventCallback JobChanged { get; set; }


    private readonly List<CalcDefinitionDto> _tankDefinitions = [];
    private readonly List<CalcJobDto> _jobs = [];

    private List<TankInputEditor> _inputs = [];

    private string? _selectedDefinitionCode;
    private string _contextKey = "";
    private string _loadError = "";

    private bool _isLoadingDefinitions;
    private bool _isSaving;


    private CalcDefinitionDto? SelectedDefinition =>
        _tankDefinitions.FirstOrDefault(definition =>
            string.Equals(definition.Code, _selectedDefinitionCode, StringComparison.OrdinalIgnoreCase));


    private int SelectedTypeNumber => GetTypeNumber(_selectedDefinitionCode);


    private bool HasTankTypeChanged =>
        Job is not null && !string.Equals(Job.DefinitionCode, _selectedDefinitionCode, StringComparison.OrdinalIgnoreCase);


    protected override async Task OnInitializedAsync()
    {
        await LoadDefinitionsAsync();
        SynchronizeSelection(force: true);
    }


    protected override void OnParametersSet()
    {
        if (_tankDefinitions.Count > 0)
            SynchronizeSelection();
    }


    /// <summary>
    /// Загружает Tank definitions и список Jobs.
    ///
    /// Jobs нужны для SourceType.CalculationOutput.
    /// </summary>
    private async Task LoadDefinitionsAsync()
    {
        _isLoadingDefinitions = true;
        _loadError = "";

        try
        {
            var definitionsTask = CalcApi.GetDefinitionsAsync();
            var jobsTask = CalcApi.GetJobsAsync();

            await Task.WhenAll(definitionsTask, jobsTask);

            _tankDefinitions.Clear();
            _tankDefinitions.AddRange((await definitionsTask)
                .Where(definition =>
                    string.Equals(definition.Category, "Tanks", StringComparison.OrdinalIgnoreCase)
                    && definition.Code.StartsWith("tank.volume.type", StringComparison.OrdinalIgnoreCase))
                .OrderBy(definition => GetTypeNumber(definition.Code)));

            _jobs.Clear();
            _jobs.AddRange(await jobsTask);

            if (_tankDefinitions.Count == 0)
                _loadError = "No Tank calculation algorithms are available in Runtime.";
        }
        catch (Exception ex)
        {
            _loadError = "Cannot load Tank algorithms: " + ex.Message;
        }
        finally
        {
            _isLoadingDefinitions = false;
        }
    }


    /// <summary>
    /// Восстанавливает выбранный Tank Type и параметры
    /// при выборе другого оборудования или после сохранения Job.
    /// </summary>
    private void SynchronizeSelection(bool force = false)
    {
        var newContextKey = $"{Model.Name}|{Job?.Id}|{Job?.Revision}";

        if (!force && string.Equals(_contextKey, newContextKey, StringComparison.Ordinal))
            return;

        _contextKey = newContextKey;

        if (Job is not null && _tankDefinitions.Any(definition =>
                string.Equals(definition.Code, Job.DefinitionCode, StringComparison.OrdinalIgnoreCase)))
        {
            _selectedDefinitionCode = Job.DefinitionCode;
            BuildInputEditors(SelectedDefinition, Job);
            return;
        }

        _selectedDefinitionCode = _tankDefinitions.FirstOrDefault()?.Code;
        BuildInputEditors(SelectedDefinition, null);
    }


    /// <summary>
    /// Переключает Tank Type.
    ///
    /// Если пользователь вернулся к алгоритму,
    /// который уже сохранён в Job, восстанавливаем его Inputs.
    /// Для другого алгоритма строим поля из DefaultValue.
    /// </summary>
    private void OnTankTypeChanged(object? value)
    {
        var definition = FindDefinition(value?.ToString());

        if (definition is null)
            return;

        _selectedDefinitionCode = definition.Code;

        var storedJob = Job is not null
            && string.Equals(Job.DefinitionCode, definition.Code, StringComparison.OrdinalIgnoreCase)
                ? Job
                : null;

        BuildInputEditors(definition, storedJob);
    }


    /// <summary>
    /// Строит редакторы всех входных параметров алгоритма.
    /// </summary>
    private void BuildInputEditors(CalcDefinitionDto? definition, CalcJobDto? job)
    {
        if (definition is null)
        {
            _inputs = [];
            return;
        }

        _inputs = definition.Parameters
            .OrderBy(parameter => parameter.Order)
            .Select(parameter =>
            {
                var stored = job?.Inputs.FirstOrDefault(input =>
                    string.Equals(input.ParameterKey, parameter.Key, StringComparison.OrdinalIgnoreCase));

                return CreateInputEditor(parameter, stored);
            })
            .ToList();
    }


    /// <summary>
    /// Создаёт редактор одного параметра.
    ///
    /// Логика совпадает с редактором Calculation Jobs:
    /// сохранённая binding включена,
    /// обязательный параметр без DefaultValue включён всегда.
    /// </summary>
    private static TankInputEditor CreateInputEditor(CalcParameterDefinitionDto parameter, CalcJobInputDto? stored)
    {
        var editor = new TankInputEditor
        {
            Parameter = parameter,
            IsRequired = parameter.IsRequired && !parameter.DefaultValue.HasValue,
            UseBinding = stored is not null || (parameter.IsRequired && !parameter.DefaultValue.HasValue),
            SourceType = stored?.SourceType ?? CalcInputSourceTypeDto.Constant,
            TagName = stored?.TagName ?? "",
            SourceJobId = stored?.SourceJobId,
            SourceOutputKey = stored?.SourceOutputKey ?? "",
            MaxAgeSeconds = stored?.MaxAgeSeconds
        };

        LoadConstantValue(editor, stored?.ConstantValue ?? parameter.DefaultValue);
        return editor;
    }


    /// <summary>
    /// Загружает ConstantValue в типизированное поле редактора.
    /// </summary>
    private static void LoadConstantValue(TankInputEditor editor, JsonElement? value)
    {
        if (!value.HasValue)
            return;

        var element = value.Value;

        switch (editor.Parameter.Type)
        {
            case CalcParameterTypeDto.Number when element.TryGetDouble(out var number):
                editor.NumberValue = number;
                break;

            case CalcParameterTypeDto.Integer when element.TryGetInt32(out var integer):
                editor.IntegerValue = integer;
                break;

            case CalcParameterTypeDto.Boolean when element.ValueKind is JsonValueKind.True or JsonValueKind.False:
                editor.BooleanValue = element.GetBoolean();
                break;

            case CalcParameterTypeDto.Selection:
            case CalcParameterTypeDto.Text:
                editor.TextValue = element.ValueKind == JsonValueKind.String ? element.GetString() ?? "" : "";
                break;
        }
    }


    /// <summary>
    /// Допустимые источники параметров.
    ///
    /// Используем ту же логику, что и в Calculation Jobs.
    /// </summary>
    private static IReadOnlyList<CalcInputSourceTypeDto> GetSourceTypes(TankInputEditor input)
    {
        return input.Parameter.Type switch
        {
            CalcParameterTypeDto.Number or CalcParameterTypeDto.Integer =>
            [
                CalcInputSourceTypeDto.Tag,
                CalcInputSourceTypeDto.Constant,
                CalcInputSourceTypeDto.CalculationOutput
            ],

            CalcParameterTypeDto.Boolean =>
            [
                CalcInputSourceTypeDto.Tag,
                CalcInputSourceTypeDto.Constant
            ],

            _ =>
            [
                CalcInputSourceTypeDto.Constant
            ]
        };
    }


    /// <summary>
    /// Source Job не может быть текущим Tank Job.
    /// </summary>
    private IReadOnlyList<CalcJobDto> GetDependencyJobs()
    {
        return _jobs
            .Where(job => Job is null || job.Id != Job.Id)
            .OrderBy(job => job.SortOrder)
            .ThenBy(job => job.Name)
            .ToList();
    }


    /// <summary>
    /// Outputs выбранного source Job.
    /// </summary>
    private IReadOnlyList<CalcOutputDefinitionDto> GetDependencyOutputs(long? sourceJobId)
    {
        if (!sourceJobId.HasValue)
            return [];

        var sourceJob = _jobs.FirstOrDefault(job => job.Id == sourceJobId.Value);

        if (sourceJob is null)
            return [];

        return FindAnyDefinition(sourceJob.DefinitionCode)?.Outputs
            .OrderBy(output => output.Order)
            .ToList()
            ?? [];
    }


    private void OnDependencyJobChanged(TankInputEditor input, object? value)
    {
        input.SourceJobId = value is null ? null : Convert.ToInt64(value);

        var outputs = GetDependencyOutputs(input.SourceJobId);

        if (!outputs.Any(output =>
                string.Equals(output.Key, input.SourceOutputKey, StringComparison.OrdinalIgnoreCase)))
        {
            input.SourceOutputKey = outputs.FirstOrDefault()?.Key ?? "";
        }
    }


    /// <summary>
    /// Создаёт новый Tank Job вместе с выбранными Inputs.
    /// </summary>
    private async Task CreateJobAsync()
    {
        var definition = SelectedDefinition;

        if (definition is null)
            return;

        _isSaving = true;

        try
        {
            var request = new CalcJobSaveRequest
            {
                EquipmentName = Model.Name,
                Name = $"{Model.Name} Tank volume",
                Description = Model.Description,
                DefinitionCode = definition.Code,
                DefinitionVersion = definition.Version,
                Enabled = false,
                PeriodMs = 5000,
                WriteEnabled = false,
                SortOrder = 0,
                ExpectedRevision = null,
                Inputs = _inputs.Where(input => input.UseBinding).Select(BuildInputBinding).ToList(),
                Outputs = []
            };

            await CalcApi.CreateJobAsync(request);

            NotificationService.Notify(
                NotificationSeverity.Success,
                "Calculations",
                $"Tank Job created for {Model.Name}.",
                4000);

            await JobChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(
                NotificationSeverity.Error,
                "Calculations",
                ex.Message,
                6000);
        }
        finally
        {
            _isSaving = false;
        }
    }


    /// <summary>
    /// Сохраняет параметры существующего Tank Job.
    ///
    /// При смене Tank Type:
    /// - Job выключается;
    /// - output writes выключаются;
    /// - старые Outputs очищаются.
    ///
    /// При сохранении того же типа существующие Outputs сохраняются.
    /// </summary>
    private async Task SaveJobAsync()
    {
        var definition = SelectedDefinition;

        if (Job is null || definition is null)
            return;

        var typeChanged = HasTankTypeChanged;

        _isSaving = true;

        try
        {
            var request = new CalcJobSaveRequest
            {
                EquipmentName = Job.EquipmentName,
                Name = Job.Name,
                Description = Job.Description,
                DefinitionCode = definition.Code,
                DefinitionVersion = definition.Version,
                Enabled = typeChanged ? false : Job.Enabled,
                PeriodMs = Job.PeriodMs,
                WriteEnabled = typeChanged ? false : Job.WriteEnabled,
                SortOrder = Job.SortOrder,
                ExpectedRevision = Job.Revision,
                Inputs = _inputs.Where(input => input.UseBinding).Select(BuildInputBinding).ToList(),
                Outputs = typeChanged ? [] : Job.Outputs.Select(BuildOutputBinding).ToList()
            };

            await CalcApi.UpdateJobAsync(Job.Id, request);

            NotificationService.Notify(
                NotificationSeverity.Success,
                "Calculations",
                typeChanged
                    ? $"Tank type changed to Type {SelectedTypeNumber}."
                    : $"Tank parameters saved for {Model.Name}.",
                4000);

            await JobChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(
                NotificationSeverity.Error,
                "Calculations",
                ex.Message,
                6000);
        }
        finally
        {
            _isSaving = false;
        }
    }


    private static CalcJobInputSaveDto BuildInputBinding(TankInputEditor input)
    {
        var result = new CalcJobInputSaveDto
        {
            ParameterKey = input.Parameter.Key,
            SourceType = input.SourceType,
            SortOrder = input.Parameter.Order
        };

        switch (input.SourceType)
        {
            case CalcInputSourceTypeDto.Tag:
                result.TagName = NullIfEmpty(input.TagName);
                result.MaxAgeSeconds = input.MaxAgeSeconds;
                break;

            case CalcInputSourceTypeDto.Constant:
                result.ConstantValue = CreateConstantValue(input);
                break;

            case CalcInputSourceTypeDto.CalculationOutput:
                result.SourceJobId = input.SourceJobId;
                result.SourceOutputKey = NullIfEmpty(input.SourceOutputKey);
                result.MaxAgeSeconds = input.MaxAgeSeconds;
                break;
        }

        return result;
    }


    private static CalcJobOutputSaveDto BuildOutputBinding(CalcJobOutputDto output)
    {
        return new CalcJobOutputSaveDto
        {
            OutputKey = output.OutputKey,
            TagName = output.TagName,
            WriteEnabled = output.WriteEnabled,
            Scale = output.Scale,
            Offset = output.Offset,
            SortOrder = output.SortOrder
        };
    }


    private static JsonElement? CreateConstantValue(TankInputEditor input)
    {
        object? value = input.Parameter.Type switch
        {
            CalcParameterTypeDto.Number => input.NumberValue,
            CalcParameterTypeDto.Integer => input.IntegerValue,
            CalcParameterTypeDto.Boolean => input.BooleanValue,
            CalcParameterTypeDto.Selection => NullIfEmpty(input.TextValue),
            CalcParameterTypeDto.Text => NullIfEmpty(input.TextValue),
            _ => null
        };

        return value is null
            ? null
            : JsonSerializer.SerializeToElement(value, value.GetType());
    }


    private CalcDefinitionDto? FindDefinition(string? code)
    {
        return _tankDefinitions.FirstOrDefault(definition =>
            string.Equals(definition.Code, code, StringComparison.OrdinalIgnoreCase));
    }


    private CalcDefinitionDto? FindAnyDefinition(string? code)
    {
        /*
         * Для dependency outputs сначала ищем среди Tank.
         *
         * Если позже понадобится подключение результата Density/Capacity,
         * список definitions лучше будет поднять на уровень Calculation.razor
         * и передавать сюда полностью.
         */
        return FindDefinition(code);
    }


    private static int GetTypeNumber(string? definitionCode)
    {
        if (string.IsNullOrWhiteSpace(definitionCode))
            return 0;

        for (var type = 1; type <= 8; type++)
        {
            if (definitionCode.EndsWith($".type{type}", StringComparison.OrdinalIgnoreCase))
                return type;
        }

        return 0;
    }


    private static string? NullIfEmpty(string? value)
    {
        var normalized = (value ?? "").Trim();
        return normalized.Length == 0 ? null : normalized;
    }


    private sealed class TankInputEditor
    {
        public CalcParameterDefinitionDto Parameter { get; set; } = new();

        public bool IsRequired { get; set; }
        public bool UseBinding { get; set; }

        public CalcInputSourceTypeDto SourceType { get; set; } = CalcInputSourceTypeDto.Constant;

        public string TagName { get; set; } = "";
        public long? SourceJobId { get; set; }
        public string SourceOutputKey { get; set; } = "";
        public int? MaxAgeSeconds { get; set; }

        public double? NumberValue { get; set; }
        public int? IntegerValue { get; set; }
        public bool BooleanValue { get; set; }
        public string TextValue { get; set; } = "";
    }
}