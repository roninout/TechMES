    /// 2500 mm
    /// </summary>
    private static string GetInputNumberFormat(TankInputEditor input)
    {
        return string.IsNullOrWhiteSpace(input.Parameter.Unit)
            ? "0.###"
            : $"0.### {input.Parameter.Unit}";
    }

