    /// <summary>
    /// Единица измерения отображается непосредственно в поле,
    /// как во вкладке PLC.
    ///
    /// Например:
    /// 2500 mm
    /// </summary>
    private static string GetInputNumberFormat(TankInputEditor input)
    {
        return string.IsNullOrWhiteSpace(input.Parameter.Unit)
            ? "0.###"
            : $"0.### {input.Parameter.Unit}";
    }

    private static string GetSwitchStateText(bool value)
    {
        return value ? "on" : "off";
    }

    private static string GetSwitchStateClass(bool value)
    {
        return value ? "is-on" : "is-off";
    }

