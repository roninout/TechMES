@using System.Text.Json
@using TechMES.Contracts.Equipment
@using System.Globalization
@inject DialogService DialogService
@inject CalcApiClient CalcApi
@inject ParamApiClient ParamApi
@inject NotificationService NotificationService

<div class="tank-configuration-host">

    @if (_isLoadingDefinitions || _isResolvingLevelTag)
    {
        @* ============================================================
           Новый Tank ещё подготавливается.

           Промежуточные данные не показываем:
           Definition, Level.R и Input должны быть полностью готовы
           до отображения новой конфигурации.
           ============================================================ *@
        <div class="tank-configuration-loading">

            <TechMesLoadingBar Label="Loading Tank configuration" />

            <div class="tank-configuration-loading-content">

                <RadzenIcon Icon="hourglass_top"
                            class="tank-configuration-loading-icon" />

                <div class="tank-configuration-loading-title">
                    Loading Tank configuration...
                </div>

                <div class="tank-configuration-loading-model">
                    @Model.Name
                </div>

            </div>

        </div>
    }
    else
    {
        @* ============================================================
           Полная конфигурация отображается только после того,
           как все необходимые данные нового Tank готовы.
           ============================================================ *@
        <div class="tank-configuration">

        <!-- ============================================================
         LEFT
         Tank geometry + Tank Type
         ============================================================ -->
        <div class="tank-preview-column">

            <!-- ============================================================
             Общая панель Tank

             В одну рамку входят:
             - Tank type
             - Job warning
             - Enabled
             - SCADA write warning
             - интерактивная схема
             - Calculate above 100%
             ============================================================ -->
            <div class="tank-preview-panel">

                <!-- ========================================================
                 Верхняя строка

                 Tank type | Job state warning | Enabled
                 ======================================================== -->
                <div class="tank-preview-toolbar">

                    <div class="tank-preview-toolbar-type">

                        <label class="tank-field-label">
                            Tank type
                        </label>

                        <RadzenDropDown TValue="string"
                                        Data="@_tankDefinitions"
                                        TextProperty="@nameof(CalcDefinitionDto.Name)"
                                        ValueProperty="@nameof(CalcDefinitionDto.Code)"
                                        Value="@_selectedDefinitionCode"
                                        Change="@OnTankTypeChanged"
                                        Disabled="@_isSaving"
                                        Style="width:100%;" />

                    </div>


                        <div class="tank-preview-toolbar-status">

                            @if (HasUnsavedChanges)
                            {
                                <RadzenAlert AlertStyle="AlertStyle.Warning"
                                             Variant="Variant.Flat"
                                             Shade="Shade.Lighter"
                                             AllowClose="false"
                                             ShowIcon="true"
                                             class="tank-toolbar-alert">

                                    Unsaved changes. Runtime continues using the last saved configuration.

                                </RadzenAlert>
                            }
                            else if (Job is null)
                            {
                                <RadzenAlert AlertStyle="AlertStyle.Warning"
                                             Variant="Variant.Flat"
                                             Shade="Shade.Lighter"
                                             AllowClose="false"
                                             ShowIcon="true"
                                             class="tank-toolbar-alert">

                                    Job is not configured. Calculation is not running.

                                </RadzenAlert>
                            }
                            else if (!Job.Enabled)
                            {
                                <RadzenAlert AlertStyle="AlertStyle.Warning"
                                             Variant="Variant.Flat"
                                             Shade="Shade.Lighter"
                                             AllowClose="false"
                                             ShowIcon="true"
                                             class="tank-toolbar-alert">

                                    Job is disabled. Calculation is not running.

                                </RadzenAlert>
                            }

                        </div>


                    <div class="tank-preview-toolbar-enabled">

                        <span class="tank-switch-state @GetSwitchStateClass(_enabled)">
                            @GetSwitchStateText(_enabled)
                        </span>

                        <RadzenSwitch @bind-Value="_enabled"
                                      Disabled="@(_isSaving || !IsLevelTankReady || !IsSensorGeometryValid)" />

                        <span class="tank-switch-label">
                            Enabled
                        </span>

                    </div>

                </div>


                <!-- ========================================================
                 Разделитель toolbar / Tank
                 ======================================================== -->
                <div class="tank-preview-panel-separator"></div>

                    <!-- ========================================================
                     Tank calculation help
                     ======================================================== -->
                    <div class="tank-preview-help-row">
                        <RadzenButton Icon="info"
                                      ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.Small"
                                      Disabled="@(_isOpeningHelp || SelectedDefinition is null)"
                                      title="Calculation help"
                                      Click="@OpenTankHelpAsync" />
                    </div>


                <!-- ========================================================
                 SCADA output warning

                 Job может быть Enabled и выполнять расчёт,
                 но запись результатов в SCADA отключена.
                 ======================================================== -->
                    @if (Job?.Enabled == true && Job.WriteEnabled != true)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger"
                                     Variant="Variant.Flat"
                                     Shade="Shade.Lighter"
                                     AllowClose="false"
                                     ShowIcon="true"
                                     class="tank-write-alert">

                            SCADA output writing is disabled in the saved Job configuration.

                        </RadzenAlert>
                    }


                <!-- ========================================================
                 Интерактивная схема Tank
                 ======================================================== -->
                <div class="tank-preview-panel-content">

                        @if (SelectedTypeNumber == 1)
                        {
                            <TankType1InteractivePreview DimA="@CurrentDimA"
                                                         DimB="@CurrentDimB"
                                                         DimC="@CurrentDimC"
                                                         UpperDeadArea="@CurrentUpperDeadArea"
                                                         LowerDeadArea="@CurrentLowerDeadArea"
                                                         CalculateAbove100="@CurrentCalculateAbove100"
                                                         LevelPercent="@CurrentLevelPercent"
                                                         Disabled="@_isSaving"
                                                         DimAChanged="@((double value) => SetInputNumber("dimA", value))"
                                                         DimBChanged="@((double value) => SetInputNumber("dimB", value))"
                                                         DimCChanged="@((double value) => SetInputNumber("dimC", value))"
                                                         UpperDeadAreaChanged="@((double value) => SetInputNumber("upperDeadArea", value))"
                                                         LowerDeadAreaChanged="@((double value) => SetInputNumber("lowerDeadArea", value))" />
                        }
                        else if (SelectedTypeNumber == 2)
                        {
                            <TankType2InteractivePreview DimA="@CurrentDimA"
                                                         DimB="@CurrentDimB"
                                                         DimC="@CurrentDimC"
                                                         UpperDeadArea="@CurrentUpperDeadArea"
                                                         LowerDeadArea="@CurrentLowerDeadArea"
                                                         CalculateAbove100="@CurrentCalculateAbove100"
                                                         LevelPercent="@CurrentLevelPercent"
                                                         Disabled="@_isSaving"
                                                         DimAChanged="@((double value) => SetInputNumber("dimA", value))"
                                                         DimBChanged="@((double value) => SetInputNumber("dimB", value))"
                                                         DimCChanged="@((double value) => SetInputNumber("dimC", value))"
                                                         UpperDeadAreaChanged="@((double value) => SetInputNumber("upperDeadArea", value))"
                                                         LowerDeadAreaChanged="@((double value) => SetInputNumber("lowerDeadArea", value))" />
                        }
                        else if (SelectedTypeNumber == 3)
                        {
                            <TankType3InteractivePreview DimA="@CurrentDimA"
                                                         DimB="@CurrentDimB"
                                                         DimC="@CurrentDimC"
                                                         DimD="@CurrentDimD"
                                                         UpperDeadArea="@CurrentUpperDeadArea"
                                                         LowerDeadArea="@CurrentLowerDeadArea"
                                                         CalculateAbove100="@CurrentCalculateAbove100"
                                                         LevelPercent="@CurrentLevelPercent"
                                                         Disabled="@_isSaving"
                                                         DimAChanged="@((double value) => SetInputNumber("dimA", value))"
                                                         DimBChanged="@((double value) => SetInputNumber("dimB", value))"
                                                         DimCChanged="@((double value) => SetInputNumber("dimC", value))"
                                                         DimDChanged="@((double value) => SetInputNumber("dimD", value))"
                                                         UpperDeadAreaChanged="@((double value) => SetInputNumber("upperDeadArea", value))"
                                                         LowerDeadAreaChanged="@((double value) => SetInputNumber("lowerDeadArea", value))" />
                        }
                        else if (SelectedTypeNumber == 4)
                        {
                            <TankType4InteractivePreview DimA="@CurrentDimA"
                                                         DimB="@CurrentDimB"
                                                         DimC="@CurrentDimC"
                                                         UpperDeadArea="@CurrentUpperDeadArea"
                                                         LowerDeadArea="@CurrentLowerDeadArea"
                                                         CalculateAbove100="@CurrentCalculateAbove100"
                                                         LevelPercent="@CurrentLevelPercent"
                                                         Disabled="@_isSaving"
                                                         DimAChanged="@((double value) => SetInputNumber("dimA", value))"
                                                         DimBChanged="@((double value) => SetInputNumber("dimB", value))"
                                                         DimCChanged="@((double value) => SetInputNumber("dimC", value))"
                                                         UpperDeadAreaChanged="@((double value) => SetInputNumber("upperDeadArea", value))"
                                                         LowerDeadAreaChanged="@((double value) => SetInputNumber("lowerDeadArea", value))" />
                        }
                        else if (SelectedTypeNumber == 5)
                        {
                            <TankType5InteractivePreview DimA="@CurrentDimA"
                                                         DimB="@CurrentDimB"
                                                         DimC="@CurrentDimC"
                                                         DimD="@CurrentDimD"
                                                         DimE="@CurrentDimE"
                                                         DimF="@CurrentDimF"
                                                         UpperDeadArea="@CurrentUpperDeadArea"
                                                         LowerDeadArea="@CurrentLowerDeadArea"
                                                         CalculateAbove100="@CurrentCalculateAbove100"
                                                         LevelPercent="@CurrentLevelPercent"
                                                         Disabled="@_isSaving"
                                                         DimAChanged="@((double value) => SetInputNumber("dimA", value))"
                                                         DimBChanged="@((double value) => SetInputNumber("dimB", value))"
                                                         DimCChanged="@((double value) => SetInputNumber("dimC", value))"
                                                         DimDChanged="@((double value) => SetInputNumber("dimD", value))"
                                                         DimEChanged="@((double value) => SetInputNumber("dimE", value))"
                                                         DimFChanged="@((double value) => SetInputNumber("dimF", value))"
                                                         UpperDeadAreaChanged="@((double value) => SetInputNumber("upperDeadArea", value))"
                                                         LowerDeadAreaChanged="@((double value) => SetInputNumber("lowerDeadArea", value))" />
                        }
                        else if (SelectedTypeNumber == 6)
                        {
                            <TankType6InteractivePreview DimA="@CurrentDimA"
                                                         DimB="@CurrentDimB"
                                                         DimC="@CurrentDimC"
                                                         UpperDeadArea="@CurrentUpperDeadArea"
                                                         LowerDeadArea="@CurrentLowerDeadArea"
                                                         CalculateAbove100="@CurrentCalculateAbove100"
                                                         LevelPercent="@CurrentLevelPercent"
                                                         Disabled="@_isSaving"
                                                         DimAChanged="@((double value) => SetInputNumber("dimA", value))"
                                                         DimBChanged="@((double value) => SetInputNumber("dimB", value))"
                                                         DimCChanged="@((double value) => SetInputNumber("dimC", value))"
                                                         UpperDeadAreaChanged="@((double value) => SetInputNumber("upperDeadArea", value))"
                                                         LowerDeadAreaChanged="@((double value) => SetInputNumber("lowerDeadArea", value))" />
                        }
                        else if (SelectedTypeNumber == 7)
                        {
                            <TankType7InteractivePreview DimA="@CurrentDimA"
                                                         DimB="@CurrentDimB"
                                                         DimC="@CurrentDimC"
                                                         DimD="@CurrentDimD"
                                                         UpperDeadArea="@CurrentUpperDeadArea"
                                                         LowerDeadArea="@CurrentLowerDeadArea"
                                                         CalculateAbove100="@CurrentCalculateAbove100"
                                                         LevelPercent="@CurrentLevelPercent"
                                                         Disabled="@_isSaving"
                                                         DimAChanged="@((double value) => SetInputNumber("dimA", value))"
                                                         DimBChanged="@((double value) => SetInputNumber("dimB", value))"
                                                         DimCChanged="@((double value) => SetInputNumber("dimC", value))"
                                                         DimDChanged="@((double value) => SetInputNumber("dimD", value))"
                                                         UpperDeadAreaChanged="@((double value) => SetInputNumber("upperDeadArea", value))"
                                                         LowerDeadAreaChanged="@((double value) => SetInputNumber("lowerDeadArea", value))" />
                        }
                        else
                        {
                            <div class="tank-preview-figure">
                                <TankTypePreview TypeNumber="@SelectedTypeNumber" />
                            </div>
                        }

                </div>


                <!-- ========================================================
                 Параметры алгоритма Tank
                 ======================================================== -->
                <div class="tank-preview-panel-footer">

                    <div class="tank-preview-option">

                        <span class="tank-switch-state @GetSwitchStateClass(CurrentCalculateAbove100)">
                            @GetSwitchStateText(CurrentCalculateAbove100)
                        </span>

                        <RadzenSwitch Value="@CurrentCalculateAbove100"
                                      Change="@((bool value) => SetInputBoolean("calculateAbove100", value))"
                                      Disabled="@_isSaving" />

                        <span class="tank-switch-label">
                            Calculate above 100%
                        </span>

                    </div>

                </div>

            </div>

        </div>

        <section class="tank-parameters-column">

         <!-- ============================================================
         VALUE
         References + calculated values
         ============================================================ -->
             <ParamAiPanel Title="Value" Icon="monitoring" InitiallyCollapsed="true">

                <div class="tank-value-panel-body">

                    <!-- Reference -->
                    <section class="tank-value-section">

                        <!-- Level -->
                        <div class="tank-value-reference-row">

                            <div class="tank-value-row-title">

                                <div class="tank-value-row-name">
                                    Level
                                </div>

                                <div class="tank-value-row-description">
                                    @ExpectedLevelName
                                </div>

                            </div>


                            <div class="tank-value-badge-cell">

                                @if (_isResolvingLevelTag)
                                {
                                    <RadzenBadge Text="RESOLVING"
                                                 BadgeStyle="BadgeStyle.Info" />
                                }
                                else if (LinkedLevel is null)
                                {
                                    <RadzenBadge Text="NOT FOUND"
                                                 BadgeStyle="BadgeStyle.Danger" />
                                }
                                else if (string.IsNullOrWhiteSpace(_levelRawTag))
                                {
                                    <RadzenBadge Text="TAG NOT FOUND"
                                                 BadgeStyle="BadgeStyle.Danger" />
                                }
                                else
                                {
                                    <RadzenBadge Text="LINKED"
                                                 BadgeStyle="BadgeStyle.Success" />
                                }

                            </div>


                            <div class="tank-value-field-cell">

                                <RadzenFormField AllowFloatingLabel="false"
                                                 Text="Level"
                                                 class="tank-value-form-field">

                                        <RadzenNumeric TValue="double?"
                                                       Value="@GetLastInputNumber("levelRaw")"
                                                       Format="0.###' %'"
                                                       Disabled="true"
                                                       ShowUpDown="false"
                                                       Style="width:100%;" />

                                </RadzenFormField>

                            </div>

                        </div>

                        <!-- Density -->
                        <div class="tank-value-reference-row">

                            <div class="tank-value-row-title">

                                <div class="tank-value-row-name">
                                    Density
                                </div>

                                <div class="tank-value-row-description">
                                    @ExpectedDensityName
                                </div>

                            </div>


                            <div class="tank-value-badge-cell">

                                @if (LinkedDensity is null)
                                {
                                    <RadzenBadge Text="NOT FOUND"
                                                 BadgeStyle="BadgeStyle.Danger" />
                                }
                                else if (string.IsNullOrWhiteSpace(DensityHmiTag))
                                {
                                    <RadzenBadge Text="TAG NOT FOUND"
                                                 BadgeStyle="BadgeStyle.Danger" />
                                }
                                else
                                {
                                    <RadzenBadge Text="LINKED"
                                                 BadgeStyle="BadgeStyle.Success" />
                                }

                            </div>


                            <div class="tank-value-field-cell">

                                <RadzenFormField AllowFloatingLabel="false"
                                                 Text="Density"
                                                 class="tank-value-form-field">

                                        <RadzenNumeric TValue="double?"
                                                       Value="@GetLastInputNumber("densityHmi")"
                                                       Format="0.### kg/m³"
                                                       Disabled="true"
                                                       ShowUpDown="false"
                                                       Style="width:100%;" />

                                </RadzenFormField>

                            </div>

                        </div>

                    </section>


                    <div class="tank-value-separator"></div>


                    @if (!IsLevelTankReady)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Warning"
                                     AllowClose="false"
                                     ShowIcon="true"
                                     class="tank-warning">

                            Level.R and Density HMI must be linked before this Tank Job can be enabled.

                            @if (!string.IsNullOrWhiteSpace(_levelTagError))
                            {
                                <span>
                                    @_levelTagError
                                </span>
                            }

                        </RadzenAlert>
                    }


                    @if (!IsOutputBindingReady)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger"
                                     AllowClose="false"
                                     ShowIcon="true"
                                     class="tank-warning">

                            One or more Tank output tags were not found.
                            Output writes cannot be enabled.

                        </RadzenAlert>
                    }


                    <!-- Calculated values -->
                    <section class="tank-value-section">

                        <!-- H max -->
                        <div class="tank-value-output-row">

                            <div class="tank-value-row-title">

                                <div class="tank-value-row-name">
                                    H max
                                </div>

                                <div class="tank-value-row-description">
                                    Height of the measuring part
                                </div>

                            </div>


                            <div class="tank-value-field-cell">

                                <RadzenFormField AllowFloatingLabel="false"
                                                 Text="H max"
                                                 class="tank-value-form-field">

                                        <RadzenNumeric TValue="double?"
                                                       Value="@GetLastOutputNumber("hMax")"
                                                       Format="0 mm"
                                                       Disabled="true"
                                                       ShowUpDown="false"
                                                       Style="width:100%;" />

                                </RadzenFormField>

                            </div>

                        </div>

                        <!-- Level -->
                        <div class="tank-value-output-row">

                            <div class="tank-value-row-title">

                                <div class="tank-value-row-name">
                                    Level
                                </div>

                                <div class="tank-value-row-description">
                                    Measured level
                                </div>

                            </div>


                            <div class="tank-value-field-cell">

                                <RadzenFormField AllowFloatingLabel="false"
                                                 Text="Level"
                                                 class="tank-value-form-field">

                                        <RadzenNumeric TValue="double?"
                                                       Value="@GetLastOutputNumber("levelMm")"
                                                       Format="0 mm"
                                                       Disabled="true"
                                                       ShowUpDown="false"
                                                       Style="width:100%;" />

                                </RadzenFormField>

                            </div>

                        </div>

                        <!-- Volume -->
                        <div class="tank-value-output-row">

                            <div class="tank-value-row-title">

                                <div class="tank-value-row-name">
                                    Volume
                                </div>

                                <div class="tank-value-row-description">
                                    Volume calculated from the level
                                </div>

                            </div>


                            <div class="tank-value-field-cell">

                                <RadzenFormField AllowFloatingLabel="false"
                                                    Text="Volume"
                                                    class="tank-value-form-field">

                                    <RadzenNumeric TValue="double?"
                                                    Value="@GetLastOutputNumber("volume")"
                                                    Format="0.### m³"
                                                    Disabled="true"
                                                    ShowUpDown="false"
                                                    Style="width:100%;" />

                                </RadzenFormField>

                            </div>

                        </div>

                        <!-- Mass -->
                        <div class="tank-value-output-row">

                            <div class="tank-value-row-title">

                                <div class="tank-value-row-name">
                                    Mass
                                </div>

                                <div class="tank-value-row-description">
                                    Mass of liquid in the tank
                                </div>

                            </div>


                            <div class="tank-value-field-cell">

                                <RadzenFormField AllowFloatingLabel="false"
                                                 Text="Mass"
                                                 class="tank-value-form-field">

                                        <RadzenNumeric TValue="double?"
                                                       Value="@GetLastOutputNumber("mass")"
                                                       Format="0.### t"
                                                       Disabled="true"
                                                       ShowUpDown="false"
                                                       Style="width:100%;" />

                                </RadzenFormField>

                            </div>

                        </div>

                    </section>

                <!-- ========================================================
                 Разделитель calculated values / output write permission
                 ======================================================== -->
                <div class="tank-value-separator tank-value-write-separator"></div>

                <!-- ========================================================
                 Allow output writes

                 Глобальное разрешение записи рассчитанных
                 значений Tank в SCADA.
                 ======================================================== -->
                <section class="tank-value-write-section">

                    <div class="tank-value-write-text">

                        <div class="tank-value-write-title">
                            Allow output writes
                        </div>

                        <div class="tank-value-write-description">
                            Write calculated Tank values to SCADA
                        </div>

                    </div>


                    <div class="tank-value-write-switch">

                        <span class="tank-switch-state @GetSwitchStateClass(_allowOutputWrites)">
                            @GetSwitchStateText(_allowOutputWrites)
                        </span>

                        <RadzenSwitch @bind-Value="_allowOutputWrites"
                                      Disabled="@(_isSaving || (!_allowOutputWrites && (!IsLevelTankReady || !IsOutputBindingReady)))" />

                    </div>

                </section>

                </div>

            </ParamAiPanel>

            <!-- ============================================================
             SAVE
             ============================================================ -->
            <div class="tank-actions">

                @if (Job is null)
                {
                    <RadzenButton Text="Create job"
                                  Icon="add"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Disabled="@_isSaving"
                                  Click="@CreateJobAsync" />
                }
                else
                {
                        <RadzenButton Text="Save"
                                      Icon="save"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Disabled="@(_isSaving || !HasUnsavedChanges)"
                                      Click="@SaveJobAsync" />
                }

            </div>

        </section>

    </div>
    }

</div>

@code {
    [Parameter, EditorRequired]
    public CalcModelDto Model { get; set; } = default!;

    [Parameter]
    public CalcJobDto? Job { get; set; }

    [Parameter]
    public CalcJobStateDto? State { get; set; }

    [Parameter]
    public IReadOnlyList<CalcModelDto> CalcModels { get; set; } = [];

    [Parameter]
    public IReadOnlyList<EquipmentDto> EquipmentCatalog { get; set; } = [];

    [Parameter]
    public EventCallback JobChanged { get; set; }

    private readonly List<CalcDefinitionDto> _tankDefinitions = [];

    private List<TankInputEditor> _inputs = [];

    private string? _selectedDefinitionCode;
    private string _contextKey = "";
    private string _loadError = "";

    private string? _resolvedLevelEquipmentName;
    private string? _levelRawTag;
    private string _levelTagError = "";

    private IReadOnlyList<EquipmentDto>? _resolvedEquipmentCatalogReference;

    private bool _isLoadingDefinitions;
    private bool _isResolvingLevelTag;
    private bool _isSaving;
    private bool _isOpeningHelp;

    private bool _enabled;
    private bool _allowOutputWrites;


    // ============================================================
    // Unsaved changes
    // ============================================================

    // Signature состояния, которое сейчас реально сохранено в Job.
    //
    // UI сравнивает с ним текущее состояние редактора.
    // Поэтому отдельные SetDirty() во всех обработчиках не нужны.
    private string _savedEditorSignature = "";

    // Есть ли изменения, которые Runtime ещё не получил.
    private bool HasUnsavedChanges => !string.Equals(_savedEditorSignature, BuildEditorSignature(), StringComparison.Ordinal);

    // Родительская страница использует это свойство перед переключением на другой Calculation model.
    public bool HasPendingChanges => HasUnsavedChanges;

    // ============================================================
    // Editor state signature
    // ============================================================
    private string BuildEditorSignature()
    {
        var parts = new List<string> {
            $"definition={_selectedDefinitionCode ?? ""}",
            $"enabled={_enabled}",
            $"writes={_allowOutputWrites}"};

        foreach (var input in _inputs
            .Where(input => !IsLinkedInput(input.Parameter.Key))
            .OrderBy(input => input.Parameter.Order)
            .ThenBy(input => input.Parameter.Key, StringComparer.OrdinalIgnoreCase))
        {
            if (input.Parameter.Type == CalcParameterTypeDto.Boolean)
            {
                parts.Add($"{input.Parameter.Key}=bool:{input.BooleanValue}");
                continue;
            }

            parts.Add($"{input.Parameter.Key}=number:" + input.NumberValue.ToString("R", CultureInfo.InvariantCulture));
        }

        return string.Join("|", parts);
    }

    private void CaptureSavedEditorState()
    {
        _savedEditorSignature = BuildEditorSignature();
    }

    // Множитель формата SCADA для Volume и Mass.
    //
    // Повторяет логику старого TechCalc:
    //
    // dimB >= 2000 mm -> x100
    // dimB <  2000 mm -> x1000
    //
    // В отличие от старого TechCalc результат не приводится к short.
    private double TankWriteScale => ResolveTankWriteScale(GetInputNumber("dimB"));

    // ============================================================
    // Числовые runtime values для disabled RadzenNumeric.
    //
    // В отличие от старых Format... методов здесь возвращается
    // настоящее число. Это позволяет использовать одинаковый
    // визуальный стиль RadzenNumeric для всех read-only значений.
    // ============================================================

    private double? GetLastInputNumber(string key)
    {
        return TryGetRuntimeNumber(State?.LastInputs, key, out var value)
            ? value
            : null;
    }

    private double? GetLastOutputNumber(string key)
    {
        return TryGetRuntimeNumber(State?.LastOutputs, key, out var value)
            ? value
            : null;
    }

    private CalcDefinitionDto? SelectedDefinition =>
        _tankDefinitions.FirstOrDefault(definition =>
            string.Equals(definition.Code, _selectedDefinitionCode, StringComparison.OrdinalIgnoreCase));

    private int SelectedTypeNumber => GetTypeNumber(_selectedDefinitionCode);


    /// <summary>
    /// S02.R02.LC01.Tank -> S02.R02.LC01
    /// </summary>
    private string TankRoot
    {
        get
        {
            var name = (Model.Name ?? "").Trim();

            return name.EndsWith(".Tank", StringComparison.OrdinalIgnoreCase)
                ? name[..^5]
                : name;
        }
    }

    private string ExpectedLevelName => TankRoot;

    private string ExpectedDensityName => TankRoot + ".Density";


    private EquipmentDto? LinkedLevel =>
        EquipmentCatalog.FirstOrDefault(item =>
            !item.IsGroup
            && !item.IsEquipmentChildNode
            && item.TypeGroup == EquipmentTypeGroup.AI
            && string.Equals(item.Name, ExpectedLevelName, StringComparison.OrdinalIgnoreCase));


    private CalcModelDto? LinkedDensity =>
        CalcModels.FirstOrDefault(item =>
            item.Type == CalcModelTypeDto.Density
            && string.Equals(item.Name, ExpectedDensityName, StringComparison.OrdinalIgnoreCase));


    /// <summary>
    /// Реальный Density HMI tag уже содержится в Calc Catalog.
    /// Сначала пробуем наиболее специфичный suffix,
    /// затем обычный *_HMI.
    /// </summary>
    private string? DensityHmiTag =>
        FindTag(LinkedDensity?.TagNames, "_DENS_HMI", "_HMI");

    private bool IsLevelTankReady => LinkedLevel is not null && LinkedDensity is not null && !string.IsNullOrWhiteSpace(_levelRawTag) && !string.IsNullOrWhiteSpace(DensityHmiTag);

    private IReadOnlyList<TankInputEditor> EditableInputs => _inputs
            .Where(input => !IsLinkedInput(input.Parameter.Key))
            .OrderBy(input => input.Parameter.Order)
            .ToList();

    private double CurrentTotalLengthMm => SelectedTypeNumber switch
    {
        1 => GetInputNumber("dimA") + GetInputNumber("dimC") * 2.0,
        2 => GetInputNumber("dimB"),
        3 => GetInputNumber("dimA") + GetInputNumber("dimC"),
        4 => GetInputNumber("dimA"),
        5 => GetInputNumber("dimA") + GetInputNumber("dimC"),
        6 => GetInputNumber("dimA") + GetInputNumber("dimC") * 2.0,
        7 => GetInputNumber("dimB"),
        8 => GetInputNumber("dimA") + GetInputNumber("dimC"),
        _ => 0.0
    };

    private double CurrentMeasurementAreaMm => Math.Max(0.0, CurrentTotalLengthMm - GetInputNumber("upperDeadArea") - GetInputNumber("lowerDeadArea"));

    private double CurrentDimA => GetInputNumber("dimA");
    private double CurrentDimB => GetInputNumber("dimB");
    private double CurrentDimC => GetInputNumber("dimC");
    private double CurrentDimD => GetInputNumber("dimD");
    private double CurrentDimE => GetInputNumber("dimE");
    private double CurrentDimF => GetInputNumber("dimF");

    private double CurrentUpperDeadArea => GetInputNumber("upperDeadArea");
    private double CurrentLowerDeadArea => GetInputNumber("lowerDeadArea");
    private bool CurrentCalculateAbove100 => GetInputBoolean("calculateAbove100");

    private double? CurrentLevelPercent => TryGetRuntimeNumber(State?.LastInputs, "levelRaw", out var value) ? value : null;

    // Проверяем не только рабочую высоту датчика, но и ограничения геометрических параметров, объявленные непосредственно выбранным алгоритмом.
    // Благодаря этому WEB не дублирует правила вроде "dimB должен быть больше нуля" для каждого Tank Type.
    private bool AreEditorValuesWithinDefinitionRanges => _inputs
            .Where(input => !IsLinkedInput(input.Parameter.Key) && input.Parameter.Type == CalcParameterTypeDto.Number)
            .All(input => (!input.Parameter.Minimum.HasValue || input.NumberValue >= input.Parameter.Minimum.Value) && (!input.Parameter.Maximum.HasValue || input.NumberValue <= input.Parameter.Maximum.Value));

    // Кроме обычных Min/Max отдельные Tank Type имеют
    // ограничения между несколькими геометрическими размерами.
    //
    // Type 3:
    // перегородка должна находиться внутри Tank.
    //
    // Type 5:
    // трубный пучок должен полностью помещаться
    // внутри цилиндрической части;
    // объём труб не может превышать геометрический
    // объём области трубного пучка.
    private bool IsTypeSpecificGeometryValid => SelectedTypeNumber switch
    {
        3 => GetInputNumber("dimD") > 0.0 && GetInputNumber("dimD") <= GetInputNumber("dimB"),
        5 => IsType5GeometryValid(),

        // Type 7:
        // dimD является диаметром малого основания
        // конического торца.
        //
        // 0      -> настоящий конус с вершиной;
        // dimB   -> торец превращается в цилиндр;
        // > dimB -> физически невозможная геометрия.
        7 => GetInputNumber("dimD") >= 0.0 && GetInputNumber("dimD") <= GetInputNumber("dimB"),

        _ => true
    };

    private bool IsType5GeometryValid()
    {
        var dimA = GetInputNumber("dimA");
        var dimB = GetInputNumber("dimB");
        var dimD = GetInputNumber("dimD");
        var dimE = GetInputNumber("dimE");
        var dimF = GetInputNumber("dimF");

        if (dimA <= 0 || dimB <= 0 || dimD <= 0 || dimE < 0 || dimF < 0 || dimD + dimE > dimA)
            return false;

        var radiusM = dimB * 0.001 / 2.0;
        var bundleHeightM = dimD * 0.001;
        var tubeVolumeM3 = dimF * 0.001;
        var grossBundleRegionVolumeM3 = Math.PI * radiusM * radiusM * bundleHeightM;

        return tubeVolumeM3 <= grossBundleRegionVolumeM3;
    }

    private bool IsSensorGeometryValid => CurrentTotalLengthMm > 0 && CurrentMeasurementAreaMm > 0 && AreEditorValuesWithinDefinitionRanges && IsTypeSpecificGeometryValid;

    private TankInputEditor? FindInputEditor(string key)
    {
        return _inputs.FirstOrDefault(input =>
            string.Equals(input.Parameter.Key, key, StringComparison.OrdinalIgnoreCase));
    }

    private IReadOnlyList<TankOutputRow> OutputRows =>
        SelectedDefinition?.Outputs
            .OrderBy(output => output.Order)
            .Select(output => new TankOutputRow(
                output.Key,
                output.Name,
                output.Unit ?? "",
                ResolveTankOutputTag(output.Key)))
            .ToList()
        ?? [];

    private bool IsOutputBindingReady =>
        OutputRows.Count > 0
        && OutputRows.All(output => !string.IsNullOrWhiteSpace(output.TagName));

    protected override async Task OnInitializedAsync()
    {
        await LoadDefinitionsAsync();
        await ResolveLinkedLevelTagAsync();
        SynchronizeSelection(force: true);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_tankDefinitions.Count == 0)
            return;

        await ResolveLinkedLevelTagAsync();

        SynchronizeSelection();
    }

    /// <summary>
    /// Загружает встроенные Tank algorithms.
    /// </summary>
    private async Task LoadDefinitionsAsync()
    {
        _isLoadingDefinitions = true;
        _loadError = "";

        try
        {
            var definitions = await CalcApi.GetDefinitionsAsync();

            _tankDefinitions.Clear();
            _tankDefinitions.AddRange(
                definitions
                    .Where(definition =>
                        string.Equals(definition.Category, "Tanks", StringComparison.OrdinalIgnoreCase)
                        && definition.Code.StartsWith("tank.volume.type", StringComparison.OrdinalIgnoreCase))
                    .OrderBy(definition => GetTypeNumber(definition.Code)));

            if (_tankDefinitions.Count == 0)
                _loadError = "No Tank calculation algorithms are available in Runtime.";
        }
        catch (Exception ex)
        {
            _loadError = "Cannot load Tank algorithms: " + ex.Message;
        }
        finally
        {
            _isLoadingDefinitions = false;
        }
    }


    /// <summary>
    /// Level model уже находится в Runtime Equipment Catalog.
    ///
    /// Для выполнения Calculation Job нужен именно реальный SCADA tag
    /// его item R. Используем уже существующий Param API.
    ///
    /// Никакого нового Equipment/CtApi discovery здесь нет.
    /// </summary>
    private async Task ResolveLinkedLevelTagAsync()
    {
        var level = LinkedLevel;

        if (level is null)
        {
            _resolvedLevelEquipmentName = null;
            _resolvedEquipmentCatalogReference = EquipmentCatalog;
            _levelRawTag = null;
            _levelTagError = "";
            return;
        }

        if (string.Equals(_resolvedLevelEquipmentName, level.Name, StringComparison.OrdinalIgnoreCase)
            && ReferenceEquals(_resolvedEquipmentCatalogReference, EquipmentCatalog))
        {
            return;
        }

        _resolvedLevelEquipmentName = level.Name;
        _resolvedEquipmentCatalogReference = EquipmentCatalog;
        _levelRawTag = null;
        _levelTagError = "";
        _isResolvingLevelTag = true;

        try
        {
            var snapshot = await ParamApi.GetSnapshotAsync(level.Name);

            if (!snapshot.Supported)
            {
                _levelTagError = snapshot.Message ?? $"Param snapshot is not available for {level.Name}.";
                return;
            }

            var item = snapshot.Items.FirstOrDefault(item =>
                string.Equals(item.Name, "R", StringComparison.OrdinalIgnoreCase));

            _levelRawTag = NullIfEmpty(item?.TagName);

            if (string.IsNullOrWhiteSpace(_levelRawTag))
                _levelTagError = $"R tag was not resolved for {level.Name}.";
        }
        catch (Exception ex)
        {
            _levelTagError = ex.Message;
            _levelRawTag = null;
        }
        finally
        {
            _isResolvingLevelTag = false;
        }
    }


    /// <summary>
    /// Восстанавливает выбранный Tank Type, constants и Job options.
    /// </summary>
    private void SynchronizeSelection(bool force = false)
    {
        var tankTagSignature = string.Join("|", Model.TagNames.OrderBy(tag => tag, StringComparer.OrdinalIgnoreCase));
        var densityTagSignature = LinkedDensity is null
            ? ""
            : string.Join("|", LinkedDensity.TagNames.OrderBy(tag => tag, StringComparer.OrdinalIgnoreCase));

        var newContextKey = $"{Model.Name}|{Job?.Id}|{Job?.Revision}|{_levelRawTag}|{DensityHmiTag}|{tankTagSignature}|{densityTagSignature}";

        if (!force && string.Equals(_contextKey, newContextKey, StringComparison.Ordinal))
            return;

        _contextKey = newContextKey;

        if (Job is not null && _tankDefinitions.Any(definition => string.Equals(definition.Code, Job.DefinitionCode, StringComparison.OrdinalIgnoreCase)))
        {
            _selectedDefinitionCode = Job.DefinitionCode;
            BuildInputEditors(SelectedDefinition, Job);
        }
        else
        {
            _selectedDefinitionCode = _tankDefinitions.FirstOrDefault()?.Code;
            BuildInputEditors(SelectedDefinition, null);
        }

        _enabled = Job?.Enabled == true && IsLevelTankReady && IsSensorGeometryValid;
        _allowOutputWrites = Job?.WriteEnabled == true && IsLevelTankReady && IsOutputBindingReady;

        // Всё, что сейчас загрузили в редактор, является последней сохранённой конфигурацией.
        CaptureSavedEditorState();
    }

    /// <summary>
    /// Переключает Tank Type.
    ///
    /// Если текущая конфигурация уже была изменена, сначала спрашиваем разрешение отбросить эти изменения.
    /// Само переключение Type является новым изменением и после него пользователь должен нажать Save.
    /// </summary>
    private async Task OnTankTypeChanged(object? value)
    {
        var definition = FindDefinition(value?.ToString());

        if (definition is null)
            return;

        if (string.Equals(_selectedDefinitionCode, definition.Code, StringComparison.OrdinalIgnoreCase))
            return;

        if (HasUnsavedChanges)
        {
            var confirmed = await DialogService.Confirm("The current Tank configuration contains unsaved changes. Discard them and change Tank type?", "Unsaved changes",
                new ConfirmOptions
                {
                    OkButtonText = "Discard",
                    CancelButtonText = "Stay"
                });

            if (confirmed != true)
            {
                StateHasChanged();
                return;
            }
        }

        _selectedDefinitionCode = definition.Code;

        // После смены физической модели Tank старый активный Job
        // не должен продолжать работать или писать в SCADA.
        _enabled = false;
        _allowOutputWrites = false;

        var storedJob = Job is not null && string.Equals(Job.DefinitionCode, definition.Code, StringComparison.OrdinalIgnoreCase) ? Job : null;

        BuildInputEditors(definition, storedJob);
    }


    /// <summary>
    /// Создаёт редакторы Job constants.
    ///
    /// levelRaw/densityHmi тоже остаются в definition,
    /// но в UI они не показываются: для них bindings создаются автоматически.
    /// </summary>
    private void BuildInputEditors(CalcDefinitionDto? definition, CalcJobDto? job)
    {
        if (definition is null)
        {
            _inputs = [];
            return;
        }

        _inputs = definition.Parameters.OrderBy(parameter => parameter.Order).Select(parameter =>
            {
                var stored = job?.Inputs.FirstOrDefault(input =>
                    string.Equals(input.ParameterKey, parameter.Key, StringComparison.OrdinalIgnoreCase));

                return CreateInputEditor(parameter, stored);
            })
            .ToList();
    }


    private static TankInputEditor CreateInputEditor(CalcParameterDefinitionDto parameter, CalcJobInputDto? stored)
    {
        JsonElement? value = null;

        if (stored?.SourceType == CalcInputSourceTypeDto.Constant)
            value = stored.ConstantValue;

        value ??= parameter.DefaultValue;

        return new TankInputEditor
        {
            Parameter = parameter,
            NumberValue = ReadNumber(value),
            BooleanValue = ReadBoolean(value)
        };
    }

    private static bool ReadBoolean(JsonElement? value)
    {
        if (!value.HasValue)
            return false;

        return value.Value.ValueKind switch
        {
            JsonValueKind.True => true,
            JsonValueKind.False => false,
            JsonValueKind.Number when value.Value.TryGetInt32(out var number) => number != 0,
            JsonValueKind.String when bool.TryParse(value.Value.GetString(), out var boolean) => boolean,
            _ => false
        };
    }


    private void OnNumberValueChanged(TankInputEditor input, double value)
    {
        input.NumberValue = value;
    }

    /// <summary>
    /// Новый Tank Job.
    /// </summary>
    private async Task CreateJobAsync()
    {
        var definition = SelectedDefinition;

        if (definition is null)
            return;

        _isSaving = true;

        try
        {
            var allowWrites = _allowOutputWrites && IsLevelTankReady && IsOutputBindingReady;

            var request = new CalcJobSaveRequest
            {
                EquipmentName = Model.Name,
                Name = $"{Model.Name} Tank volume",
                Description = Model.Description,
                DefinitionCode = definition.Code,
                DefinitionVersion = definition.Version,
                Enabled = _enabled && IsLevelTankReady && IsSensorGeometryValid,
                PeriodMs = 5000,
                WriteEnabled = allowWrites,
                SortOrder = 0,
                ExpectedRevision = null,
                Inputs = BuildTankInputs(definition),
                Outputs = BuildTankOutputs(definition, allowWrites)
            };

            await CalcApi.CreateJobAsync(request);

            CaptureSavedEditorState();
            NotificationService.Notify(NotificationSeverity.Success, "Calculations", $"Tank Job created for {Model.Name}.", 4000);

            await JobChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Calculations", ex.Message, 6000);
        }
        finally
        {
            _isSaving = false;
        }
    }


    /// <summary>
    /// Сохраняет существующий Tank Job.
    /// </summary>
    private async Task SaveJobAsync()
    {
        var definition = SelectedDefinition;

        if (Job is null || definition is null)
            return;

        _isSaving = true;

        try
        {
            var allowWrites = _allowOutputWrites && IsLevelTankReady && IsOutputBindingReady;

            var request = new CalcJobSaveRequest
            {
                EquipmentName = Job.EquipmentName,
                Name = Job.Name,
                Description = Job.Description,
                DefinitionCode = definition.Code,
                DefinitionVersion = definition.Version,
                Enabled = _enabled && IsLevelTankReady && IsSensorGeometryValid,
                PeriodMs = Job.PeriodMs,
                WriteEnabled = allowWrites,
                SortOrder = Job.SortOrder,
                ExpectedRevision = Job.Revision,
                Inputs = BuildTankInputs(definition),
                Outputs = BuildTankOutputs(definition, allowWrites)
            };

            await CalcApi.UpdateJobAsync(Job.Id, request);

            CaptureSavedEditorState();
            NotificationService.Notify(NotificationSeverity.Success, "Calculations", $"Tank configuration saved for {Model.Name}.", 4000);

            await JobChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Calculations", ex.Message, 6000);
        }
        finally
        {
            _isSaving = false;
        }
    }


    /// <summary>
    /// Формирует окончательные inputs Tank Job.
    ///
    /// levelRaw   -> связанный Level.R tag
    /// densityHmi -> связанный Density HMI tag
    /// всё остальное -> ConstantValue
    ///
    /// Если связанный tag пока отсутствует, binding не создаётся.
    /// Это позволяет сохранить Disabled Job и закончить привязку позже.
    /// </summary>
    private List<CalcJobInputSaveDto> BuildTankInputs(CalcDefinitionDto definition)
    {
        var result = new List<CalcJobInputSaveDto>();

        foreach (var parameter in definition.Parameters.OrderBy(parameter => parameter.Order))
        {
            if (string.Equals(parameter.Key, "levelRaw", StringComparison.OrdinalIgnoreCase))
            {
                if (!string.IsNullOrWhiteSpace(_levelRawTag))
                {
                    result.Add(new CalcJobInputSaveDto
                    {
                        ParameterKey = parameter.Key,
                        SourceType = CalcInputSourceTypeDto.Tag,
                        TagName = _levelRawTag,
                        SortOrder = parameter.Order
                    });
                }

                continue;
            }

            if (string.Equals(parameter.Key, "densityHmi", StringComparison.OrdinalIgnoreCase))
            {
                if (!string.IsNullOrWhiteSpace(DensityHmiTag))
                {
                    result.Add(new CalcJobInputSaveDto
                    {
                        ParameterKey = parameter.Key,
                        SourceType = CalcInputSourceTypeDto.Tag,
                        TagName = DensityHmiTag,
                        SortOrder = parameter.Order
                    });
                }

                continue;
            }

            var editor = _inputs.FirstOrDefault(input => string.Equals(input.Parameter.Key, parameter.Key, StringComparison.OrdinalIgnoreCase));
            object value;

            if (parameter.Type == CalcParameterTypeDto.Boolean)
                value = editor?.BooleanValue ?? ReadBoolean(parameter.DefaultValue);
            else
                value = editor?.NumberValue ?? ReadNumber(parameter.DefaultValue);

            result.Add(new CalcJobInputSaveDto
            {
                ParameterKey = parameter.Key,
                SourceType = CalcInputSourceTypeDto.Constant,
                ConstantValue = JsonSerializer.SerializeToElement(value),
                SortOrder = parameter.Order
            });
        }

        return result;
    }

    // Формирует фиксированную Tank output structure.
    //
    // H max и Level записываются в SCADA без преобразования.
    //
    // Volume и Mass перед записью преобразуются в формат SCADA
    // по правилу старого TechCalc:
    //
    // dimB >= 2000 mm -> x100
    // dimB <  2000 mm -> x1000
    //
    // Приведения результата к short нет.
    //
    // Offset для Tank не используется и всегда равен 0.
    //
    // Индивидуального Allow Write в UI нет.
    // Все Output.WriteEnabled получают одно глобальное значение
    // Allow output writes.
    private List<CalcJobOutputSaveDto> BuildTankOutputs(CalcDefinitionDto definition, bool allowWrites)
    {
        var writeScale = TankWriteScale;

        return definition.Outputs.OrderBy(output => output.Order).Select(output =>
            {
                var scale = output.Key.ToLowerInvariant() switch
                {
                    "volume" => writeScale,
                    "mass" => writeScale,
                    _ => 1.0
                };

                return new CalcJobOutputSaveDto
                {
                    OutputKey = output.Key,
                    TagName = ResolveTankOutputTag(output.Key),
                    WriteEnabled = allowWrites,

                    // Scale остаётся частью универсального Calc binding, но для Tank пользователь его не задаёт.
                    Scale = scale,

                    // Tank не использует Offset.
                    Offset = 0.0,

                    SortOrder = output.Order
                };
            })
            .ToList();
    }

    private string? ResolveTankOutputTag(string outputKey)
    {
        return outputKey.ToLowerInvariant() switch
        {
            "hmax" => FindTag(Model.TagNames, "_H_MAX"),
            "levelmm" => FindTag(Model.TagNames, "_H_HMI"),
            "volume" => FindTag(Model.TagNames, "_V_HMI"),
            "mass" => FindTag(Model.TagNames, "_M_HMI"),
            _ => null
        };
    }

    private static string? FindTag(IEnumerable<string>? tags, params string[] suffixes)
    {
        if (tags is null)
            return null;

        var source = tags
            .Where(tag => !string.IsNullOrWhiteSpace(tag))
            .Select(tag => tag.Trim())
            .ToList();

        foreach (var suffix in suffixes)
        {
            var tag = source.FirstOrDefault(candidate =>
                candidate.EndsWith(suffix, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrWhiteSpace(tag))
                return tag;
        }

        return null;
    }

    private double GetInputNumber(string key)
    {
        return _inputs.FirstOrDefault(input =>
                string.Equals(input.Parameter.Key, key, StringComparison.OrdinalIgnoreCase))
            ?.NumberValue
            ?? 0.0;
    }

    private bool GetInputBoolean(string key)
    {
        return _inputs.FirstOrDefault(input =>
                string.Equals(input.Parameter.Key, key, StringComparison.OrdinalIgnoreCase))
            ?.BooleanValue
            ?? false;
    }

    private void SetInputNumber(string key, double value)
    {
        var input = FindInputEditor(key);

        if (input is null)
            return;

        OnNumberValueChanged(input, value);
    }

    private void SetInputBoolean(string key, bool value)
    {
        var input = FindInputEditor(key);

        if (input is null)
            return;

        input.BooleanValue = value;
    }

    // Определяет коэффициент преобразования инженерных Volume/Mass в формат SCADA.
    private static double ResolveTankWriteScale(double dimB)
    {
        return dimB >= 2000.0 ? 100.0 : 1000.0;
    }

    private static bool IsLinkedInput(string key)
    {
        return string.Equals(key, "levelRaw", StringComparison.OrdinalIgnoreCase)
            || string.Equals(key, "densityHmi", StringComparison.OrdinalIgnoreCase);
    }

    private CalcDefinitionDto? FindDefinition(string? code)
    {
        return _tankDefinitions.FirstOrDefault(definition =>
            string.Equals(definition.Code, code, StringComparison.OrdinalIgnoreCase));
    }

    private static double ReadNumber(JsonElement? value)
    {
        if (value.HasValue && value.Value.ValueKind == JsonValueKind.Number
            && value.Value.TryGetDouble(out var number) && double.IsFinite(number))
        {
            return number;
        }

        return 0.0;
    }

    private static int GetTypeNumber(string? definitionCode)
    {
        if (string.IsNullOrWhiteSpace(definitionCode))
            return 0;

        for (var type = 1; type <= 8; type++)
        {
            if (definitionCode.EndsWith($".type{type}", StringComparison.OrdinalIgnoreCase))
                return type;
        }

        return 0;
    }

    private static string? NullIfEmpty(string? value)
    {
        var normalized = (value ?? "").Trim();
        return normalized.Length == 0 ? null : normalized;
    }

    /// <summary>
    /// Безопасно читает числовое значение из LastInputs / LastOutputs.
    ///
    /// Сравнение ключей case-insensitive, потому что DTO не должен
    /// зависеть от способа сериализации Dictionary.
    /// </summary>
    private static bool TryGetRuntimeNumber(JsonElement? source, string key, out double value)
    {
        value = 0;

        if (!source.HasValue || source.Value.ValueKind != JsonValueKind.Object)
            return false;

        foreach (var property in source.Value.EnumerateObject())
        {
            if (!string.Equals(property.Name, key, StringComparison.OrdinalIgnoreCase))
                continue;

            if (property.Value.ValueKind == JsonValueKind.Number && property.Value.TryGetDouble(out value) && double.IsFinite(value))
                return true;

            return false;
        }

        return false;
    }

    private string GetInputDescription(string key)
    {
        return key.ToLowerInvariant() switch
        {
            "dima" => GetDimADescription(),
            "dimb" => GetDimBDescription(),
            "dimc" => GetDimCDescription(),
            "dimd" => GetDimDDescription(),
            "dime" => GetDimEDescription(),
            "dimf" => "Tube bundle displacement volume, l",

            "upperdeadarea" => "Unmeasured area above the working range",
            "lowerdeadarea" => "Unmeasured area below the working range",
            "calculateabove100" => "Continue volume calculation above 100% inside the upper dead area",

            _ => key
        };
    }

    private string GetDimADescription()
    {
        return SelectedTypeNumber switch
        {
            1 => "Height of cylindrical part",
            2 => "Length of cylindrical part",
            3 => "Height of cylindrical part",
            4 => "Height of tank body",
            5 => "Height of cylindrical part",
            6 => "Height of cylindrical part",
            7 => "Length of cylindrical part",
            8 => "Height to bottom head start",
            _ => "Main tank dimension"
        };
    }

    private string GetDimBDescription()
    {
        return SelectedTypeNumber switch
        {
            1 => "Tank diameter",
            2 => "Tank diameter",
            3 => "Tank diameter",
            4 => "Tank width",
            5 => "Tank diameter",
