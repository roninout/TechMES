<div class="tank-preview">

    <svg viewBox="0 0 380 350" role="img" aria-label="@($"Tank Type {TypeNumber}")">

        @switch (TypeNumber)
        {
            // ============================================================
            // TYPE 1
            // Вертикальный с двумя эллиптическими днищами
            // ============================================================
            // ============================================================
            // TYPE 1
            // Вертикальный с двумя эллиптическими днищами
            // ============================================================
            case 1:
                <g>
                    <!-- ============================================================
             Корпус сборника
             ============================================================ -->

                    <path class="tank-shape"
                          d="M120 85
                    C120 58 240 58 240 85
                    L240 235
                    C240 262 120 262 120 235 Z" />

                    <!-- Границы цилиндрической части.
             Они визуально отделяют верхнее и нижнее эллиптические днища. -->
                    <line class="tank-body-line" x1="120" y1="85" x2="240" y2="85" />
                    <line class="tank-body-line" x1="120" y1="235" x2="240" y2="235" />


                    <!-- ============================================================
             dimC
             Высота верхнего эллиптического днища
             ============================================================ -->
                    <!-- Верхняя выноска идёт до верхней точки днища -->
                    <line class="tank-guide-red" x1="72" y1="58" x2="180" y2="58" />

                    <!-- Нижняя выноска идёт до границы цилиндрической части -->
                    <line class="tank-guide-red" x1="72" y1="85" x2="120" y2="85" />

                    <!-- Размер -->
                    <line class="tank-dim" x1="72" y1="58" x2="72" y2="85" />

                    <!-- Засечки -->
                    <line class="tank-dim-cap" x1="64" y1="58" x2="80" y2="58" />
                    <line class="tank-dim-cap" x1="64" y1="85" x2="80" y2="85" />

                    <text class="tank-dim-label" x="24" y="76">dimC</text>


                    <!-- ============================================================
             dimA
             Высота цилиндрической части
             ============================================================ -->

                    <line class="tank-guide-red" x1="55" y1="85" x2="120" y2="85" />
                    <line class="tank-guide-red" x1="55" y1="235" x2="120" y2="235" />

                    <!-- Размер -->
                    <line class="tank-dim" x1="55" y1="85" x2="55" y2="235" />

                    <!-- Засечки -->
                    <line class="tank-dim-cap" x1="47" y1="85" x2="63" y2="85" />
                    <line class="tank-dim-cap" x1="47" y1="235" x2="63" y2="235" />

                    <text class="tank-dim-label" x="8" y="165">dimA</text>


                    <!-- ============================================================
             dimB
             Диаметр / ширина корпуса
             ============================================================ -->
                    <!-- Выноски начинаются от границы цилиндрической части,
             как на твоём эскизе -->
                    <line class="tank-guide-red" x1="120" y1="235" x2="120" y2="305" />
                    <line class="tank-guide-red" x1="240" y1="235" x2="240" y2="305" />

                    <!-- Размер -->
                    <line class="tank-dim" x1="120" y1="305" x2="240" y2="305" />

                    <!-- Засечки -->
                    <line class="tank-dim-cap" x1="120" y1="297" x2="120" y2="313" />
                    <line class="tank-dim-cap" x1="240" y1="297" x2="240" y2="313" />

                    <text class="tank-dim-label" x="162" y="330">dimB</text>


                    <!-- ============================================================
             measurement
             Измерительная часть справа
             ============================================================ -->
                    <!-- Верхняя выноска от верхней точки сборника -->
                    <line class="tank-guide-blue" x1="180" y1="58" x2="305" y2="58" />

                    <!-- Нижняя выноска от нижней границы цилиндрической части -->
                    <line class="tank-guide-blue" x1="240" y1="235" x2="305" y2="235" />

                    <!-- Размер -->
                    <line class="tank-measure" x1="305" y1="58" x2="305" y2="235" />

                    <!-- Засечки -->
                    <line class="tank-measure-cap" x1="297" y1="58" x2="313" y2="58" />
                    <line class="tank-measure-cap" x1="297" y1="235" x2="313" y2="235" />

                    <text class="tank-sensor-label" x="320" y="150">measurement</text>
                </g>
                break;


            // ============================================================
            // TYPE 2
            // Горизонтальный с двумя эллиптическими боковинами
            // ============================================================
            case 2:
                <g>
                    <path class="tank-shape"
                          d="M90 125
                    C55 125 55 215 90 215
                    L265 215
                    C300 215 300 125 265 125 Z" />

                    <!-- Внешний датчик -->
                    <line class="tank-sensor" x1="280" y1="140" x2="325" y2="140" />
                    <line class="tank-sensor" x1="280" y1="200" x2="325" y2="200" />
                    <line class="tank-sensor-body" x1="325" y1="140" x2="325" y2="200" />

                    <line class="tank-measure" x1="345" y1="140" x2="345" y2="200" />
                    <line class="tank-measure-cap" x1="338" y1="140" x2="352" y2="140" />
                    <line class="tank-measure-cap" x1="338" y1="200" x2="352" y2="200" />

                    <!-- dimA -->
                    <line class="tank-dim" x1="90" y1="80" x2="265" y2="80" />
                    <line class="tank-dim-cap" x1="90" y1="72" x2="90" y2="88" />
                    <line class="tank-dim-cap" x1="265" y1="72" x2="265" y2="88" />
                    <text class="tank-dim-label" x="157" y="65">dimA</text>

                    <!-- dimB -->
                    <line class="tank-dim" x1="45" y1="125" x2="45" y2="215" />
                    <line class="tank-dim-cap" x1="37" y1="125" x2="53" y2="125" />
                    <line class="tank-dim-cap" x1="37" y1="215" x2="53" y2="215" />
                    <text class="tank-dim-label" x="8" y="174">dimB</text>

                    <!-- dimC -->
                    <line class="tank-dim" x1="55" y1="255" x2="90" y2="255" />
                    <line class="tank-dim-cap" x1="55" y1="247" x2="55" y2="263" />
                    <line class="tank-dim-cap" x1="90" y1="247" x2="90" y2="263" />
                    <text class="tank-dim-label" x="54" y="280">dimC</text>
                </g>
                break;


            // ============================================================
            // TYPE 3
            // Вертикальный с перегородкой
            // ============================================================
            case 3:
                <g>
                    <path class="tank-shape"
                          d="M130 55
                    L225 55
                    L225 245
                    C225 275 130 275 130 245 Z" />

                    <!-- Перегородка -->
                    <line class="tank-internal" x1="165" y1="125" x2="165" y2="245" />
                    <line class="tank-internal" x1="165" y1="125" x2="205" y2="125" />

                    <!-- Датчик -->
                    <line class="tank-sensor" x1="225" y1="120" x2="275" y2="120" />
                    <line class="tank-sensor" x1="225" y1="235" x2="275" y2="235" />
                    <line class="tank-sensor-body" x1="275" y1="120" x2="275" y2="235" />

                    <line class="tank-measure" x1="295" y1="120" x2="295" y2="235" />
                    <line class="tank-measure-cap" x1="288" y1="120" x2="302" y2="120" />
                    <line class="tank-measure-cap" x1="288" y1="235" x2="302" y2="235" />

                    <!-- dimA -->
                    <line class="tank-dim" x1="330" y1="80" x2="330" y2="245" />
                    <line class="tank-dim-cap" x1="322" y1="80" x2="338" y2="80" />
                    <line class="tank-dim-cap" x1="322" y1="245" x2="338" y2="245" />
                    <text class="tank-dim-label" x="340" y="165">dimA</text>

                    <!-- dimB -->
                    <line class="tank-dim" x1="130" y1="310" x2="225" y2="310" />
                    <line class="tank-dim-cap" x1="130" y1="302" x2="130" y2="318" />
                    <line class="tank-dim-cap" x1="225" y1="302" x2="225" y2="318" />
                    <text class="tank-dim-label" x="160" y="334">dimB</text>

                    <!-- dimC -->
                    <line class="tank-dim" x1="250" y1="245" x2="250" y2="275" />
                    <line class="tank-dim-cap" x1="242" y1="245" x2="258" y2="245" />
                    <line class="tank-dim-cap" x1="242" y1="275" x2="258" y2="275" />
                    <text class="tank-dim-label" x="260" y="264">dimC</text>

                    <!-- dimD -->
                    <line class="tank-dim" x1="95" y1="125" x2="165" y2="125" />
                    <line class="tank-dim-cap" x1="95" y1="117" x2="95" y2="133" />
                    <line class="tank-dim-cap" x1="165" y1="117" x2="165" y2="133" />
                    <text class="tank-dim-label" x="108" y="112">dimD</text>
                </g>
                break;


            // ============================================================
            // TYPE 4
            // Параллелепипед
            // ============================================================
            case 4:
                <g>
                    <path class="tank-shape"
                          d="M105 90 L225 90 L270 60 L150 60 Z
                    M225 90 L270 60 L270 240 L225 270 Z
                    M105 90 L225 90 L225 270 L105 270 Z" />

                    <!-- Датчик -->
                    <line class="tank-sensor" x1="270" y1="105" x2="310" y2="105" />
                    <line class="tank-sensor" x1="270" y1="230" x2="310" y2="230" />
                    <line class="tank-sensor-body" x1="310" y1="105" x2="310" y2="230" />

                    <line class="tank-measure" x1="330" y1="105" x2="330" y2="230" />

                    <!-- dimA -->
                    <line class="tank-dim" x1="65" y1="90" x2="65" y2="270" />
                    <line class="tank-dim-cap" x1="57" y1="90" x2="73" y2="90" />
                    <line class="tank-dim-cap" x1="57" y1="270" x2="73" y2="270" />
                    <text class="tank-dim-label" x="18" y="185">dimA</text>

                    <!-- dimB -->
                    <line class="tank-dim" x1="105" y1="310" x2="225" y2="310" />
                    <line class="tank-dim-cap" x1="105" y1="302" x2="105" y2="318" />
                    <line class="tank-dim-cap" x1="225" y1="302" x2="225" y2="318" />
                    <text class="tank-dim-label" x="147" y="334">dimB</text>

                    <!-- dimC -->
                    <line class="tank-dim" x1="235" y1="288" x2="280" y2="253" />
                    <line class="tank-dim-cap" x1="230" y1="282" x2="240" y2="294" />
                    <line class="tank-dim-cap" x1="275" y1="247" x2="285" y2="259" />
                    <text class="tank-dim-label" x="274" y="290">dimC</text>
                </g>
                break;


            // ============================================================
            // TYPE 5
            // Куб колонны со встроенным ребойлером
            // ============================================================
            case 5:
                <g>
                    <path class="tank-shape"
                          d="M130 40
                    L225 40
                    L225 255
                    C225 285 130 285 130 255 Z" />

                    <!-- Упрощённый встроенный ребойлер -->
                    <rect class="tank-internal" x="143" y="130" width="69" height="105" />

                    @for (var x = 150; x <= 205; x += 9)
                    {
                        <line class="tank-bundle" x1="@x" y1="137" x2="@x" y2="228" />
                    }

                    <!-- Датчик -->
                    <line class="tank-sensor" x1="225" y1="95" x2="275" y2="95" />
                    <line class="tank-sensor" x1="225" y1="245" x2="275" y2="245" />
                    <line class="tank-sensor-body" x1="275" y1="95" x2="275" y2="245" />

                    <line class="tank-measure" x1="295" y1="95" x2="295" y2="245" />

                    <!-- dimA -->
                    <line class="tank-dim" x1="330" y1="40" x2="330" y2="275" />
                    <line class="tank-dim-cap" x1="322" y1="40" x2="338" y2="40" />
                    <line class="tank-dim-cap" x1="322" y1="275" x2="338" y2="275" />
                    <text class="tank-dim-label" x="340" y="160">dimA</text>

                    <!-- dimB -->
                    <line class="tank-dim" x1="130" y1="315" x2="225" y2="315" />
                    <line class="tank-dim-cap" x1="130" y1="307" x2="130" y2="323" />
                    <line class="tank-dim-cap" x1="225" y1="307" x2="225" y2="323" />
                    <text class="tank-dim-label" x="160" y="339">dimB</text>

                    <!-- dimC -->
                    <line class="tank-dim" x1="250" y1="255" x2="250" y2="285" />
                    <text class="tank-dim-label" x="260" y="275">dimC</text>

                    <!-- dimD -->
                    <line class="tank-dim" x1="105" y1="130" x2="105" y2="235" />
                    <line class="tank-dim-cap" x1="97" y1="130" x2="113" y2="130" />
                    <line class="tank-dim-cap" x1="97" y1="235" x2="113" y2="235" />
                    <text class="tank-dim-label" x="57" y="186">dimD</text>

                    <!-- dimE -->
                    <line class="tank-dim" x1="85" y1="95" x2="85" y2="130" />
                    <line class="tank-dim-cap" x1="77" y1="95" x2="93" y2="95" />
                    <line class="tank-dim-cap" x1="77" y1="130" x2="93" y2="130" />
                    <text class="tank-dim-label" x="38" y="117">dimE</text>

                    <text class="tank-dim-label tank-dimf" x="132" y="120">dimF = reboiler volume, L</text>
                </g>
                break;


            // ============================================================
            // TYPE 6
            // Вертикальный с двумя конусными днищами
            // ============================================================
            case 6:
                <g>
                    <path class="tank-shape"
                          d="M130 90
                    L155 50
                    L215 50
                    L240 90
                    L240 240
                    L215 285
                    L155 285
                    L130 240 Z" />

                    <line class="tank-sensor" x1="240" y1="105" x2="285" y2="105" />
                    <line class="tank-sensor" x1="240" y1="225" x2="285" y2="225" />
                    <line class="tank-sensor-body" x1="285" y1="105" x2="285" y2="225" />
                    <line class="tank-measure" x1="305" y1="105" x2="305" y2="225" />

                    <line class="tank-dim" x1="90" y1="90" x2="90" y2="240" />
                    <text class="tank-dim-label" x="43" y="170">dimA</text>

                    <line class="tank-dim" x1="130" y1="320" x2="240" y2="320" />
                    <text class="tank-dim-label" x="166" y="343">dimB</text>

                    <line class="tank-dim" x1="270" y1="50" x2="270" y2="90" />
                    <text class="tank-dim-label" x="280" y="74">dimC</text>
                </g>
                break;


            // ============================================================
            // TYPE 7
            // Горизонтальный с двумя конусными боковинами
            // ============================================================
            case 7:
                <g>
                    <path class="tank-shape"
                          d="M95 125
                    L55 170
                    L95 215
                    L265 215
                    L305 170
                    L265 125 Z" />

                    <line class="tank-sensor" x1="275" y1="140" x2="330" y2="140" />
                    <line class="tank-sensor" x1="275" y1="200" x2="330" y2="200" />
                    <line class="tank-sensor-body" x1="330" y1="140" x2="330" y2="200" />
                    <line class="tank-measure" x1="350" y1="140" x2="350" y2="200" />

                    <line class="tank-dim" x1="95" y1="80" x2="265" y2="80" />
                    <text class="tank-dim-label" x="162" y="65">dimA</text>

                    <line class="tank-dim" x1="30" y1="125" x2="30" y2="215" />
                    <text class="tank-dim-label" x="2" y="174">dimB</text>

                    <line class="tank-dim" x1="55" y1="255" x2="95" y2="255" />
                    <text class="tank-dim-label" x="56" y="280">dimC</text>

                    <line class="tank-dim" x1="48" y1="150" x2="48" y2="190" />
                    <text class="tank-dim-label" x="8" y="205">dimD</text>
                </g>
                break;


            // ============================================================
            // TYPE 8
            // Вертикальный с усечённым цилиндром
            // ============================================================
            case 8:
                <g>
                    <path class="tank-shape"
                          d="M130 45
                    L225 45
                    L225 245
                    L195 285
                    L150 285
                    L130 245 Z" />

                    <!-- Внутренняя секция -->
                    <rect class="tank-internal" x="145" y="135" width="65" height="95" />

                    <line class="tank-sensor" x1="225" y1="100" x2="275" y2="100" />
                    <line class="tank-sensor" x1="225" y1="235" x2="275" y2="235" />
                    <line class="tank-sensor-body" x1="275" y1="100" x2="275" y2="235" />
                    <line class="tank-measure" x1="295" y1="100" x2="295" y2="235" />

                    <line class="tank-dim" x1="330" y1="45" x2="330" y2="265" />
                    <text class="tank-dim-label" x="340" y="160">dimA</text>

                    <line class="tank-dim" x1="130" y1="320" x2="225" y2="320" />
                    <text class="tank-dim-label" x="160" y="343">dimB</text>

                    <line class="tank-dim" x1="250" y1="245" x2="250" y2="285" />
                    <text class="tank-dim-label" x="260" y="270">dimC</text>

                    <line class="tank-dim" x1="105" y1="135" x2="105" y2="230" />
                    <text class="tank-dim-label" x="57" y="185">dimD</text>

                    <line class="tank-dim" x1="85" y1="100" x2="85" y2="135" />
                    <text class="tank-dim-label" x="38" y="122">dimE</text>

                    <text class="tank-dim-label tank-dimf" x="140" y="124">dimF = internal volume, L</text>
                </g>
                break;


            default:
                <g>
                    <rect class="tank-shape" x="120" y="80" width="140" height="180" rx="8" />
                    <text class="tank-empty-label" x="190" y="175" text-anchor="middle">No preview</text>
                </g>
                break;
        }

    </svg>

    <div class="tank-preview-legend">
        <span><i class="tank-legend-sensor"></i> Sensor / measurement</span>
        <span><i class="tank-legend-dimension"></i> Tank dimensions</span>
    </div>

</div>

@code {
    [Parameter]
    public int TypeNumber { get; set; }
}