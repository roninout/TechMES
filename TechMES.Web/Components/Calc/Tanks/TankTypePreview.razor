<div class="tank-preview">

    <svg viewBox="0 35 380 350" role="img" aria-label="@($"Tank Type {TypeNumber}")">

        @switch (TypeNumber)
        {
            // ============================================================
            // TYPE 1
            // Вертикальный с двумя эллиптическими днищами
            // ============================================================
            case 1:
                <g>
                    <!-- ============================================================
                     Корпус сборника
                     ============================================================ -->

                    <path class="tank-shape"
                          d="M120 85
                    C120 58 240 58 240 85
                    L240 235
                    C240 262 120 262 120 235 Z" />

                    <!-- Границы цилиндрической части. Они визуально отделяют верхнее и нижнее эллиптические днища. -->
                    <line class="tank-body-line" x1="120" y1="85" x2="240" y2="85" />
                    <line class="tank-body-line" x1="120" y1="235" x2="240" y2="235" />


                    <!-- ============================================================
                     dimC
                     Высота верхнего эллиптического днища
                     ============================================================ -->
                    <!-- Верхняя выноска идёт до верхней точки днища -->
                    <line class="tank-guide-red" x1="72" y1="58" x2="180" y2="58" />

                    <!-- Нижняя выноска идёт до границы цилиндрической части -->
                    <line class="tank-guide-red" x1="72" y1="85" x2="120" y2="85" />

                    <!-- Размер -->
                    <line class="tank-dim" x1="72" y1="58" x2="72" y2="85" />

                    <!-- Засечки -->
                    <line class="tank-dim-cap" x1="64" y1="58" x2="80" y2="58" />
                    <line class="tank-dim-cap" x1="64" y1="85" x2="80" y2="85" />

                    <text class="tank-dim-label" x="24" y="76">dimC</text>


                    <!-- ============================================================
                     dimA
                     Высота цилиндрической части
                     ============================================================ -->

                    <line class="tank-guide-red" x1="55" y1="85" x2="120" y2="85" />
                    <line class="tank-guide-red" x1="55" y1="235" x2="120" y2="235" />

                    <!-- Размер -->
                    <line class="tank-dim" x1="55" y1="85" x2="55" y2="235" />

                    <!-- Засечки -->
                    <line class="tank-dim-cap" x1="47" y1="85" x2="63" y2="85" />
                    <line class="tank-dim-cap" x1="47" y1="235" x2="63" y2="235" />

                    <text class="tank-dim-label" x="8" y="165">dimA</text>


                    <!-- ============================================================
                     dimB
                     Диаметр / ширина корпуса
                     ============================================================ -->
                    <!-- Выноски начинаются от границы цилиндрической части -->
                    <line class="tank-guide-red" x1="120" y1="235" x2="120" y2="305" />
                    <line class="tank-guide-red" x1="240" y1="235" x2="240" y2="305" />

                    <!-- Размер -->
                    <line class="tank-dim" x1="120" y1="305" x2="240" y2="305" />

                    <!-- Засечки -->
                    <line class="tank-dim-cap" x1="120" y1="297" x2="120" y2="313" />
                    <line class="tank-dim-cap" x1="240" y1="297" x2="240" y2="313" />

                    <text class="tank-dim-label" x="162" y="330">dimB</text>
                </g>
                break;


            // ============================================================
            // TYPE 2
            // Горизонтальный с двумя эллиптическими боковинами
            // ============================================================
            case 2:
                <g>
                    <!-- ============================================================
                     Корпус сборника
                     ============================================================ -->

                    <path class="tank-shape"
                          d="M95 125
                    C60 125 60 215 95 215
                    L265 215
                    C300 215 300 125 265 125 Z" />

                    <!-- Границы цилиндрической части. Отделяют левое и правое эллиптические днища. -->
                    <line class="tank-body-line" x1="95" y1="125" x2="95" y2="215" />
                    <line class="tank-body-line" x1="265" y1="125" x2="265" y2="215" />


                    <!-- ============================================================
                     dimA
                     Длина цилиндрической части
                     ============================================================ -->

                    <line class="tank-guide-red" x1="95" y1="125" x2="95" y2="80" />
                    <line class="tank-guide-red" x1="265" y1="125" x2="265" y2="80" />

                    <line class="tank-dim" x1="95" y1="80" x2="265" y2="80" />

                    <line class="tank-dim-cap" x1="95" y1="72" x2="95" y2="88" />
                    <line class="tank-dim-cap" x1="265" y1="72" x2="265" y2="88" />

                    <text class="tank-dim-label" x="163" y="65">dimA</text>


                    <!-- ============================================================
                     dimB
                     Диаметр сборника
                     ============================================================ -->

                    <line class="tank-guide-red" x1="95" y1="125" x2="45" y2="125" />
                    <line class="tank-guide-red" x1="95" y1="215" x2="45" y2="215" />

                    <line class="tank-dim" x1="45" y1="125" x2="45" y2="215" />

                    <line class="tank-dim-cap" x1="37" y1="125" x2="53" y2="125" />
                    <line class="tank-dim-cap" x1="37" y1="215" x2="53" y2="215" />

                    <text class="tank-dim-label" x="8" y="174">dimB</text>


                    <!-- ============================================================
                     dimC
                     Глубина эллиптического днища
                     ============================================================ -->
                    <!-- Левая крайняя точка эллиптического днища находится на x=60 -->
                    <line class="tank-guide-red" x1="60" y1="170" x2="60" y2="265" />
                    <line class="tank-guide-red" x1="95" y1="215" x2="95" y2="265" />

                    <line class="tank-dim" x1="60" y1="265" x2="95" y2="265" />

                    <line class="tank-dim-cap" x1="60" y1="257" x2="60" y2="273" />
                    <line class="tank-dim-cap" x1="95" y1="257" x2="95" y2="273" />

                    <text class="tank-dim-label" x="60" y="290">dimC</text>

                </g>
                break;


            // ============================================================
            // TYPE 3
            // Вертикальный сборник с нижним эллиптическим днищем
            // и перегородкой посредине
            // ============================================================
            case 3:
                <g>
                    <!-- Корпус -->
                    <path class="tank-shape" d="M150 95 L240 95 L240 245 C240 262 150 262 150 245 Z" />

                    <!-- Границы основной части -->
                    <line class="tank-body-line" x1="150" y1="95" x2="240" y2="95" />
                    <line class="tank-body-line" x1="150" y1="245" x2="240" y2="245" />

                    <!-- Перегородка посредине -->
                    <line class="tank-internal" x1="195" y1="128" x2="195" y2="245" />

                    <!-- ============================================================
                     dimD
                     От левой стенки до перегородки
                     ============================================================ -->
                    <line class="tank-guide-red" x1="150" y1="95" x2="150" y2="55" />
                    <line class="tank-guide-red" x1="195" y1="128" x2="195" y2="55" />

                    <line class="tank-dim" x1="150" y1="55" x2="195" y2="55" />
                    <line class="tank-dim-cap" x1="150" y1="47" x2="150" y2="63" />
                    <line class="tank-dim-cap" x1="195" y1="47" x2="195" y2="63" />

                    <text class="tank-dim-label" x="163" y="40">dimD</text>

                    <!-- ============================================================
                     dimA
                     Высота цилиндрической части
                     ============================================================ -->
                    <line class="tank-guide-red" x1="95" y1="95" x2="150" y2="95" />
                    <line class="tank-guide-red" x1="95" y1="245" x2="150" y2="245" />

                    <line class="tank-dim" x1="95" y1="95" x2="95" y2="245" />
                    <line class="tank-dim-cap" x1="87" y1="95" x2="103" y2="95" />
                    <line class="tank-dim-cap" x1="87" y1="245" x2="103" y2="245" />

                    <text class="tank-dim-label" x="48" y="176">dimA</text>

                    <!-- ============================================================
                     dimC
                     Высота нижнего эллиптического днища
                     ============================================================ -->
                    <line class="tank-guide-red" x1="110" y1="245" x2="150" y2="245" />
                    <line class="tank-guide-red" x1="110" y1="262" x2="165" y2="262" />

                    <line class="tank-dim" x1="110" y1="245" x2="110" y2="262" />
                    <line class="tank-dim-cap" x1="102" y1="245" x2="118" y2="245" />
                    <line class="tank-dim-cap" x1="102" y1="262" x2="118" y2="262" />

                    <text class="tank-dim-label" x="62" y="260">dimC</text>

                    <!-- ============================================================
                     dimB
                     Ширина корпуса
                     ============================================================ -->
                    <line class="tank-guide-red" x1="150" y1="245" x2="150" y2="305" />
                    <line class="tank-guide-red" x1="240" y1="245" x2="240" y2="305" />

                    <line class="tank-dim" x1="150" y1="305" x2="240" y2="305" />
                    <line class="tank-dim-cap" x1="150" y1="297" x2="150" y2="313" />
                    <line class="tank-dim-cap" x1="240" y1="297" x2="240" y2="313" />

                    <text class="tank-dim-label" x="182" y="330">dimB</text>

                </g>
                break;


            // ============================================================
            // TYPE 4
            // Прямоугольный сборник / параллелепипед
            // ============================================================
            case 4:
                <g>
                    <!-- ============================================================
                     Корпус сборника
                     ============================================================ -->
                    <!-- Передняя грань -->
                    <path class="tank-shape" d="M125 90 L225 90 L225 245 L125 245 Z" />

                    <!-- Верхняя грань -->
                    <path class="tank-shape" d="M125 90 L170 62 L270 62 L225 90 Z" />

                    <!-- Правая грань -->
                    <path class="tank-shape" d="M225 90 L270 62 L270 217 L225 245 Z" />


                    <!-- ============================================================
                     dimA
                     Высота сборника
                     ============================================================ -->

                    <line class="tank-guide-red" x1="80" y1="90" x2="125" y2="90" />
                    <line class="tank-guide-red" x1="80" y1="245" x2="125" y2="245" />

                    <line class="tank-dim" x1="80" y1="90" x2="80" y2="245" />

                    <line class="tank-dim-cap" x1="72" y1="90" x2="88" y2="90" />
                    <line class="tank-dim-cap" x1="72" y1="245" x2="88" y2="245" />

                    <text class="tank-dim-label" x="32" y="172">dimA</text>


                    <!-- ============================================================
                     dimB
                     Ширина передней грани
                     ============================================================ -->

                    <line class="tank-guide-red" x1="125" y1="245" x2="125" y2="300" />
                    <line class="tank-guide-red" x1="225" y1="245" x2="225" y2="300" />

                    <line class="tank-dim" x1="125" y1="300" x2="225" y2="300" />

                    <line class="tank-dim-cap" x1="125" y1="292" x2="125" y2="308" />
                    <line class="tank-dim-cap" x1="225" y1="292" x2="225" y2="308" />

                    <text class="tank-dim-label" x="158" y="326">dimB</text>


                    <!-- ============================================================
                     dimC
                     Глубина сборника
                     ============================================================ -->
                    <!-- Пунктирные выноски параллельны глубине корпуса -->
                    <line class="tank-guide-red" x1="225" y1="245" x2="242" y2="268" />
                    <line class="tank-guide-red" x1="270" y1="217" x2="287" y2="240" />

                    <!-- Размер dimC повторяет направление глубины -->
                    <line class="tank-dim" x1="242" y1="268" x2="287" y2="240" />

                    <!-- Засечки -->
                    <line class="tank-dim-cap" x1="236" y1="262" x2="248" y2="274" />
                    <line class="tank-dim-cap" x1="281" y1="234" x2="293" y2="246" />

                    <text class="tank-dim-label" x="274" y="278">dimC</text>

                </g>
                break;

            // ============================================================
            // TYPE 5
            // Вертикальный аппарат с одним цилиндрическим корпусом
            // и внутренним трубным пучком
            // ============================================================
            case 5:
                <g>
                    <!-- ============================================================
                     Корпус аппарата
                     Один цилиндрический корпус + нижнее эллиптическое днище
                     ============================================================ -->

                    <path class="tank-shape"
                          d="M145 55
                    L235 55
                    L235 245
                    C235 260 145 260 145 245
                    Z" />

                    <!-- Граница между верхней частью и трубным пучком -->
                    <line class="tank-body-line" x1="145" y1="110" x2="235" y2="110" />

                    <!-- Граница трубного пучка и нижнего днища -->
                    <line class="tank-body-line" x1="145" y1="245" x2="235" y2="245" />


                    <!-- ============================================================
                     Трубный пучок
                     ============================================================ -->

                    <rect class="tank-internal" x="157" y="120" width="66" height="110" />

                    @for (var x = 163; x <= 217; x += 8)
                    {
                        <line class="tank-bundle" x1="@x" y1="125" x2="@x" y2="225" />
                    }


                    <!-- ============================================================
                     dimE
                     От верха аппарата до верха трубного пучка
                     ============================================================ -->

                    <line class="tank-guide-red" x1="85" y1="55" x2="145" y2="55" />
                    <line class="tank-guide-red" x1="85" y1="120" x2="157" y2="120" />

                    <line class="tank-dim" x1="85" y1="55" x2="85" y2="120" />

                    <line class="tank-dim-cap" x1="77" y1="55" x2="93" y2="55" />
                    <line class="tank-dim-cap" x1="77" y1="120" x2="93" y2="120" />

                    <text class="tank-dim-label" x="37" y="91">dimE</text>


                    <!-- ============================================================
                     dimD
                     Размер трубного пучка
                     ============================================================ -->

                    <line class="tank-guide-red" x1="85" y1="120" x2="157" y2="120" />
                    <line class="tank-guide-red" x1="85" y1="230" x2="157" y2="230" />

                    <line class="tank-dim" x1="85" y1="120" x2="85" y2="230" />

                    <line class="tank-dim-cap" x1="77" y1="120" x2="93" y2="120" />
                    <line class="tank-dim-cap" x1="77" y1="230" x2="93" y2="230" />

                    <text class="tank-dim-label" x="37" y="180">dimD</text>


                    <!-- ============================================================
                     dimA
                     Общая высота до начала нижнего днища
                     ============================================================ -->

                    <line class="tank-guide-red" x1="235" y1="55" x2="330" y2="55" />
                    <line class="tank-guide-red" x1="235" y1="245" x2="330" y2="245" />

                    <line class="tank-dim" x1="330" y1="55" x2="330" y2="245" />

                    <line class="tank-dim-cap" x1="322" y1="55" x2="338" y2="55" />
                    <line class="tank-dim-cap" x1="322" y1="245" x2="338" y2="245" />

                    <text class="tank-dim-label" x="340" y="156">dimA</text>


                    <!-- ============================================================
                     dimC
                     Высота нижнего эллиптического днища
                     ============================================================ -->

                    <line class="tank-guide-red" x1="235" y1="245" x2="275" y2="245" />
                    <line class="tank-guide-red" x1="235" y1="260" x2="275" y2="260" />

                    <line class="tank-dim" x1="275" y1="245" x2="275" y2="260" />

                    <line class="tank-dim-cap" x1="267" y1="245" x2="283" y2="245" />
                    <line class="tank-dim-cap" x1="267" y1="260" x2="283" y2="260" />

                    <text class="tank-dim-label" x="285" y="257">dimC</text>


                    <!-- ============================================================
                     dimB
                     Диаметр / ширина корпуса
                     ============================================================ -->

                    <line class="tank-guide-red" x1="145" y1="245" x2="145" y2="305" />
                    <line class="tank-guide-red" x1="235" y1="245" x2="235" y2="305" />

                    <line class="tank-dim" x1="145" y1="305" x2="235" y2="305" />

                    <line class="tank-dim-cap" x1="145" y1="297" x2="145" y2="313" />
                    <line class="tank-dim-cap" x1="235" y1="297" x2="235" y2="313" />

                    <text class="tank-dim-label" x="176" y="330">dimB</text>
                </g>
                break;


            // ============================================================
            // TYPE 6
            // Вертикальный сборник с коническими днищами
            // По компоновке как TYPE 1, меняются только днища
            // ============================================================
            case 6:
                <g>
                    <!-- Корпус -->
                    <path class="tank-shape"
                          d="M120 85
                        L180 58
                        L240 85
                        L240 235
                        L180 262
                        L120 235
                        Z" />

                    <!-- Верхняя и нижняя линии цилиндрической части -->
                    <line class="tank-body-line" x1="120" y1="85" x2="240" y2="85" />
                    <line class="tank-body-line" x1="120" y1="235" x2="240" y2="235" />

                    <!-- ============================================================
                     dimC
                     Высота верхнего конического днища
                     ============================================================ -->
                    <line class="tank-guide-red" x1="72" y1="58" x2="180" y2="58" />
                    <line class="tank-guide-red" x1="72" y1="85" x2="120" y2="85" />

                    <line class="tank-dim" x1="72" y1="58" x2="72" y2="85" />
                    <line class="tank-dim-cap" x1="64" y1="58" x2="80" y2="58" />
                    <line class="tank-dim-cap" x1="64" y1="85" x2="80" y2="85" />

                    <text class="tank-dim-label" x="24" y="76">dimC</text>

                    <!-- ============================================================
                     dimA
                     Высота цилиндрической части
                     ============================================================ -->
                    <line class="tank-guide-red" x1="55" y1="85" x2="120" y2="85" />
                    <line class="tank-guide-red" x1="55" y1="235" x2="120" y2="235" />

                    <line class="tank-dim" x1="55" y1="85" x2="55" y2="235" />
                    <line class="tank-dim-cap" x1="47" y1="85" x2="63" y2="85" />
                    <line class="tank-dim-cap" x1="47" y1="235" x2="63" y2="235" />

                    <text class="tank-dim-label" x="8" y="165">dimA</text>

                    <!-- ============================================================
                     dimB
                     Ширина корпуса
                     ============================================================ -->
                    <line class="tank-guide-red" x1="120" y1="235" x2="120" y2="305" />
                    <line class="tank-guide-red" x1="240" y1="235" x2="240" y2="305" />

                    <line class="tank-dim" x1="120" y1="305" x2="240" y2="305" />
                    <line class="tank-dim-cap" x1="120" y1="297" x2="120" y2="313" />
                    <line class="tank-dim-cap" x1="240" y1="297" x2="240" y2="313" />

                    <text class="tank-dim-label" x="162" y="330">dimB</text>
                </g>
                break;


            // ============================================================
            // TYPE 7
            // Горизонтальный сборник с коническими боковинами
            // По компоновке как TYPE 2, меняются только днища
            // ============================================================
            case 7:
                <g>
                    <!-- Корпус: немного уже, чтобы вся схема лучше помещалась -->
                    <path class="tank-shape"
                          d="M105 125
                    L65 150
                    L65 190
                    L105 215
                    L235 215
                    L275 190
                    L275 150
                    L235 125
                    Z" />

                    <!-- Границы цилиндрической части -->
                    <line class="tank-body-line" x1="105" y1="125" x2="105" y2="215" />
                    <line class="tank-body-line" x1="235" y1="125" x2="235" y2="215" />

                    <!-- ============================================================
                     dimA
                     Длина цилиндрической части
                     ============================================================ -->
                    <line class="tank-guide-red" x1="105" y1="125" x2="105" y2="80" />
                    <line class="tank-guide-red" x1="235" y1="125" x2="235" y2="80" />

                    <line class="tank-dim" x1="105" y1="80" x2="235" y2="80" />
                    <line class="tank-dim-cap" x1="105" y1="72" x2="105" y2="88" />
                    <line class="tank-dim-cap" x1="235" y1="72" x2="235" y2="88" />

                    <text class="tank-dim-label" x="153" y="65">dimA</text>

                    <!-- ============================================================
                     dimB
                     Диаметр основной части
                     ============================================================ -->
                    <line class="tank-guide-red" x1="40" y1="125" x2="105" y2="125" />
                    <line class="tank-guide-red" x1="40" y1="215" x2="105" y2="215" />

                    <line class="tank-dim" x1="40" y1="125" x2="40" y2="215" />
                    <line class="tank-dim-cap" x1="32" y1="125" x2="48" y2="125" />
                    <line class="tank-dim-cap" x1="32" y1="215" x2="48" y2="215" />

                    <text class="tank-dim-label" x="30" y="174" text-anchor="end">dimB</text>

                    <!-- ============================================================
                     dimC
                     Глубина конической боковины
                     ============================================================ -->
                    <line class="tank-guide-red" x1="65" y1="190" x2="65" y2="265" />
                    <line class="tank-guide-red" x1="105" y1="215" x2="105" y2="265" />

                    <line class="tank-dim" x1="65" y1="265" x2="105" y2="265" />
                    <line class="tank-dim-cap" x1="65" y1="257" x2="65" y2="273" />
                    <line class="tank-dim-cap" x1="105" y1="257" x2="105" y2="273" />

                    <text class="tank-dim-label" x="68" y="290">dimC</text>

                    <!-- ============================================================
                     dimD
                     Диаметр малого основания конической боковины
                     Перенесён вправо, чтобы не пересекались линии
                     ============================================================ -->
                    <line class="tank-guide-red" x1="275" y1="150" x2="300" y2="150" />
                    <line class="tank-guide-red" x1="275" y1="190" x2="300" y2="190" />

                    <line class="tank-dim" x1="300" y1="150" x2="300" y2="190" />
                    <line class="tank-dim-cap" x1="292" y1="150" x2="308" y2="150" />
                    <line class="tank-dim-cap" x1="292" y1="190" x2="308" y2="190" />

                    <text class="tank-dim-label" x="312" y="175">dimD</text>
                </g>
                break;


            // ============================================================
            // TYPE 8
            // Вертикальный аппарат, похожий на TYPE 5,
            // но с другим нижним днищем
            // ============================================================
            case 8:
                <g>
                    <!-- ============================================================
                     Корпус аппарата
                     Один цилиндрический корпус + сужающееся нижнее днище
                     ============================================================ -->

                    <path class="tank-shape"
                          d="M145 55
                    L235 55
                    L235 245
                    L220 260
                    L160 260
                    L145 245
                    Z" />

                    <!-- Граница между верхней частью и внутренней частью -->
                    <line class="tank-body-line" x1="145" y1="110" x2="235" y2="110" />

                    <!-- Граница начала нижнего днища -->
                    <line class="tank-body-line" x1="145" y1="245" x2="235" y2="245" />


                    <!-- ============================================================
                     Внутренняя часть
                     ============================================================ -->

                    <rect class="tank-internal" x="157" y="120" width="66" height="110" />

                    @for (var x = 163; x <= 217; x += 8)
                    {
                        <line class="tank-bundle" x1="@x" y1="125" x2="@x" y2="225" />
                    }


                    <!-- ============================================================
                     dimE
                     От верха аппарата до верха внутренней части
                     ============================================================ -->

                    <line class="tank-guide-red" x1="85" y1="55" x2="145" y2="55" />
                    <line class="tank-guide-red" x1="85" y1="120" x2="157" y2="120" />

                    <line class="tank-dim" x1="85" y1="55" x2="85" y2="120" />

                    <line class="tank-dim-cap" x1="77" y1="55" x2="93" y2="55" />
                    <line class="tank-dim-cap" x1="77" y1="120" x2="93" y2="120" />

                    <text class="tank-dim-label" x="37" y="91">dimE</text>


                    <!-- ============================================================
                     dimD
                     Размер внутренней части
                     ============================================================ -->

                    <line class="tank-guide-red" x1="85" y1="120" x2="157" y2="120" />
                    <line class="tank-guide-red" x1="85" y1="230" x2="157" y2="230" />

                    <line class="tank-dim" x1="85" y1="120" x2="85" y2="230" />

                    <line class="tank-dim-cap" x1="77" y1="120" x2="93" y2="120" />
                    <line class="tank-dim-cap" x1="77" y1="230" x2="93" y2="230" />

                    <text class="tank-dim-label" x="37" y="180">dimD</text>


                    <!-- ============================================================
                     dimA
                     Общая высота до начала нижнего днища
                     ============================================================ -->

                    <line class="tank-guide-red" x1="235" y1="55" x2="330" y2="55" />
                    <line class="tank-guide-red" x1="235" y1="245" x2="330" y2="245" />

                    <line class="tank-dim" x1="330" y1="55" x2="330" y2="245" />

                    <line class="tank-dim-cap" x1="322" y1="55" x2="338" y2="55" />
                    <line class="tank-dim-cap" x1="322" y1="245" x2="338" y2="245" />

                    <text class="tank-dim-label" x="340" y="156">dimA</text>


                    <!-- ============================================================
                     dimC
                     Высота нижнего днища
                     ============================================================ -->

                    <line class="tank-guide-red" x1="235" y1="245" x2="275" y2="245" />
                    <line class="tank-guide-red" x1="220" y1="260" x2="275" y2="260" />

                    <line class="tank-dim" x1="275" y1="245" x2="275" y2="260" />

                    <line class="tank-dim-cap" x1="267" y1="245" x2="283" y2="245" />
                    <line class="tank-dim-cap" x1="267" y1="260" x2="283" y2="260" />

                    <text class="tank-dim-label" x="285" y="257">dimC</text>


                    <!-- ============================================================
                     dimB
                     Ширина корпуса
                     ============================================================ -->

                    <line class="tank-guide-red" x1="145" y1="245" x2="145" y2="305" />
                    <line class="tank-guide-red" x1="235" y1="245" x2="235" y2="305" />

                    <line class="tank-dim" x1="145" y1="305" x2="235" y2="305" />

                    <line class="tank-dim-cap" x1="145" y1="297" x2="145" y2="313" />
                    <line class="tank-dim-cap" x1="235" y1="297" x2="235" y2="313" />

                    <text class="tank-dim-label" x="176" y="330">dimB</text>
                </g>
                break;


            default:
                <g>
                    <rect class="tank-shape" x="120" y="80" width="140" height="180" rx="8" />
                    <text class="tank-empty-label" x="190" y="175" text-anchor="middle">No preview</text>
                </g>
                break;
        }

    </svg>

</div>

@code {
    [Parameter]
    public int TypeNumber { get; set; }
}