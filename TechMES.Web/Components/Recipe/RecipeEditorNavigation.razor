@using Microsoft.AspNetCore.WebUtilities
@using TechMES.Contracts.Security
@inject NavigationManager Navigation
@inject CurrentUserRoles UserRoles

<RadzenSelectBar @key="_revision" TValue="string" Value="@View" ValueChanged="@ChangeViewAsync" Disabled="@Disabled" AriaLabel="Recipe editor view">
    <Items>
        <RadzenSelectBarItem Text=" Back" Value="@("back")" Icon="arrow_back" />

        @if (UserRoles.HasRole(AppRoles.Developer))
        {
            <RadzenSelectBarItem Text=" Parameters" Value="@("parameters")" Icon="tune" />
            <RadzenSelectBarItem Text=" Stages" Value="@("stages")" Icon="view_agenda" />
        }

        <RadzenSelectBarItem Text=" Recipes" Value="@("recipes")" Icon="menu_book" />
    </Items>
</RadzenSelectBar>

@code {
    [Parameter] public string View { get; set; } = "recipes";
    [Parameter] public int? FamilyId { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback Back { get; set; }

    private int _revision;

    /// <summary>
    /// Ожидает общие роли до отображения навигации.
    /// Повторный запрос не создаётся, если роли уже загружает Header.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await UserRoles.EnsureLoadedAsync();
    }

    /// <summary>
    /// Общая навигация редакторов.
    /// Несохранённые черновики защищает существующий NavigationLock страницы.
    /// </summary>
    private async Task ChangeViewAsync(string value)
    {
        if (Disabled || value == View) return;

        // Ограничение перехода соответствует отображению кнопок.
        if ((value is "parameters" or "stages") && !UserRoles.HasRole(AppRoles.Developer)) return;

        if (value == "back" && Back.HasDelegate)
        {
            await Back.InvokeAsync();
        }
        else
        {
            var path = value switch { "back" => "/recipes", "parameters" => "/recipes/parameters", "stages" => "/recipes/stages", _ => "/recipes/editor" };

            Navigation.NavigateTo(FamilyId is > 0 ? $"{path}?family={FamilyId}" : path);
        }

        _revision++;
    }

    /// <summary>
    /// Передаёт выбранное семейство между редакторами.
    /// </summary>
    public static int? ReadFamily(string uri)
    {
        var query = QueryHelpers.ParseQuery(new Uri(uri).Query);

        return query.TryGetValue("family", out var text) && int.TryParse(text.ToString(), out var id) && id > 0 ? id : null;
    }
}